---
import type { AdaptedPage } from '@/lib/page-adapter';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getUITranslation } from '@/lib/translations';
// translate-code-embedded（Batch 3）：5 语言内容 namespace 接线（TERMINOLOGY-AND-RULES §四）
import * as C_EN from './aicoolit-content';
import * as C_ZH from './aicoolit-content-zh';
import * as C_RU from './aicoolit-content-ru';
import * as C_PT from './aicoolit-content-pt';
import * as C_ES from './aicoolit-content-es';
import series1Svg from './aicoolit-svg/1-40-Foot-AI-Container-Data-Center-100kW-per-Rack.svg?raw';
import series2Svg from './aicoolit-svg/2-40-Foot-AI-Container-Data-Center-60kW-per-Rack.svg?raw';
import series3Svg from './aicoolit-svg/3-20-Foot-AI-Container-Data-Center-50kW-per-Rack.svg?raw';
import series4Svg from './aicoolit-svg/4-40-Foot-AI-Container-Data-Center-50kW-per-Rack-Immersion-Cooling.svg?raw';

// ⚠️ Astro 7 Rust 编译器会静默丢弃本文件内任何 <script> 元素（同 <style is:global>
// 的坑，见 commit a16fc32）。因此客户端逻辑放在 public/js/aicoolit-page-client.js，
// 这里用 set:html 注入 script src 引用 —— SSR 输出原始 HTML，浏览器直接执行，
// 不经过 Astro 的 script 打包/收集管线。
const AICOOLIT_CLIENT_SCRIPT =
  '<script src="/js/aicoolit-page-client.js" defer></script>';
import './AICoolitPage.css';

export interface Props {
  page: AdaptedPage;
  lang: string;
}

const { page, lang } = Astro.props;
const pdfUrl = '/resources/SOETECK-AICoolit-Series-Liquid-Cooling-Data-Center-Solutions.pdf';

const C_LANG_MAP: Record<string, typeof C_EN> = { en: C_EN, zh: C_ZH, ru: C_RU, pt: C_PT, es: C_ES };
const C = C_LANG_MAP[lang] ?? C_EN;

const SERIES_SVG_HTML = [series1Svg, series2Svg, series3Svg, series4Svg].map((raw) => {
  const cleaned = raw.replace(/^<\?xml[^>]*\?>/, '').replace(/<style>.*?<\/style>/, '');
  return cleaned;
});
---

<div class="soeteck-aicoolit-solution" data-aicoolit-solution>
  <!-- Sticky Nav -->
  <nav class="soeteck-aicoolit-sticky-nav" data-aicoolit-nav aria-label={C.AICOOLIT_NAV.ariaLabel}>
    <div class="soeteck-container soeteck-aicoolit-sticky-nav__inner">
      <span class="soeteck-aicoolit-sticky-nav__brand">
        <strong>AICoolit&trade;</strong>
        <span class="soeteck-aicoolit-sticky-nav__divider" aria-hidden="true">|</span>
        <span>{C.AICOOLIT_NAV.brandSubtitle}</span>
      </span>
      <ul class="soeteck-aicoolit-sticky-nav__list">
        {C.AICOOLIT_NAV_SECTIONS.map((section) => (
          <li><a href={`#${section.id}`} class="soeteck-aicoolit-sticky-nav__link">{section.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- Hero -->
  <section class="soeteck-aicoolit-hero" id="aicoolit-hero" aria-labelledby="aicoolit-hero-title">
    <div class="soeteck-container soeteck-aicoolit-hero__breadcrumbs">
      <Breadcrumbs items={page.breadcrumbs} lang={lang} />
    </div>
    <div class="soeteck-container soeteck-aicoolit-hero__inner">
      <div class="soeteck-aicoolit-hero__content">
        <h1 id="aicoolit-hero-title" class="soeteck-page-title soeteck-aicoolit-hero__title" set:html={C.AICOOLIT_HERO.title}></h1>
        <p class="soeteck-aicoolit-hero__subtitle" set:html={C.AICOOLIT_HERO.subtitle}></p>
        <p class="soeteck-aicoolit-hero__intro" set:html={C.AICOOLIT_HERO.intro}></p>
        <div class="soeteck-aicoolit-hero__ctas">
          <a class="soeteck-button soeteck-button--primary" href="#aicoolit-models">
            {C.AICOOLIT_HERO.ctaModels}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M19 12l-7 7-7-7"/></svg>
          </a>
          <a class="soeteck-button soeteck-button--outline" href={pdfUrl} target="_blank" rel="noopener">{C.AICOOLIT_HERO.ctaWhitepaper}</a>
        </div>
        <div class="soeteck-aicoolit-hero__badges">
          <span class="soeteck-aicoolit-hero__badges-label">{C.AICOOLIT_HERO.badgesLabel}</span>
          {C.AICOOLIT_GPU_BADGES.map((badge) => (
            <span class="soeteck-aicoolit-hero__badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
              {badge}
            </span>
          ))}
        </div>
      </div>
      {page.heroImage && (
        <div class="soeteck-aicoolit-hero__media">
          <div class="soeteck-aicoolit-hero__glow" aria-hidden="true"></div>
          <img src="/resources/full-range-of-aicoolit-series-liquid-cooling-products-2-1.webp" alt={C.AICOOLIT_HERO.imgAlt} loading="eager" fetchpriority="high" />
        </div>
      )}
    </div>
    <!-- Stats Bar -->
    <div class="soeteck-container soeteck-aicoolit-stats__grid">
      {C.AICOOLIT_STATS.map((stat) => (
        <div class="soeteck-aicoolit-stats__card">
          <div class="soeteck-aicoolit-stats__value">
            <span class="soeteck-aicoolit-stats__number">{stat.value}</span>
            {stat.unit && <span class="soeteck-aicoolit-stats__unit">{stat.unit}</span>}
          </div>
          <div class="soeteck-aicoolit-stats__label">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Why Section -->
  <section class="soeteck-aicoolit-section soeteck-aicoolit-competitive" id="aicoolit-why" aria-labelledby="aicoolit-competitive-title">
    <div class="soeteck-container">
      <span class="soeteck-eyebrow">{C.AICOOLIT_WHY.eyebrow}</span>
      <h2 id="aicoolit-competitive-title" class="soeteck-section-title">{C.AICOOLIT_WHY.title}</h2>
      <p class="soeteck-section-lead">{C.AICOOLIT_WHY.lead}</p>
      <div class="soeteck-aicoolit-competitive__grid">
        {C.AICOOLIT_COMPARISON_CARDS.map((card) => (
          <article class="soeteck-aicoolit-compare-card">
            <h3 class="soeteck-aicoolit-compare-card__title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              {card.title}
            </h3>
            <p class="soeteck-aicoolit-compare-card__desc">{card.description}</p>
            {card.features.map((feature) => (
              <div class="soeteck-aicoolit-compare-card__feature">
                <strong>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
                  {feature.title}
                </strong>
                <p>{feature.text}</p>
              </div>
            ))}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Lineup -->
  <section class="soeteck-aicoolit-section soeteck-aicoolit-models" id="aicoolit-models" aria-labelledby="aicoolit-models-title">
    <div class="soeteck-container">
      <span class="soeteck-eyebrow">{C.AICOOLIT_MODELS.eyebrow}</span>
      <h2 id="aicoolit-models-title" class="soeteck-section-title">{C.AICOOLIT_MODELS.title}</h2>
      <div class="soeteck-aicoolit-models__badges">
        {C.AICOOLIT_MODELS.badges.map((badge) => (
          <span>{badge}</span>
        ))}
      </div>
    </div>
    {C.AICOOLIT_PRODUCT_SERIES.map((series, index) => (
      <article class={`soeteck-aicoolit-series ${index % 2 === 0 ? 'soeteck-aicoolit-series--text-first' : 'soeteck-aicoolit-series--image-first'}`}>
        <div class="soeteck-container soeteck-aicoolit-series__grid">
          <div class="soeteck-aicoolit-series__content">
            <span class="soeteck-aicoolit-series__label">{series.label}</span>
            <h3 class="soeteck-subsection-title soeteck-aicoolit-series__title">{series.title}</h3>
            <p class="soeteck-aicoolit-series__desc">{series.description}</p>
            <div class="soeteck-aicoolit-series__specs">
              {series.specs.map((spec) => (
                <div class="soeteck-aicoolit-series__spec">
                  <span class="soeteck-aicoolit-series__spec-label">{spec.label}</span>
                  <span class="soeteck-aicoolit-series__spec-value">{spec.value}</span>
                </div>
              ))}
            </div>
            <div class="soeteck-aicoolit-series__features">
              {series.features.map((feature) => (
                <p class="soeteck-aicoolit-series__feature">{feature}</p>
              ))}
            </div>
            <a class="soeteck-aicoolit-series__download" href={pdfUrl} target="_blank" rel="noopener">
              <span>{C.AICOOLIT_MODELS.downloadSpecs.replace('{series}', series.label)}</span>
              <span class="soeteck-aicoolit-series__download-icon" aria-hidden="true">&darr;</span>
            </a>
          </div>
          <div class="soeteck-aicoolit-series__media">
            <img src={series.image} alt={series.title} class="soeteck-aicoolit-series__image" loading="lazy" />
            <div class="soeteck-aicoolit-series__layout" set:html={SERIES_SVG_HTML[index]}></div>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- Engineering Core -->
  <section class="soeteck-aicoolit-section soeteck-aicoolit-components" id="aicoolit-components">
    <div class="soeteck-container">
      <span class="soeteck-eyebrow">{C.AICOOLIT_COMPONENTS.eyebrow}</span>
      <h2 class="soeteck-section-title">{C.AICOOLIT_COMPONENTS.title}</h2>
      <p class="soeteck-section-lead">{C.AICOOLIT_COMPONENTS.lead}</p>
    </div>

    <div class="soeteck-container">
      <div class="soeteck-aicoolit-layer">
        <div class="soeteck-aicoolit-layer__grid">
          <div class="soeteck-aicoolit-layer__main">
            <span class="soeteck-aicoolit-layer__badge">{C.AICOOLIT_SHELL.layer1Badge}</span>
            <h3 class="soeteck-aicoolit-layer__title">{C.AICOOLIT_SHELL.layer1Title}</h3>
            <p class="soeteck-aicoolit-layer__desc">{C.AICOOLIT_SHELL.layer1Desc}</p>
            <div class="soeteck-aicoolit-layer__specs">
              {C.AICOOLIT_LAYER_SPECS.map((spec) => (
                <div class="soeteck-aicoolit-layer__spec">
                  <span class="soeteck-aicoolit-layer__spec-icon">
                    {spec.icon === 'shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
                    {spec.icon === 'temperature' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V3.5a2.5 2.5 0 00-5 0v11.26a4.5 4.5 0 105 0z"/></svg>}
                    {spec.icon === 'globe' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>}
                  </span>
                  <span class="soeteck-aicoolit-layer__spec-label">{spec.label}</span>
                  <span class="soeteck-aicoolit-layer__spec-value">{spec.value}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="soeteck-aicoolit-layer__media-col">
            <div class="soeteck-aicoolit-layer__media">
              <img src="/resources/application-of-container-data-center-1.png.webp" alt={C.AICOOLIT_SHELL.layer1ImgAlt} class="soeteck-aicoolit-layer__image" loading="lazy" />
            </div>
            <div class="soeteck-aicoolit-layer__extra">
              <div class="soeteck-aicoolit-layer__spec">
                <span class="soeteck-aicoolit-layer__spec-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 3v18"/></svg>
                </span>
                <span class="soeteck-aicoolit-layer__spec-label">{C.AICOOLIT_LAYER_EXTRA_SPEC.label}</span>
                <span class="soeteck-aicoolit-layer__spec-value">{C.AICOOLIT_LAYER_EXTRA_SPEC.value}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="soeteck-aicoolit-shell-divider" aria-hidden="true">
      <div class="soeteck-aicoolit-shell-divider__line"></div>
      <span class="soeteck-aicoolit-shell-divider__text">
        <span class="soeteck-aicoolit-shell-divider__icon">&darr;</span>
        {C.AICOOLIT_SHELL.divider}
      </span>
      <div class="soeteck-aicoolit-shell-divider__line"></div>
    </div>

    <div class="soeteck-container">
      <span class="soeteck-aicoolit-layer__badge">{C.AICOOLIT_SHELL.layer2Badge}</span>
      <h3 class="soeteck-aicoolit-layer__title">{C.AICOOLIT_SHELL.layer2Title}</h3>
      <p class="soeteck-aicoolit-layer__desc" set:html={C.AICOOLIT_SHELL.layer2Desc}></p>
    </div>
    <div class="soeteck-container">
      <div class="soeteck-aicoolit-layer" data-aicoolit-tabs>
  <!-- Tab Navigation -->
  <div class="aicoolit-cdu__nav" role="tablist" aria-label={C.AICOOLIT_SHELL.tabsAriaLabel}>
    {C.AICOOLIT_CDU_TABS.map((tab, tabIndex) => (
      <button class={`aicoolit-cdu__tab${tabIndex === 0 ? ' is-active' : ''}`} role="tab" type="button" data-tab-target={tab.id} aria-selected={tabIndex === 0 ? 'true' : 'false'}>
        <svg class="aicoolit-cdu__tab-icon" width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true"><circle cx="4" cy="4" r="3"/></svg>
        <span class="aicoolit-cdu__tab-text">
          <span class="aicoolit-cdu__tab-title">{tab.title}</span>
          <span class="aicoolit-cdu__tab-subtitle">{tab.subtitle}</span>
        </span>
      </button>
    ))}
  </div>
  <!-- Tab Panels -->
  <div class="aicoolit-cdu__panels">
    {C.AICOOLIT_CDU_TABS.map((tab, tabIndex) => (
      <div class={`aicoolit-cdu__panel${tabIndex === 0 ? ' is-active' : ''}`} role="tabpanel" data-tab-panel={tab.id} { ...(tabIndex !== 0 && { hidden: true }) }>
        <div class="aicoolit-cdu__products">
          {tab.products.map((product) => (
            <div class="aicoolit-cdu__product">
              <a href={`/${lang}${product.url}`} class="aicoolit-cdu__product-link">
                <img src={product.image} alt={product.alt} class="aicoolit-cdu__product-img" />
              </a>
              <a href={`/${lang}${product.url}`} class="aicoolit-cdu__product-name">{product.title}</a>
            </div>
          ))}
        </div>
        <div class="aicoolit-cdu__info">
          <div class="aicoolit-cdu__info-header">
            <h4 class="aicoolit-cdu__info-title">{tab.contentTitle}</h4>
            <span class="aicoolit-cdu__badge">{tab.badge}</span>
          </div>
          <p class="aicoolit-cdu__info-desc">{tab.description}</p>
          <div class="aicoolit-cdu__tags">
            {tab.tags.map((tag) => (
              <span class="aicoolit-cdu__tag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))}
    </div>
    </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="soeteck-aicoolit-trust" aria-label={C.AICOOLIT_TRUST_HEAD.ariaLabel}>
    <div class="soeteck-container">
      <p class="soeteck-aicoolit-trust__heading">{C.AICOOLIT_TRUST_HEAD.heading}</p>
      <div class="soeteck-aicoolit-trust__grid">
        {C.AICOOLIT_TRUST_BADGES.map((badge) => (
          <div class="soeteck-aicoolit-trust__badge">
            <span class="soeteck-aicoolit-trust__icon" aria-hidden="true">
              {badge.icon === 'medal' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/></svg>}
              {badge.icon === 'check' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>}
              {badge.icon === 'lightbulb' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0018 8 6 6 0 006 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 018.91 14"/></svg>}
              {badge.icon === 'trending' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg>}
            </span>
            <span>{badge.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Supply Chain -->
  <section class="soeteck-aicoolit-section soeteck-aicoolit-supply">
    <div class="soeteck-container soeteck-aicoolit-supply__grid">
      <div class="soeteck-aicoolit-supply__content">
        <span class="soeteck-eyebrow">{C.AICOOLIT_SUPPLY_HEAD.eyebrow}</span>
        <h2 class="soeteck-section-title" set:html={C.AICOOLIT_SUPPLY_HEAD.title}></h2>
        <p>{C.AICOOLIT_SUPPLY_HEAD.lead}</p>
        <div class="soeteck-aicoolit-supply__items">
          {C.AICOOLIT_SUPPLY_CHAIN.map((item) => (
            <div class="soeteck-aicoolit-supply__item">
              <strong>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {item.title}
              </strong>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="soeteck-aicoolit-supply__media">
        <img src="/resources/data-center-container-in-soeteck-factory-1.jpg" alt={C.AICOOLIT_SUPPLY_HEAD.imgAlt} class="soeteck-aicoolit-supply__image" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="soeteck-aicoolit-section soeteck-aicoolit-faq" id="aicoolit-faq">
    <div class="soeteck-container">
      <span class="soeteck-eyebrow">{C.AICOOLIT_FAQ_HEAD.eyebrow}</span>
      <h2 class="soeteck-section-title">{C.AICOOLIT_FAQ_HEAD.title}</h2>
      <p class="soeteck-section-lead">{C.AICOOLIT_FAQ_HEAD.lead}</p>
      <div class="soeteck-aicoolit-faq__list" data-aicoolit-faq>
        {C.AICOOLIT_FAQ.map((faq, faqIndex) => (
          <details class="soeteck-aicoolit-faq__item">
            <summary class="soeteck-aicoolit-faq__question">
              <span>{faq.question}</span>
              <span class="soeteck-aicoolit-faq__chevron" aria-hidden="true"></span>
            </summary>
            <div class="soeteck-aicoolit-faq__answer">
              <p set:html={faq.answer}></p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="soeteck-aicoolit-section soeteck-aicoolit-cta" id="aicoolit-contact">
    <div class="soeteck-container soeteck-aicoolit-cta__grid">
      <div class="soeteck-aicoolit-cta__content">
        <h2 class="soeteck-section-title">{C.AICOOLIT_CTA.title}</h2>
        <p>{C.AICOOLIT_CTA.lead}</p>
        <div class="soeteck-aicoolit-cta__offers">
          {C.AICOOLIT_CTA_OFFERS.map((offer) => (
            <div class="soeteck-aicoolit-cta__offer">
              <span class="soeteck-aicoolit-cta__offer-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
              </span>
              <span>{offer.label}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="soeteck-aicoolit-cta__form">
        <div class="soeteck-aicoolit-cta__form-header">{C.AICOOLIT_FORM.title}</div>
        <form class="soeteck-aicoolit-cta__form-body" data-aicoolit-inquiry data-api-base={import.meta.env.PUBLIC_API_BASE || 'https://cms.soeteck.com/wp-json'} data-i18n-sending={getUITranslation(lang, 'common.submitting')} data-i18n-error={getUITranslation(lang, 'common.submitFailed')} aria-describedby="aicoolit-form-note">
          <input type="hidden" name="product_name" value="AICoolit Liquid Cooling Data Center" />
          <input type="hidden" name="product_url" value={Astro.url.pathname} />
          <div class="soeteck-aicoolit-cta__form-field">
            <label for="aicoolit-name" class="soeteck-aicoolit-cta__form-label">{C.AICOOLIT_FORM.nameLabel}</label>
            <input id="aicoolit-name" name="name" type="text" required class="soeteck-aicoolit-cta__form-input" placeholder={C.AICOOLIT_FORM.namePlaceholder} />
          </div>
          <div class="soeteck-aicoolit-cta__form-field">
            <label for="aicoolit-email" class="soeteck-aicoolit-cta__form-label">{C.AICOOLIT_FORM.emailLabel}</label>
            <input id="aicoolit-email" name="email" type="email" required class="soeteck-aicoolit-cta__form-input" placeholder={C.AICOOLIT_FORM.emailPlaceholder} />
          </div>
          <div class="soeteck-aicoolit-cta__form-field">
            <label for="aicoolit-company" class="soeteck-aicoolit-cta__form-label">{C.AICOOLIT_FORM.companyLabel}</label>
            <input id="aicoolit-company" name="company" type="text" class="soeteck-aicoolit-cta__form-input" placeholder={C.AICOOLIT_FORM.companyPlaceholder} />
          </div>
          <div class="soeteck-aicoolit-cta__form-field">
            <label for="aicoolit-phone" class="soeteck-aicoolit-cta__form-label">{C.AICOOLIT_FORM.phoneLabel}</label>
            <input id="aicoolit-phone" name="phone" type="tel" class="soeteck-aicoolit-cta__form-input" placeholder={C.AICOOLIT_FORM.phonePlaceholder} />
          </div>
          <div class="soeteck-aicoolit-cta__form-field">
            <label for="aicoolit-subject" class="soeteck-aicoolit-cta__form-label">{C.AICOOLIT_FORM.subjectLabel}</label>
            <input id="aicoolit-subject" name="subject" type="text" class="soeteck-aicoolit-cta__form-input" placeholder={C.AICOOLIT_FORM.subjectPlaceholder} />
          </div>
          <div class="soeteck-aicoolit-cta__form-field">
            <label for="aicoolit-message" class="soeteck-aicoolit-cta__form-label">{C.AICOOLIT_FORM.messageLabel}</label>
            <textarea id="aicoolit-message" name="message" required class="soeteck-aicoolit-cta__form-textarea" rows="4" placeholder={C.AICOOLIT_FORM.messagePlaceholder}></textarea>
          </div>
          <button type="submit" class="soeteck-aicoolit-cta__form-submit">{C.AICOOLIT_FORM.submit}</button>
          <p id="aicoolit-form-note" class="soeteck-aicoolit-cta__form-note" hidden></p>
        </form>
      </div>
    </div>
  </section>
</div>

<Fragment set:html={AICOOLIT_CLIENT_SCRIPT} />
