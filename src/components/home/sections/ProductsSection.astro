---
/**
 * ProductsSection — Products grid (grayscale→color hover) + Industries trust strip.
 * Shared across variants. `compact` renders a tighter 2-column grid (Variant C).
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';
interface Props {
  productCategories: HomeContent['productCategories'];
  industries: HomeContent['industries'];
  compact?: boolean;
}
const { productCategories, industries, compact = false } = Astro.props;
---

{/* ── PRODUCTS ── */}
<section class="home-products" aria-labelledby="products-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="home-section__eyebrow">{productCategories.eyebrow}</p>
      <h2 id="products-title" class="home-section__title">{productCategories.title}</h2>
    </div>
    {productCategories.groups.map((group) => (
      <div class="home-products__group">
        <h3 class="home-products__group-label">{group.label}</h3>
        <div class={`home-products__grid${compact ? ' home-products__grid--compact' : ''}`}>
          {group.items.map((item) => (
            <a href={item.ctaLink} class="home-product-card">
              <div class="home-product-card__images">
                <img class="home-product-card__img home-product-card__img--primary" src={item.image.path} alt={item.image.alt} width="384" height="384" loading="lazy" decoding="async" />
                <img class="home-product-card__img home-product-card__img--hover" src={item.hoverImage.path} alt={item.hoverImage.alt} width="384" height="384" loading="lazy" decoding="async" />
              </div>
              <div class="home-product-card__label">
                <span class="home-product-card__title">{item.title}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
    {/* Industries — subordinate trust strip */}
    <div class="home-products__industries">
      <span class="home-products__industries-label">{industries.eyebrow}</span>
      <div class="home-products__industries-strip">
        {industries.items.map((item) => (
          <a href={item.ctaLink} class="home-industry-chip">
            <span class="home-industry-chip__icon">{item.icon}</span>
            <span class="home-industry-chip__text">{item.title}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* ═══ PRODUCTS — grid layout matching live site ══════════════ */
.home-products {
  padding: var(--soeteck-section-y) 0 0;
  background: var(--soeteck-white);
}
.home-products :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

/* ── Shared section head ──────────────────────────────────── */
.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
.home-section__eyebrow { margin: 0 0 10px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 800; line-height: 1.12; color: var(--soeteck-text); }

/* ── Product groups ───────────────────────────────────────── */
.home-products__group { margin-bottom: 40px; }
.home-products__group-label {
  margin: 0 0 20px;
  font-size: var(--soeteck-text-sm);
  font-weight: 600;
  color: var(--soeteck-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.home-products__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.home-products__grid--compact {
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  max-width: 880px;
  margin: 0 auto;
}

/* ── Product card — grayscale→color hover ─────────────────── */
.home-product-card {
  display: flex;
  flex-direction: column;
  border-radius: var(--soeteck-radius-lg);
  overflow: hidden;
  background: var(--soeteck-surface);
  border: 1px solid var(--soeteck-border-soft);
  text-decoration: none;
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
}
.home-product-card:hover {
  border-color: var(--soeteck-primary);
  box-shadow: 0 8px 28px rgba(0, 102, 204, 0.1);
  transform: translateY(-3px);
}

.home-product-card__images {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--soeteck-white);
}
.home-product-card__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 16px;
  transition: transform 0.5s ease, opacity 0.4s ease;
}
.home-product-card__img--hover {
  opacity: 0;
}
.home-product-card:hover .home-product-card__img--primary {
  opacity: 0;
  transform: scale(1.05);
}
.home-product-card:hover .home-product-card__img--hover {
  opacity: 1;
  transform: scale(1.05);
}

.home-product-card__label {
  padding: 14px 16px;
  text-align: center;
  border-top: 1px solid var(--soeteck-border-soft);
}
.home-product-card__title {
  font-size: var(--soeteck-text-sm);
  font-weight: 600;
  color: var(--soeteck-text);
  line-height: 1.3;
}

/* ── Industries chip strip ────────────────────────────────── */
.home-products__industries {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 32px 0;
  margin-top: 20px;
  border-top: 1px solid var(--soeteck-border-soft);
}
.home-products__industries-label {
  font-size: var(--soeteck-text-xs);
  font-weight: 600;
  color: var(--soeteck-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  white-space: nowrap;
}
.home-products__industries-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.home-industry-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  background: var(--soeteck-white);
  border: 1px solid var(--soeteck-border);
  border-radius: 999px;
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  color: var(--soeteck-text-soft);
  transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
}
.home-industry-chip:hover {
  border-color: var(--soeteck-primary);
  color: var(--soeteck-primary);
  background: var(--soeteck-primary-soft);
}
.home-industry-chip__icon { font-size: 11px; }

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 991px) {
  .home-products__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .home-products__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .home-products__industries { flex-direction: column; align-items: flex-start; }
}
</style>
