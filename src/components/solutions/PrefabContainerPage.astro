---
import type { AdaptedPage } from '@/lib/page-adapter';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import * as C_EN from './prefab-content';
import * as C_ZH from './prefab-content-zh';
import * as C_RU from './prefab-content-ru';
import * as C_PT from './prefab-content-pt';
import * as C_ES from './prefab-content-es';
import '@/styles/product-gallery.css';
import './PrefabContainerPage.css';

export interface Props {
  page: AdaptedPage;
  lang: string;
}

const { page, lang } = Astro.props;
const brochureUrl = '/resources/Soeteck-Data-Center-Solution-Prefabricated-Container-Data-Center.pdf';

// 正文内容按语言选择（translate-code-embedded 模式，Batch 3）
const C_LANG_MAP: Record<string, typeof C_EN> = { en: C_EN, zh: C_ZH, ru: C_RU, pt: C_PT, es: C_ES };
const C = C_LANG_MAP[lang] ?? C_EN;
// 内容串中的 {lang} 占位符 → 当前语言前缀（内链 slug 不译，仅前缀动态化）
const overviewParagraphs = C.PREFAB_OVERVIEW_PARAGRAPHS.map((p) => p.replace(/\{lang\}/g, lang));

// hero 背景图：优先 ACF sections.heroImage（WP 后台可传），兜底原硬编码图
// replace 剥掉可能的 cms.soeteck.com 域名，统一成 /resources/ 相对路径
const heroOverride = page.sections?.heroImage?.replace(/^https?:\/\/[^/]+/, '');
const bannerImage = heroOverride || '/resources/soeteck-prefab-container-data-center-qatar-project-3.webp';
const videoThumb = '/resources/prefab-modular-data-center-of-Saudi-Telecom-01.webp';
const videoId = 'lKo6rY0jVm4';
---

<div class="soeteck-prefab-solution" data-prefab-solution>
  <!-- Banner Hero -->
  <section class="soeteck-prefab-banner" aria-labelledby="prefab-hero-title">
    <img class="soeteck-prefab-banner__image" src={bannerImage} alt={C.PREFAB_PAGE_HERO.bannerAlt} width="1920" height="600" loading="eager" fetchpriority="high" />
    <div class="soeteck-prefab-banner__overlay" aria-hidden="true"></div>
    <div class="soeteck-container soeteck-prefab-banner__inner">
      <Breadcrumbs items={page.breadcrumbs} class="soeteck-breadcrumbs--hero" lang={lang} />
      <div class="soeteck-prefab-banner__body">
        <h1 id="prefab-hero-title" class="soeteck-page-title soeteck-prefab-banner__title">{C.PREFAB_PAGE_HERO.title}</h1>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="soeteck-prefab-section soeteck-prefab-overview">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.PREFAB_OVERVIEW_HEADING}</h2>
      <div class="soeteck-prefab-overview__grid">
        <div class="soeteck-prefab-rich-text">
          {overviewParagraphs.map((p) => (
            <p set:html={p}></p>
          ))}
        </div>
        <div class="soeteck-prefab-video" data-prefab-video data-video-fallback-title={C.PREFAB_VIDEO_FALLBACK_TITLE}>
          <a class="soeteck-prefab-video__button" data-youtube-id={videoId} href={`https://www.youtube.com/watch?v=${videoId}`} target="_blank" rel="noopener" aria-label={C.PREFAB_PAGE_HERO.videoAriaLabel}>
            <img class="soeteck-prefab-video__image" src={videoThumb} alt={C.PREFAB_PAGE_HERO.videoThumbAlt} width="640" height="360" loading="lazy" />
            <span class="soeteck-prefab-video__play" aria-hidden="true"></span>
          </a>
        </div>
      </div>
      <div class="soeteck-prefab-cta-row">
        <a class="soeteck-button-primary" href={brochureUrl} target="_blank" rel="noopener">{C.PREFAB_CTA_ROW.getBrochure}</a>
        <a class="soeteck-button-outline" href={`/${lang}/contact-us/`}>{C.PREFAB_CTA_ROW.contactUs}</a>
      </div>
    </div>
  </section>

  <!-- Closer Look -->
  <section class="soeteck-prefab-section soeteck-prefab-closer">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.PREFAB_CLOSER_HEADING}</h2>

      <!-- 1 - Typical Design -->
      <article class="soeteck-prefab-detail-block">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>{C.PREFAB_DETAIL_BLOCKS.typical.num}</span>{C.PREFAB_DETAIL_BLOCKS.typical.title}</h3>
        <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
          <div class="soeteck-prefab-hotspot__media">
            <img class="soeteck-prefab-hotspot__image" src={C.PREFAB_HOTSPOT_IMAGE} alt={C.PREFAB_DETAIL_BLOCKS.typical.imageAlt} width="800" height="500" loading="lazy" />
            {C.PREFAB_HOTSPOTS.map((hotspot, index) => (
              <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={index} style={{ '--x': hotspot.x, '--y': hotspot.y } as any} aria-expanded="false" aria-label={hotspot.label}>
                <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{hotspot.label}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="soeteck-prefab-rich-text soeteck-prefab-detail-block__copy">
          <p>{C.PREFAB_DETAIL_BLOCKS.typical.lead}</p>
          <p><strong>{C.PREFAB_DETAIL_BLOCKS.typical.featuresLabel}</strong></p>
          <ul>
            {C.PREFAB_DETAIL_BLOCKS.typical.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
      </article>

      <!-- 2 - Models -->
      <article class="soeteck-prefab-detail-block soeteck-prefab-models">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>{C.PREFAB_DETAIL_BLOCKS.models.num}</span>{C.PREFAB_DETAIL_BLOCKS.models.title}</h3>
        <div class="soeteck-prefab-rich-text soeteck-prefab-models__intro">
          <p>{C.PREFAB_DETAIL_BLOCKS.models.intro}</p>
        </div>

        <!-- 20ft Model -->
        <section class="soeteck-prefab-model">
          <h4 class="soeteck-minor-title soeteck-title-bordered soeteck-prefab-model__title">{C.PREFAB_DETAIL_BLOCKS.models.ft20Title}</h4>
          <div class="soeteck-prefab-model__grid">
            <div class="soeteck-prefab-model__full-view">
              <img class="soeteck-prefab-model__image" src="/resources/20ft-container-data-center-3-1024x683.webp" alt={C.PREFAB_DETAIL_BLOCKS.models.ft20Title} width="400" height="300" loading="lazy" />
              <div class="soeteck-prefab-view-label"><span aria-hidden="true">&#9650;</span>{C.PREFAB_DETAIL_BLOCKS.models.fullViewLabel}</div>
              <p>{C.PREFAB_DETAIL_BLOCKS.models.ft20Desc}</p>
            </div>
            {C.PREFAB_MODEL_VIEWS_20FT.map((view) => (
              <div class="soeteck-prefab-view" data-prefab-view>
                <div class="soeteck-prefab-view__media">
                  <img class="soeteck-prefab-view__image" src={view.image} alt={view.title} width="400" height="300" loading="lazy" />
                  <div class="soeteck-prefab-view-label"><span aria-hidden="true">&#9650;</span>{view.title}</div>
                  {view.items.map((item, i) => (
                    <button class="soeteck-prefab-view__pin" type="button" data-view-target={i} style={{ '--x': item.x, '--y': item.y } as any} aria-label={item.label} aria-expanded="false">
                      <span class="soeteck-prefab-view__core">{i + 1}</span>
                      <span class="soeteck-prefab-view__pulse" aria-hidden="true"></span>
                    </button>
                  ))}
                </div>
                <div class="soeteck-prefab-view__accordion">
                  {view.items.map((item, i) => (
                    <div class="soeteck-prefab-view__item" data-view-item={i}>
                      <button class="soeteck-prefab-view__title" type="button" aria-expanded="false">{item.label}</button>
                      <div class="soeteck-prefab-view__content"><div class="soeteck-prefab-view__content-inner">{item.text}</div></div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- 40ft Model -->
        <section class="soeteck-prefab-model">
          <h4 class="soeteck-minor-title soeteck-title-bordered soeteck-prefab-model__title">{C.PREFAB_DETAIL_BLOCKS.models.ft40Title}</h4>
          <div class="soeteck-prefab-model__grid">
            <div class="soeteck-prefab-model__full-view">
              <img class="soeteck-prefab-model__image" src="/resources/40ft-container-data-center-3-1024x683.webp" alt={C.PREFAB_DETAIL_BLOCKS.models.ft40Title} width="400" height="300" loading="lazy" />
              <div class="soeteck-prefab-view-label"><span aria-hidden="true">&#9650;</span>{C.PREFAB_DETAIL_BLOCKS.models.fullViewLabel}</div>
              <p>{C.PREFAB_DETAIL_BLOCKS.models.ft40Desc}</p>
            </div>
            {C.PREFAB_MODEL_VIEWS_40FT.map((view) => (
              <div class="soeteck-prefab-view" data-prefab-view>
                <div class="soeteck-prefab-view__media">
                  <img class="soeteck-prefab-view__image" src={view.image} alt={view.title} width="400" height="300" loading="lazy" />
                  <div class="soeteck-prefab-view-label"><span aria-hidden="true">&#9650;</span>{view.title}</div>
                  {view.items.map((item, i) => (
                    <button class="soeteck-prefab-view__pin" type="button" data-view-target={i} style={{ '--x': item.x, '--y': item.y } as any} aria-label={item.label} aria-expanded="false">
                      <span class="soeteck-prefab-view__core">{i + 1}</span>
                      <span class="soeteck-prefab-view__pulse" aria-hidden="true"></span>
                    </button>
                  ))}
                </div>
                <div class="soeteck-prefab-view__accordion">
                  {view.items.map((item, i) => (
                    <div class="soeteck-prefab-view__item" data-view-item={i}>
                      <button class="soeteck-prefab-view__title" type="button" aria-expanded="false">{item.label}</button>
                      <div class="soeteck-prefab-view__content"><div class="soeteck-prefab-view__content-inner">{item.text}</div></div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      </article>

      <!-- 3 - Core Modules -->
      <article class="soeteck-prefab-detail-block soeteck-prefab-modules">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>{C.PREFAB_DETAIL_BLOCKS.modules.num}</span>{C.PREFAB_DETAIL_BLOCKS.modules.title}</h3>
        <div class="soeteck-prefab-rich-text soeteck-prefab-modules__lead">
          <p>{C.PREFAB_DETAIL_BLOCKS.modules.lead}</p>
        </div>
        <div class="soeteck-prefab-module-grid">
          {C.PREFAB_CORE_MODULES.map((module) => (
            <article class="soeteck-prefab-module-card">
              <span class={`soeteck-prefab-module-card__icon soeteck-prefab-module-card__icon--${module.icon}`} aria-hidden="true"></span>
              <h3 class="soeteck-card-title">{module.title}</h3>
              <p>{module.text}</p>
            </article>
          ))}
        </div>
      </article>

      <!-- Critical Power -->
      <section class="soeteck-prefab-product-group" aria-labelledby="prefab-critical-power-title">
        <div class="soeteck-prefab-rich-text">
          <h4 id="prefab-critical-power-title" class="soeteck-minor-title soeteck-title-bordered">{C.PREFAB_PRODUCT_GROUPS.criticalPower}</h4>
          <p>{C.PREFAB_CRITICAL_POWER_TEXT}</p>
        </div>
        <div class="soeteck-prefab-product-gallery-grid" data-prefab-gallery>
          {C.PREFAB_CRITICAL_POWER_PRODUCTS.map((product, pIdx) => {
            const panelId = `prefab-critical-power-${pIdx}`;
            return (
              <article class="soeteck-prefab-product-gallery" data-product-panel={panelId}>
                <div class="soeteck-prefab-product-gallery__stage">
                  {product.images.slice(0, 4).map((img, iIdx) => (
                    <a class={`soeteck-prefab-product-gallery__item${iIdx === 0 ? ' is-active' : ''}`}
                       href={`/${lang}/products/${product.slug}/`}
                       target="_blank" rel="noopener"
                       data-product-gallery-item={`${panelId}-${iIdx}`}>
                      <img src={img} alt={product.title} class="soeteck-prefab-product-gallery__image" loading="lazy" />
                    </a>
                  ))}
                </div>
                {product.images.slice(0, 4).length > 1 && (
                  <div class="soeteck-prefab-product-gallery__thumbs" role="tablist" aria-label={C.PREFAB_PRODUCT_GROUPS.galleryAria.replace('{title}', product.title)}>
                    {product.images.slice(0, 4).map((img, iIdx) => (
                      <button class={`soeteck-prefab-product-gallery__thumb${iIdx === 0 ? ' is-active' : ''}`}
                              type="button"
                              data-product-gallery-target={`${panelId}-${iIdx}`}
                              aria-selected={iIdx === 0 ? 'true' : 'false'}>
                        <img src={img} alt="" class="soeteck-prefab-product-gallery__thumb-image" loading="lazy" />
                      </button>
                    ))}
                  </div>
                )}
                <div class="soeteck-prefab-product-gallery__copy">
                  <a class="soeteck-card-title soeteck-prefab-product-gallery__title" href={`/${lang}/products/${product.slug}/`} target="_blank" rel="noopener">{product.title}</a>
                  <p class="soeteck-prefab-product-gallery__excerpt">{product.excerpt}</p>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Thermal Management -->
      <section class="soeteck-prefab-product-group" aria-labelledby="prefab-thermal-title">
        <div class="soeteck-prefab-rich-text">
          <h4 id="prefab-thermal-title" class="soeteck-minor-title soeteck-title-bordered">{C.PREFAB_PRODUCT_GROUPS.thermal}</h4>
          <p>{C.PREFAB_THERMAL_MANAGEMENT_TEXT}</p>
        </div>
        <div class="soeteck-prefab-product-gallery-grid" data-prefab-gallery>
          {C.PREFAB_THERMAL_PRODUCTS.map((product, pIdx) => {
            const panelId = `prefab-thermal-${pIdx}`;
            return (
              <article class="soeteck-prefab-product-gallery" data-product-panel={panelId}>
                <div class="soeteck-prefab-product-gallery__stage">
                  {product.images.slice(0, 4).map((img, iIdx) => (
                    <a class={`soeteck-prefab-product-gallery__item${iIdx === 0 ? ' is-active' : ''}`}
                       href={`/${lang}/products/${product.slug}/`}
                       target="_blank" rel="noopener"
                       data-product-gallery-item={`${panelId}-${iIdx}`}>
                      <img src={img} alt={product.title} class="soeteck-prefab-product-gallery__image" loading="lazy" />
                    </a>
                  ))}
                </div>
                {product.images.slice(0, 4).length > 1 && (
                  <div class="soeteck-prefab-product-gallery__thumbs" role="tablist" aria-label={C.PREFAB_PRODUCT_GROUPS.galleryAria.replace('{title}', product.title)}>
                    {product.images.slice(0, 4).map((img, iIdx) => (
                      <button class={`soeteck-prefab-product-gallery__thumb${iIdx === 0 ? ' is-active' : ''}`}
                              type="button"
                              data-product-gallery-target={`${panelId}-${iIdx}`}
                              aria-selected={iIdx === 0 ? 'true' : 'false'}>
                        <img src={img} alt="" class="soeteck-prefab-product-gallery__thumb-image" loading="lazy" />
                      </button>
                    ))}
                  </div>
                )}
                <div class="soeteck-prefab-product-gallery__copy">
                  <a class="soeteck-card-title soeteck-prefab-product-gallery__title" href={`/${lang}/products/${product.slug}/`} target="_blank" rel="noopener">{product.title}</a>
                  <p class="soeteck-prefab-product-gallery__excerpt">{product.excerpt}</p>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </div>
  </section>

  <!-- Specs Table -->
  <section class="soeteck-prefab-section soeteck-prefab-specs">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.PREFAB_SPECS.heading}</h2>
      <div class="soeteck-prefab-table-wrap">
        <table class="soeteck-prefab-spec-table">
          <thead>
            <tr class="soeteck-prefab-spec-table__images">
              <th scope="col"></th>
              {C.PREFAB_SPEC_COLUMNS.map((col) => (
                <th scope="col">
                  <img src={col.image} alt={col.model} width="249" height="282" loading="lazy" />
                </th>
              ))}
            </tr>
            <tr>
              <th scope="col">{C.PREFAB_SPECS.modelsLabel}</th>
              {C.PREFAB_SPEC_COLUMNS.map((col) => (
                <th scope="col">{col.model}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {C.PREFAB_SPEC_ROWS.map((row) => (
              <tr>
                <th scope="row">{row[0]}</th>
                {row.slice(1).map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="soeteck-prefab-pdf-link"><a href={brochureUrl} target="_blank" rel="noopener"><span aria-hidden="true">PDF</span>{C.PREFAB_SPECS.pdfLinkText}</a></p>
    </div>
  </section>

  <!-- Scenarios -->
  <section class="soeteck-prefab-section soeteck-prefab-scenarios">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.PREFAB_SCENARIOS_HEADING}</h2>
      <p class="soeteck-prefab-section__subtitle">{C.PREFAB_SCENARIOS_SUBTITLE}</p>
      <div class="soeteck-prefab-scenario-grid">
        {C.PREFAB_SCENARIOS.map((scenario) => (
          <article class="soeteck-prefab-scenario-card" data-scenario-card>
            <img class="soeteck-prefab-scenario-card__image" src={scenario.image} alt={scenario.title} width="436" height="237" loading="lazy" />
            <div class="soeteck-prefab-scenario-card__body">
              <h3 class="soeteck-card-title">{scenario.title}</h3>
              <div class="soeteck-prefab-scenario-card__tabs" role="tablist" aria-label={C.PREFAB_SCENARIO_UI.detailsAria.replace('{title}', scenario.title)}>
                <button class="soeteck-prefab-scenario-card__tab is-active" type="button" role="tab" aria-selected="true" data-scenario-tab="benefits">{C.PREFAB_SCENARIO_UI.benefitsTab}</button>
                <button class="soeteck-prefab-scenario-card__tab" type="button" role="tab" aria-selected="false" data-scenario-tab="pain">{C.PREFAB_SCENARIO_UI.painTab}</button>
              </div>
              <div class="soeteck-prefab-scenario-card__panel is-active" data-scenario-panel="benefits">
                <div class="soeteck-prefab-scenario-card__tags">
                  {scenario.benefits.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <p>{scenario.solution}</p>
              </div>
              <div class="soeteck-prefab-scenario-card__panel" data-scenario-panel="pain" hidden>
                <div class="soeteck-prefab-scenario-card__tags">
                  {scenario.pain_points.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <p>{scenario.problem}</p>
              </div>
              <p><strong>{scenario.application}</strong></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Client Cases -->
  <section class="soeteck-prefab-section soeteck-prefab-cases">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.PREFAB_CASES_HEADING}</h2>
      <div class="soeteck-prefab-case-grid">
        {C.PREFAB_CLIENT_CASES.map((c) => (
          <article class="soeteck-prefab-case-card">
            <a class="soeteck-prefab-case-card__media" href={`/${lang}/news-and-insights/client-case-studies/${c.slug}/`}>
              <img class="soeteck-prefab-case-card__image" src={c.imgSrc} alt={c.title} width="436" height="240" loading="lazy" />
            </a>
            <div class="soeteck-prefab-case-card__body">
              <h3 class="soeteck-card-title"><a href={`/${lang}/news-and-insights/client-case-studies/${c.slug}/`}>{c.title}</a></h3>
              <p>{c.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="soeteck-cta" id="prefab-inquiry">
    <div class="soeteck-container soeteck-cta__inner">
      <div>
        <p class="soeteck-eyebrow">{C.PREFAB_CTA_SECTION.eyebrow}</p>
        <h2>{C.PREFAB_CTA_SECTION.title}</h2>
        <p>{C.PREFAB_CTA_SECTION.text}</p>
        <ul class="soeteck-cta__checks">
          {C.PREFAB_CTA_SECTION.checks.map((check) => (
            <li>{check}</li>
          ))}
        </ul>
      </div>
      <div class="soeteck-cta__actions">
        <a class="soeteck-cta__button" href={`/${lang}/contact-us/`}>{C.PREFAB_CTA_SECTION.contactButton}</a>
        <a class="soeteck-cta__button soeteck-cta__button--outline" href={brochureUrl} target="_blank" rel="noopener">{C.PREFAB_CTA_SECTION.brochureButton}</a>
      </div>
    </div>
  </section>
</div>


<script>


// @ts-nocheck — 内嵌迁移 JS（IIFE + DOM），类型由运行验证维护；模板区 {…} 仍检查

/*
 * Prefabricated Container Data Center solution page interactions.
 * @package Soeteck
 */

(function () {
    'use strict';

    var roots = document.querySelectorAll('[data-prefab-solution]');

    if (!roots.length) {
        return;
    }

    function buildYouTubeEmbed(videoId: string, title: string, fallbackTitle: string) {
        var wrapper = document.createElement('div');
        var iframe = document.createElement('iframe');

        wrapper.className = 'soeteck-prefab-video__iframe-wrap';

        iframe.className = 'soeteck-prefab-video__iframe';
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1&rel=0';
        iframe.title = title || fallbackTitle || '';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.loading = 'eager';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';

        wrapper.appendChild(iframe);

        return wrapper;
    }

    function enhanceVideos(root) {
        var triggers = root.querySelectorAll('[data-youtube-id]');

        triggers.forEach(function (trigger) {
            trigger.addEventListener('click', function (event) {
                var videoId = trigger.getAttribute('data-youtube-id');
                var videoShell = trigger.closest('[data-prefab-video]');

                if (!videoId || !videoShell) {
                    return;
                }

                event.preventDefault();

                videoShell.replaceChildren(buildYouTubeEmbed(videoId, trigger.getAttribute('aria-label'), videoShell.getAttribute('data-video-fallback-title')));
            });
        });
    }

    function clearHotspotGroup(group) {
        group.querySelectorAll('[data-hotspot-index].is-active').forEach(function (pin) {
            pin.classList.remove('is-active');
            pin.setAttribute('aria-expanded', 'false');
        });
    }

    function enhanceHotspots(root) {
        var groups = root.querySelectorAll('[data-prefab-hotspots]');

        groups.forEach(function (group) {
            var pins = group.querySelectorAll('[data-hotspot-index]');

            pins.forEach(function (pin) {
                pin.addEventListener('click', function (event) {
                    var isActive = pin.classList.contains('is-active');

                    event.stopPropagation();
                    clearHotspotGroup(group);

                    if (!isActive) {
                        pin.classList.add('is-active');
                        pin.setAttribute('aria-expanded', 'true');
                    }
                });

                pin.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') {
                        clearHotspotGroup(group);
                        pin.blur();
                    }
                });
            });

            document.addEventListener('click', function (event) {
                if (!group.contains(event.target)) {
                    clearHotspotGroup(group);
                }
            });
        });
    }

    function clearViewGroup(group) {
        group.querySelectorAll('.is-active').forEach(function (node) {
            node.classList.remove('is-active');
        });

        group.querySelectorAll('[aria-expanded="true"]').forEach(function (node) {
            node.setAttribute('aria-expanded', 'false');
        });
    }

    function setViewTarget(group, target) {
        var pin = group.querySelector('[data-view-target="' + target + '"]');
        var item = group.querySelector('[data-view-item="' + target + '"]');
        var title = item ? item.querySelector('.soeteck-prefab-view__title') : null;

        if (!pin || !item || !title) {
            return;
        }

        clearViewGroup(group);
        pin.classList.add('is-active');
        pin.setAttribute('aria-expanded', 'true');
        item.classList.add('is-active');
        title.classList.add('is-active');
        title.setAttribute('aria-expanded', 'true');
    }

    function enhanceViewAccordions(root) {
        var groups = root.querySelectorAll('[data-prefab-view]');

        groups.forEach(function (group) {
            group.querySelectorAll('[data-view-target]').forEach(function (pin) {
                pin.addEventListener('click', function () {
                    var target = pin.getAttribute('data-view-target');
                    var isActive = pin.classList.contains('is-active');

                    clearViewGroup(group);

                    if (!isActive && target) {
                        setViewTarget(group, target);
                    }
                });
            });

            group.querySelectorAll('[data-view-item]').forEach(function (item) {
                var title = item.querySelector('.soeteck-prefab-view__title');

                if (!title) {
                    return;
                }

                title.addEventListener('click', function () {
                    var target = item.getAttribute('data-view-item');
                    var isActive = item.classList.contains('is-active');

                    clearViewGroup(group);

                    if (!isActive && target) {
                        setViewTarget(group, target);
                    }
                });
            });
        });
    }

    function enhanceScenarioCards(root) {
        root.querySelectorAll('[data-scenario-card]').forEach(function (card) {
            card.querySelectorAll('[data-scenario-tab]').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var target = tab.getAttribute('data-scenario-tab');

                    if (!target) {
                        return;
                    }

                    card.querySelectorAll('[data-scenario-tab]').forEach(function (node) {
                        var isActive = node === tab;
                        node.classList.toggle('is-active', isActive);
                        node.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    });

                    card.querySelectorAll('[data-scenario-panel]').forEach(function (panel) {
                        var isActive = panel.getAttribute('data-scenario-panel') === target;
                        panel.classList.toggle('is-active', isActive);
                        panel.hidden = !isActive;
                    });
                });
            });
        });
    }

    function enhanceProductGallery(root) {
        var grids = root.querySelectorAll('[data-prefab-gallery]');
        grids.forEach(function (grid) {
            grid.querySelectorAll('[data-product-gallery-target]').forEach(function (thumb) {
                thumb.addEventListener('click', function () {
                    var target = thumb.getAttribute('data-product-gallery-target');
                    var panel = thumb.closest('[data-product-panel]');
                    if (!panel) return;
                    panel.querySelectorAll('[data-product-gallery-target]').forEach(function (t) {
                        t.classList.remove('is-active');
                        t.setAttribute('aria-selected', 'false');
                    });
                    panel.querySelectorAll('[data-product-gallery-item]').forEach(function (item) {
                        item.classList.remove('is-active');
                    });
                    thumb.classList.add('is-active');
                    thumb.setAttribute('aria-selected', 'true');
                    var activeItem = panel.querySelector('[data-product-gallery-item="' + target + '"]');
                    if (activeItem) activeItem.classList.add('is-active');
                });
            });
        });
    }

    roots.forEach(function (root) {
        enhanceVideos(root);
        enhanceHotspots(root);
        enhanceViewAccordions(root);
        enhanceScenarioCards(root);
        enhanceProductGallery(root);
    });
}());
</script>