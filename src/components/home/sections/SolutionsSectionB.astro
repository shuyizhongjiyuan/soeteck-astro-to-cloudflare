---
/**
 * SolutionsSectionB — Narrative-driven solutions (Variant B).
 * Each solution is a "story chapter": chapter number, dashed thread line,
 * light cards on surface background — distinct from Variant A's dark blocks.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props {
  solutions: HomeContent['solutions'];
}

const { solutions } = Astro.props;
---

<section class="home-solutions-b" aria-labelledby="solutions-b-title">
  <div class="soeteck-container">
    <div class="home-section__head home-section__head--left">
      <p class="home-section__eyebrow">{solutions.eyebrow}</p>
      <h2 id="solutions-b-title" class="home-section__title">{solutions.title}</h2>
      <p class="home-section__lead">{solutions.text}</p>
    </div>
    <div class="home-solutions-b__thread">
      {solutions.cards.map((card, i) => (
        <article class={`home-solution-b${i % 2 === 1 ? ' home-solution-b--reverse' : ''}`}>
          <div class="home-solution-b__media">
            <img src={card.image.path} alt={card.image.alt} width="600" height="380" loading="lazy" decoding="async" />
            <span class="home-solution-b__chapter" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="home-solution-b__body">
            <span class="home-solution-b__step">Chapter {String(i + 1).padStart(2, '0')}</span>
            <h3 class="home-solution-b__title">{card.title}</h3>
            <p class="home-solution-b__text">{card.text}</p>
            <ul class="home-solution-b__features">
              {card.features.map((feat) => <li>{feat}</li>)}
            </ul>
            <a href={card.ctaLink} class="home-solution-b__cta">{card.cta} →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
/* ═══ SOLUTIONS B — narrative story cards ════════════════════ */
.home-solutions-b {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-surface);
}
.home-solutions-b :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

/* ── Section head ─────────────────────────────────────────── */
.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
.home-section__head--left { margin-left: 0; text-align: left; }
.home-section__eyebrow { margin: 0 0 10px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(1.85rem, 3.1vw, 2.5rem); font-weight: 700; line-height: 1.14; color: var(--soeteck-text); }
.home-section__lead { margin: 18px 0 0; font-size: 1.05rem; line-height: 1.7; color: var(--soeteck-text-soft); }

/* ── Narrative thread ─────────────────────────────────────── */
.home-solutions-b__thread {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: clamp(32px, 4vw, 48px);
}
.home-solutions-b__thread::before {
  content: '';
  position: absolute;
  top: 60px;
  bottom: 60px;
  left: 32px;
  width: 2px;
  border-left: 2px dashed var(--soeteck-border);
}

/* ── Story card ───────────────────────────────────────────── */
.home-solution-b {
  position: relative;
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: clamp(28px, 4vw, 56px);
  align-items: center;
  padding: 24px;
  background: var(--soeteck-white);
  border: 1px solid var(--soeteck-border-soft);
  border-radius: var(--soeteck-radius-lg);
  box-shadow: 0 8px 32px rgba(15, 23, 42, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.home-solution-b:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 40px rgba(15, 23, 42, 0.1);
}
.home-solution-b--reverse { direction: rtl; }
.home-solution-b--reverse > * { direction: ltr; }

/* ── Media + chapter badge ────────────────────────────────── */
.home-solution-b__media {
  position: relative;
  border-radius: var(--soeteck-radius);
  overflow: hidden;
  aspect-ratio: 16 / 10;
}
.home-solution-b__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.home-solution-b:hover .home-solution-b__media img { transform: scale(1.04); }

.home-solution-b__chapter {
  position: absolute;
  bottom: 14px;
  left: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 52px;
  height: 52px;
  padding: 0 10px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(6px);
  color: #fff;
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: 0.04em;
}

/* ── Body ─────────────────────────────────────────────────── */
.home-solution-b__step {
  display: block;
  margin-bottom: 10px;
  font-size: var(--soeteck-text-xs);
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--soeteck-primary);
}
.home-solution-b__title {
  margin: 0 0 12px;
  font-size: clamp(1.4rem, 2.2vw, 1.8rem);
  font-weight: 700;
  color: var(--soeteck-text);
  line-height: 1.2;
}
.home-solution-b__text {
  margin: 0 0 18px;
  font-size: 1rem;
  line-height: 1.7;
  color: var(--soeteck-text-soft);
}
.home-solution-b__features {
  list-style: none;
  margin: 0 0 24px;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.home-solution-b__features li {
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--soeteck-primary-soft);
  color: var(--soeteck-primary-dark);
  font-size: var(--soeteck-text-xs);
  font-weight: 600;
}
.home-solution-b__cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 24px;
  border-radius: 999px;
  background: var(--soeteck-primary);
  color: #fff;
  font-size: var(--soeteck-text-sm);
  font-weight: 600;
  text-decoration: none;
  transition: background 0.3s ease, transform 0.2s ease;
}
.home-solution-b__cta:hover {
  background: var(--soeteck-primary-dark);
  transform: translateY(-1px);
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 991px) {
  .home-solution-b { grid-template-columns: 1fr; }
  .home-solution-b--reverse { direction: ltr; }
  .home-solutions-b__thread::before { display: none; }
}
</style>
