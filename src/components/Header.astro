---
// @ts-nocheck — 巨型内嵌 megamenu 模板表达式超出 Astro TS 语言服务解析能力（2304/级联语法错误），
// 运行时不受影响（Astro 编译器正常 build）；类型守护以此文件为准 + 构建产物验证。
import type { GlobalConfigResponse } from '@/lib/content-api';
import { getUITranslation } from '@/lib/translations';
import HeaderDesktopMenu from './HeaderDesktopMenu.astro';
import HeaderMobileMenu from './HeaderMobileMenu.astro';
import { localizePath, translateNav, getLanguageUrl } from '@/lib/header-helpers';

interface Props {
  globalConfig: GlobalConfigResponse;
  lang?: string;
}

const { globalConfig, lang = 'en' } = Astro.props;

// Use data from API, fall back to defaults if not available
const mainNavigation = globalConfig.mainNavigation || [];
const languages = globalConfig.languages || [
  { slug: 'en', name: 'English', nativeName: 'English', flag: { path: '/resources/flags/en.svg' }, url: '/en/', isCurrent: true },
  { slug: 'zh', name: 'Chinese', nativeName: '中文', flag: { path: '/resources/flags/zh.svg' }, url: '/zh/', isCurrent: false },
  { slug: 'ru', name: 'Russian', nativeName: 'Русский', flag: { path: '/resources/flags/ru.svg' }, url: '/ru/', isCurrent: false },
  { slug: 'pt', name: 'Portuguese', nativeName: 'Português', flag: { path: '/resources/flags/pt.svg' }, url: '/pt/', isCurrent: false },
  { slug: 'es', name: 'Spanish', nativeName: 'Español', flag: { path: '/resources/flags/es.svg' }, url: '/es/', isCurrent: false },
];
const currentLanguage = globalConfig.currentLanguage || languages[0];
const logoUrl = globalConfig.site.logo?.path || '/resources/soeteck-logo-2.webp';
const contactUrl = localizePath(globalConfig.urls.contact || '/en/contact-us/', lang);
const searchUrl = localizePath(globalConfig.urls.search || '/en/search/', lang);
---

<header id="masthead" class="site-header">
  <div class="header-inner">
    <a class="site-logo-link" href={localizePath("/en/", lang)} rel="home" aria-label="Soeteck">
      <img class="site-logo-image" src={logoUrl} alt="Soeteck" width="230" height="57">
    </a>

    <button class="menu-toggle" type="button" aria-controls="mobile-menu-overlay" aria-expanded="false" aria-label="Open menu">
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
    </button>

    <HeaderDesktopMenu items={mainNavigation} lang={lang} />

    <div class="header-actions">
      <div class="header-dropdown language-navigation">
        <button class="language-toggle" type="button" aria-expanded="false" aria-label="Language">
          <img class="globe-icon" src="/resources/globe-1.svg" alt="" width="22" height="22" aria-hidden="true">
        </button>
        <ul class="header-dropdown-panel language-panel">
          {languages.map(l => (
            <li>
              <a href={getLanguageUrl(l.slug, Astro.url.pathname)} aria-current={l.slug === lang ? 'true' : undefined}>
                <img src={l.flag.path} alt={l.name} width="18" height="12">
                <span>{l.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="header-dropdown header-search">
        <button class="header-icon-button header-search-toggle" type="button" aria-expanded="false" aria-label={getUITranslation(lang, 'common.search')}>
          <img class="search-icon" src="/resources/MagnifyingGlass.svg" alt="" width="18" height="18" aria-hidden="true">
        </button>
        <div class="header-dropdown-panel search-panel">
          <form role="search" method="get" class="header-search-form" action={searchUrl}>
            <label class="screen-reader-text" for="header-search-field">{getUITranslation(lang, 'common.searchFor')}</label>
            <input id="header-search-field" type="search" name="s" placeholder={getUITranslation(lang, 'common.searchPlaceholder')}>
            <button type="submit">{getUITranslation(lang, 'common.search')}</button>
          </form>
        </div>
      </div>

      <a class="header-contact-button" href={contactUrl}>
        {translateNav('Contact Us', lang)}
      </a>
    </div>
  </div>
</header>

<HeaderMobileMenu items={mainNavigation} languages={languages} lang={lang} contactUrl={contactUrl} logoUrl={logoUrl} />

<!-- Mobile search overlay -->
<div id="mobile-search-overlay" class="mobile-search-overlay" role="dialog" aria-modal="true" aria-label={getUITranslation(lang, 'common.search')}>
  <div class="mobile-search-sidebar">
    <div class="mobile-menu-header">
      <button class="mobile-search-close" type="button" aria-label="Close search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="mobile-search-title">{getUITranslation(lang, 'common.search')}</div>
    </div>
    <div class="mobile-search-content">
      <form role="search" method="get" class="mobile-search-form" action={searchUrl}>
        <label class="screen-reader-text" for="mobile-search-field">{getUITranslation(lang, 'common.searchFor')}</label>
        <input id="mobile-search-field" type="search" name="s" placeholder={getUITranslation(lang, 'common.searchPlaceholder')} class="mobile-search-input">
        <button type="submit" aria-label={getUITranslation(lang, 'common.search')} class="mobile-search-submit">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true">
            <path d="m21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<script is:inline>
// Header navigation interactions
document.addEventListener('DOMContentLoaded', function() {
  const header = document.querySelector('.site-header')
  if (!header) return

  // 焦点归还目标（移动 overlay 打开前记住；关闭后归还，无障碍）
  let lastFocused = null

  // Mobile menu toggle（aria-expanded 同步 + 打开聚焦关闭按钮 / 关闭归还焦点）
  const menuToggle = header.querySelector('.menu-toggle')
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay')
  const mobileMenuClose = document.querySelector('.mobile-menu-close')

  function openMobileMenu() {
    mobileMenuOverlay.classList.add('is-open')
    menuToggle.classList.add('is-open')
    menuToggle.setAttribute('aria-expanded', 'true')
    document.body.classList.add('mobile-menu-open')
    lastFocused = document.activeElement
    if (mobileMenuClose) mobileMenuClose.focus()
  }
  function closeMobileMenu() {
    mobileMenuOverlay.classList.remove('is-open')
    menuToggle.classList.remove('is-open')
    menuToggle.setAttribute('aria-expanded', 'false')
    document.body.classList.remove('mobile-menu-open')
    if (lastFocused && lastFocused.focus) lastFocused.focus()
    lastFocused = null
  }
  function toggleMobileMenu() {
    if (mobileMenuOverlay.classList.contains('is-open')) closeMobileMenu()
    else openMobileMenu()
  }

  if (menuToggle && mobileMenuOverlay) {
    menuToggle.addEventListener('click', toggleMobileMenu)
    if (mobileMenuClose) mobileMenuClose.addEventListener('click', closeMobileMenu)
    mobileMenuOverlay.addEventListener('click', function(e) {
      if (e.target === mobileMenuOverlay) closeMobileMenu()
    })
  }

  // Mobile search toggle（aria-expanded 同步 + 打开聚焦输入框 / 关闭归还焦点）
  const searchToggle = header.querySelector('.header-search-toggle')
  const mobileSearchOverlay = document.getElementById('mobile-search-overlay')
  const mobileSearchClose = document.querySelector('.mobile-search-close')

  function openMobileSearch() {
    mobileSearchOverlay.classList.add('is-open')
    document.body.classList.add('mobile-search-open')
    if (searchToggle) searchToggle.setAttribute('aria-expanded', 'true')
    lastFocused = document.activeElement
    const field = document.getElementById('mobile-search-field')
    if (field) field.focus()
  }
  function closeMobileSearch() {
    mobileSearchOverlay.classList.remove('is-open')
    document.body.classList.remove('mobile-search-open')
    if (searchToggle) searchToggle.setAttribute('aria-expanded', 'false')
    if (lastFocused && lastFocused.focus) lastFocused.focus()
    lastFocused = null
  }
  function toggleMobileSearch() {
    if (mobileSearchOverlay.classList.contains('is-open')) closeMobileSearch()
    else openMobileSearch()
  }

  if (searchToggle && mobileSearchOverlay) {
    searchToggle.addEventListener('click', function(e) {
      if (window.innerWidth <= 1199) {
        e.preventDefault()
        toggleMobileSearch()
      }
    })
    if (mobileSearchClose) mobileSearchClose.addEventListener('click', closeMobileSearch)
    mobileSearchOverlay.addEventListener('click', function(e) {
      if (e.target === mobileSearchOverlay) closeMobileSearch()
    })
  }

  // 收起节点及其全部子孙展开态（手风琴互斥用）；面板 max-height 归 0（精确收起）
  function collapseAccordion(node) {
    node.classList.remove('is-open')
    node.querySelectorAll('.mobile-submenu, .mobile-accordion-nested').forEach(function (p) { p.style.maxHeight = '0px' })
    node.querySelectorAll('.mobile-menu-toggle-button, .mobile-accordion-toggle-button').forEach(function (b) { b.setAttribute('aria-expanded', 'false') })
    node.querySelectorAll('.is-open').forEach(function (el) { el.classList.remove('is-open') })
  }

  // 祖先面板联动：子面板展开/收起时，父级已开面板同步增减子面板全高，
  // 与子面板动画并行进行（打开加、关闭减，对称平滑；避免嵌套裁剪/留白）
  function adjustAncestors(container, delta) {
    let cur = container.parentElement
    while (cur && cur !== document.body) {
      const p = cur.querySelector(':scope > .mobile-submenu, :scope > .mobile-accordion-nested')
      if (p && p.style.maxHeight && parseInt(p.style.maxHeight, 10) > 0) {
        p.style.maxHeight = (parseInt(p.style.maxHeight, 10) + delta) + 'px'
      }
      cur = cur.parentElement
    }
  }

  // Mobile accordion toggles（⚠️ 按钮在 <header> 外的移动 overlay 里，必须用 document 查询，
  // header.querySelectorAll 会扑空 → 历史 bug：移动端子菜单此前无法展开）
  // 同级互斥：同一容器内最多展开一个（Critical Power 等同级分类；含顶层 Products/Solutions/News）
  // 柔和对称：打开前实测 scrollHeight 设精确 max-height，避免 0→2000px 大行程「展开瞬开、收起柔」不对称
  document.querySelectorAll('.mobile-menu-toggle-button, .mobile-accordion-toggle-button').forEach(button => {
    button.addEventListener('click', function() {
      const willOpen = this.getAttribute('aria-expanded') !== 'true'
      const container = this.closest('.mobile-menu-item, .mobile-accordion-section')
      if (!container) return
      const panel = container.querySelector(':scope > .mobile-submenu, :scope > .mobile-accordion-nested')

      if (willOpen && container.parentElement) {
        // 收起同级兄弟（含它们各自子孙的展开态）
        const siblingSel = container.classList.contains('mobile-menu-item')
          ? ':scope > .mobile-menu-item'
          : ':scope > .mobile-accordion-section'
        container.parentElement.querySelectorAll(siblingSel).forEach(function(sib) {
          if (sib !== container) collapseAccordion(sib)
        })
      }
      if (panel) {
        const full = panel.scrollHeight
        panel.style.maxHeight = willOpen ? (full + 'px') : '0px'
        adjustAncestors(container, willOpen ? full : -full)
      }
      // toggle 自身
      this.setAttribute('aria-expanded', willOpen ? 'true' : 'false')
      if (!willOpen) collapseAccordion(container)
      container.classList.toggle('is-open', willOpen)
    })
  })

  // Desktop dropdown interactions（档3：点击开合 + 点外/ESC 关闭；hover 不再单独开 panel，
  // 消除 hover↔click 冲突；:focus-within 保留键盘可达）
  function closeAllDropdowns() {
    header.querySelectorAll('.header-dropdown.dropdown-open').forEach(dropdown => {
      dropdown.classList.remove('dropdown-open')
      const t = dropdown.querySelector('.language-toggle, .header-search-toggle')
      if (t) t.setAttribute('aria-expanded', 'false')
    })
  }

  if (window.innerWidth >= 1200) {
    const dropdownToggles = header.querySelectorAll('.language-toggle, .header-search-toggle')

    dropdownToggles.forEach(toggle => {
      toggle.addEventListener('click', function(e) {
        e.preventDefault()
        const dropdown = this.closest('.header-dropdown')
        if (!dropdown) return

        const willOpen = !dropdown.classList.contains('dropdown-open')
        closeAllDropdowns()
        if (willOpen) {
          dropdown.classList.add('dropdown-open')
          this.setAttribute('aria-expanded', 'true')
        }
      })
    })

    // 点外关闭：点击落在任意 .header-dropdown 之外即收起
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.header-dropdown')) closeAllDropdowns()
    })
  }

  // Desktop megamenu：submenu-toggle 点击切换 submenu-open（CSS hover 仍可开）；
  // 悬停/焦点镜像 aria-expanded，便于读屏
  const megamenuItems = header.querySelectorAll('.has-megamenu')
  const syncSubmenuAria = function (item) {
    const t = item.querySelector('.submenu-toggle')
    if (t) t.setAttribute('aria-expanded', item.classList.contains('submenu-open') ? 'true' : 'false')
  }
  megamenuItems.forEach(item => {
    const toggleBtn = item.querySelector('.submenu-toggle')
    if (toggleBtn) {
      toggleBtn.addEventListener('click', function(e) {
        e.preventDefault()
        item.classList.toggle('submenu-open')
        megamenuItems.forEach(o => { if (o !== item) o.classList.remove('submenu-open') })
        megamenuItems.forEach(syncSubmenuAria)
      })
    }
    if (window.innerWidth >= 1200) {
      item.addEventListener('mouseenter', function() {
        const t = item.querySelector('.submenu-toggle')
        if (t) t.setAttribute('aria-expanded', 'true')
      })
      item.addEventListener('mouseleave', function() {
        if (!item.contains(document.activeElement)) syncSubmenuAria(item)
      })
      item.addEventListener('focusout', function() {
        if (!item.contains(document.activeElement)) syncSubmenuAria(item)
      })
    }
  })

  // 移动 overlay focus trap（档3：Tab 在弹层内循环，防止焦点逃到背景）
  const mobileOverlays = [mobileMenuOverlay, mobileSearchOverlay].filter(Boolean)
  function trapFocus(overlay, e) {
    if (!overlay.classList.contains('is-open')) return
    const focusable = overlay.querySelectorAll('a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])')
    if (!focusable.length) return
    const first = focusable[0]
    const last = focusable[focusable.length - 1]
    const active = document.activeElement
    if (e.shiftKey) {
      if (active === first || !overlay.contains(active)) { e.preventDefault(); last.focus() }
    } else if (active === last || !overlay.contains(active)) {
      e.preventDefault(); first.focus()
    }
  }
  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Tab') return
    mobileOverlays.forEach(function(ov) { trapFocus(ov, e) })
  })

  // ESC：关闭移动菜单/搜索、桌面 dropdown、megamenu（档3，无障碍）
  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape') return
    if (mobileMenuOverlay && mobileMenuOverlay.classList.contains('is-open')) closeMobileMenu()
    if (mobileSearchOverlay && mobileSearchOverlay.classList.contains('is-open')) closeMobileSearch()
    closeAllDropdowns()
    megamenuItems.forEach(item => { item.classList.remove('submenu-open'); syncSubmenuAria(item) })
  })
})
</script>
