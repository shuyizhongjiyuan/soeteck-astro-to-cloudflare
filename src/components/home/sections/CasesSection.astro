---
/**
 * CasesSection — Redesigned case study cards with data metrics and location tags.
 * Shared across all variants.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props {
  data: HomeContent['projects'];
}

const { data } = Astro.props;
---

<section class="home-cases" aria-labelledby="cases-title">
  <div class="soeteck-container">
    <div class="home-section__head home-section__head--split">
      <div>
        <p class="home-section__eyebrow">{data.eyebrow}</p>
        <h2 id="cases-title" class="home-section__title">{data.title}</h2>
      </div>
      <a href="/en/case-studies/" class="home-section__view-all">View All Cases →</a>
    </div>
    <div class="home-cases__list">
      {data.cards.map((card) => (
        <article class="home-case-card">
          <div class="home-case-card__media">
            <img src={card.image.path} alt={card.image.alt} loading="lazy" width="600" height="340" />
            <div class="home-case-card__overlay"></div>
            <div class="home-case-card__metric">
              <span class="home-case-card__metric-value">{card.metric}</span>
              <span class="home-case-card__metric-label">{card.metricLabel}</span>
            </div>
            <div class="home-case-card__location">
              <span class="home-case-card__location-icon">📍</span>
              <span class="home-case-card__location-text">{card.location}</span>
            </div>
          </div>
          <div class="home-case-card__body">
            <h3 class="home-case-card__title">{card.title}</h3>
            <p class="home-case-card__text">{card.text}</p>
            <a href={card.ctaLink} class="home-case-card__link">{card.cta} →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
/* ═══ CASES ═══════════════════════════════════════════════════════ */
.home-cases {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-surface);
}

.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
.home-section__head--split { max-width: none; display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; text-align: left; }
.home-section__eyebrow { margin: 0 0 10px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(1.85rem, 3.1vw, 2.5rem); font-weight: 700; line-height: 1.14; color: var(--soeteck-text); }
.home-section__view-all { white-space: nowrap; font-weight: 600; color: var(--soeteck-primary); font-size: var(--soeteck-text-sm); }
.home-section__view-all:hover { color: var(--soeteck-primary-dark); }

.home-cases__list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
}

/* ── Case card ──────────────────────────────────────────────── */
.home-case-card {
  border-radius: var(--soeteck-radius-lg);
  overflow: hidden;
  background: var(--soeteck-white);
  border: 1px solid var(--soeteck-border-soft);
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
}
.home-case-card:hover {
  border-color: var(--soeteck-primary);
  box-shadow: 0 12px 40px rgba(0, 102, 204, 0.1);
  transform: translateY(-3px);
}

/* ── Media area ─────────────────────────────────────────────── */
.home-case-card__media {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
}
.home-case-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.home-case-card:hover .home-case-card__media img {
  transform: scale(1.04);
}
.home-case-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(11, 31, 58, 0.7) 100%);
}

/* ── Metric badge (top-right) ───────────────────────────────── */
.home-case-card__metric {
  position: absolute;
  top: 16px;
  right: 16px;
  padding: 10px 16px;
  border-radius: var(--soeteck-radius);
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  text-align: center;
}
.home-case-card__metric-value {
  display: block;
  font-size: 1.5rem;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.home-case-card__metric-label {
  display: block;
  margin-top: 3px;
  font-size: 10px;
  color: rgba(255, 255, 255, 0.8);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* ── Location tag (bottom-left) ─────────────────────────────── */
.home-case-card__location {
  position: absolute;
  bottom: 16px;
  left: 16px;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
}
.home-case-card__location-icon {
  font-size: 12px;
}
.home-case-card__location-text {
  font-size: 12px;
  font-weight: 500;
  color: #fff;
  letter-spacing: 0.02em;
}

/* ── Card body ──────────────────────────────────────────────── */
.home-case-card__body {
  padding: 24px 28px 28px;
}
.home-case-card__title {
  margin: 0 0 10px;
  font-size: clamp(1.15rem, 1.5vw, 1.35rem);
  font-weight: 700;
  color: var(--soeteck-text);
  line-height: 1.25;
}
.home-case-card__text {
  margin: 0 0 16px;
  font-size: var(--soeteck-text-sm);
  line-height: 1.7;
  color: var(--soeteck-text-soft);
}
.home-case-card__link {
  font-weight: 600;
  font-size: var(--soeteck-text-sm);
  color: var(--soeteck-primary);
}
.home-case-card__link:hover { color: var(--soeteck-primary-dark); }

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 640px) {
  .home-cases__list { grid-template-columns: 1fr; }
  .home-section__head--split { flex-direction: column; align-items: flex-start; }
}
</style>
