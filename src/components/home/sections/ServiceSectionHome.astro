---
/**
 * ServiceSectionHome — Service value grid for Variant C homepage.
 * 3×2 grid of value items: number + icon + title + description.
 * Surface background creates a subtle visual break between white Solutions
 * and navy Case Carousel sections.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props {
  data: HomeContent['services'];
}

const { data } = Astro.props;
---

<section class="home-service" aria-labelledby="service-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="home-section__eyebrow">{data.eyebrow}</p>
      <h2 id="service-title" class="home-section__title">{data.title}</h2>
      <p class="home-section__lead">{data.text}</p>
    </div>

    <div class="home-service__grid">
      {data.steps.map((step) => (
        <div class="home-service__item">
          <div class="home-service__item-top">
            <span class="home-service__num">{step.num}</span>
            <span class="home-service__icon">
              {step.icon === 'design' && <svg viewBox="0 0 32 32" fill="none"><path d="M5 27l4-1 16-16-3-3L6 23l-1 4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M21 7l3 3" stroke="currentColor" stroke-width="2"/><circle cx="17" cy="15" r="2" stroke="currentColor" stroke-width="2"/></svg>}
              {step.icon === 'manufacture' && <svg viewBox="0 0 32 32" fill="none"><path d="M4 28V16l7 4v-5l7 4V9h7v19H4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M10 28v-6M16 28v-8M22 28v-6M28 28H4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
              {step.icon === 'test' && <svg viewBox="0 0 32 32" fill="none"><path d="M16 5l9 4v7c0 5-4 9-9 12-5-3-9-7-9-12V9l9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 16l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              {step.icon === 'ship' && <svg viewBox="0 0 32 32" fill="none"><path d="M6 10h12l6 6h-4l-4-4H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M6 16h20v5H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 21l2 4M16 21l2 4M24 21l-2 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
              {step.icon === 'install' && <svg viewBox="0 0 32 32" fill="none"><path d="M21 7a6 6 0 00-8 5L7 18v3l4 4h3l6-6a6 6 0 005-8l-3 3-3-3 3-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>}
              {step.icon === 'support' && <svg viewBox="0 0 32 32" fill="none"><path d="M16 7a9 9 0 00-9 9v5a3 3 0 003 3h1v-6h-1a3 3 0 00-3 3M16 7a9 9 0 019 9v5a3 3 0 01-3 3h-1v-6h1a3 3 0 013 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 24v2a3 3 0 01-3 3h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
            </span>
          </div>
          <h3 class="home-service__title">{step.title}</h3>
          <p class="home-service__text">{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
/* ═══ SERVICE HOME — value grid for Variant C ═══════════════════ */
.home-service {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-white);
}
.home-service :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

/* ── Section head (shared pattern) ──────────────────────────────── */
.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
.home-section__eyebrow { margin: 0 0 30px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(1.9rem, 3.2vw, 2.6rem); font-weight: 800; line-height: 1.12; color: var(--soeteck-text); }
.home-section__lead { margin: 16px auto 0; max-width: 620px; font-size: 1.05rem; line-height: 1.7; color: var(--soeteck-text-soft); }

/* ── 3×2 value grid ──────────────────────────────────────────────── */
.home-service__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

/* ── Individual value item ───────────────────────────────────────── */
.home-service__item {
  padding: 28px 24px;
  background: var(--soeteck-white);
  border: 1px solid var(--soeteck-border-soft);
  border-radius: var(--soeteck-radius-lg);
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
}
.home-service__item:hover {
  border-color: var(--soeteck-primary);
  box-shadow: 0 8px 28px rgba(0, 102, 204, 0.07);
  transform: translateY(-3px);
}

/* ── Top row: number + icon ──────────────────────────────────────── */
.home-service__item-top {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.home-service__num {
  font-size: 22px;
  font-weight: 800;
  color: var(--soeteck-primary);
  line-height: 1;
  letter-spacing: 0.02em;
}
.home-service__icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--soeteck-radius-sm);
  background: var(--soeteck-primary-soft);
  color: var(--soeteck-primary);
  margin-left: auto;
}
.home-service__icon :global(svg) {
  width: 22px;
  height: 22px;
}

/* ── Text ────────────────────────────────────────────────────────── */
.home-service__title {
  margin: 0 0 8px;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--soeteck-text);
  line-height: 1.3;
}
.home-service__text {
  margin: 0;
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--soeteck-text-soft);
}

/* ── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 991px) {
  .home-service__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .home-service__grid { grid-template-columns: 1fr; }
}
</style>