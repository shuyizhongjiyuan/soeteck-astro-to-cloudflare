---
/**
 * Preview page — Why section, unified numbered bands + unified content items.
 * Access: http://localhost:4321/preview-why-v2/
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HOME_EN } from '@/components/home/home-content';

const c = HOME_EN;
const why = c.whySoeteck;
const bands = [
  {
    num: '01',
    title: 'Quantified Production &amp; Delivery Certainty',
    subtitle: 'Data-backed capacity and lead time commitments — not empty promises.',
    items: [
      { type: 'stat', value: '2000', suffix: '+', label: 'Projects Delivered' },
      { type: 'stat', value: '50', suffix: '+', label: 'Countries Served' },
      { type: 'stat', value: '20', suffix: '+', label: 'Years of Innovation' },
      { type: 'stat', value: '8–12', suffix: 'W', label: 'Delivery Lead Time' },
      { type: 'chip', text: '50,000 m² Manufacturing Base', highlight: true },
      { type: 'chip', text: '100% Factory Tested Before Dispatch', highlight: true },
      { type: 'chip', text: '8–12 Weeks Delivery Lead Time', highlight: true },
    ],
  },
  {
    num: '02',
    title: 'Market Validation &amp; Social Proof',
    subtitle: 'Trusted by the world\'s most demanding operators across five continents.',
    items: [
      { type: 'chip', text: 'Telecom Operators' },
      { type: 'chip', text: 'AI Hyperscalers' },
      { type: 'chip', text: 'Financial Institutions' },
      { type: 'chip', text: 'Government &amp; Public Sector' },
      { type: 'chip', text: 'Telecom Carriers' },
      { type: 'desc', text: 'Deployed across 50+ countries — every climate, every grid standard.' },
    ],
  },
  {
    num: '03',
    title: 'Core Differentiators',
    subtitle: 'Four structural advantages that define how we build and deliver.',
    items: why.items.map((item) => ({
      type: 'card',
      icon: item.icon === 'factory' ? '⚙' : item.icon === 'accountability' ? '✓' : item.icon === 'global' ? '🌐' : '⚡',
      title: item.title,
      text: item.text,
    })),
  },
  {
    num: '04',
    title: 'Quality &amp; Global Compliance',
    subtitle: 'Certified quality systems and 100% factory testing before every shipment.',
    items: [
      { type: 'text', text: 'Every unit undergoes full-load testing before shipment — thermal validation, failover verification, and system integration checks. All systems are certified to international standards.' },
      ...why.certs.map((c) => ({ type: 'chip', text: c, highlight: true })),
    ],
  },
  {
    num: '05',
    title: 'After-Sales &amp; Supply Chain Guarantee',
    subtitle: 'Single-point accountability with warranty, support, and flexible trade terms.',
    items: [
      { type: 'text', text: 'One contract, one team, one throat to choke. From design to commissioning, SOETECK owns the entire delivery — backed by comprehensive after-sales support.' },
      { type: 'chip', text: '2-Year Warranty', highlight: true },
      { type: 'chip', text: '24/7 Technical Support', highlight: true },
      { type: 'chip', text: 'On-Site Commissioning', highlight: true },
      { type: 'chip', text: 'FOB / CIF / DDP', highlight: true },
      { type: 'chip', text: 'Operator Training', highlight: true },
    ],
  },
];
---

<BaseLayout title="Preview: Why Section B2B — Variant C" lang="en" canonical="https://soeteck.com/preview-why-v2/" robots="noindex">
  <div style="padding:40px 24px; background:var(--soeteck-navy); color:#fff;">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:var(--soeteck-primary); font-size:12px; letter-spacing:.16em; text-transform:uppercase; margin:0 0 8px;">Variant C · Why Section v3</p>
      <h1 style="font-size:26px; margin:0 0 8px;">统一编号 + 统一内容元素风格</h1>
      <p style="color:rgba(255,255,255,.8); margin:0;">所有内容项使用同一套容器（chip/card/text），消除拼凑感</p>
    </div>
  </div>

  <section style="background:var(--soeteck-white); padding:clamp(56px,7vw,80px) 0;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">

      <!-- Head -->
      <div style="max-width:760px; margin:0 auto 56px; text-align:center;">
        <p style="margin:0 0 30px; color:var(--soeteck-primary); font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase;">The SOETECK Difference</p>
        <h2 style="margin:0; font-size:clamp(1.85rem,3.1vw,2.5rem); font-weight:700; color:var(--soeteck-text);">Why the World&rsquo;s Most Demanding Operators Choose Us</h2>
        <p style="margin:18px auto 0; max-width:620px; font-size:1.05rem; line-height:1.7; color:var(--soeteck-text-soft);">It is not just what we build — it is how we build it, and who stands behind it.</p>
      </div>

      <!-- ═══ Bands 01-05 ═══ -->
      {bands.map((band) => (
        <div style="display:grid; grid-template-columns:80px 1fr; gap:40px; padding:36px 0; border-bottom:1px solid var(--soeteck-border-soft);">
          <div style="text-align:center; padding-top:2px;">
            <span style="font-size:42px; font-weight:800; color:var(--soeteck-primary); opacity:.35; line-height:1; font-variant-numeric:tabular-nums;">{band.num}</span>
          </div>
          <div>
            <h3 style="margin:0 0 4px; font-size:20px; font-weight:700; color:var(--soeteck-text); line-height:1.3;">
              {band.title}
            </h3>
            <p style="margin:0 0 24px; font-size:14px; line-height:1.6; color:var(--soeteck-text-soft);">{band.subtitle}</p>
            <div style="display:flex; flex-wrap:wrap; gap:12px;">
              {band.items.map((item) => {
                if (item.type === 'stat') {
                  return (
                    <div style="flex:1; min-width:100px; text-align:center; padding:16px 12px; background:var(--soeteck-surface); border:1px solid var(--soeteck-border-soft); border-radius:10px;">
                      <span style="display:block; font-size:clamp(1.4rem,2.2vw,1.8rem); font-weight:800; color:var(--soeteck-text);">
                        {item.value}<span style="color:var(--soeteck-primary);">{item.suffix}</span>
                      </span>
                      <span style="display:block; margin-top:4px; font-size:12px; font-weight:500; color:var(--soeteck-muted);">{item.label}</span>
                    </div>
                  );
                }
                if (item.type === 'chip') {
                  return (
                    <span style={item.highlight
                      ? `padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);`
                      : `padding:10px 20px; background:var(--soeteck-surface); border:1px solid var(--soeteck-border); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-text-soft);`}
                    >
                      {item.text}
                    </span>
                  );
                }
                if (item.type === 'desc') {
                  return (
                    <p style="width:100%; margin:4px 0 0; font-size:14px; line-height:1.6; color:var(--soeteck-text-soft); font-style:italic;">{item.text}</p>
                  );
                }
                if (item.type === 'text') {
                  return (
                    <p style="width:100%; margin:0; font-size:15px; line-height:1.65; color:var(--soeteck-text-soft);">{item.text}</p>
                  );
                }
                if (item.type === 'card') {
                  return (
                    <div style="flex:1; min-width:180px; padding:20px 18px; background:var(--soeteck-surface); border:1px solid var(--soeteck-border-soft); border-radius:10px;">
                      <div style="width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:8px; background:var(--soeteck-primary-soft); color:var(--soeteck-primary); margin-bottom:12px; font-size:18px;">{item.icon}</div>
                      <h4 style="margin:0 0 6px; font-size:15px; font-weight:700; color:var(--soeteck-text);">{item.title}</h4>
                      <p style="margin:0; font-size:13px; line-height:1.55; color:var(--soeteck-muted);">{item.text}</p>
                    </div>
                  );
                }
                return null;
              })}
            </div>
          </div>
        </div>
      ))}

      <!-- Delivery epilogue -->
      <div style="margin-top:40px; padding:32px; background:var(--soeteck-surface); border-radius:14px; text-align:center;">
        <p style="margin:0 0 20px; font-size:14px; font-weight:600; color:var(--soeteck-muted); text-transform:uppercase; letter-spacing:.1em;">End-to-End Delivery</p>
        <div style="display:flex; justify-content:center; gap:16px; flex-wrap:wrap;">
          {c.timeline.steps.map((step) => (
            <span style="display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:500; color:var(--soeteck-text-soft);">
              <span style="width:28px; height:28px; display:inline-flex; align-items:center; justify-content:center; border-radius:50%; background:var(--soeteck-primary-soft); font-size:11px; font-weight:700; color:var(--soeteck-primary);">{step.num}</span>
              {step.title}
            </span>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>