---
import { CTA_TEMPLATE_EN, type CtaTemplateContent } from '@/components/cta/cta-template-content';
import { CTA_TEMPLATE_ZH } from '@/components/cta/cta-template-content-zh';
import { CTA_TEMPLATE_RU } from '@/components/cta/cta-template-content-ru';
import { CTA_TEMPLATE_PT } from '@/components/cta/cta-template-content-pt';
import { CTA_TEMPLATE_ES } from '@/components/cta/cta-template-content-es';

interface CheckItem {
  icon?: string;
  label: string;
}

interface CtaButton {
  label: string;
  href: string;
}

interface Props {
  /** 语言：未传内容时按此语言取模板默认 CTA（五语言） */
  lang?: string;
  /** 可选锚点 id（如迁移前各页的 inquiry 锚点） */
  id?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
  checks?: Array<string | CheckItem>;
  buttons?: CtaButton[];
}

const TEMPLATE_MAP: Record<string, CtaTemplateContent> = {
  en: CTA_TEMPLATE_EN,
  zh: CTA_TEMPLATE_ZH,
  ru: CTA_TEMPLATE_RU,
  pt: CTA_TEMPLATE_PT,
  es: CTA_TEMPLATE_ES,
};

const { lang = 'en', id, eyebrow, title, text, checks, buttons } = Astro.props;
const dft = TEMPLATE_MAP[lang] ?? CTA_TEMPLATE_EN;

const finalEyebrow = eyebrow ?? dft.eyebrow;
const finalTitle = title ?? dft.title;
const finalText = text ?? dft.text;
const finalChecks = checks ?? dft.checks;
const finalButtons = buttons ?? dft.buttons;

// 统一 CTA 模板：checks 接受字符串(兼容 ACF 旧值/任意文字) 或 {icon,label}；icon 不在映射内则仅渲染标签
const checkItems: CheckItem[] = finalChecks.map((c) => (typeof c === 'string' ? { label: c } : c));
---
<section class="about-cta" id={id ?? undefined} aria-labelledby="about-cta-title">
  <div class="soeteck-container about-cta__inner">
    <div>
      <p class="soeteck-eyebrow">{finalEyebrow}</p>
      <h2 id="about-cta-title">{finalTitle}</h2>
      <p>{finalText}</p>
      <ul class="about-cta__checks">
        {checkItems.map((check) => (
          <li>
            {check.icon === 'products' && (
              <svg class="about-cta__check-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="18" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="5" y="18" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/><rect x="18" y="18" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="2"/></svg>
            )}
            {check.icon === 'solutions' && (
              <svg class="about-cta__check-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="11" stroke="currentColor" stroke-width="2"/><path d="M16 8v16M8 16h16" stroke="currentColor" stroke-width="2"/></svg>
            )}
            {check.icon === 'engineering' && (
              <svg class="about-cta__check-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M11 22l-5-6 5-6M21 10l5 6-5 6M14 7l4 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {check.icon === 'manufacturing' && (
              <svg class="about-cta__check-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M4 28h24M7 28V14l7 5v-5l7 5v-9h6v18" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            )}
            {check.icon === 'turnkey' && (
              <svg class="about-cta__check-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="2"/><path d="M11 16.5l3.6 3.6 6.5-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {check.icon === 'global' && (
              <svg class="about-cta__check-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="11" stroke="currentColor" stroke-width="2"/><path d="M5 16h22M16 5c3.5 3.2 3.5 20.6 0 22M16 5c-3.5 3.2-3.5 20.6 0 22" stroke="currentColor" stroke-width="2"/></svg>
            )}
            <span>{check.label}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="about-cta__actions">
        {finalButtons.map((btn, i) => (
          <a
            class={`about-cta__button${i > 0 ? ' about-cta__button--outline' : ''}`}
            href={btn.href}
          >
            {btn.label}
          </a>
        ))}
      </div>
  </div>
</section>

<style>
  .about-cta {
    position: relative;
    overflow: hidden;
    padding: var(--soeteck-section-y) 0;
    background: radial-gradient(circle at 78% 18%, rgba(0, 102, 204, 0.28), transparent 34%), linear-gradient(135deg, #061529 0%, #0a2749 56%, #061529 100%);
    color: #fff;
  }

  /* Desktop: unified CTA min-height (2026-09-02); flex centers content when min-height applies */
  @media (min-width: 1200px) {
    .about-cta {
      display: flex;
      align-items: center;
      min-height: 460px;
    }
  }

  .about-cta::before {
    content: '';
    position: absolute;
    inset: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  .about-cta__inner {
    position: relative;
    display: flex;
    gap: 32px;
    align-items: center;
    justify-content: space-between;
  }

  .about-cta h2 {
    margin: 0;
    color: #fff;
  }

  /* 6.2 Hero Eyebrow（深色 CTA 区 per §6.4）— 颜色/weight/transform 走基类 primary，字号/字距/间距对齐 hero 档（17px/0.1em/28px） */
  .about-cta .soeteck-eyebrow {
    margin: 0 0 28px;
    font-size: 17px;
    letter-spacing: 0.1em;
  }

  .about-cta p:not(.soeteck-eyebrow) {
    max-width: 820px;
    margin: 22px 0 0;
    color: rgba(255, 255, 255, 0.78);
  }

  .about-cta__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .about-cta__checks li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--soeteck-text-sm);
    font-weight: var(--soeteck-weight-semibold);
  }

  .about-cta__check-icon {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--soeteck-primary);
  }

  .about-cta__button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 200px; /* 桌面端统一按钮最小宽度（等宽）；移动端被 width:100% 覆盖 */
    padding: 0 22px;
    border-radius: 999px;
    background: var(--soeteck-primary);
    color: #fff;
    font-weight: 700;
    box-shadow: 0 16px 36px rgba(0, 102, 204, 0.28);
    transition: background-color var(--soeteck-transition-medium), border-color var(--soeteck-transition-medium), filter var(--soeteck-transition-medium), box-shadow var(--soeteck-transition-medium), transform var(--soeteck-transition-medium);
  }

  /* 柔和悬停（2026-09-02 定稿）：亮度微升 + 微位移 + 柔光渐变，避免硬切 primary-dark */
  .about-cta__button:hover {
    color: #fff;
    filter: brightness(1.07);
    transform: translateY(-1px);
    box-shadow: 0 18px 40px rgba(0, 102, 204, 0.36);
  }

  .about-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch; /* 三按钮等宽（列宽=最宽按钮内容宽度） */
    gap: 12px;
  }

  .about-cta__button--outline {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.3);
    box-shadow: none;
  }

  .about-cta__button--outline:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 991px) {
    .about-cta__inner {
      display: grid;
      justify-items: start;
    }
  }

  @media (max-width: 768px) {
    .about-cta {
      padding-block: 56px;
    }
    .about-cta::before {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .about-cta__actions {
      width: 100%;
      align-items: stretch;
    }
    .about-cta__button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
