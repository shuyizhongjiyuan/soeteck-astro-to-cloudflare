---
/**
 * Why SOETECK section — differentiators, stats, certifications.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props { data: HomeContent['whySoeteck']; }

const { data } = Astro.props;
---

<section class="home-why" aria-labelledby="why-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="soeteck-eyebrow">{data.eyebrow}</p>
      <h2 id="why-title" class="home-section__title">{data.title}</h2>
      <p class="home-section__lead">{data.text}</p>
    </div>
    <div class="home-why__stats">
      {data.stats.map((stat) => (
        <div class="home-why-stat">
          <span class="home-why-stat__value">{stat.value}<span class="home-why-stat__suffix">{stat.suffix}</span></span>
          <span class="home-why-stat__label">{stat.label}</span>
        </div>
      ))}
    </div>
    <div class="home-why__grid">
      {data.items.map((item) => (
        <div class="home-why-card">
          <div class="home-why-card__icon">
            {item.icon === 'factory' && <svg viewBox="0 0 32 32" fill="none"><path d="M4 28V16l7 4V16l7 4V9h7v19H4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>}
            {item.icon === 'accountability' && <svg viewBox="0 0 32 32" fill="none"><path d="M16 5l9 4v7c0 5-4 9-9 12-5-3-9-7-9-12V9l9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 16l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {item.icon === 'global' && <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="2"/><path d="M4 16h24M16 4c4 4 4 20 0 24M16 4c-4 4-4 20 0 24" stroke="currentColor" stroke-width="2"/></svg>}
            {item.icon === 'speed' && <svg viewBox="0 0 32 32" fill="none"><path d="M16 5l3 8h8l-6 5 2 8-7-5-7 5 2-8-6-5h8l3-8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>}
          </div>
          <h3 class="home-why-card__title">{item.title}</h3>
          <p class="home-why-card__text">{item.text}</p>
        </div>
      ))}
    </div>
    <div class="home-why__certs">
      {data.certs.map((cert) => <span class="home-why__cert">{cert}</span>)}
    </div>
  </div>
</section>

<style>
  /* ---------- Section wrapper ---------- */
  .home-why {
    padding: var(--soeteck-section-y) 0;
    background: var(--soeteck-white);
  }

  .home-why :global(.soeteck-container) {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- Section head ---------- */
  .home-section__head {
    text-align: center;
    margin-bottom: 48px;
  }

  .home-section__title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: var(--soeteck-text);
    margin: 12px 0;
    line-height: 1.2;
  }

  .home-section__lead {
    font-size: var(--soeteck-text-base);
    color: var(--soeteck-muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ---------- Stats row ---------- */
  .home-why__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 56px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--soeteck-border-soft);
  }

  .home-why-stat {
    text-align: center;
  }

  .home-why-stat__value {
    display: block;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    line-height: 1;
    color: var(--soeteck-text);
    letter-spacing: -0.02em;
  }

  .home-why-stat__suffix {
    color: var(--soeteck-primary);
  }

  .home-why-stat__label {
    display: block;
    margin-top: 8px;
    font-size: var(--soeteck-text-sm);
    color: var(--soeteck-muted);
  }

  /* ---------- Card grid ---------- */
  .home-why__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .home-why-card {
    padding: 30px 24px;
    background: var(--soeteck-surface);
    border: 1px solid var(--soeteck-border-soft);
    border-radius: var(--soeteck-radius-lg);
  }

  .home-why-card__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--soeteck-radius-md);
    background: var(--soeteck-primary-soft);
    color: var(--soeteck-primary);
    margin-bottom: 18px;
  }

  .home-why-card__icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .home-why-card__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--soeteck-text);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .home-why-card__text {
    font-size: var(--soeteck-text-sm);
    color: var(--soeteck-muted);
    line-height: 1.6;
  }

  /* ---------- Certifications ---------- */
  .home-why__certs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--soeteck-border-soft);
  }

  .home-why__cert {
    padding: 8px 18px;
    border: 1px solid var(--soeteck-border);
    border-radius: 999px;
    font-size: var(--soeteck-text-sm);
    font-weight: 600;
    color: var(--soeteck-muted);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1200px) {
    .home-why__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .home-why__stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .home-why__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
