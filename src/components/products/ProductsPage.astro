---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { AdaptedPage, PageBreadcrumb } from '@/lib/page-adapter';
import {
  PRODUCTS_EN,
  type ProductsContent,
  type SubcategoryLink,
} from './products-content';
import { PRODUCTS_ZH } from './products-content-zh';
import { PRODUCTS_RU } from './products-content-ru';
import { PRODUCTS_PT } from './products-content-pt';
import AboutCta from '@/components/about/AboutCta.astro';
import { PRODUCTS_ES } from './products-content-es';

interface Props {
  page: AdaptedPage;
  lang?: string;
}

const { page, lang = 'en' } = Astro.props;

const contentMap: Record<string, ProductsContent> = {
  en: PRODUCTS_EN,
  zh: PRODUCTS_ZH,
  ru: PRODUCTS_RU,
  pt: PRODUCTS_PT,
  es: PRODUCTS_ES,
};
const content = contentMap[lang] ?? PRODUCTS_EN;

// hero banner：读 Content API page() 顶层 bannerImage（= product_cat term 的
// product_category_banner 字段，/products/ 父级页 + 子分类页同链路）。未设不显示图，
// 保持深蓝底色（不引资源、不 404，2026-09-02 接线）。
const heroBannerPath = page.source?.bannerImage?.path ?? null;

const localizePath = (path: string) => `/${lang}${path}`;

const numbered = content.categories.map((cat, i) => ({
  ...cat,
  num: String(i + 1).padStart(2, '0'),
}));

const firstChar = (t: string) => (t.trim().charAt(0) || '').toUpperCase();

const hasGrouped = (c: { subcategories: SubcategoryLink[] }) =>
  c.subcategories.some((s) => s.children && s.children.length > 0);
const flatSubs = (c: { subcategories: SubcategoryLink[] }) =>
  c.subcategories.filter((s) => !s.children || s.children.length === 0);
const groupedSubs = (c: { subcategories: SubcategoryLink[] }) =>
  c.subcategories.filter((s) => s.children && s.children.length > 0);

const breadcrumbs: PageBreadcrumb[] = page.breadcrumbs.length > 0
  ? page.breadcrumbs
  : [
      { label: 'Home', path: `/${lang}/` },
      { label: content.heroTitle, path: `/${lang}/products/` },
    ];
---

<div class="soeteck-products-page">
    <!-- Hero -->
    <section class="soeteck-products-hero" style={heroBannerPath ? `background-image:url('${heroBannerPath}')` : undefined}>
      <div class="soeteck-products-hero__overlay"></div>
      <div class="soeteck-container soeteck-products-hero__content">
        <Breadcrumbs items={breadcrumbs} class="soeteck-breadcrumbs--hero" lang={lang} />

        <div class="soeteck-products-hero__body">
          <h1 class="soeteck-page-title soeteck-products-hero__title">{content.heroTitle}</h1>
          {content.heroDescription && (
            <p class="soeteck-products-hero__lead">{content.heroDescription}</p>
          )}
        </div>
      </div>
    </section>

    <!-- Numbered chapters -->
    <section class="soeteck-products-body">
      <div class="soeteck-container">
        <div class="soeteck-products-chapters">
          {numbered.map((cat) => (
            <article class="soeteck-products-chapter" id={`products-${cat.slug}`}>
              <header class="soeteck-products-chapter__head">
                <span class="soeteck-products-chapter__num" aria-hidden="true">{cat.num}</span>

                <div class="soeteck-products-chapter__tile" aria-hidden="true">
                  {firstChar(cat.title)}
                </div>

                <div class="soeteck-products-chapter__info">
                  <h2 class="soeteck-products-chapter__title">
                    <a href={localizePath(cat.viewAllUrl)}>{cat.title}</a>
                  </h2>
                  <p class="soeteck-products-chapter__desc">{cat.description}</p>
                </div>

                <a class="soeteck-products-chapter__view" href={localizePath(cat.viewAllUrl)}>
                  {cat.viewAllLabel}
                  <span class="soeteck-products-chapter__view-arrow" aria-hidden="true">→</span>
                </a>
              </header>

                   split into two columns; the grouped category spans the column height,
                   styled identically to same-level categories -->
              {hasGrouped(cat) ? (
                <div class="soeteck-products-dir soeteck-products-dir--split">
                  <ul class="soeteck-products-dir__grid soeteck-products-dir__flat">
                    {flatSubs(cat).map((s) => (
                      <li>
                        <a class="soeteck-products-dir__link" href={localizePath(s.path)}>{s.name}</a>
                      </li>
                    ))}
                  </ul>

                  <div class="soeteck-products-dir__side">
                    {groupedSubs(cat).map((g) => (
                      <div class="soeteck-products-dir__group">
                        <a class="soeteck-products-dir__link" href={localizePath(g.path)}>{g.name}</a>
                        <ul class="soeteck-products-dir__children">
                          {g.children!.map((ch) => (
                            <li>
                              <a class="soeteck-products-dir__child" href={localizePath(ch.path)}>{ch.name}</a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="soeteck-products-dir">
                  <ul class="soeteck-products-dir__grid">
                    {cat.subcategories.map((s) => (
                      <li>
                        <a class="soeteck-products-dir__link" href={localizePath(s.path)}>{s.name}</a>
                      </li>
                    ))}
                    {cat.subcategories.length % 2 === 1 && (
                      <li class="soeteck-products-dir__spacer" aria-hidden="true"></li>
                    )}
                  </ul>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <AboutCta lang={lang} id="products-inquiry" />
</div>

<style>
/* ========================================
   Products Page — Hero
   ======================================== */

.soeteck-products-page {
  --soeteck-products-content-width: 1200px;
  --soeteck-products-content-gutter: 20px;
  background: var(--soeteck-white);
}

.soeteck-products-hero__content,
.soeteck-products-body .soeteck-container {
  width: min(var(--soeteck-products-content-width), calc(100% - (var(--soeteck-products-content-gutter) * 2)));
  max-width: none;
  padding-inline: 0;
}

/* Hero */
/* Hero 背景图由后台 product_category_banner（product_cat term）经 Content API 顶层
   bannerImage 驱动（inline style，见上方 heroBannerPath）；未设时仅显示深蓝底色，
   移除了原先写死 /resources/soeteck-products-hero-bg.webp（文件不存在，404）（2026-09-02）。 */
.soeteck-products-hero {
  position: relative;
  overflow: hidden;
  background-color: var(--soeteck-dark);
  color: var(--soeteck-white);
  background-size: cover;
  background-position: center center;
}

.soeteck-products-hero__overlay {
  position: absolute;
  inset: 0;
  /* hero 遮盖层标准值（全站 hero 统一 2026-09-02） */
  background: linear-gradient(90deg, #0b1f3ad6, #0b1f3a6b, #0b1f3a1f);
}

.soeteck-products-hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  min-height: 540px;
}

.soeteck-products-hero__content :global(.soeteck-breadcrumbs--hero) {
  position: absolute;
  top: 20px;
  left: 0;
  width: 100%;
  margin: 0;
}

.soeteck-products-hero__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-block: 0;
  min-height: 540px;
}

.soeteck-products-hero__title {
  font-family: var(--soeteck-font-heading);
  margin: 0;
  color: var(--soeteck-white);
  font-size: var(--soeteck-heading-lg);
  font-weight: var(--soeteck-weight-bold);
  line-height: 1.08;
}

.soeteck-products-hero__lead {
  font-family: var(--soeteck-font-body);
  margin: 22px 0 0;
  max-width: 760px;
  color: rgba(255, 255, 255, 0.88);
  font-size: var(--soeteck-text-lg);
  line-height: 1.65;
}

/* ========================================
   Products Page — Numbered chapters
   ======================================== */

.soeteck-products-body {
  padding-block: var(--soeteck-section-y);
  background: var(--soeteck-white);
}

.soeteck-products-chapters {
  display: flex;
  flex-direction: column;
  gap: var(--soeteck-section-y-sm);
}

.soeteck-products-chapter {
  scroll-margin-top: 96px;
}

/* chapter head: number | tile | title+desc | view */
.soeteck-products-chapter__head {
  display: grid;
  grid-template-columns: auto auto 1fr auto;
  grid-template-areas: "num tile info view";
  column-gap: 24px;
  align-items: center;
  margin-bottom: 34px;
}

.soeteck-products-chapter__num {
  grid-area: num;
  font-family: var(--soeteck-font-heading);
  font-weight: var(--soeteck-weight-bold);
  font-size: clamp(2.4rem, 4.4vw, 3.5rem);
  line-height: 0.9;
  letter-spacing: -0.03em;
  color: var(--soeteck-primary);
  opacity: 0.28;
  user-select: none;
}

/* placeholder tile: brand gradient tile, initial to be replaced by a photo */
.soeteck-products-chapter__tile {
  grid-area: tile;
  width: 120px;
  height: 120px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #e7fbff, #d9ebff);
  border-radius: var(--soeteck-radius-lg);
  color: var(--soeteck-primary);
  font-family: var(--soeteck-font-heading);
  font-weight: var(--soeteck-weight-bold);
  font-size: 2.9rem;
  line-height: 1;
  box-shadow: var(--soeteck-shadow);
}

.soeteck-products-chapter__info {
  grid-area: info;
  min-width: 0;
}

.soeteck-products-chapter__title {
  margin: 0 0 8px;
  font-family: var(--soeteck-font-heading);
  font-size: clamp(1.35rem, 2.2vw, 1.75rem);
  line-height: 1.15;
  font-weight: var(--soeteck-weight-bold);
}

.soeteck-products-chapter__title a {
  color: var(--soeteck-text);
  text-decoration: none;
  transition: color 180ms ease;
}

.soeteck-products-chapter__title a:hover {
  color: var(--soeteck-primary);
}

.soeteck-products-chapter__desc {
  margin: 0;
  color: var(--soeteck-text-soft);
  font-size: 0.98rem;
  max-width: 560px;
}

.soeteck-products-chapter__view {
  grid-area: view;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--soeteck-font-ui);
  font-weight: var(--soeteck-weight-bold);
  font-size: 0.9rem;
  color: var(--soeteck-primary);
  text-decoration: none;
  white-space: nowrap;
}

.soeteck-products-chapter__view-arrow {
  transition: transform 180ms ease;
}

.soeteck-products-chapter__view:hover .soeteck-products-chapter__view-arrow {
  transform: translateX(4px);
}

/* Directory panel: grid lines drawn by the container background through a 1px gap */
.soeteck-products-dir {
  border: 1px solid var(--soeteck-border-soft);
  border-radius: var(--soeteck-radius-lg);
  background: var(--soeteck-border-soft);
  overflow: hidden;
}

.soeteck-products-dir__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  background: var(--soeteck-border-soft);
}

.soeteck-products-dir__grid li {
  background: var(--soeteck-white);
  padding: 18px 22px;
  display: flex;
  align-items: center;
  min-width: 0;
}

/* keeps an empty last-row cell white instead of showing the grey line */
.soeteck-products-dir__grid li.soeteck-products-dir__spacer {
  background: var(--soeteck-white);
}

.soeteck-products-dir__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--soeteck-font-ui);
  font-size: 1rem;
  font-weight: var(--soeteck-weight-semibold);
  color: var(--soeteck-text);
  text-decoration: none;
  transition: color 180ms ease;
}

.soeteck-products-dir__link::before {
  content: '';
  display: inline-block;
  width: 5px;
  height: 5px;
  border-right: 1.5px solid var(--soeteck-primary);
  border-bottom: 1.5px solid var(--soeteck-primary);
  transform: rotate(-45deg);
  margin-right: -2px;
  opacity: 0.6;
  flex-shrink: 0;
}

.soeteck-products-dir__link:hover {
  color: var(--soeteck-primary);
}

/* Categories with 3rd-level children: two columns. Left = flat sub-categories;
   right = grouped category spanning the column height, styled like same-level links. */
.soeteck-products-dir--split {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 1px;
  background: var(--soeteck-border-soft);
}

.soeteck-products-dir--split > .soeteck-products-dir__flat {
  display: block;
  background: var(--soeteck-white);
}

.soeteck-products-dir--split .soeteck-products-dir__flat li {
  border-bottom: 1px solid var(--soeteck-border-soft);
}

.soeteck-products-dir--split .soeteck-products-dir__flat li:last-child {
  border-bottom: 0;
}

.soeteck-products-dir__side {
  background: var(--soeteck-white);
  display: flex;
  flex-direction: column;
}

.soeteck-products-dir__group {
  padding: 18px 22px;
}

.soeteck-products-dir__group + .soeteck-products-dir__group {
  border-top: 1px solid var(--soeteck-border-soft);
}

.soeteck-products-dir__children {
  list-style: none;
  margin: 14px 0 0;
  padding: 0 0 0 6px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.soeteck-products-dir__child {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--soeteck-font-ui);
  font-size: 0.9rem;
  color: var(--soeteck-text-soft);
  text-decoration: none;
  transition: color 180ms ease;
}

.soeteck-products-dir__child::before {
  content: '';
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.5;
  flex-shrink: 0;
}

.soeteck-products-dir__child:hover {
  color: var(--soeteck-primary);
}

/* ========================================
   CTA
   ======================================== */

.soeteck-cta {
  position: relative;
  overflow: hidden;
  padding: var(--soeteck-section-y) 0;
  background: radial-gradient(circle at 78% 18%, rgba(0, 102, 204, 0.28), transparent 34%), linear-gradient(135deg, #061529 0%, #0a2749 56%, #061529 100%);
  color: #fff;
}

/* Desktop: unified CTA min-height (2026-09-02); flex centers content when min-height applies */
@media (min-width: 1200px) {
  .soeteck-cta {
    display: flex;
    align-items: center;
    min-height: 460px;
  }
}

.soeteck-cta::before {
  content: '';
  position: absolute;
  inset: 24px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.soeteck-cta__inner {
  position: relative;
  display: flex;
  gap: 32px;
  align-items: center;
  justify-content: space-between;
}

.soeteck-cta h2 {
  margin: 0;
  color: #fff;
}

.soeteck-cta p:not(.soeteck-eyebrow) {
  max-width: 820px;
  margin: 22px 0 0;
  color: rgba(255, 255, 255, 0.78);
}

.soeteck-cta__actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex: 0 0 auto;
}

.soeteck-cta__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 28px;
  border-radius: 999px;
  background: var(--soeteck-primary);
  color: #fff;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 16px 36px rgba(0, 102, 204, 0.28);
  transition: background 200ms ease;
}

.soeteck-cta__button:hover {
  color: #fff;
  background: var(--soeteck-primary-dark);
}

/* ========================================
   Responsive
   ======================================== */

@media (max-width: 991px) {
  .soeteck-products-hero__content {
    min-height: 420px;
  }

  .soeteck-products-hero__body {
    min-height: 420px;
  }

  .soeteck-products-body {
    padding-top: 60px;
  }

  .soeteck-products-dir--split {
    grid-template-columns: 1fr;
  }

  .soeteck-cta__inner {
    display: grid;
    justify-items: start;
  }

  .soeteck-cta__actions {
    flex-direction: row;
  }
}

@media (max-width: 768px) {
  .soeteck-products-hero__content {
    min-height: 360px;
  }

  .soeteck-products-hero__body {
    min-height: 360px;
  }

  .soeteck-products-hero__lead {
    font-size: var(--soeteck-text-md);
  }

  .soeteck-products-chapter__head {
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "num tile"
      "info info"
      "view view";
    column-gap: 18px;
    row-gap: 14px;
  }

  .soeteck-products-chapter__tile {
    width: 88px;
    height: 88px;
    font-size: 2rem;
  }

  .soeteck-products-chapter__num {
    align-self: start;
    padding-top: 8px;
    font-size: 2.6rem;
  }

  .soeteck-products-chapter__view {
    white-space: normal;
  }

  .soeteck-products-dir__grid {
    grid-template-columns: 1fr;
  }

  .soeteck-products-chapter__desc {
    font-size: 0.92rem;
  }

  .soeteck-cta {
    padding-block: 56px;
  }

  .soeteck-cta::before {
    display: none;
  }

  .soeteck-cta__actions {
    flex-direction: column;
    width: 100%;
  }

  .soeteck-cta__button {
    width: 100%;
    justify-content: center;
  }
}

@media (prefers-reduced-motion: reduce) {
  .soeteck-products-chapter__view-arrow,
  .soeteck-products-dir__link,
  .soeteck-products-dir__child,
  .soeteck-products-chapter__title a,
  .soeteck-cta__button {
    transition: none;
  }
}
</style>