---
import type { AdaptedPage } from '@/lib/page-adapter';
import AboutPage from '@/components/about/AboutPage.astro';
import AICoolitPage from '@/components/solutions/AICoolitPage.astro';
import ArticleSinglePage from '@/components/article-single/ArticleSinglePage.astro';
import BlogArchivePage from '@/components/article-archive/BlogArchivePage.astro';
import CaseStudiesArchivePage from '@/components/article-archive/CaseStudiesArchivePage.astro';
import ContactPage from '@/components/contact/ContactPage.astro';
import GenericPocPage from '@/components/poc/GenericPocPage.astro';
import HomePage from '@/components/home/HomePage.astro';
import NewsReleasesPage from '@/components/news-releases/NewsReleasesPage.astro';
import PrefabContainerPage from '@/components/solutions/PrefabContainerPage.astro';
import CabinetModularPage from '@/components/solutions/CabinetModularPage.astro';
import RowModularPage from '@/components/solutions/RowModularPage.astro';
import ProductCategoryPage from '@/components/product-category/ProductCategoryPage.astro';
import ProductCategoryLandingPage from '@/components/product-category/ProductCategoryLandingPage.astro';
import ProductsPage from '@/components/products/ProductsPage.astro';
import ProductSinglePage from '@/components/product-single/ProductSinglePage.astro';
import SearchPage from '@/components/search/SearchPage.astro';
import SimplePage from '@/components/simple-page/SimplePage.astro';
import ThankYouPage from '@/components/thank-you/ThankYouPage.astro';

interface Props {
  page: AdaptedPage;
  lang: string;
}

const { page, lang } = Astro.props;
---

{
  page.kind === 'home' ? (
    <HomePage page={page} lang={lang} />
  ) : page.kind === 'about' ? (
    <AboutPage page={page} lang={lang} />
  ) : page.kind === 'contact' ? (
    <ContactPage page={page} lang={lang} />
  ) : page.kind === 'search' ? (
    <SearchPage page={page} lang={lang} />
  ) : page.kind === 'thankYou' ? (
    <ThankYouPage page={page} lang={lang} />
  ) : page.kind === 'blogsArchive' ? (
    <BlogArchivePage page={page} lang={lang} />
  ) : page.kind === 'caseStudiesArchive' ? (
    <CaseStudiesArchivePage page={page} lang={lang} />
  ) : page.kind === 'newsReleases' ? (
    <NewsReleasesPage page={page} lang={lang} />
  ) : page.kind === 'articleCategoryArchive' ? (
    <NewsReleasesPage page={page} lang={lang} />
  ) : page.kind === 'productCategoryLanding' ? (
    <ProductCategoryLandingPage page={page} lang={lang} />
  ) : page.kind === 'productCategory' ? (
    <ProductCategoryPage page={page} lang={lang} />
  ) : page.kind === 'products' ? (
    <ProductsPage page={page} lang={lang} />
  ) : page.kind === 'productSingle' ? (
    <ProductSinglePage page={page} lang={lang} />
  ) : page.kind === 'articleSingle' ? (
    <ArticleSinglePage page={page} lang={lang} />
  ) : page.kind === 'solutionAicoolit' ? (
    <AICoolitPage page={page} lang={lang} />
  ) : page.kind === 'solutionPrefab' ? (
    <PrefabContainerPage page={page} lang={lang} />
  ) : page.kind === 'solutionCabinetModular' ? (
    <CabinetModularPage page={page} lang={lang} />
  ) : page.kind === 'solutionRowModular' ? (
    <RowModularPage page={page} lang={lang} />
  ) : page.kind === 'simple' ? (
    <SimplePage page={page} lang={lang} />
  ) : (
    <GenericPocPage page={page} lang={lang} />
  )
}

