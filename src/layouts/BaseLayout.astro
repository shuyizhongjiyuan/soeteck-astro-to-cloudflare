---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { fetchGlobalConfig } from '@/lib/content-api';

interface Props {
  title: string;
  description?: string;
  canonical: string;
  robots?: string;
  lang?: string;
  localizedPaths?: Record<string, { path: string | null; status: string }>;
  schemas?: Array<Record<string, unknown>>;
}

const { title, description, canonical, robots = 'index,follow', lang = 'en', localizedPaths, schemas } = Astro.props;
const globalConfig = await fetchGlobalConfig(lang);

// ── 追踪与同意配置（ADR-023 / spec 2026-08-20-consent-tracking-design） ──
const tracking = globalConfig.tracking;
const consent = globalConfig.consent;
const gtmId = tracking?.gtmId ?? '';
const isProd = import.meta.env.PROD;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* ═══ 站点图标（读取 WordPress Site Icon — Content API globalConfig.site.favicon）═══ */}
    {globalConfig.site?.favicon?.url && (
      <>
        <link rel="icon" href={globalConfig.site.favicon.url} />
        <link rel="apple-touch-icon" href={globalConfig.site.favicon.url} />
      </>
    )}

    {/* ═══ Consent Mode v2 初始化（必须在 GTM 之前）ADR-023 ═══ */}
    {/* 4 信号先保守 deny；security/functionality（必要类）恒 granted。
        geo+偏好解析后由 consent 模块触发 consent:update。 */}
    {isProd ? (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent','default',{
          'ad_storage':'denied',
          'ad_user_data':'denied',
          'ad_personalization':'denied',
          'analytics_storage':'denied',
          'functionality_storage':'granted',
          'security_storage':'granted',
          'wait_for_update':500
        });
      </script>
    ) : (
      <script is:inline>window.dataLayer = window.dataLayer || [];</script>
    )}
    {/* ═══ Google Tag Manager（生产 + gtmId 才注入） === */}
    {isProd && gtmId && (
      <script is:inline>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','{gtmId}');
      </script>
    )}
    {/* ═══ End Google Tag Manager === */}

    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {description && <meta name="description" content={description} />}
    {/* hreflang 标签 */}
    {localizedPaths && Object.entries(localizedPaths).map(([l, data]) => (
      data.path && (
        <link rel="alternate" hreflang={l} href={`https://soeteck.com/${l}${data.path}`} />
      )
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://soeteck.com/en${localizedPaths?.en?.path || '/'}`} />
    {/* Schema.org JSON-LD（Rank Math 生成，Content API 交付） */}
    {schemas?.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...s })} />
    ))}
  </head>
  <body>
    {/* GTM noscript fallback（生产 + gtmId） */}
    {isProd && gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style={{ display: 'none', visibility: 'hidden' }}></iframe>
      </noscript>
    )}
    <Header globalConfig={globalConfig} lang={lang} />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer globalConfig={globalConfig} lang={lang} />
    <CookieConsent consent={consent} lang={lang} />
    <script>
      import { initLightbox } from '@/lib/lightbox';
      initLightbox();
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Sora';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/assets/fonts/sora/sora-v16-latin-400.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Sora';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/assets/fonts/sora/sora-v16-latin-500.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Sora';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('/assets/fonts/sora/sora-v16-latin-600.woff2') format('woff2');
  }

  @font-face {
    font-family: 'Sora';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/assets/fonts/sora/sora-v16-latin-700.woff2') format('woff2');
  }

  /* Header Styles - Navigation and Site Header */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--soeteck-primary);
    color: var(--soeteck-white);
    padding: 8px 16px;
    z-index: 10000;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 0;
  }

  .screen-reader-text {
    border: 0;
    clip: rect(1px, 1px, 1px, 1px);
    clip-path: inset(50%);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    width: 1px;
    word-wrap: normal !important;
  }

  #page.site {
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: #f3f3f3;
    border-top: var(--soeteck-header-topbar) solid var(--soeteck-navy-accent);
    box-shadow: var(--soeteck-shadow-header);
    transition: transform 0.5s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--soeteck-header-h);
    padding: 0 15px;
    gap: 36px;
  }

  .site-logo-link {
    display: inline-flex;
    align-items: center;
    flex: 0 0 230px;
    width: 230px;
    height: 57px;
  }

  .site-logo-image {
    display: block;
    width: 230px;
    height: auto;
  }

  .main-navigation {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
  }

  .primary-menu {
    display: flex;
    align-items: center;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 20px;
    width: 100%;
  }

  .primary-menu-item {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--soeteck-header-h);
  }

  .primary-menu-link {
    display: inline-flex;
    font-family: var(--soeteck-font-ui);
    align-items: center;
    min-height: var(--soeteck-header-h);
    color: var(--soeteck-text);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .primary-menu-link:hover,
  .primary-menu-item:hover > .primary-menu-link,
  .primary-menu-item:focus-within > .primary-menu-link {
    color: var(--soeteck-primary);
  }

  .submenu-toggle {
    display: inline-flex;
    font-family: var(--soeteck-font-ui);
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    margin-left: 6px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--soeteck-text);
    cursor: pointer;
    font-size: 17px;
    line-height: 1;
  }

  @media (min-width: 992px) {
    .primary-menu {
      align-items: flex-end;
      min-height: var(--soeteck-header-h);
    }

    .primary-menu-item {
      min-height: 0;
      padding-bottom: 25px;
    }

    .primary-menu-link {
      min-height: 0;
    }

    .submenu-toggle {
      height: 18px;
    }

    .has-megamenu:hover > .megamenu-panel,
    .has-megamenu:focus-within > .megamenu-panel,
    .has-megamenu.submenu-open > .megamenu-panel {
      display: block;
    }

    .megamenu-panel {
      display: none;
      position: fixed;
      top: var(--soeteck-header-total);
      left: 0;
      right: 0;
      z-index: 999;
      background: var(--soeteck-white);
      border-top: 2px solid var(--soeteck-primary);
      box-shadow: var(--soeteck-shadow-panel);
    }

    .megamenu-inner {
      display: grid;
      grid-template-columns: repeat(4, minmax(180px, 1fr));
      gap: 36px;
      width: 80%;
      margin: 0 auto;
      padding: 20px 0;
    }

    .megamenu-column {
      min-width: 0;
    }

    .menu-products .megamenu-inner {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      justify-content: space-between;
    }

    .solutions-megamenu-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 376px;
      width: 72%;
      max-width: 1280px;
      min-height: 372px;
      margin: 0 auto;
      background: var(--soeteck-white);
    }

    .solutions-megamenu-main {
      padding: 28px 40px 56px 0;
    }

    .solutions-megamenu-title {
      margin: 0 0 26px;
      font-family: var(--soeteck-font-heading);
      padding-bottom: 20px;
      border-bottom: 1px solid var(--soeteck-border);
      color: var(--soeteck-text);
      font-size: 18px;
      font-weight: 700;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .solutions-bento {
      display: flex;
      align-items: stretch;
      gap: 16px;
      font-family: var(--soeteck-font-body);
    }

    .solutions-bento-featured {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      padding: 24px;
      border-radius: 16px;
      color: var(--soeteck-white);
      text-decoration: none;
      background:
        linear-gradient(180deg, rgba(11, 22, 36, 0.88) 0%, rgba(15, 34, 58, 0.6) 100%),
        url('/resources/ai-data-center-card-bg.jpg') center/cover no-repeat,
        var(--soeteck-primary-dark);
    }

    .solutions-bento-grid {
      flex: 2 1 0;
      min-width: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .solutions-bento-featured__icon {
      color: #bfe0ff;
      margin-bottom: 16px;
    }

    .solutions-bento-featured__title {
      display: block;
      margin: 0 0 8px;
      font-family: var(--soeteck-font-heading);
      color: var(--soeteck-white);
      font-size: 18px;
      font-weight: 700;
      line-height: 1.25;
    }

    .solutions-bento-featured__desc {
      display: block;
      color: rgba(255, 255, 255, 0.86);
      font-size: 14px;
      line-height: 1.5;
    }

    .solutions-bento-featured__explore {
      margin-top: auto;
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--soeteck-white);
      font-size: 14px;
      font-weight: 500;
    }

    .solutions-bento-featured__arrow {
      display: inline-block;
      transition: transform 0.2s ease;
    }

    .solutions-bento-featured:hover .solutions-bento-featured__arrow {
      transform: translateX(4px);
    }

    .solutions-bento-item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-content: start;
      column-gap: 12px;
      padding: 16px 20px;
      border: 1px solid var(--soeteck-border-soft);
      border-radius: 12px;
      background: var(--soeteck-white);
      color: var(--soeteck-text);
      text-decoration: none;
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .solutions-bento-item__icon {
      grid-column: 1;
      grid-row: 1 / 3;
      align-self: start;
      color: var(--soeteck-primary);
      padding-top: 2px;
    }

    .solutions-bento-item__title {
      grid-column: 2;
      display: block;
      margin-bottom: 4px;
      font-family: var(--soeteck-font-heading);
      color: var(--soeteck-text);
      font-size: 15px;
      font-weight: 600;
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .solutions-bento-item__desc {
      grid-column: 2;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      color: var(--soeteck-muted);
      font-size: 13px;
      line-height: 1.4;
    }

    .solutions-bento-item:hover,
    .solutions-bento-item:focus-visible {
      border-color: var(--soeteck-primary);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px color-mix(in srgb, var(--soeteck-primary) 12%, transparent);
    }

    /* ⚠️ 原 max-width:720 内嵌块已删除：嵌套在 min-width:992 内永不满足，属死 CSS */

    .solutions-megamenu-sidebar {
      display: flex;
      flex-direction: column;
      min-height: 372px;
      padding: 28px 30px 30px;
      background: var(--soeteck-surface);
    }

    .solutions-industry-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .solutions-industry-list li {
      color: var(--soeteck-text);
      font-size: 16px;
      line-height: 1.35;
    }

    .solutions-industry-list li + li {
      margin-top: 14px;
    }

    .solutions-custom-cta {
      margin-top: auto;
      padding: 21px 20px 23px;
      border-radius: 6px;
      background: #d7e9ff;
    }

    .solutions-custom-cta span {
      display: block;
      margin-bottom: 8px;
      color: var(--soeteck-text);
      font-size: 16px;
      line-height: 1.3;
    }

    .solutions-custom-cta a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 39px;
      border-radius: 4px;
      background: var(--soeteck-primary);
      color: var(--soeteck-white);
      font-size: 15px;
      font-weight: 500;
      line-height: 1;
      text-decoration: none;
      transition: background 180ms ease;
    }

    .solutions-custom-cta a:hover {
      background: var(--soeteck-primary-dark);
    }

    .news-megamenu-inner {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
      width: 78%;
      max-width: 1504px;
      margin: 0 auto;
      padding: 30px 0 42px;
      background: var(--soeteck-white);
    }

    .news-megamenu-column {
      min-width: 0;
    }

    .news-megamenu-heading {
      display: flex;
      font-family: var(--soeteck-font-heading);
      align-items: center;
      gap: 6px;
      margin-bottom: 6px;
      color: var(--soeteck-text);
      font-size: 18px;
      font-weight: 700;
      line-height: 1.2;
      text-decoration: none;
      transition: color 180ms ease;
    }

    .news-megamenu-marker {
      display: inline-block;
      width: 14px;
      height: 14px;
      border-radius: 3px;
      background: var(--soeteck-primary);
    }

    .news-megamenu-heading:hover {
      color: var(--soeteck-primary);
    }

    .news-megamenu-subtitle {
      min-height: 24px;
      font-family: var(--soeteck-font-body);
      margin: 0 0 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--soeteck-border);
      color: var(--soeteck-muted);
      font-size: 11px;
      font-weight: 400;
      font-style: italic;
      line-height: 1.25;
    }

    .news-featured-card,
    .news-featured-placeholder {
      display: block;
      color: var(--soeteck-text);
      text-decoration: none;
    }

    .news-featured-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 150px;
      background: #f3f6fa;
      border-radius: 4px;
      color: #94a3b8;
    }

    .news-featured-icon {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .news-featured-image {
      position: relative;
      display: block;
      width: 100%;
      height: 150px;
      margin-bottom: 14px;
      background: #f3f6fa;
      overflow: hidden;
    }

    .news-featured-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 220ms ease;
    }

    .news-date-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 78px;
      min-height: 20px;
      padding: 4px 6px;
      border-radius: 3px;
      background: color-mix(in srgb, var(--soeteck-primary) 92%, transparent);
      color: var(--soeteck-white);
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
    }

    .news-featured-image .news-date-badge {
      position: absolute;
      left: 10px;
      bottom: 10px;
    }

    .news-featured-title {
      display: -webkit-box;
      min-height: 40px;
      margin-bottom: 8px;
      color: var(--soeteck-text);
      font-size: 16px;
      font-weight: 700;
      line-height: 1.25;
      overflow: hidden;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      transition: color 180ms ease;
    }

    .news-featured-excerpt {
      display: -webkit-box;
      min-height: 34px;
      color: var(--soeteck-muted);
      font-size: 12px;
      line-height: 1.4;
      overflow: hidden;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .news-featured-card:hover .news-featured-image img {
      transform: scale(1.04);
    }

    .news-featured-card:hover .news-featured-title {
      color: var(--soeteck-primary);
    }

    .news-latest-list {
      list-style: none;
      margin: 18px 0 0;
      padding: 14px 0 0;
      border-top: 1px solid var(--soeteck-border-soft);
    }

    .news-latest-list li + li {
      margin-top: 10px;
    }

    .news-latest-list a {
      display: grid;
      grid-template-columns: 78px minmax(0, 1fr);
      align-items: start;
      gap: 14px;
      color: var(--soeteck-muted);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.35;
      text-decoration: none;
      transition: color 180ms ease;
    }

    .news-latest-list a:hover {
      color: var(--soeteck-primary);
    }

    .megamenu-heading {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
      color: var(--soeteck-text);
      font-size: 16px;
      font-weight: 700;
      line-height: 1.2;
      text-decoration: none;
    }

    .megamenu-heading-icon {
      display: inline-flex;
      flex: 0 0 16px;
      width: 16px;
      height: 16px;
    }

    .megamenu-heading-icon svg {
      display: block;
      width: 16px;
      height: 16px;
    }

    .megamenu-heading-text {
      position: relative;
      display: inline-block;
      transition: color 0.2s ease;
    }

    .megamenu-heading-text::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 0;
      height: 2px;
      background-color: var(--soeteck-primary);
      transition: width 0.2s ease;
    }

    .megamenu-heading:hover .megamenu-heading-text {
      color: var(--soeteck-primary);
    }

    .megamenu-heading:hover .megamenu-heading-text::after {
      width: 100%;
    }

    .megamenu-list,
    .megamenu-sublist {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .megamenu-list > li + li {
      margin-top: 5px;
    }

    .megamenu-list a,
    .megamenu-sublist a {
      display: block;
      margin-left: 24px;
      color: var(--soeteck-muted);
      font-size: 13px;
      font-weight: 400;
      line-height: 1.35;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .megamenu-list a:hover,
    .megamenu-sublist a:hover {
      color: var(--soeteck-primary);
    }

    .megamenu-sublist {
      margin-top: 7px;
      margin-left: 14px;
    }

    .megamenu-sublist > li + li {
      margin-top: 6px;
    }

    .megamenu-sublist a {
      color: var(--soeteck-muted);
      font-size: 13px;
    }

    .site-header .megamenu-panel {
      display: block;
      position: fixed;
      top: var(--soeteck-header-total);
      left: 0;
      right: 0;
      width: auto;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.2s ease-out, visibility 0.2s ease-out;
    }

    .site-header .has-megamenu:hover > .megamenu-panel,
    .site-header .has-megamenu:focus-within > .megamenu-panel,
    .site-header .has-megamenu.submenu-open > .megamenu-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 0 auto;
    gap: 14px;
    margin-left: auto;
  }

  .header-dropdown {
    position: relative;
  }

  @media (min-width: 992px) {
    .header-dropdown {
      display: flex;
      align-items: center;
      min-height: var(--soeteck-header-h);
      margin: 0 -10px;
      padding: 0 10px;
    }

    .header-dropdown::after {
