---
import type { GlobalConfigResponse } from '@/lib/content-api';
import { getUITranslation } from '@/lib/translations';
import AidcIcon from './solutions/AidcIcon.astro';

interface Props {
  globalConfig: GlobalConfigResponse;
  lang?: string;
}

const { globalConfig, lang = 'en' } = Astro.props;

// 将 API 返回的 /en/ 路径转为当前语言路径
function localizePath(apiPath: string): string {
  if (lang === 'en') return apiPath;
  return apiPath.replace(/^\/en\//, `/${lang}/`);
}

// 翻译导航标签
const navMap: Record<string, string> = {
  'Products': 'nav.products',
  'Solutions': 'nav.solutions',
  'News & Insights': 'nav.news',
  'About Soeteck': 'nav.about',
  'Contact Us': 'nav.contact',
  'Home': 'nav.home',
};
function translateNav(title: string): string {
  if (lang === 'en') return title;
  const key = navMap[title];
  return key ? getUITranslation(lang, key) : title;
}

// 翻译 Mega Menu 中的分类标题（API 返回英文，需映射到翻译 key）
const categoryMap: Record<string, string> = {
  'Critical Power': 'category.criticalPower',
  'Thermal Management': 'category.thermalManagement',
  'Racks & Enclosures': 'category.racksEnclosures',
  'Monitoring & Management': 'category.monitoringManagement',
  'Prefabricated Data Center': 'category.prefabDC',
  'Colocation Data Center': 'category.colocationDC',
  'Edge Computing': 'category.edgeComputing',
  'News Releases': 'category.newsReleases',
  'Blogs': 'category.blogs',
  'Client Case Studies': 'category.caseStudies',
  'Liquid Cooling Data Center': 'solutions.liquidCoolingDC',
  'Liquid Cooling DC': 'solutions.liquidCoolingDC',
  'Prefabricated Container Data Center': 'solutions.prefabContainerDC',
  'Prefab Container DC': 'solutions.prefabContainerDC',
  'Cabinet Modular Data Center': 'solutions.cabinetModularDC',
  'Cabinet Modular DC': 'solutions.cabinetModularDC',
  'Row Modular Data Center': 'solutions.rowModularDC',
  'Row Modular DC': 'solutions.rowModularDC',
  'Aisle Modular Data Center': 'solutions.aisleModularDC',
  'Aisle Modular DC': 'solutions.aisleModularDC',
  'AI Data Center Infrastructure': 'solutions.aiDataCenter',
  'AI Data Center': 'solutions.aiDataCenter',
  'Data Center Cooling Solutions': 'solutions.dataCenterCooling',
  'Data Center Cooling': 'solutions.dataCenterCooling',
  'Uninterruptible Power Supplies': 'products.uninterruptiblePowerSupplies',
  'DC Power Systems': 'products.dcPowerSystems',
  'Power Distribution': 'products.powerDistribution',
  'Static Transfer Switches': 'products.staticTransferSwitches',
  'Busway and Busduct': 'products.buswayAndBusduct',
  'Battery': 'products.battery',
  'Liquid Cooling Solutions': 'products.liquidCoolingSolutions',
  'Precision Air Conditioning': 'products.precisionAirConditioning',
  'Room Cooling': 'products.roomCooling',
  'In-Row Cooling': 'products.inRowCooling',
  'Rack Cooling': 'products.rackCooling',
  'Pumped Refrigerant Cooling': 'products.pumpedRefrigerantCooling',
  'Telecom Enclosure Air Conditioner': 'products.telecomEnclosureAirConditioner',
  'Heat Rejection': 'products.heatRejection',
  'Evaporative Free Cooling': 'products.evaporativeFreeCooling',
  'Free Cooling Chillers': 'products.freeCoolingChillers',
  'Integrated Containments': 'products.integratedContainments',
  'Outdoor Enclosures': 'products.outdoorEnclosures',
  'Racks & Cabinets': 'products.racksAndCabinets',
  'Monitoring Host': 'products.monitoringHost',
  'Battery Monitoring System': 'products.batteryMonitoringSystem',
  'Environmental Sensor': 'products.environmentalSensor',
  'Rack Asset Management': 'products.rackAssetManagement',
  'KVM': 'products.kvm',
};
function translateCategoryTitle(title: string): string {
  if (lang === 'en') return title;
  const key = categoryMap[title];
  return key ? getUITranslation(lang, key) : title;
}

// 解决方案卡片描述映射：title → shared.json key
const solutionDescMap: Record<string, string> = {
  'Liquid Cooling Data Center': 'solutions.liquidCoolingDCDesc',
  'Liquid Cooling DC': 'solutions.liquidCoolingDCDesc',
  'Prefabricated Container Data Center': 'solutions.prefabContainerDCDesc',
  'Prefab Container DC': 'solutions.prefabContainerDCDesc',
  'Cabinet Modular Data Center': 'solutions.cabinetModularDCDesc',
  'Cabinet Modular DC': 'solutions.cabinetModularDCDesc',
  'Row Modular Data Center': 'solutions.rowModularDCDesc',
  'Row Modular DC': 'solutions.rowModularDCDesc',
  'Aisle Modular Data Center': 'solutions.aisleModularDCDesc',
  'Aisle Modular DC': 'solutions.aisleModularDCDesc',
  'AI Data Center Infrastructure': 'solutions.aiDataCenterDesc',
  'AI Data Center': 'solutions.aiDataCenterDesc',
  'Data Center Cooling Solutions': 'solutions.dataCenterCoolingDesc',
  'Data Center Cooling': 'solutions.dataCenterCoolingDesc',
};

// Detect menu variant type from URL path (fallback when API type is 'default')
function detectMenuType(item: { path?: string; type?: string; children?: unknown[] }): string {
  if (item.type && item.type !== 'default') return item.type;
  const p = (item.path || '').toLowerCase();
  if (p.includes('/products')) return 'product';
  if (p.includes('/solutions')) return 'solution';
  if (p.includes('/news')) return 'news';
  return 'default';
}

// 生成目标语言的当前页面链接
function getLanguageUrl(targetLang: string): string {
  const currentPath = Astro.url.pathname;
  // 移除当前语言前缀，添加目标语言前缀
  const pathWithoutLang = currentPath.replace(/^\/(en|zh|ru|pt|es)/, '') || '/';
  return `/${targetLang}${pathWithoutLang}`;
}

// Use data from API, fall back to defaults if not available
const mainNavigation = globalConfig.mainNavigation || [];
const languages = globalConfig.languages || [
  { slug: 'en', name: 'English', nativeName: 'English', flag: { path: '/resources/flags/en.svg' }, url: '/en/', isCurrent: true },
  { slug: 'zh', name: 'Chinese', nativeName: '中文', flag: { path: '/resources/flags/zh.svg' }, url: '/zh/', isCurrent: false },
  { slug: 'ru', name: 'Russian', nativeName: 'Русский', flag: { path: '/resources/flags/ru.svg' }, url: '/ru/', isCurrent: false },
  { slug: 'pt', name: 'Portuguese', nativeName: 'Português', flag: { path: '/resources/flags/pt.svg' }, url: '/pt/', isCurrent: false },
  { slug: 'es', name: 'Spanish', nativeName: 'Español', flag: { path: '/resources/flags/es.svg' }, url: '/es/', isCurrent: false },
];
const currentLanguage = globalConfig.currentLanguage || languages[0];
const logoUrl = globalConfig.site.logo?.path || '/resources/soeteck-logo-2.webp';
const contactUrl = localizePath(globalConfig.urls.contact || '/en/contact-us/');
const searchUrl = localizePath(globalConfig.urls.search || '/en/search/');
---

<header id="masthead" class="site-header">
  <div class="header-inner">
    <a class="site-logo-link" href={localizePath("/en/")} rel="home" aria-label="Soeteck">
      <img class="site-logo-image" src={logoUrl} alt="Soeteck" width="230" height="57">
    </a>

    <button class="menu-toggle" type="button" aria-controls="mobile-menu-overlay" aria-expanded="false" aria-label="Open menu">
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
      <span class="menu-toggle-line"></span>
    </button>

    <nav id="site-navigation" class="main-navigation" aria-label="Primary menu">
      <ul class="primary-menu">
        {mainNavigation.map(item => {
          const titleKey = item.title.toLowerCase()
          const isContact = titleKey === 'contact us'
          if (isContact) return null

          const hasChildren = !!(item.children && item.children.length)
          const menuType = detectMenuType(item)
          const variantClass =
            menuType === 'product' ? ' menu-products' :
            menuType === 'solution' ? ' menu-solutions' :
            menuType === 'news' ? ' menu-news' : ''

          // Solutions 导航 Bento 网格：Featured = AI Data Center（路径兜底），其余小卡
          const solutionChildren = item.children ?? []
          const normPath = (p: string) => p.replace(/^\/[a-z]{2}\//, '/')
          const featuredSolution = solutionChildren.find((c: any) => normPath(c.path || '').endsWith('/solutions/data-center-solutions/ai-data-center/')) ?? solutionChildren[0]
          const featuredIsAidc = !!featuredSolution && normPath(featuredSolution.path || '').endsWith('/solutions/data-center-solutions/ai-data-center/')
          const otherSolutions = solutionChildren.filter((c: any) => c !== featuredSolution)
          const solutionIconMap: Record<string, string> = {
            'AI Data Center Infrastructure': 'ai',
            'AI Data Center': 'ai',
            'Liquid Cooling Data Center': 'liquid',
            'Liquid Cooling DC': 'liquid',
            'Prefabricated Container Data Center': 'prefab',
            'Prefab Container DC': 'prefab',
            'Cabinet Modular Data Center': 'cabinet',
            'Cabinet Modular DC': 'cabinet',
            'Row Modular Data Center': 'row',
            'Row Modular DC': 'row',
            'Aisle Modular Data Center': 'aisle',
            'Aisle Modular DC': 'aisle',
            'Data Center Cooling Solutions': 'ac',
            'Data Center Cooling': 'ac',
          }

          return (
            <li class={`primary-menu-item${hasChildren ? ' has-megamenu' : ''}${variantClass}`}>
              <a class="primary-menu-link" href={localizePath(item.path)}>
                {translateNav(item.title)}
              </a>

              {hasChildren && (
                <>
                  <button class="submenu-toggle" type="button" aria-expanded="false" aria-label={`Open ${item.title} menu`}>
                    <svg class="dropdown-chevron" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" focusable="false">
                      <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <div class="megamenu-panel" aria-label={item.title}>
                    {menuType === 'news' && (
                      <div class="news-megamenu-inner">
                        {item.children.map(newsCategory => {
                          const categoryKey = newsCategory.title.toLowerCase()
                          const subtitles = {
                            'news releases': getUITranslation(lang, 'megamenu.newsSubtitle1'),
                            'blogs': getUITranslation(lang, 'megamenu.newsSubtitle2'),
                            'client case studies': getUITranslation(lang, 'megamenu.newsSubtitle3'),
                          }
                          const subtitle = subtitles[categoryKey] || ''
                          const np = (newsCategory as any).newsPosts as { featured: any; list: any[] } | undefined
                          const featuredPost = np?.featured ?? null
                          const latestPosts = np?.list ?? []

                          return (
                            <section class="news-megamenu-column">
                              <a class="megamenu-heading" href={localizePath(newsCategory.path)}>
                                <span class="megamenu-heading__marker" aria-hidden="true"></span>
                                <span class="megamenu-heading-text">{translateCategoryTitle(newsCategory.title)}</span>
                              </a>
                              {subtitle && <p class="news-megamenu-subtitle">{subtitle}</p>}

                              {featuredPost ? (
                                <a class="news-featured-card" href={localizePath(featuredPost.path)}>
                                  {featuredPost.featuredImage && (
                                    <span class="news-featured-image">
                                      <img src={featuredPost.featuredImage.path} alt={featuredPost.title} loading="lazy">
                                      <span class="news-date-badge">{featuredPost.date}</span>
                                    </span>
                                  )}
                                  <span class="news-featured-title">{featuredPost.title}</span>
                                  {featuredPost.excerpt && (
                                    <span class="news-featured-excerpt">{featuredPost.excerpt}</span>
                                  )}
                                </a>
                              ) : (
                                <a class="news-featured-placeholder" href={localizePath(newsCategory.path)}>
                                  <span class="news-featured-icon" aria-hidden="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                      <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 12h10" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </span>
                                </a>
                              )}

                              {latestPosts.length > 0 && (
                                <ul class="news-latest-list">
                                  {latestPosts.map((post: any) => (
                                    <li>
                                      <a href={localizePath(post.path)}>
                                        <span class="news-date-badge">{post.date}</span>
                                        <span>{post.title}</span>
                                      </a>
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </section>
                          )
                        })}
                      </div>
                    )}

                    {menuType === 'solution' && (
                      <div class="solutions-megamenu-inner">
                        <div class="solutions-megamenu-main">
                          <p class="solutions-megamenu-title">{getUITranslation(lang, 'megamenu.prefabDC')}</p>
                          <div class="solutions-bento">
                            <a class="solutions-bento-featured" href={localizePath(featuredSolution.path)}>
                              <span class="solutions-bento-featured__icon"><AidcIcon name={(solutionIconMap[featuredSolution.title] || 'gpu') as any} size={30} /></span>
                              <span class="solutions-bento-featured__title">{getUITranslation(lang, categoryMap[featuredSolution.title] || 'solutions.aiDataCenter')}</span>
                              <span class="solutions-bento-featured__desc">{getUITranslation(lang, solutionDescMap[featuredSolution.title] || 'solutions.aiDataCenterDesc')}</span>
                              <span class="solutions-bento-featured__explore">
                                {getUITranslation(lang, featuredIsAidc ? 'megamenu.exploreAidc' : 'megamenu.exploreSolutions')}
                                <span class="solutions-bento-featured__arrow" aria-hidden="true">→</span>
                              </span>
                            </a>
                            <div class="solutions-bento-grid">
                              {otherSolutions.map(solution => (
                                <a class="solutions-bento-item" href={localizePath(solution.path)}>
                                  <span class="solutions-bento-item__icon"><AidcIcon name={(solutionIconMap[solution.title] || 'grid') as any} size={22} /></span>
                                  <span class="solutions-bento-item__title">{getUITranslation(lang, categoryMap[solution.title] || 'solutions.prefabContainerDC')}</span>
                                  <span class="solutions-bento-item__desc">{getUITranslation(lang, solutionDescMap[solution.title] || 'solutions.prefabContainerDCDesc')}</span>
                                </a>
                              ))}
                            </div>
                          </div>
                        </div>
                        <aside class="solutions-megamenu-sidebar">
                          <p class="solutions-megamenu-title">{getUITranslation(lang, 'megamenu.industries')}</p>
                          <ul class="solutions-industry-list">
                            <li><a href={localizePath('/en/solutions/telecom/')}>{getUITranslation(lang, 'megamenu.industryTelecom')}</a></li>
                            <li><a href={localizePath('/en/solutions/colocation/')}>{getUITranslation(lang, 'megamenu.industryColocation')}</a></li>
                            <li><a href={localizePath('/en/solutions/cloud-hyperscale/')}>{getUITranslation(lang, 'megamenu.industryCloudHyperscale')}</a></li>
                            <li><a href={localizePath('/en/solutions/internet/')}>{getUITranslation(lang, 'megamenu.industryInternet')}</a></li>
                            <li><a href={localizePath('/en/solutions/finance/')}>{getUITranslation(lang, 'megamenu.industryFinance')}</a></li>
                            <li><a href={localizePath('/en/solutions/government/')}>{getUITranslation(lang, 'megamenu.industryGovernment')}</a></li>
                            <li><a href={localizePath('/en/solutions/manufacturing/')}>{getUITranslation(lang, 'megamenu.industryManufacturing')}</a></li>
                            <li><a href={localizePath('/en/solutions/healthcare/')}>{getUITranslation(lang, 'megamenu.industryHealthcare')}</a></li>
                          </ul>
                        </aside>
                      </div>
                    )}

                    {menuType === 'product' && (
                      <div class="megamenu-inner">
                        {item.children.map(column => (
                          <div class="megamenu-column">
                            <a class="megamenu-heading" href={localizePath(column.path)}>
                              <span class="megamenu-heading__marker" aria-hidden="true"></span>
                              <span class="megamenu-heading-text">{translateCategoryTitle(column.title)}</span>
                            </a>

                            {column.children && (
                              <ul class="megamenu-list">
                                {column.children.map(child => (
                                  <li>
                                    <a href={localizePath(child.path)}>{translateCategoryTitle(child.title)}</a>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </>
              )}
            </li>
          )
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <div class="header-dropdown language-navigation">
        <button class="language-toggle" type="button" aria-expanded="false" aria-label="Language">
          <img class="globe-icon" src="/resources/globe-1.svg" alt="" width="22" height="22" aria-hidden="true">
        </button>
        <ul class="header-dropdown-panel language-panel">
          {languages.map(l => (
            <li>
              <a href={getLanguageUrl(l.slug)} aria-current={l.slug === lang ? 'true' : undefined}>
                <img src={l.flag.path} alt={l.name} width="18" height="12">
                <span>{l.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="header-dropdown header-search">
        <button class="header-icon-button header-search-toggle" type="button" aria-expanded="false" aria-label={getUITranslation(lang, 'common.search')}>
          <img class="search-icon" src="/resources/MagnifyingGlass.svg" alt="" width="18" height="18" aria-hidden="true">
        </button>
        <div class="header-dropdown-panel search-panel">
          <form role="search" method="get" class="header-search-form" action={searchUrl}>
            <label class="screen-reader-text" for="header-search-field">{getUITranslation(lang, 'common.searchFor')}</label>
            <input id="header-search-field" type="search" name="s" placeholder={getUITranslation(lang, 'common.searchPlaceholder')}>
            <button type="submit">{getUITranslation(lang, 'common.search')}</button>
          </form>
        </div>
      </div>

      <a class="header-contact-button" href={contactUrl}>
        {translateNav('Contact Us')}
      </a>
    </div>
  </div>
</header>

<!-- Mobile menu overlay -->
<div id="mobile-menu-overlay" class="mobile-menu-overlay" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="mobile-menu-sidebar">
    <div class="mobile-menu-header">
      <button class="mobile-menu-close" type="button" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <a class="mobile-menu-logo" href={localizePath("/en/")} rel="home" aria-label="Soeteck">
        <img src={logoUrl} alt="Soeteck" width="140" height="auto">
      </a>
    </div>
    <div class="mobile-menu-content">
      <nav class="mobile-nav" aria-label="Mobile menu">
        <ul class="mobile-nav-list">
          {mainNavigation.map(item => {
            const titleKey = item.title.toLowerCase()
            const isContact = titleKey === 'contact us'
            if (isContact) return null

            const hasChildren = !!(item.children && item.children.length)

            return (
              <li class={`mobile-menu-item${hasChildren ? ' mobile-has-submenu' : ''}`}>
                {hasChildren ? (
                  <div class="mobile-menu-toggle-item">
                    <a class="mobile-menu-parent-link" href={localizePath(item.path)}>{translateNav(item.title)}</a>
                    <button class="mobile-menu-toggle-button" type="button" aria-expanded="false" aria-label={`Toggle ${item.title} menu`}>
                      <svg class="mobile-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="m19.5 8.25l-7.5 7.5-7.5-7.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                ) : (
                  <a class="mobile-menu-link" href={localizePath(item.path)}>
                    {translateNav(item.title)}
                  </a>
                )}

                {hasChildren && (
                  <div class="mobile-submenu">
                    <div class="mobile-submenu-content">
                      {item.children.map(column => {
                        const hasGrandChildren = !!(column.children && column.children.length)

                        return (
                          <div class={`mobile-accordion-section${hasGrandChildren ? ' mobile-has-nested' : ''}`}>
                            <div class="mobile-accordion-toggle">
                              <a class="mobile-accordion-main-link" href={localizePath(column.path)}>{translateCategoryTitle(column.title)}</a>
                              {hasGrandChildren && (
                                <button class="mobile-accordion-toggle-button" type="button" aria-expanded="false" aria-label={`Toggle ${column.title} section`}>
                                  <svg class="mobile-accordion-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="m19.5 8.25l-7.5 7.5-7.5-7.5" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </button>
                              )}
                            </div>

                            {hasGrandChildren && (
                              <div class="mobile-accordion-nested">
                                {column.children.map(child => {
                                  const hasGreatGrandChildren = !!(child.children && child.children.length)

                                  return hasGreatGrandChildren ? (
                                    <div class="mobile-accordion-section mobile-has-nested">
                                      <div class="mobile-accordion-toggle mobile-accordion-toggle-link-style">
                                        <a class="mobile-accordion-main-link" href={localizePath(child.path)}>{translateCategoryTitle(child.title)}</a>
                                        <button class="mobile-accordion-toggle-button" type="button" aria-expanded="false" aria-label={`Toggle ${child.title} section`}>
                                          <svg class="mobile-accordion-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="m19.5 8.25l-7.5 7.5-7.5-7.5" stroke-linecap="round" stroke-linejoin="round"/>
                                          </svg>
                                        </button>
                                      </div>
                                      <div class="mobile-accordion-nested">
                                        {child.children.map(grandChild => (
                                          <a href={localizePath(grandChild.path)} class="mobile-accordion-sub-link">
                                            {translateCategoryTitle(grandChild.title)}
                                          </a>
                                        ))}
                                      </div>
                                    </div>
                                  ) : (
                                    <a href={localizePath(child.path)} class="mobile-accordion-sub-link">
                                      {translateCategoryTitle(child.title)}
                                    </a>
                                  )
                                })}
                              </div>
                            )}
                          </div>
                        )
                      })}
                    </div>
                  </div>
                )}
              </li>
            )
          })}
        </ul>
      </nav>
      <div class="mobile-menu-footer">
        <div class="mobile-lang-switcher">
          <span class="mobile-lang-title">{getUITranslation(lang, 'common.language')}</span>
          <div class="mobile-lang-options">
            {languages.map(l => (
              <a class={`mobile-lang-option${l.slug === lang ? ' active' : ''}`} href={getLanguageUrl(l.slug)}>
                <img src={l.flag.path} alt={l.name} width="18" height="12">
                <span>{l.name}</span>
              </a>
            ))}
          </div>
        </div>
        <a class="mobile-contact-btn" href={contactUrl}>
          {translateNav('Contact Us')}
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Mobile search overlay -->
<div id="mobile-search-overlay" class="mobile-search-overlay" role="dialog" aria-modal="true" aria-label={getUITranslation(lang, 'common.search')}>
  <div class="mobile-search-sidebar">
    <div class="mobile-menu-header">
      <button class="mobile-search-close" type="button" aria-label="Close search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="mobile-search-title">{getUITranslation(lang, 'common.search')}</div>
    </div>
    <div class="mobile-search-content">
      <form role="search" method="get" class="mobile-search-form" action={searchUrl}>
        <label class="screen-reader-text" for="mobile-search-field">{getUITranslation(lang, 'common.searchFor')}</label>
        <input id="mobile-search-field" type="search" name="s" placeholder={getUITranslation(lang, 'common.searchPlaceholder')} class="mobile-search-input">
        <button type="submit" aria-label={getUITranslation(lang, 'common.search')} class="mobile-search-submit">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true">
            <path d="m21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<script is:inline>
// Header navigation interactions
document.addEventListener('DOMContentLoaded', function() {
  const header = document.querySelector('.site-header')
  if (!header) return

  // 焦点归还目标（移动 overlay 打开前记住；关闭后归还，无障碍）
  let lastFocused = null

  // Mobile menu toggle（aria-expanded 同步 + 打开聚焦关闭按钮 / 关闭归还焦点）
  const menuToggle = header.querySelector('.menu-toggle')
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay')
  const mobileMenuClose = document.querySelector('.mobile-menu-close')

  function openMobileMenu() {
    mobileMenuOverlay.classList.add('is-open')
    menuToggle.classList.add('is-open')
    menuToggle.setAttribute('aria-expanded', 'true')
    document.body.classList.add('mobile-menu-open')
    lastFocused = document.activeElement
    if (mobileMenuClose) mobileMenuClose.focus()
  }
  function closeMobileMenu() {
    mobileMenuOverlay.classList.remove('is-open')
    menuToggle.classList.remove('is-open')
    menuToggle.setAttribute('aria-expanded', 'false')
    document.body.classList.remove('mobile-menu-open')
    if (lastFocused && lastFocused.focus) lastFocused.focus()
    lastFocused = null
  }
  function toggleMobileMenu() {
    if (mobileMenuOverlay.classList.contains('is-open')) closeMobileMenu()
    else openMobileMenu()
  }

  if (menuToggle && mobileMenuOverlay) {
    menuToggle.addEventListener('click', toggleMobileMenu)
    if (mobileMenuClose) mobileMenuClose.addEventListener('click', closeMobileMenu)
    mobileMenuOverlay.addEventListener('click', function(e) {
      if (e.target === mobileMenuOverlay) closeMobileMenu()
    })
  }

  // Mobile search toggle（aria-expanded 同步 + 打开聚焦输入框 / 关闭归还焦点）
  const searchToggle = header.querySelector('.header-search-toggle')
  const mobileSearchOverlay = document.getElementById('mobile-search-overlay')
  const mobileSearchClose = document.querySelector('.mobile-search-close')

  function openMobileSearch() {
    mobileSearchOverlay.classList.add('is-open')
    document.body.classList.add('mobile-search-open')
    if (searchToggle) searchToggle.setAttribute('aria-expanded', 'true')
    lastFocused = document.activeElement
    const field = document.getElementById('mobile-search-field')
    if (field) field.focus()
  }
  function closeMobileSearch() {
    mobileSearchOverlay.classList.remove('is-open')
    document.body.classList.remove('mobile-search-open')
    if (searchToggle) searchToggle.setAttribute('aria-expanded', 'false')
    if (lastFocused && lastFocused.focus) lastFocused.focus()
    lastFocused = null
  }
  function toggleMobileSearch() {
    if (mobileSearchOverlay.classList.contains('is-open')) closeMobileSearch()
    else openMobileSearch()
  }

  if (searchToggle && mobileSearchOverlay) {
    searchToggle.addEventListener('click', function(e) {
      if (window.innerWidth <= 1199) {
        e.preventDefault()
        toggleMobileSearch()
      }
    })
    if (mobileSearchClose) mobileSearchClose.addEventListener('click', closeMobileSearch)
    mobileSearchOverlay.addEventListener('click', function(e) {
      if (e.target === mobileSearchOverlay) closeMobileSearch()
    })
  }

  // 收起节点及其全部子孙展开态（手风琴互斥用）；面板 max-height 归 0（精确收起）
  function collapseAccordion(node) {
    node.classList.remove('is-open')
    node.querySelectorAll('.mobile-submenu, .mobile-accordion-nested').forEach(function (p) { p.style.maxHeight = '0px' })
    node.querySelectorAll('.mobile-menu-toggle-button, .mobile-accordion-toggle-button').forEach(function (b) { b.setAttribute('aria-expanded', 'false') })
    node.querySelectorAll('.is-open').forEach(function (el) { el.classList.remove('is-open') })
  }

  // 祖先面板联动：子面板展开/收起时，父级已开面板同步增减子面板全高，
  // 与子面板动画并行进行（打开加、关闭减，对称平滑；避免嵌套裁剪/留白）
  function adjustAncestors(container, delta) {
    let cur = container.parentElement
    while (cur && cur !== document.body) {
      const p = cur.querySelector(':scope > .mobile-submenu, :scope > .mobile-accordion-nested')
      if (p && p.style.maxHeight && parseInt(p.style.maxHeight, 10) > 0) {
        p.style.maxHeight = (parseInt(p.style.maxHeight, 10) + delta) + 'px'
      }
      cur = cur.parentElement
    }
  }

  // Mobile accordion toggles（⚠️ 按钮在 <header> 外的移动 overlay 里，必须用 document 查询，
  // header.querySelectorAll 会扑空 → 历史 bug：移动端子菜单此前无法展开）
  // 同级互斥：同一容器内最多展开一个（Critical Power 等同级分类；含顶层 Products/Solutions/News）
  // 柔和对称：打开前实测 scrollHeight 设精确 max-height，避免 0→2000px 大行程「展开瞬开、收起柔」不对称
  document.querySelectorAll('.mobile-menu-toggle-button, .mobile-accordion-toggle-button').forEach(button => {
    button.addEventListener('click', function() {
      const willOpen = this.getAttribute('aria-expanded') !== 'true'
      const container = this.closest('.mobile-menu-item, .mobile-accordion-section')
      if (!container) return
      const panel = container.querySelector(':scope > .mobile-submenu, :scope > .mobile-accordion-nested')

      if (willOpen && container.parentElement) {
        // 收起同级兄弟（含它们各自子孙的展开态）
        const siblingSel = container.classList.contains('mobile-menu-item')
          ? ':scope > .mobile-menu-item'
          : ':scope > .mobile-accordion-section'
        container.parentElement.querySelectorAll(siblingSel).forEach(function(sib) {
          if (sib !== container) collapseAccordion(sib)
        })
      }
      if (panel) {
        const full = panel.scrollHeight
        panel.style.maxHeight = willOpen ? (full + 'px') : '0px'
        adjustAncestors(container, willOpen ? full : -full)
      }
      // toggle 自身
      this.setAttribute('aria-expanded', willOpen ? 'true' : 'false')
      if (!willOpen) collapseAccordion(container)
      container.classList.toggle('is-open', willOpen)
    })
  })

  // Desktop dropdown interactions（档3：点击开合 + 点外/ESC 关闭；hover 不再单独开 panel，
  // 消除 hover↔click 冲突；:focus-within 保留键盘可达）
  function closeAllDropdowns() {
    header.querySelectorAll('.header-dropdown.dropdown-open').forEach(dropdown => {
      dropdown.classList.remove('dropdown-open')
      const t = dropdown.querySelector('.language-toggle, .header-search-toggle')
      if (t) t.setAttribute('aria-expanded', 'false')
    })
  }

  if (window.innerWidth >= 1200) {
    const dropdownToggles = header.querySelectorAll('.language-toggle, .header-search-toggle')

    dropdownToggles.forEach(toggle => {
      toggle.addEventListener('click', function(e) {
        e.preventDefault()
        const dropdown = this.closest('.header-dropdown')
        if (!dropdown) return

        const willOpen = !dropdown.classList.contains('dropdown-open')
        closeAllDropdowns()
        if (willOpen) {
          dropdown.classList.add('dropdown-open')
          this.setAttribute('aria-expanded', 'true')
        }
      })
    })

    // 点外关闭：点击落在任意 .header-dropdown 之外即收起
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.header-dropdown')) closeAllDropdowns()
    })
  }

  // Desktop megamenu：submenu-toggle 点击切换 submenu-open（CSS hover 仍可开）；
  // 悬停/焦点镜像 aria-expanded，便于读屏
  const megamenuItems = header.querySelectorAll('.has-megamenu')
  const syncSubmenuAria = function (item) {
    const t = item.querySelector('.submenu-toggle')
    if (t) t.setAttribute('aria-expanded', item.classList.contains('submenu-open') ? 'true' : 'false')
  }
  megamenuItems.forEach(item => {
    const toggleBtn = item.querySelector('.submenu-toggle')
    if (toggleBtn) {
      toggleBtn.addEventListener('click', function(e) {
        e.preventDefault()
        item.classList.toggle('submenu-open')
        megamenuItems.forEach(o => { if (o !== item) o.classList.remove('submenu-open') })
        megamenuItems.forEach(syncSubmenuAria)
      })
    }
    if (window.innerWidth >= 1200) {
      item.addEventListener('mouseenter', function() {
        const t = item.querySelector('.submenu-toggle')
        if (t) t.setAttribute('aria-expanded', 'true')
      })
      item.addEventListener('mouseleave', function() {
        if (!item.contains(document.activeElement)) syncSubmenuAria(item)
      })
      item.addEventListener('focusout', function() {
        if (!item.contains(document.activeElement)) syncSubmenuAria(item)
      })
    }
  })

  // 移动 overlay focus trap（档3：Tab 在弹层内循环，防止焦点逃到背景）
  const mobileOverlays = [mobileMenuOverlay, mobileSearchOverlay].filter(Boolean)
  function trapFocus(overlay, e) {
    if (!overlay.classList.contains('is-open')) return
    const focusable = overlay.querySelectorAll('a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])')
    if (!focusable.length) return
    const first = focusable[0]
    const last = focusable[focusable.length - 1]
    const active = document.activeElement
    if (e.shiftKey) {
      if (active === first || !overlay.contains(active)) { e.preventDefault(); last.focus() }
    } else if (active === last || !overlay.contains(active)) {
      e.preventDefault(); first.focus()
    }
  }
  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Tab') return
    mobileOverlays.forEach(function(ov) { trapFocus(ov, e) })
  })

  // ESC：关闭移动菜单/搜索、桌面 dropdown、megamenu（档3，无障碍）
  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape') return
    if (mobileMenuOverlay && mobileMenuOverlay.classList.contains('is-open')) closeMobileMenu()
    if (mobileSearchOverlay && mobileSearchOverlay.classList.contains('is-open')) closeMobileSearch()
    closeAllDropdowns()
    megamenuItems.forEach(item => { item.classList.remove('submenu-open'); syncSubmenuAria(item) })
  })
})
</script>
