---
/**
 * ScenariosSection — application scenario cards grid.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props { data: HomeContent['scenarios']; }

const { data } = Astro.props;
---

<section class="home-scenarios" aria-labelledby="scenarios-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="soeteck-eyebrow">{data.eyebrow}</p>
      <h2 id="scenarios-title" class="home-section__title">{data.title}</h2>
      <p class="home-section__lead">{data.text}</p>
    </div>
    <div class="home-scenarios__grid">
      {data.items.map((item) => (
        <article class="home-scenario-card">
          <div class="home-scenario-card__media">
            <img src={item.image.path} alt={item.image.alt} loading="lazy" width="400" height="260" />
          </div>
          <div class="home-scenario-card__body">
            <div class="home-scenario-card__tags">
              {item.tags.map((tag) => <span class="home-scenario-card__tag">{tag}</span>)}
            </div>
            <h3 class="home-scenario-card__title">{item.title}</h3>
            <p class="home-scenario-card__text">{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .home-scenarios {
    padding: var(--soeteck-section-y) 0;
    background: var(--soeteck-white);
  }

  /* Container override — narrower than default for card layout */
  :global(.home-scenarios) .soeteck-container,
  .home-scenarios :global(.soeteck-container) {
    max-width: 1200px;
  }

  /* Section head inherited from HomePage global styles */

  .home-scenarios__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  /* --- Card --- */

  .home-scenario-card {
    background: var(--soeteck-surface);
    border: 1px solid var(--soeteck-border-soft);
    border-radius: var(--soeteck-radius-lg);
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }

  .home-scenario-card:hover {
    border-color: var(--soeteck-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  /* --- Media --- */

  .home-scenario-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .home-scenario-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .home-scenario-card:hover .home-scenario-card__media img {
    transform: scale(1.05);
  }

  /* --- Body --- */

  .home-scenario-card__body {
    padding: 24px;
  }

  .home-scenario-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  .home-scenario-card__tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--soeteck-primary-soft);
    color: var(--soeteck-primary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .home-scenario-card__title {
    margin: 0 0 8px;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--soeteck-text);
  }

  .home-scenario-card__text {
    margin: 0;
    font-size: var(--soeteck-text-sm);
    line-height: 1.65;
    color: var(--soeteck-text-soft);
  }

  /* --- Responsive --- */

  @media (max-width: 991px) {
    .home-scenarios__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .home-scenarios__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
