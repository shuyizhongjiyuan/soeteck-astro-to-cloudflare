---
/**
 * CaseCarouselSection — Framed full-screen case carousel (Variant C).
 * Section head on navy first, then the immersive carousel stage.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props {
  data: HomeContent['projects'];
}

const { data } = Astro.props;
const cards = data.cards;
---
<section class="home-case-carousel" aria-roledescription="carousel" aria-label={data.title}>
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="soeteck-eyebrow">{data.eyebrow}</p>
      <h2 class="home-section__title">{data.title}</h2>
      <p class="home-section__lead">{data.text}</p>
      {data.ctaAll && data.projectsAllLink && (
        <a href={data.projectsAllLink} class="home-case-carousel__all">{data.ctaAll} →</a>
      )}
    </div>
  </div>

  <div class="home-case-carousel__stage">
    {cards.map((card, i) => (
      <article class={`home-case-slide${i === 0 ? ' home-case-slide--active' : ''}`} data-index={String(i)} aria-hidden={i === 0 ? 'false' : 'true'}>
        <img class="home-case-slide__bg" src={card.image.path} alt="" width="1920" height="1080" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        <div class="home-case-slide__overlay"></div>
        <div class="soeteck-container home-case-slide__content">
          <p class="home-case-slide__location"><svg class="home-case-slide__pin" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 22s-7.5-5.6-7.5-11.5a7.5 7.5 0 1 1 15 0C19.5 16.4 12 22 12 22zM12 13.4a2.9 2.9 0 1 0 0-5.8 2.9 2.9 0 0 0 0 5.8z" fill="currentColor"/></svg>{card.location}</p>
          <h3 class="home-case-slide__title">{card.title}</h3>
          <p class="home-case-slide__text">{card.text}</p>
          <a href={card.ctaLink} class="home-case-slide__cta">{card.cta} →</a>
        </div>
      </article>
    ))}

    <button type="button" class="home-case-carousel__arrow home-case-carousel__arrow--prev" aria-label="Previous case"></button>
    <button type="button" class="home-case-carousel__arrow home-case-carousel__arrow--next" aria-label="Next case"></button>
    <div class="home-case-carousel__controls">
      <div class="home-case-carousel__thumbs">
        {cards.map((card, i) => (
          <button type="button" class={`home-case-carousel__thumb${i === 0 ? ' home-case-carousel__thumb--active' : ''}`} data-index={String(i)} aria-label={`Case ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'}>
            <img src={card.image.path} alt={card.title} width="120" height="72" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* ═══ CASE CAROUSEL — framed ════════════════════════════════ */
.home-case-carousel {
  background: var(--soeteck-navy);
  color: #fff;
}
.home-case-carousel :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

/* ── Section head ─────────────────────────────────────────── */
.home-section__head { max-width: 760px; margin: 0 auto 0; padding: clamp(48px, 6vw, 80px) 0 40px; text-align: center; }
/* 6.1 标准 Eyebrow — 元素只挂规范基类 .soeteck-eyebrow，此处仅覆盖间距（深色 section 沿用基类 primary 色） */
.home-section__head .soeteck-eyebrow { margin: 0 0 25px; padding: 0; }
.home-section__title { margin: 0; font-size: clamp(1.9rem, 3.2vw, 2.6rem); font-weight: 800; line-height: 1.12; color: #fff; }
.home-section__lead { margin: 14px auto 0; max-width: 620px; font-size: 1.05rem; line-height: 1.7; color: rgba(255, 255, 255, 0.78); }

/* ── View-all button ──────────────────────────────────────── */
.home-case-carousel__all {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 22px;
  padding: 12px 28px;
  border-radius: 999px;
  border: 1.5px solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: var(--soeteck-text-sm);
  font-weight: 600;
  text-decoration: none;
  transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
}
.home-case-carousel__all:hover {
  background: var(--soeteck-primary);
  border-color: var(--soeteck-primary);
}

/* ── Carousel stage ───────────────────────────────────────── */
.home-case-carousel__stage {
  position: relative;
  min-height: 690px;
  overflow: hidden;
}

/* ── Slides ───────────────────────────────────────────────── */
.home-case-slide {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.9s ease, visibility 0s linear 0.9s;
}
.home-case-slide--active {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.9s ease, visibility 0s linear 0s;
}
.home-case-slide__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.home-case-slide__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(8, 22, 43, 0.9) 0%, rgba(8, 22, 43, 0.55) 55%, rgba(8, 22, 43, 0.2) 100%),
    linear-gradient(180deg, rgba(8, 22, 43, 0.15) 0%, rgba(8, 22, 43, 0.5) 100%);
}
.home-case-slide__content {
  position: relative;
  z-index: 1;
  padding: 40px 0;
  color: #fff;
  max-width: 640px;
  margin-left: 0;
}

.home-case-slide__location {
  margin: 0 0 20px;
  font-size: var(--soeteck-text-sm);
  font-weight: 600;
  line-height: 1; /* 单行标签：消除行距半 leading 导致的文字偏上，使与 pin 几何居中一致 */
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--soeteck-primary);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.home-case-slide__pin {
  width: 15px;
  height: 15px;
  flex: 0 0 auto;
  color: var(--soeteck-primary);
}
.home-case-slide__title {
  margin: 0 0 14px;
  font-size: clamp(1.8rem, 3.4vw, 2.8rem);
  font-weight: 800;
  line-height: 1.15;
  color: #fff;
}
.home-case-slide__text {
  margin: 0 0 26px;
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.85);
}
.home-case-slide__cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 12px 28px;
  border-radius: 999px;
  background: var(--soeteck-primary);
  color: #fff;
  font-size: var(--soeteck-text-sm);
  font-weight: 600;
  text-decoration: none;
  transition: background 0.3s ease, transform 0.2s ease;
}
.home-case-slide__cta:hover {
  background: var(--soeteck-primary-dark);
  transform: translateY(-2px);
}

/* ── Controls ─────────────────────────────────────────────── */
.home-case-carousel__controls {
  position: absolute;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: 12px;
  background: rgba(8, 22, 43, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(8px);
}
.home-case-carousel__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 46px;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  border: 0;
  background: rgba(255, 255, 255, 0.84);
  opacity: 0.5;
  cursor: pointer;
  transition: background 160ms ease, opacity 160ms ease;
}
/* Chevron — same treatment as the product detail gallery arrows */
.home-case-carousel__arrow::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 11px;
  height: 11px;
  border-top: 2px solid #1d4f8f;
  border-right: 2px solid #1d4f8f;
}
.home-case-carousel__arrow:hover {
  background: #fff;
  opacity: 1;
}
.home-case-carousel__arrow--prev { left: 24px; }
.home-case-carousel__arrow--prev::before {
  transform: translate(-35%, -50%) rotate(-135deg);
}
.home-case-carousel__arrow--next { right: 24px; }
.home-case-carousel__arrow--next::before {
  transform: translate(-65%, -50%) rotate(45deg);
}
.home-case-carousel__thumbs {
  display: flex;
  gap: 10px;
  align-items: center;
}
.home-case-carousel__thumb {
  width: 120px;
  height: 72px;
  padding: 0;
  border-radius: 8px;
  overflow: hidden;
  border: 2px solid transparent;
  background: transparent;
  cursor: pointer;
  opacity: 0.55;
  transition: border-color 0.3s ease, opacity 0.3s ease, transform 0.2s ease;
}
.home-case-carousel__thumb img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.home-case-carousel__thumb:hover {
  opacity: 1;
  transform: translateY(-2px);
}
.home-case-carousel__thumb--active {
  border-color: var(--soeteck-primary);
  opacity: 1;
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 768px) {
  .home-case-carousel__stage { min-height: 480px; }
  .home-case-carousel__controls { bottom: 18px; padding: 6px 10px; }
  .home-case-carousel__thumbs { max-width: 200px; overflow-x: auto; }
  .home-case-carousel__thumb { width: 76px; height: 46px; flex-shrink: 0; }
  .home-case-carousel__arrow--prev { left: 12px; }
  .home-case-carousel__arrow--next { right: 12px; }
}
@media (prefers-reduced-motion: reduce) {
  .home-case-slide { transition: opacity 0.2s ease; }
}
</style>

<script is:inline>
(function () {
  var section = document.querySelector('.home-case-carousel');
  if (!section) return;

  var slides = section.querySelectorAll('.home-case-slide');
  var thumbs = section.querySelectorAll('.home-case-carousel__thumb');
  if (slides.length === 0) return;

  var current = 0;
  var total   = slides.length;
  var reduce  = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function goTo(index) {
    if (index === current) return;
    slides[current].classList.remove('home-case-slide--active');
    slides[current].setAttribute('aria-hidden', 'true');
    thumbs[current].classList.remove('home-case-carousel__thumb--active');
    thumbs[current].setAttribute('aria-selected', 'false');
    current = index;
    slides[current].classList.add('home-case-slide--active');
    slides[current].setAttribute('aria-hidden', 'false');
    thumbs[current].classList.add('home-case-carousel__thumb--active');
    thumbs[current].setAttribute('aria-selected', 'true');
  }

  section.querySelector('.home-case-carousel__arrow--prev').addEventListener('click', function () {
    goTo((current - 1 + total) % total);
  });
  section.querySelector('.home-case-carousel__arrow--next').addEventListener('click', function () {
    goTo((current + 1) % total);
  });
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      goTo(parseInt(thumb.getAttribute('data-index'), 10));
    });
  });

  if (reduce) return;
  var timer = setInterval(function () {
    goTo((current + 1) % total);
  }, 6000);
  section.addEventListener('mouseenter', function () { clearInterval(timer); });
  section.addEventListener('mouseleave', function () {
    timer = setInterval(function () { goTo((current + 1) % total); }, 6000);
  });
})();
</script>
