---
import type { AdaptedPage } from '@/lib/page-adapter';
import NewsArchiveHero from './NewsArchiveHero.astro';
import NewsroomFeaturedSlider from './NewsroomFeaturedSlider.astro';
import NewsroomPressList from './NewsroomPressList.astro';
import NewsroomSidebar from './NewsroomSidebar.astro';
import ArchiveCta from '@/components/article-archive/ArchiveCta.astro';
import { ARCHIVE_EN } from './news-releases-content';
import { ARCHIVE_ZH } from './news-releases-content-zh';
import { ARCHIVE_RU } from './news-releases-content-ru';
import { ARCHIVE_PT } from './news-releases-content-pt';
import { ARCHIVE_ES } from './news-releases-content-es';
import type { ArchiveContent } from './news-releases-content';

interface Props {
  page: AdaptedPage;
  lang?: string;
}

const { page, lang = 'en' } = Astro.props;

const contentMap: Record<string, ArchiveContent> = {
  en: ARCHIVE_EN,
  zh: ARCHIVE_ZH,
  ru: ARCHIVE_RU,
  pt: ARCHIVE_PT,
  es: ARCHIVE_ES,
};
const archiveContent = contentMap[lang] ?? ARCHIVE_EN;

// 根据页面类型选择英雄区配置
const normalizedPath = page.routePath.replace(/^\/[a-z]{2}\//, '/');
const heroConfig = normalizedPath.startsWith('/news-and-insights/blogs')
  ? archiveContent.blogs
  : normalizedPath.startsWith('/news-and-insights/client-case-studies')
    ? archiveContent.caseStudies
    : archiveContent.newsReleases;

const featuredIds = new Set(page.featuredArticles.map((article) => article.id).filter((id): id is number => typeof id === 'number'));
const pressArticles = page.articles.filter((article) => !featuredIds.has(article.id ?? -1));
const fallbackPressArticles = pressArticles.length > 0 ? pressArticles : page.articles;
const featuredArticles = page.featuredArticles.length > 0 ? page.featuredArticles : page.articles.slice(0, 3);
const description = page.source.archive?.description || heroConfig.description;
---
<div class="soeteck-news-releases-page">
  <NewsArchiveHero breadcrumbs={page.breadcrumbs} title={page.title || heroConfig.title} description={description} lang={lang} heroConfig={heroConfig} />
  <section class="soeteck-container soeteck-news-releases-page__container">
    <div class="newsroom-layout">
      <div class="newsroom-layout__main">
        <NewsroomFeaturedSlider articles={featuredArticles} lang={lang} />
        <NewsroomPressList articles={fallbackPressArticles} lang={lang} />
      </div>
      <NewsroomSidebar lang={lang} />
    </div>
  </section>

  <ArchiveCta
    title={archiveContent.cta.title}
    buttonLabel={archiveContent.cta.buttonLabel}
    buttonHref={`/${lang}/contact-us/`}
    lang={lang}
  />
</div>

<style>
  .soeteck-news-releases-page {
    background: var(--soeteck-white);
  }

  .soeteck-news-releases-page__container {
    padding: var(--soeteck-section-y-sm) 0 var(--soeteck-section-y);
  }

  .newsroom-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .newsroom-layout__main {
    min-width: 0;
  }

  @media (max-width: 991px) {
    .newsroom-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
