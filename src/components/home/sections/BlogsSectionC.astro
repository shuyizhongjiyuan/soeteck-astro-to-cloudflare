---
/**
 * BlogsSectionC — Blogs section (Variant C).
 * Surface background to alternate with news section, 3-col grid of latest blog posts.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';
import type { AdaptedArticleCard } from '@/lib/page-adapter';

interface Props {
  newsC: NonNullable<HomeContent['newsC']>;
  articles: AdaptedArticleCard[];
  lang: string;
}

const { newsC, articles, lang } = Astro.props;
void lang;

function formatDate(d: string | null): string {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
  catch { return d; }
}
---

<section class="home-blogs-c" aria-labelledby="blogs-c-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="home-section__eyebrow">{newsC.blogEyebrow}</p>
      <h2 id="blogs-c-title" class="home-section__title">{newsC.blogTitle}</h2>
    </div>

    <div class="home-blogs-c__grid">
      {articles.length > 0 ? articles.map((article) => (
        <a href={article.path} class="home-blogs-c__card">
          {article.featuredImage && (
            <div class="home-blogs-c__media">
              <img src={article.featuredImage.path} alt="" width="400" height="225" loading="lazy" decoding="async" />
            </div>
          )}
          <div class="home-blogs-c__body">
            {article.date && <time class="home-blogs-c__date">{article.date}</time>}
            <span class="home-blogs-c__title">{article.title}</span>
            {article.excerpt && <p class="home-blogs-c__excerpt">{article.excerpt}</p>}
            <span class="home-blogs-c__cta">Read →</span>
          </div>
        </a>
      )) : (
        <p class="home-blogs-c__empty">No articles yet.</p>
      )}
    </div>

    <div class="home-blogs-c__footer">
      <a href={newsC.blogLink} class="home-blogs-c__view-all">{newsC.viewAllBlogs}</a>
    </div>
  </div>
</section>

<style>
.home-blogs-c {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-surface);
}
.home-blogs-c :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
.home-section__eyebrow { margin: 0 0 10px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(1.85rem, 3.1vw, 2.5rem); font-weight: 700; line-height: 1.14; color: var(--soeteck-text); }

.home-blogs-c__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.home-blogs-c__card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  border-bottom: 1px solid var(--soeteck-border-soft);
  padding-bottom: 20px;
}
.home-blogs-c__card:last-child { border-bottom: none; padding-bottom: 0; }

.home-blogs-c__media {
  aspect-ratio: 16 / 9;
  border-radius: 10px;
  overflow: hidden;
  background: var(--soeteck-media-bg);
  margin-bottom: 14px;
}
.home-blogs-c__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.home-blogs-c__card:hover .home-blogs-c__media img { transform: scale(1.04); }

.home-blogs-c__body { display: flex; flex-direction: column; }
.home-blogs-c__date { font-size: 12px; font-weight: 600; color: var(--soeteck-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
.home-blogs-c__title { font-size: 16px; font-weight: 600; color: var(--soeteck-text); line-height: 1.35; transition: color 0.25s ease; }
.home-blogs-c__card:hover .home-blogs-c__title { color: var(--soeteck-primary); }
.home-blogs-c__excerpt { margin: 6px 0 0; font-size: 13px; line-height: 1.6; color: var(--soeteck-text-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.home-blogs-c__cta { margin-top: 10px; font-size: 13px; font-weight: 600; color: var(--soeteck-primary); transition: transform 0.2s ease; }
.home-blogs-c__card:hover .home-blogs-c__cta { transform: translateX(3px); }

.home-blogs-c__footer { text-align: center; margin-top: 40px; }
.home-blogs-c__view-all { display: inline-flex; padding: 12px 28px; border-radius: 999px; border: 1.5px solid var(--soeteck-primary); color: var(--soeteck-primary); font-size: 14px; font-weight: 600; text-decoration: none; transition: background 0.3s ease, color 0.3s ease, transform 0.2s ease; }
.home-blogs-c__view-all:hover { background: var(--soeteck-primary); color: #fff; transform: translateY(-1px); }
.home-blogs-c__empty { font-size: 14px; color: var(--soeteck-muted); font-style: italic; }

@media (max-width: 991px) {
  .home-blogs-c__grid { grid-template-columns: 1fr; }
}
</style>