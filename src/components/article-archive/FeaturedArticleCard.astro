---
import type { AdaptedArticleCard } from '@/lib/page-adapter';

interface Props {
  article: AdaptedArticleCard;
  /** Label above the title, e.g. "Featured article" or "Featured case study" */
  label: string;
  /** Text for the read-more link */
  readMoreLabel: string;
  /** Language code for date formatting */
  lang?: string;
}

const { article, label, readMoreLabel, lang = 'en' } = Astro.props;

const dateLocale = lang === 'zh' ? 'zh-CN' : lang === 'ru' ? 'ru-RU' : lang === 'pt' ? 'pt-PT' : lang === 'es' ? 'es-ES' : 'en-US';
const dateStr = article.date
  ? new Date(article.date).toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---

<article class="featured-card">
  <a href={article.path} class="featured-card__link">
    <span class="featured-card__media">
      {article.featuredImage ? (
        <img
          src={article.featuredImage.path}
          alt={article.featuredImage.alt || article.title}
          class="featured-card__image"
          loading="eager"
          decoding="async"
        />
      ) : (
        <span class="featured-card__media featured-card__media--empty" aria-hidden="true"></span>
      )}
    </span>
    <span class="featured-card__body">
      <span class="featured-card__label">{label}</span>
      {dateStr && <time class="featured-card__date" datetime={article.date ?? ''}>{dateStr}</time>}
      <h3 class="featured-card__title">{article.title}</h3>
      {article.excerpt && <p class="featured-card__excerpt">{article.excerpt}</p>}
      <span class="featured-card__cta">{readMoreLabel}</span>
    </span>
  </a>
</article>

<style>
  .featured-card {
    overflow: hidden;
    background: var(--soeteck-white);
    border: 1px solid var(--soeteck-border-soft);
    border-radius: var(--soeteck-radius-lg);
    box-shadow: var(--soeteck-shadow);
    margin-bottom: clamp(34px, 5vw, 72px);
  }

  .featured-card__link {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    min-height: 390px;
    color: inherit;
    text-decoration: none;
  }

  .featured-card__media {
    display: block;
    overflow: hidden;
    background: var(--soeteck-media-bg);
    min-height: 390px;
  }

  .featured-card__media--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--soeteck-muted);
  }

  .featured-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .featured-card:hover .featured-card__image {
    transform: scale(1.03);
  }

  .featured-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 4vw, 48px);
    gap: 14px;
  }

  .featured-card__label {
    display: inline-flex;
    align-self: flex-start;
    padding: 4px 14px;
    border: 1px solid var(--soeteck-primary);
    border-radius: 999px;
    color: var(--soeteck-primary);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .featured-card__date {
    color: var(--soeteck-muted);
    font-size: var(--soeteck-text-sm);
    line-height: 1.4;
  }

  .featured-card__title {
    margin: 0;
    color: var(--soeteck-text);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .featured-card__excerpt {
    display: -webkit-box;
    margin: 0;
    color: var(--soeteck-text-soft);
    font-size: var(--soeteck-text-sm);
    overflow: hidden;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .featured-card__cta {
    display: inline-flex;
    align-self: flex-start;
    margin-top: 8px;
    color: var(--soeteck-primary);
    font-size: var(--soeteck-text-md);
    font-weight: 600;
    line-height: 1.2;
    transition: color var(--soeteck-transition-fast);
  }

  .featured-card:hover .featured-card__cta {
    color: var(--soeteck-primary-dark);
  }

  @media (max-width: 991px) {
    .featured-card__link {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .featured-card__media {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }

  }
</style>