---
/**
 * Preview page for Homepage Variant C — Visual Impact
 * Access: http://localhost:4321/preview-home-c/
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePage from '@/components/home/HomePage.astro';
import type { AdaptedPage } from '@/lib/page-adapter';

const lang = 'en';

// Create a minimal page object for preview
const page: AdaptedPage = {
  id: null,
  kind: 'generic' as const,
  routeType: 'page' as const,
  routePath: '/preview-home-c/',
  language: lang,
  title: 'Preview: Homepage Variant C',
  seo: { title: 'Preview Homepage Variant C', canonical: '', robots: 'noindex' },
  breadcrumbs: [{ label: 'Home', path: '/en/' }, { label: 'Preview C', path: '/preview-home-c/' }],
  heroImage: null,
  contentHtml: '',
  media: [],
  article: null,
  articles: [],
  featuredArticles: [],
  source: {} as any,
};
---

<BaseLayout title="Preview: Homepage Variant C — Visual Impact" lang={lang} canonical="https://soeteck.com/preview-home-c/">
  <HomePage page={page} lang={lang} variant="C" />
</BaseLayout>
