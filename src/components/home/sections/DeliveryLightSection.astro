---
/**
 * DeliveryLightSection — Lightweight delivery cards (Variant C only).
 * Icon + text cards in a horizontally scrollable snap track.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props {
  data: HomeContent['timeline'];
}

const { data } = Astro.props;
---

<section class="home-delivery-light" aria-labelledby="delivery-light-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="home-section__eyebrow">{data.eyebrow}</p>
      <h2 id="delivery-light-title" class="home-section__title">{data.title}</h2>
      <p class="home-section__lead">{data.text}</p>
    </div>
    <div class="home-delivery-light__track">
      {data.steps.map((step) => (
        <div class="home-delivery-light__card">
          <div class="home-delivery-light__icon">
            {step.icon === 'design' && <svg viewBox="0 0 32 32" fill="none"><path d="M5 27l4-1 16-16-3-3L6 23l-1 4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M21 7l3 3" stroke="currentColor" stroke-width="2"/></svg>}
            {step.icon === 'manufacture' && <svg viewBox="0 0 32 32" fill="none"><path d="M4 28V16l7 4v-5l7 4V9h7v19H4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M10 28v-6M16 28v-8M22 28v-6M28 28H4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
            {step.icon === 'integrate' && <svg viewBox="0 0 32 32" fill="none"><rect x="5" y="5" width="8" height="8" rx="2" stroke="currentColor" stroke-width="2"/><rect x="19" y="19" width="8" height="8" rx="2" stroke="currentColor" stroke-width="2"/><path d="M13 9h8M23 9a3 3 0 013 3v7M9 23h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
            {step.icon === 'test' && <svg viewBox="0 0 32 32" fill="none"><path d="M16 5l9 4v7c0 5-4 9-9 12-5-3-9-7-9-12V9l9-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 16l3 3 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
            {step.icon === 'ship' && <svg viewBox="0 0 32 32" fill="none"><path d="M6 10h12l6 6h-4l-4-4H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M6 16h20v5H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 21l2 4M16 21l2 4M24 21l-2 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
            {step.icon === 'install' && <svg viewBox="0 0 32 32" fill="none"><path d="M21 7a6 6 0 00-8 5L7 18v3l4 4h3l6-6a6 6 0 005-8l-3 3-3-3 3-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>}
          </div>
          <span class="home-delivery-light__num">{step.num}</span>
          <h3 class="home-delivery-light__title">{step.title}</h3>
          <p class="home-delivery-light__text">{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
/* ═══ DELIVERY LIGHT — horizontal snap cards ═════════════════ */
.home-delivery-light {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-surface);
}
.home-delivery-light :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

/* ── Section head ─────────────────────────────────────────── */
.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
.home-section__eyebrow { margin: 0 0 30px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(1.85rem, 3.1vw, 2.5rem); font-weight: 700; line-height: 1.14; color: var(--soeteck-text); }
.home-section__lead { margin: 18px 0 0; font-size: 1.05rem; line-height: 1.7; color: var(--soeteck-text-soft); }

/* ── Horizontal snap track ────────────────────────────────── */
.home-delivery-light__track {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 12px;
  scrollbar-width: thin;
  scrollbar-color: var(--soeteck-primary) transparent;
}
.home-delivery-light__track::-webkit-scrollbar { height: 8px; }
.home-delivery-light__track::-webkit-scrollbar-track { background: transparent; }
.home-delivery-light__track::-webkit-scrollbar-thumb {
  background: var(--soeteck-border);
  border-radius: 999px;
}
.home-delivery-light__track::-webkit-scrollbar-thumb:hover { background: var(--soeteck-primary); }

.home-delivery-light__card {
  flex: 0 0 230px;
  scroll-snap-align: start;
  padding: 28px 22px;
  background: var(--soeteck-white);
  border: 1px solid var(--soeteck-border-soft);
  border-radius: var(--soeteck-radius-lg);
  transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
}
.home-delivery-light__card:hover {
  border-color: var(--soeteck-primary);
  box-shadow: 0 8px 28px rgba(0, 102, 204, 0.08);
  transform: translateY(-3px);
}

.home-delivery-light__icon {
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--soeteck-radius-md);
  background: var(--soeteck-primary-soft);
  color: var(--soeteck-primary);
  margin-bottom: 16px;
}
.home-delivery-light__icon :global(svg) { width: 28px; height: 28px; }

.home-delivery-light__num {
  display: block;
  margin-bottom: 6px;
  font-size: var(--soeteck-text-xs);
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--soeteck-muted);
}
.home-delivery-light__title {
  margin: 0 0 8px;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--soeteck-text);
  line-height: 1.3;
}
.home-delivery-light__text {
  margin: 0;
  font-size: var(--soeteck-text-sm);
  line-height: 1.6;
  color: var(--soeteck-text-soft);
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 640px) {
  .home-delivery-light__card { flex-basis: 200px; }
}
</style>
