---
import type { AdaptedPage, PageImage } from '@/lib/page-adapter';
import { getUITranslation } from '@/lib/translations';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { CONTACT_EN, type ContactContent, COUNTRIES } from './contact-content';
import { CONTACT_ZH } from './contact-content-zh';
import { CONTACT_RU } from './contact-content-ru';
import { CONTACT_PT } from './contact-content-pt';
import { CONTACT_ES } from './contact-content-es';

export interface Props {
  page: AdaptedPage;
  lang: string;
}

const { page, lang } = Astro.props;
const t = (key: string): string => getUITranslation(lang, key);

const contentMap: Record<string, ContactContent> = {
  en: CONTACT_EN,
  zh: CONTACT_ZH,
  ru: CONTACT_RU,
  pt: CONTACT_PT,
  es: CONTACT_ES,
};
const c = contentMap[lang] ?? CONTACT_EN;
const countries = COUNTRIES;

// Contact data — try ACF option 'company_contact_data' first, then page contentHtml, then fallback defaults
const contactData = page.sections?.contact ?? {};
const email = contactData.email || (page.sections?.company_contact_data?.email) || (page.sections?.email) || 'sales@soeteck.com';
const phoneLabel = contactData.phone_label || (page.sections?.company_contact_data?.phone_label) || 'WhatsApp/Tel';
const phone = contactData.phone || (page.sections?.company_contact_data?.phone) || '+86 18155158620';
const phoneUri = String(phone).replace(/[^0-9+]/g, '');
const wechat = contactData.wechat || (page.sections?.company_contact_data?.wechat) || '18155158620';
const address = contactData.address || (page.sections?.company_contact_data?.address) || 'Floor 21, Building 8, China Sound Valley, No. 3333, Xiyou Road, Hefei, China';
const addressUrl = contactData.address_url || (page.sections?.company_contact_data?.address_url) || '';
const mapEmbed = contactData.map_embed || (page.sections?.company_contact_data?.map_embed) || '';
// ACF Option 的 inquiry_default_intro / inquiry_submit_label 是单语言字段（恒存英文值），
// 非英文语言若直接使用会露出英文 → 英文保留 ACF 编辑入口，非英文走多语言文案。
// intro 文案暂内联（shared.json 正被其他窗口重构，稳定后可迁 common.inquiryIntro）；
// submitLabel 复用既有 product.formSubmit。
const inquiryIntroMap: Record<string, string> = {
  en: 'Tell us your industry and interests for tailored solutions and quotes.',
  zh: '请告诉我们您的行业与需求，我们将为您提供定制方案与报价。',
  ru: 'Расскажите о вашей отрасли и задачах — мы подготовим индивидуальное решение и предложение.',
  pt: 'Conte-nos seu setor e suas necessidades para soluções e cotações personalizadas.',
  es: 'Cuéntenos su sector y sus necesidades para ofrecerle soluciones y cotizaciones a medida.',
};
const intro = lang === 'en'
  ? (contactData.inquiry_default_intro || (page.sections?.company_contact_data?.inquiry_default_intro) || inquiryIntroMap.en)
  : (inquiryIntroMap[lang] || inquiryIntroMap.en);
const submitLabel = lang === 'en'
  ? (contactData.inquiry_submit_label || (page.sections?.company_contact_data?.inquiry_submit_label) || 'Submit')
  : t('product.formSubmit');
const socials = contactData.socials || (page.sections?.company_contact_data?.socials) || {};

// hero 背景图：优先 ACF「Hero Background Image」(page.sections.heroImage)，兜底页面特色图(page.heroImage)。
// replace 剥掉可能的 cms.soeteck.com 域名，统一成 /resources/ 相对路径（与解决方案页同款，ADR-020）。
const heroField = page.sections?.heroImage?.replace(/^https?:\/\/[^/]+/, '');
const contactHeroImage: PageImage | null = heroField ? { path: heroField, alt: '' } : page.heroImage;
---

<div class="soeteck-contact-page">
    <!-- Hero Section -->
    <section class="soeteck-contact-hero" aria-labelledby="soeteck-contact-title">
      {contactHeroImage && (
        <img
          class="soeteck-contact-hero__image"
          src={contactHeroImage.path}
          alt={contactHeroImage.alt || ''}
          fetchpriority="high"
          loading="eager"
        />
      )}
      <div class="soeteck-contact-hero__overlay" aria-hidden="true"></div>
      <div class="soeteck-container soeteck-contact-hero__content">
        <Breadcrumbs items={page.breadcrumbs} class="soeteck-breadcrumbs--hero" lang={lang} />
        <div class="soeteck-contact-hero__body">
          <h1 id="soeteck-contact-title" class="soeteck-page-title">{t('product.contactSoeteck')}</h1>
          <p>{c.heroDesc}</p>
        </div>
      </div>
    </section>

    <!-- Main Grid: Form + Contact Info -->
    <section class="soeteck-contact-main soeteck-section-light" aria-labelledby="soeteck-contact-form-title">
      <div class="soeteck-container">
        <div class="soeteck-contact-main__grid">
          <div class="soeteck-contact-form-card soeteck-card">
            <h2 id="soeteck-contact-form-title" class="soeteck-section-title">{c.formTitle}</h2>
            <form class="soeteck-contact-form" data-contact-form data-i18n-pending={t('common.submitting')} data-i18n-error={t('common.submitFailed')} data-i18n-nofiles={t('product.noFilesSelected')} data-i18n-remove={t('common.removeFile')} aria-describedby="soeteck-contact-form-note">
              <div class="soeteck-contact-form__grid">
                <label>
                  <input type="text" name="name" autocomplete="name" placeholder={t('product.formYourName')} aria-label={t('product.formYourName')} />
                </label>
                <label>
                  <input type="text" name="company" autocomplete="organization" placeholder={t('product.formCompany')} aria-label={t('product.formCompany')} />
                </label>
                <div class="soeteck-contact-form__country-wrap">
                  <div class="soeteck-country-select" data-country-select>
                    <button type="button" class="soeteck-country-select__trigger" data-country-trigger aria-haspopup="listbox" aria-expanded="false">
                      <span class="soeteck-country-select__placeholder" data-country-placeholder>{t('product.formCountryPlaceholder')}</span>
                      <svg class="soeteck-country-select__arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div class="soeteck-country-select__dropdown" data-country-dropdown role="listbox" aria-label={t('product.formCountry')}>
                      <div class="soeteck-country-select__search-wrap">
                        <svg class="soeteck-country-select__search-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                          <circle cx="6.5" cy="6.5" r="5.5" stroke="currentColor" stroke-width="1.3"/>
                          <path d="M10.5 10.5L13 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                        </svg>
                        <input type="text" class="soeteck-country-select__search" data-country-search placeholder={t('common.searchCountries')} autocomplete="off">
                      </div>
                      <div class="soeteck-country-select__list" data-country-list>
                        {countries.map((c, i) => (
                          <button type="button" class="soeteck-country-select__option" role="option" data-country-value={c.code} data-country-name={c.name} data-index={i}>
                            <span class="soeteck-country-select__flag"><img src={c.flagUrl} alt="" width="20" height="15" loading="lazy"></span>
                            <span class="soeteck-country-select__name">{c.name}</span>
                          </button>
                        ))}
                      </div>
                    </div>
                  </div>
                  <!-- 隐藏的原生 select，用于表单提交 -->
                  <select name="country" data-country-native hidden aria-hidden="true">
                    <option value="">{t('product.formCountryPlaceholder')}</option>
                    {countries.map(c => (
                      <option value={c.name} data-country-code={c.code}>{c.name}</option>
                    ))}
                  </select>
                </div>
                <label>
                  <input type="tel" name="phone" autocomplete="tel" placeholder={t('product.formPhone')} aria-label={t('product.formPhone')} />
                </label>
                <label>
                  <input type="email" name="email" autocomplete="email" placeholder={t('product.formEmail')} aria-label={t('product.formEmail')} />
                </label>
                <label>
                  <input type="tel" name="whatsapp" placeholder={t('product.formWhatsapp')} aria-label={t('product.formWhatsapp')} />
                </label>
                <label class="soeteck-contact-form__wide">
                  <input type="text" name="subject" placeholder={t('product.formSubject')} aria-label={t('product.formSubject')} />
                </label>
                <label class="soeteck-contact-form__wide">
                  <textarea name="message" rows={6} placeholder={intro} aria-label={t('product.formMessage')}></textarea>
                </label>
              </div>

              <div class="soeteck-contact-form__upload-switch">
                <span class="soeteck-contact-form__upload-switch-inner">
                  <span class="soeteck-contact-form__upload-switch-label">{t('product.formUploadPrompt')}</span>
                  <label class="soeteck-contact-form__upload-switch-track" aria-label={t('product.formUploadPrompt')}>
                    <input type="checkbox" class="soeteck-contact-form__upload-switch-input" data-upload-toggle role="switch" aria-checked="false" />
                    <span class="soeteck-contact-form__upload-switch-knob"></span>
                  </label>
                </span>
                <!-- Hidden radios for form submission -->
                <input type="radio" name="needs_file_upload" value="yes" data-upload-yes hidden />
                <input type="radio" name="needs_file_upload" value="no" data-upload-no checked hidden />
              </div>

              <div class="soeteck-contact-form__file" aria-hidden="true">
                <span class="soeteck-contact-form__file-label">{t('product.uploadFiles')}</span>
                <span class="soeteck-contact-form__file-control">
                  <span class="soeteck-contact-form__file-actions">
                    <button class="soeteck-contact-form__file-add" type="button" data-file-trigger tabindex="-1">
                      <span class="soeteck-contact-form__file-icon" aria-hidden="true">+</span>
                      <span class="soeteck-contact-form__file-action">{t('product.addFiles')}</span>
                    </button>
                    <button type="button" class="soeteck-contact-form__file-clear" data-file-clear hidden>{t('archive.clearAll')}</button>
                  </span>
                  <span class="soeteck-contact-form__file-name" data-file-list>{t('product.noFilesSelected')}</span>
                </span>
                <input type="file" name="file_upload[]" multiple tabindex="-1" />
              </div>

              <button class="soeteck-button soeteck-button-primary" type="submit">{submitLabel}</button>

              <p id="soeteck-contact-form-note" class="soeteck-contact-form__note" hidden>
                {t('product.formSubmitPending')}
              </p>
            </form>
          </div>

          <aside class="soeteck-contact-info-card" aria-labelledby="soeteck-contact-info-title">
            <h2 id="soeteck-contact-info-title" class="soeteck-section-title">{t('product.letsTalk')}</h2>
            <p>{t('product.contactDescription')}</p>
            <dl class="soeteck-contact-methods">
              {email && (
                <div>
                  <dt>{c.emailLabel}</dt>
                  <dd><a href={`mailto:${email}`}>{email}</a></dd>
                </div>
              )}
              {phone && (
                <div>
                  <dt>{phoneLabel}:</dt>
                  <dd><a href={`tel:${phoneUri}`}>{phone}</a></dd>
                </div>
              )}
              {wechat && (
                <div>
                  <dt>{c.wechatLabel}</dt>
                  <dd>{wechat}</dd>
                </div>
              )}
              {address && (
                <div>
                  <dt>{c.addressLabel}</dt>
                  <dd>
                    {addressUrl ? (
                      <a href={addressUrl} target="_blank" rel="noopener noreferrer">{address}</a>
                    ) : (
                      address
                    )}
                  </dd>
                </div>
              )}
            </dl>

            <div class="soeteck-contact-socials" aria-label="Social media">
              <h3 class="soeteck-card-title">{t('product.followUs')}</h3>
              <ul class="soeteck-contact-socials__list">
                <li><a href="https://www.linkedin.com/company/soeteck" target="_blank" rel="noopener noreferrer" class="soeteck-contact-socials__link soeteck-contact-socials__link--linkedin">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  <span>LinkedIn</span>
                </a></li>
                <li><a href="https://www.facebook.com/soeteck123/" target="_blank" rel="noopener noreferrer" class="soeteck-contact-socials__link soeteck-contact-socials__link--facebook">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  <span>Facebook</span>
                </a></li>
                <li><a href="https://www.youtube.com/@Soeteck" target="_blank" rel="noopener noreferrer" class="soeteck-contact-socials__link soeteck-contact-socials__link--youtube">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  <span>YouTube</span>
                </a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Map Section -->
    <section class="soeteck-contact-location" aria-labelledby="soeteck-contact-location-title">
      <div class="soeteck-container">
        <h2 id="soeteck-contact-location-title" class="soeteck-section-title">{t('product.ourLocation')}</h2>
        <div class="soeteck-contact-location__frame">
          {mapEmbed ? (
            <div set:html={mapEmbed}></div>
          ) : (
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4021.491121228908!2d117.12300999999998!3d31.818560000000005!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x35cc9f74f8fbc68b%3A0x63b8196145222c2f!2sChina%20Speech%20Vly.%20Ev%20Charging%20Stn.!5e1!3m2!1sen!2sus!4v1784801348119!5m2!1sen!2sus"
              width="100%"
              height="420"
              style="border:0;display:block;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Soeteck location on Google Maps"
            ></iframe>
          )}
        </div>
      </div>
    </section>
</div>

<script>
  import { submitContactForm } from '@/lib/inquiry-form';

  // 模板经 data-i18n-* 注入的翻译值（SSR 已按语言渲染）
  const i18n = (document.querySelector<HTMLElement>('[data-contact-form]'))?.dataset ?? {};

  document.querySelector<HTMLFormElement>('[data-contact-form]')
    ?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const note = document.getElementById('soeteck-contact-form-note');
      const submitBtn = form.querySelector<HTMLButtonElement>('[type="submit"]');
      const fileInput = form.querySelector<HTMLInputElement>('input[type="file"][name="file_upload[]"]');

      // Loading state
      submitBtn!.disabled = true;
      submitBtn!.classList.add('is-loading');
      note!.hidden = false;
      note!.textContent = i18n.i18nPending || 'Submitting your inquiry...';

      try {
        await submitContactForm(form, fileInput);
        // submitContactForm handles redirect on success
      } catch (err: any) {
        note!.textContent = err.message || i18n.i18nError || 'Submission failed. Please try again or contact us directly.';
        note!.classList.add('soeteck-contact-form__note--error');
        submitBtn!.disabled = false;
        submitBtn!.classList.remove('is-loading');
      }
    });

  // 文件上传开关切换逻辑
  document.querySelector<HTMLInputElement>('[data-upload-toggle]')
    ?.addEventListener('change', function () {
      const fileSection = document.querySelector<HTMLElement>('.soeteck-contact-form__file');
      const inputYes = document.querySelector<HTMLInputElement>('[data-upload-yes]');
      const inputNo = document.querySelector<HTMLInputElement>('[data-upload-no]');
      const isChecked = this.checked;
      if (fileSection) {
        fileSection.classList.toggle('is-visible', isChecked);
      }
      if (inputYes) inputYes.checked = isChecked;
      if (inputNo) inputNo.checked = !isChecked;
    });

  // 文件芯片交互
  const fileInput = document.querySelector<HTMLInputElement>('input[type="file"][name="file_upload[]"]');
  const fileTrigger = document.querySelector<HTMLButtonElement>('[data-file-trigger]');
  const fileList = document.querySelector<HTMLElement>('[data-file-list]');
  const fileClear = document.querySelector<HTMLButtonElement>('[data-file-clear]');
  const fileSection = document.querySelector<HTMLElement>('.soeteck-contact-form__file');
  let pendingFiles: File[] = [];

  fileTrigger?.addEventListener('click', () => {
    // Save current files before opening file dialog
    pendingFiles = Array.from(fileInput?.files || []);
    fileInput!.value = ''; // Clear so same file can be re-selected
    fileInput?.click();
  });

  function mergeFiles(existing: File[], incoming: FileList | null): File[] {
    const incomingArr = Array.from(incoming || []);
    // Avoid duplicates by name + size
    const existingNames = new Set(existing.map(f => `${f.name}-${f.size}`));
    const newFiles = incomingArr.filter(f => !existingNames.has(`${f.name}-${f.size}`));
    return [...existing, ...newFiles];
  }

  function updateFileInput(allFiles: File[]): void {
    const dt = new DataTransfer();
    allFiles.forEach(f => dt.items.add(f));
    fileInput!.files = dt.files;
  }

  function refreshFileChips(): void {
    const allFiles = Array.from(fileInput?.files || []);
    if (allFiles.length === 0) {
      if (fileList) fileList.textContent = i18n.i18nNofiles || 'No files selected';
      if (fileClear) fileClear.hidden = true;
      fileSection?.classList.remove('has-file');
      return;
    }
    const chips = allFiles.map((f, i) => {
      return `<span class="soeteck-contact-form__file-chip" data-chip-index="${i}">
        <span class="soeteck-contact-form__file-chip-name">${f.name}</span>
        <button type="button" class="soeteck-contact-form__file-remove" data-chip-remove="${i}" aria-label="${(i18n.i18nRemove || 'Remove {name}').replace('{name}', f.name)}">×</button>
      </span>`;
    }).join('');
    if (fileList) fileList.innerHTML = chips;
    if (fileClear) fileClear.hidden = false;
    fileSection?.classList.add('has-file');

    // Bind individual remove buttons
    document.querySelectorAll<HTMLButtonElement>('[data-chip-remove]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const index = parseInt(btn.getAttribute('data-chip-remove') || '0');
        const remaining = Array.from(fileInput!.files || []).filter((_, i) => i !== index);
        updateFileInput(remaining);
        refreshFileChips();
      });
    });
  }

  fileInput?.addEventListener('change', () => {
    const merged = mergeFiles(pendingFiles, fileInput?.files || null);
    updateFileInput(merged);
    pendingFiles = [];
    refreshFileChips();
  });

  // Clear all button
  fileClear?.addEventListener('click', () => {
    updateFileInput([]);
    refreshFileChips();
  });

  // -------- 自定义国家选择器 --------
  class CountrySelect {
    private root: HTMLElement;
    private trigger: HTMLButtonElement;
    private dropdown: HTMLElement;
    private placeholder: HTMLElement;
    private nativeSelect: HTMLSelectElement;
    private searchInput: HTMLInputElement;
    private list: HTMLElement;
    private options: HTMLElement[];
    private visibleOptions: HTMLElement[];
    private selectedCode: string = '';
    private isOpen: boolean = false;
    private activeIndex: number = -1;

    constructor(root: HTMLElement) {
      this.root = root;
      this.trigger = root.querySelector<HTMLButtonElement>('[data-country-trigger]')!;
      this.dropdown = root.querySelector<HTMLElement>('[data-country-dropdown]')!;
      this.placeholder = root.querySelector<HTMLElement>('[data-country-placeholder]')!;
      this.nativeSelect = root.querySelector<HTMLSelectElement>('[data-country-native]')!;
      this.searchInput = root.querySelector<HTMLInputElement>('[data-country-search]')!;
      this.list = root.querySelector<HTMLElement>('[data-country-list]')!;
      this.options = Array.from(root.querySelectorAll<HTMLElement>('[data-country-value]'));
      this.visibleOptions = [...this.options];

      this.bindEvents();
      this.close();
    }

    private bindEvents(): void {
      this.trigger.addEventListener('click', () => this.toggle());

      document.addEventListener('click', (e) => {
        if (!this.root.contains(e.target as Node)) this.close();
      });

      this.trigger.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); this.open(); this.focusOption(0); }
        if (e.key === 'ArrowUp') { e.preventDefault(); this.open(); this.focusOption(this.visibleOptions.length - 1); }
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.toggle(); }
        if (e.key === 'Escape') this.close();
      });

      this.options.forEach((opt) => {
        opt.addEventListener('click', () => this.select(opt));
        opt.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.select(opt); }
          if (e.key === 'ArrowDown') { e.preventDefault(); this.focusNext(1); }
          if (e.key === 'ArrowUp') { e.preventDefault(); this.focusNext(-1); }
          if (e.key === 'Escape') { e.preventDefault(); this.close(); this.trigger.focus(); }
          if (e.key === 'Tab') this.close();
        });
      });

      // 搜索过滤
      let searchTimer: number;
      this.searchInput.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => this.filter(), 80);
      });
      this.searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); this.focusOption(0); }
        if (e.key === 'Escape') { e.preventDefault(); this.close(); this.trigger.focus(); }
      });
    }

    private toggle(): void {
      this.isOpen ? this.close() : this.open();
    }

    private open(): void {
      this.isOpen = true;
      this.dropdown.classList.add('is-open');
      this.trigger.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => this.searchInput.focus());
    }

    private close(): void {
      this.isOpen = false;
      this.dropdown.classList.remove('is-open');
      this.trigger.setAttribute('aria-expanded', 'false');
      this.searchInput.value = '';
      this.filter();
    }

    private select(opt: HTMLElement): void {
      const code = opt.getAttribute('data-country-value') || '';
      const name = opt.getAttribute('data-country-name') || '';
      const flagImg = opt.querySelector('.soeteck-country-select__flag img');
      const flagHtml = flagImg ? flagImg.outerHTML : '';
      this.selectedCode = code;
      this.placeholder.innerHTML = `${flagHtml} ${name}`;
      this.placeholder.classList.add('soeteck-country-select__placeholder--selected');
      this.nativeSelect.value = name;

      this.options.forEach(o => o.classList.remove('is-selected'));
      opt.classList.add('is-selected');

      this.close();
      this.trigger.focus();
    }

    private filter(): void {
      const q = this.searchInput.value.toLowerCase().trim();
      this.options.forEach(opt => {
        const name = (opt.getAttribute('data-country-name') || '').toLowerCase();
        const code = (opt.getAttribute('data-country-value') || '').toLowerCase();
        const matches = !q || name.includes(q) || code.includes(q);
        opt.classList.toggle('is-hidden', !matches);
      });
      this.visibleOptions = this.options.filter(o => !o.classList.contains('is-hidden'));
      this.activeIndex = -1;
    }

    private focusOption(index: number): void {
      if (this.visibleOptions.length === 0) return;
      const idx = Math.max(0, Math.min(index, this.visibleOptions.length - 1));
      this.visibleOptions.forEach(o => o.classList.remove('is-focused'));
      this.visibleOptions[idx].classList.add('is-focused');
      this.visibleOptions[idx].scrollIntoView({ block: 'nearest' });
      this.activeIndex = idx;
    }

    private focusNext(dir: number): void {
      if (this.activeIndex < 0) this.focusOption(0);
      else this.focusOption(this.activeIndex + dir);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-country-select]').forEach(el => new CountrySelect(el));
</script>

