---
import type { AdaptedPage } from '@/lib/page-adapter';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
// 5-language content wiring (translate-code-embedded namespace pattern)
import * as C_EN from './row-modular-content';
import * as C_ZH from './row-modular-content-zh';
import * as C_RU from './row-modular-content-ru';
import * as C_PT from './row-modular-content-pt';
import * as C_ES from './row-modular-content-es';
import './RowModularPage.css';
// Shared client cases (Prefab/Cabinet/Row) — translations live in prefab-content-<lang>.ts
import { PREFAB_CLIENT_CASES as CASES_EN } from './prefab-content';
import { PREFAB_CLIENT_CASES as CASES_ZH } from './prefab-content-zh';
import { PREFAB_CLIENT_CASES as CASES_RU } from './prefab-content-ru';
import { PREFAB_CLIENT_CASES as CASES_PT } from './prefab-content-pt';
import { PREFAB_CLIENT_CASES as CASES_ES } from './prefab-content-es';
import '@/styles/product-gallery.css';

export interface Props {
  page: AdaptedPage;
  lang: string;
}

const { page, lang } = Astro.props;

const C_LANG_MAP: Record<string, typeof C_EN> = { en: C_EN, zh: C_ZH, ru: C_RU, pt: C_PT, es: C_ES };
const C = C_LANG_MAP[lang] ?? C_EN;
const CASES = ({ en: CASES_EN, zh: CASES_ZH, ru: CASES_RU, pt: CASES_PT, es: CASES_ES })[lang] ?? CASES_EN;

// {LANG} 占位符（正文内嵌产品链接的语言前缀）渲染时替换为 /<lang>
const withLangHtml = (html: string) => html.replace(/\{LANG\}/g, '/' + lang);

const brochureUrl = '/resources/Soeteck-Data-Center-Solution-Row-Modular-Data-Center.pdf';
// hero 背景图：优先 ACF sections.heroImage（WP 后台可传），兜底原硬编码图
// replace 剥掉可能的 cms.soeteck.com 域名，统一成 /resources/ 相对路径
const heroOverride = page.sections?.heroImage?.replace(/^https?:\/\/[^/]+/, '');
const bannerImage = heroOverride || '/resources/row-modular-data-center-header.webp';
---

<div class="soeteck-prefab-solution" data-row-solution>
  <!-- Banner Hero -->
  <section class="soeteck-prefab-banner" aria-labelledby="row-hero-title">
    <img class="soeteck-prefab-banner__image" src={bannerImage} alt={C.ROW_HERO_IMAGE_ALT} width="1920" height="600" loading="eager" fetchpriority="high" />
    <div class="soeteck-prefab-banner__overlay" aria-hidden="true"></div>
    <div class="soeteck-container soeteck-prefab-banner__inner">
      <Breadcrumbs items={page.breadcrumbs} class="soeteck-breadcrumbs--hero" lang={lang} />
      <div class="soeteck-prefab-banner__body">
        <h1 id="row-hero-title" class="soeteck-page-title soeteck-prefab-banner__title">{C.ROW_HERO_TITLE}</h1>
        <p class="soeteck-row-banner__subtitle">{C.ROW_HERO_SUBTITLE}</p>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="soeteck-prefab-section soeteck-prefab-overview">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.ROW_OVERVIEW_TITLE}</h2>
      <div class="soeteck-row-overview__grid">
        <div class="soeteck-prefab-rich-text">
          {C.ROW_OVERVIEW_PARAGRAPHS.map((p) => (
            <div set:html={p}></div>
          ))}
        </div>
        <div class="soeteck-prefab-video" data-prefab-video>
          <button class="soeteck-prefab-video__button" data-youtube-id="e-XPwDrFCWQ" data-video-fallback-title={C.ROW_VIDEO_FALLBACK_TITLE} aria-label={C.ROW_VIDEO_ARIA_LABEL}>
            <img class="soeteck-prefab-video__image" src="/resources/row-modular-data-center-header.webp" alt="" width="640" height="360" loading="lazy" />
            <span class="soeteck-prefab-video__play" aria-hidden="true"></span>
          </button>
        </div>
      </div>
      <div class="soeteck-prefab-cta-row">
        <a class="soeteck-button-primary" href={brochureUrl} target="_blank" rel="noopener">{C.ROW_CTA_BROCHURE}</a>
        <a class="soeteck-button-outline" href={`/${lang}/contact-us/`}>{C.ROW_CTA_CONTACT}</a>
      </div>
    </div>
  </section>

  <!-- Closer Look -->
  <section class="soeteck-prefab-section soeteck-prefab-closer">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.ROW_INSIDE_TITLE}</h2>

      <!-- 1 - Two Typical Units (Two hotspot diagrams) -->
      <article class="soeteck-prefab-detail-block">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>1 - </span>{C.ROW_UNITS_TITLE}</h3>
        <div class="soeteck-row-hotspot-tabs" data-hotspot-tabs>
          <div class="soeteck-row-hotspot-tab-bar" role="tablist" aria-label={C.ROW_TABLIST_ARIA}>
            <button class="soeteck-row-hotspot-tab is-active" type="button" role="tab" aria-selected="true" data-hotspot-tab="rack">{C.ROW_TAB_RACK}</button>
            <button class="soeteck-row-hotspot-tab" type="button" role="tab" aria-selected="false" data-hotspot-tab="inrow">{C.ROW_TAB_INROW}</button>
          </div>
          <div class="soeteck-row-hotspot-panel is-active" data-hotspot-panel="rack">
            <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
              <div class="soeteck-prefab-hotspot__media">
                <img class="soeteck-prefab-hotspot__image" src={C.ROW_RACK_HOTSPOT_IMAGE} alt={C.ROW_RACK_DIAGRAM_ALT} width="800" height="800" loading="lazy" />
                {C.ROW_RACK_HOTSPOTS.map((hotspot, index) => (
                  <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={`rack-${index}`} style={{ '--x': hotspot.x, '--y': hotspot.y } as any} aria-expanded="false" aria-label={hotspot.label}>
                    <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                    <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                    <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{hotspot.label}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
          <div class="soeteck-row-hotspot-panel" data-hotspot-panel="inrow" hidden>
            <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
              <div class="soeteck-prefab-hotspot__media">
                <img class="soeteck-prefab-hotspot__image" src={C.ROW_INROW_HOTSPOT_IMAGE} alt={C.ROW_INROW_DIAGRAM_ALT} width="800" height="800" loading="lazy" />
                {C.ROW_INROW_HOTSPOTS.map((hotspot, index) => (
                  <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={`inrow-${index}`} style={{ '--x': hotspot.x, '--y': hotspot.y } as any} aria-expanded="false" aria-label={hotspot.label}>
                    <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                    <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                    <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{hotspot.label}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="soeteck-prefab-rich-text soeteck-prefab-detail-block__copy">
          <p set:html={withLangHtml(C.ROW_UNITS_LEAD_HTML)}></p>
          <p><strong>{C.ROW_KEY_FEATURES_LABEL}</strong></p>
          <ul>
            {C.ROW_KEY_FEATURES.map((feature) => (
              <li set:html={feature}></li>
            ))}
          </ul>
        </div>
      </article>

      <!-- 2 - Build Your Data Center Like LEGO (Evolve From - Hotspot diagrams) -->
      <article class="soeteck-prefab-detail-block soeteck-row-models">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>2 - </span>{C.ROW_LEGO_TITLE}</h3>
        <p class="soeteck-prefab-rich-text">{C.ROW_LEGO_INTRO}</p>

        <h4 class="soeteck-minor-title soeteck-title-bordered">{C.ROW_EVOLVE_RACK.title}</h4>
        <div class="soeteck-prefab-rich-text">
          <p>{C.ROW_EVOLVE_RACK_TEXT}</p>
        </div>
        <div class="soeteck-row-evolve-grid">
          {C.ROW_EVOLVE_RACK.images.map((item, idx) => (
            <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
              <div class="soeteck-prefab-hotspot__media">
                <img class="soeteck-prefab-hotspot__image" src={item.image} alt={C.ROW_EVOLVE_RACK.title} width="300" height="300" loading="lazy" />
                {item.hotspots.map((pin, pi) => (
                  <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={`rack-evo-${idx}-${pi}`} style={{ '--x': pin.x, '--y': pin.y } as any} aria-expanded="false" aria-label={pin.label}>
                    <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                    <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                    <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{pin.label}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <h4 class="soeteck-minor-title soeteck-title-bordered">{C.ROW_EVOLVE_INROW.title}</h4>
        <div class="soeteck-prefab-rich-text">
          <p>{C.ROW_EVOLVE_INROW_TEXT}</p>
        </div>
        <div class="soeteck-row-evolve-grid">
          {C.ROW_EVOLVE_INROW.images.map((item, idx) => (
            <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
              <div class="soeteck-prefab-hotspot__media">
                <img class="soeteck-prefab-hotspot__image" src={item.image} alt={C.ROW_EVOLVE_INROW.title} width="300" height="300" loading="lazy" />
                {item.hotspots.map((pin, pi) => (
                  <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={`inrow-evo-${idx}-${pi}`} style={{ '--x': pin.x, '--y': pin.y } as any} aria-expanded="false" aria-label={pin.label}>
                    <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                    <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                    <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{pin.label}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="soeteck-prefab-rich-text">
          <p>{C.ROW_EVOLVE_SUMMARY}</p>
        </div>
      </article>

      <!-- 3 - Core Infrastructure Modules + Critical Power + Thermal Management -->
      <article class="soeteck-prefab-detail-block soeteck-prefab-modules">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>3 - </span>{C.ROW_MODULES_TITLE}</h3>
        <div class="soeteck-prefab-rich-text soeteck-prefab-modules__lead">
          <p>{C.ROW_MODULES_LEAD}</p>
        </div>
        <div class="soeteck-prefab-module-grid">
          {C.ROW_CORE_MODULES.map((module) => (
            <article class="soeteck-prefab-module-card">
              <span class={`soeteck-prefab-module-card__icon soeteck-prefab-module-card__icon--${module.icon}`} aria-hidden="true"></span>
              <h3 class="soeteck-card-title">{module.title}</h3>
              <p>{module.text}</p>
            </article>
          ))}
        </div>

        <!-- Critical Power -->
        <section class="soeteck-prefab-product-group" aria-labelledby="row-critical-power-title">
          <div class="soeteck-prefab-rich-text">
            <h4 id="row-critical-power-title" class="soeteck-minor-title soeteck-title-bordered">{C.ROW_CRITICAL_POWER_HEADING}</h4>
            <p>{C.ROW_CRITICAL_POWER_TEXT}</p>
          </div>
          <div class="soeteck-prefab-product-gallery-grid" data-row-gallery>
            {C.ROW_CRITICAL_POWER_PRODUCTS.map((product, pIdx) => {
              const panelId = `row-critical-power-${pIdx}`;
              return (
                <article class="soeteck-prefab-product-gallery" data-product-panel={panelId}>
                  <div class="soeteck-prefab-product-gallery__stage">
                    {product.images.slice(0, 4).map((img, iIdx) => (
                      <a class={`soeteck-prefab-product-gallery__item${iIdx === 0 ? ' is-active' : ''}`}
                         href={`/${lang}/products/${product.slug}/`}
                         target="_blank" rel="noopener"
                         data-product-gallery-item={`${panelId}-${iIdx}`}>
                        <img src={img} alt={product.title} class="soeteck-prefab-product-gallery__image" loading="lazy" />
                      </a>
                    ))}
                  </div>
                  {product.images.slice(0, 4).length > 1 && (
                    <div class="soeteck-prefab-product-gallery__thumbs" role="tablist" aria-label={`${product.title} ${C.ROW_GALLERY_ARIA}`}>
                      {product.images.slice(0, 4).map((img, iIdx) => (
                        <button class={`soeteck-prefab-product-gallery__thumb${iIdx === 0 ? ' is-active' : ''}`}
                                type="button"
                                data-product-gallery-target={`${panelId}-${iIdx}`}
                                aria-selected={iIdx === 0 ? 'true' : 'false'}>
                          <img src={img} alt="" class="soeteck-prefab-product-gallery__thumb-image" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="soeteck-prefab-product-gallery__copy">
                    <a class="soeteck-card-title soeteck-prefab-product-gallery__title" href={`/${lang}/products/${product.slug}/`} target="_blank" rel="noopener">{product.title}</a>
                    <p class="soeteck-prefab-product-gallery__excerpt">{product.excerpt}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Thermal Management -->
        <section class="soeteck-prefab-product-group" aria-labelledby="row-thermal-title">
          <div class="soeteck-prefab-rich-text">
            <h4 id="row-thermal-title" class="soeteck-minor-title soeteck-title-bordered">{C.ROW_THERMAL_HEADING}</h4>
            <p>{C.ROW_THERMAL_MANAGEMENT_TEXT}</p>
          </div>
          <div class="soeteck-prefab-product-gallery-grid" data-row-gallery>
            {C.ROW_THERMAL_PRODUCTS.map((product, pIdx) => {
              const panelId = `row-thermal-${pIdx}`;
              return (
                <article class="soeteck-prefab-product-gallery" data-product-panel={panelId}>
                  <div class="soeteck-prefab-product-gallery__stage">
                    {product.images.slice(0, 4).map((img, iIdx) => (
                      <a class={`soeteck-prefab-product-gallery__item${iIdx === 0 ? ' is-active' : ''}`}
                         href={`/${lang}/products/${product.slug}/`}
                         target="_blank" rel="noopener"
                         data-product-gallery-item={`${panelId}-${iIdx}`}>
                        <img src={img} alt={product.title} class="soeteck-prefab-product-gallery__image" loading="lazy" />
                      </a>
                    ))}
                  </div>
                  {product.images.slice(0, 4).length > 1 && (
                    <div class="soeteck-prefab-product-gallery__thumbs" role="tablist" aria-label={`${product.title} ${C.ROW_GALLERY_ARIA}`}>
                      {product.images.slice(0, 4).map((img, iIdx) => (
                        <button class={`soeteck-prefab-product-gallery__thumb${iIdx === 0 ? ' is-active' : ''}`}
                                type="button"
                                data-product-gallery-target={`${panelId}-${iIdx}`}
                                aria-selected={iIdx === 0 ? 'true' : 'false'}>
                          <img src={img} alt="" class="soeteck-prefab-product-gallery__thumb-image" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="soeteck-prefab-product-gallery__copy">
                    <a class="soeteck-card-title soeteck-prefab-product-gallery__title" href={`/${lang}/products/${product.slug}/`} target="_blank" rel="noopener">{product.title}</a>
                    <p class="soeteck-prefab-product-gallery__excerpt">{product.excerpt}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      </article>
    </div>
  </section>

  <!-- Specs Table -->
  <section class="soeteck-prefab-section soeteck-prefab-specs">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.ROW_SPECS_TITLE}</h2>
      <div class="soeteck-prefab-table-wrap">
        <table class="soeteck-prefab-spec-table">
          <thead>
            <tr>
              <th scope="col">{C.ROW_SPEC_HEADER_MODELS}</th>
              {C.ROW_SPEC_COLUMNS.map((col) => (
                <th scope="col">{col.model}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {C.ROW_SPEC_ROWS.map((row) => (
              <tr>
                <th scope="row">{row[0]}</th>
                {row.slice(1).map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="soeteck-prefab-pdf-link"><a href={brochureUrl} target="_blank" rel="noopener"><span aria-hidden="true">PDF</span>{C.ROW_PDF_LINK_TEXT}</a></p>
    </div>
  </section>

  <!-- Scenarios -->
  <section class="soeteck-prefab-section soeteck-prefab-scenarios">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.ROW_SCENARIOS_TITLE}</h2>
      <p class="soeteck-prefab-section__subtitle">{C.ROW_SCENARIOS_SUBTITLE}</p>
      <div class="soeteck-prefab-scenario-grid">
        {C.ROW_SCENARIOS.map((scenario) => (
          <article class="soeteck-prefab-scenario-card" data-scenario-card>
            <img class="soeteck-prefab-scenario-card__image" src={scenario.image} alt={scenario.title} width="436" height="237" loading="lazy" />
            <div class="soeteck-prefab-scenario-card__body">
              <h3 class="soeteck-card-title">{scenario.title}</h3>
              <div class="soeteck-prefab-scenario-card__tabs" role="tablist" aria-label={`${scenario.title} ${C.ROW_SCENARIO_DETAILS_ARIA}`}>
                <button class="soeteck-prefab-scenario-card__tab is-active" type="button" role="tab" aria-selected="true" data-scenario-tab="benefits">{C.ROW_TAB_BENEFITS}</button>
                <button class="soeteck-prefab-scenario-card__tab" type="button" role="tab" aria-selected="false" data-scenario-tab="pain">{C.ROW_TAB_PAIN}</button>
              </div>
              <div class="soeteck-prefab-scenario-card__panel is-active" data-scenario-panel="benefits">
                <div class="soeteck-prefab-scenario-card__tags">
                  {scenario.benefits.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <p>{scenario.solution}</p>
              </div>
              <div class="soeteck-prefab-scenario-card__panel" data-scenario-panel="pain" hidden>
                <div class="soeteck-prefab-scenario-card__tags">
                  {scenario.pain_points.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <p>{scenario.problem}</p>
              </div>
              <p><strong>{scenario.application}</strong></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Client Cases -->
  <section class="soeteck-prefab-section soeteck-prefab-cases">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">{C.ROW_CASES_TITLE}</h2>
      <div class="soeteck-prefab-case-grid">
        {CASES.map((c) => (
          <article class="soeteck-prefab-case-card">
            <a class="soeteck-prefab-case-card__media" href={`/${lang}/news-and-insights/client-case-studies/${c.slug}/`}>
              <img class="soeteck-prefab-case-card__image" src={c.imgSrc} alt={c.title} width="436" height="240" loading="lazy" />
            </a>
            <div class="soeteck-prefab-case-card__body">
              <h3 class="soeteck-card-title"><a href={`/${lang}/news-and-insights/client-case-studies/${c.slug}/`}>{c.title}</a></h3>
              <p>{c.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="soeteck-cta" id="row-inquiry">
    <div class="soeteck-container soeteck-cta__inner">
      <div>
        <p class="soeteck-eyebrow">{C.ROW_CONTACT_EYEBROW}</p>
        <h2>{C.ROW_CONTACT_TITLE}</h2>
        <p>{C.ROW_CONTACT_TEXT}</p>
        <ul class="soeteck-cta__checks">
          {C.ROW_CONTACT_CHECKS.map((check) => (
            <li>{check}</li>
          ))}
        </ul>
      </div>
      <div class="soeteck-cta__actions">
        <a class="soeteck-cta__button" href={`/${lang}/contact-us/`}>{C.ROW_CONTACT_BUTTON}</a>
        <a class="soeteck-cta__button soeteck-cta__button--outline" href={brochureUrl} target="_blank" rel="noopener">{C.ROW_CONTACT_BROCHURE}</a>
      </div>
    </div>
  </section>
</div>


<script>
  function buildYouTubeEmbed(videoId, title) {
    var wrapper = document.createElement('div');
    var iframe = document.createElement('iframe');
    wrapper.className = 'soeteck-prefab-video__iframe-wrap';
    iframe.className = 'soeteck-prefab-video__iframe';
    iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1&rel=0';
    iframe.title = title || '';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.loading = 'eager';
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    wrapper.appendChild(iframe);
    return wrapper;
  }

  (function initRowPage() {
    const container = document.querySelector('[data-row-solution]');
    if (!container) return;

    // --- Video ---
    var videoTriggers = container.querySelectorAll('[data-youtube-id]');
    videoTriggers.forEach(function(trigger) {
      trigger.addEventListener('click', function(event) {
        var videoId = trigger.getAttribute('data-youtube-id');
        var videoShell = trigger.closest('[data-prefab-video]');
        if (!videoId || !videoShell) return;
        event.preventDefault();
        videoShell.replaceChildren(buildYouTubeEmbed(videoId, trigger.getAttribute('aria-label') || trigger.getAttribute('data-video-fallback-title')));
      });
    });

    // --- Hotspot interaction ---
    container.querySelectorAll('[data-prefab-hotspots]').forEach(function(group) {
      var pins = group.querySelectorAll('[data-hotspot-index]');
      pins.forEach(function(pin) {
        pin.addEventListener('click', function() {
          var isActive = pin.classList.contains('is-active');
          pins.forEach(function(p) {
            p.classList.remove('is-active');
            p.setAttribute('aria-expanded', 'false');
          });
          if (!isActive) {
            pin.classList.add('is-active');
            pin.setAttribute('aria-expanded', 'true');
          }
        });
      });
    });

    // --- Scenario card tabs ---
    container.querySelectorAll('[data-scenario-card]').forEach(function(card) {
      card.querySelectorAll('[data-scenario-tab]').forEach(function(tab) {
        tab.addEventListener('click', function() {
          var target = tab.getAttribute('data-scenario-tab');
          if (!target) return;
          card.querySelectorAll('[data-scenario-tab]').forEach(function(node) {
            var isActive = node === tab;
            node.classList.toggle('is-active', isActive);
            node.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
          card.querySelectorAll('[data-scenario-panel]').forEach(function(panel) {
            var isActive = panel.getAttribute('data-scenario-panel') === target;
            panel.classList.toggle('is-active', isActive);
            panel.hidden = !isActive;
          });
        });
      });
    });

    // --- Hotspot tab switching (Rack-Cooling / In-Row-Cooling) ---
    var hotspotTabs = container.querySelector('[data-hotspot-tabs]');
    if (hotspotTabs) {
      hotspotTabs.querySelectorAll('[data-hotspot-tab]').forEach(function(tab) {
        tab.addEventListener('click', function() {
          var target = tab.getAttribute('data-hotspot-tab');
          if (!target) return;
          hotspotTabs.querySelectorAll('[data-hotspot-tab]').forEach(function(node) {
            var isActive = node === tab;
            node.classList.toggle('is-active', isActive);
            node.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
          hotspotTabs.querySelectorAll('[data-hotspot-panel]').forEach(function(panel) {
            var isActive = panel.getAttribute('data-hotspot-panel') === target;
            panel.classList.toggle('is-active', isActive);
            panel.hidden = !isActive;
          });
        });
      });
    }

    // --- Product gallery thumbnails ---
    container.querySelectorAll('[data-row-gallery]').forEach(function(grid) {
      grid.querySelectorAll('[data-product-gallery-target]').forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          var target = thumb.getAttribute('data-product-gallery-target');
          var panel = thumb.closest('[data-product-panel]');
          if (!panel) return;
          panel.querySelectorAll('[data-product-gallery-target]').forEach(function(t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });
          panel.querySelectorAll('[data-product-gallery-item]').forEach(function(item) {
            item.classList.remove('is-active');
          });
          thumb.classList.add('is-active');
          thumb.setAttribute('aria-selected', 'true');
          var activeItem = panel.querySelector('[data-product-gallery-item="' + target + '"]');
          if (activeItem) activeItem.classList.add('is-active');
        });
      });
    });
  })();
</script>