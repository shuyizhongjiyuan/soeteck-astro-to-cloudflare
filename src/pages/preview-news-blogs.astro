---
/**
 * Preview page — Unified News & Blogs section design options (Variant C).
 * Access: http://localhost:4321/preview-news-blogs/
 *
 * Option N1 — 2-col large cards (news left, blogs right)
 * Option N2 — Magazine layout (featured + grid)
 * Option N3 — 3-col equal card grid
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { adaptArticleCard } from '@/lib/page-adapter';

const lang = 'en';

// Fetch real articles
let newsArticles: any[] = [];
let blogArticles: any[] = [];
try {
  const { fetchRouteContent } = await import('@/lib/content-api');
  const newsRoute = { path: `/en/news-and-insights/news-releases/`, routeType: 'article_category_archive' as const, expectedTitle: '' };
  const newsData = await fetchRouteContent(newsRoute, lang);
  newsArticles = (newsData.articles ?? []).slice(0, 3).map(adaptArticleCard);
  const blogRoute = { path: `/en/news-and-insights/blogs/`, routeType: 'article_category_archive' as const, expectedTitle: '' };
  const blogData = await fetchRouteContent(blogRoute, lang);
  blogArticles = (blogData.articles ?? []).slice(0, 3).map(adaptArticleCard);
} catch (e) {
  // Fallback: use placeholder data
  newsArticles = [{ title: 'Sample news article', slug: '', path: '/en/news-and-insights/', excerpt: 'Preview fallback — no data loaded.', date: null, compactExcerpt: '', featuredImage: null, primaryCategory: null, id: null, modified: null }];
  blogArticles = [{ title: 'Sample blog post', slug: '', path: '/en/news-and-insights/', excerpt: 'Preview fallback — no data loaded.', date: null, compactExcerpt: '', featuredImage: null, primaryCategory: null, id: null, modified: null }];
}

function fmt(d: string | null): string {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
  catch { return d; }
}
---

<BaseLayout title="Preview: News & Blogs Section — Variant C" lang="en" canonical="https://soeteck.com/preview-news-blogs/" robots="noindex">
  <div style="padding:40px 24px; background:var(--soeteck-navy); color:#fff;">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:var(--soeteck-primary); font-size:12px; letter-spacing:.16em; text-transform:uppercase; margin:0 0 8px;">Variant C · News & Blogs</p>
      <h1 style="font-size:26px; margin:0 0 8px;">统一新闻&博客区设计对比</h1>
      <p style="color:rgba(255,255,255,.8); margin:0;">统一板块头 + 单 View All，新闻和博客各自保留视觉特点</p>
    </div>
  </div>

  <!-- ═══ Option N1 — 2-col large cards ═══ -->
  <section style="background:var(--soeteck-surface); padding:clamp(56px,7vw,80px) 0;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Option N1 · 双列大图卡</p>
      <p class="opt-why">左右两列，各 3 张带图大卡，新闻与博客同款排版</p>
      <h2 style="font-size:26px; font-weight:800; margin:14px 0 6px; color:var(--soeteck-text);">Industry Insights &amp; Company News</h2>

      <div class="n1-cols">
        <div>
          <h3 class="n1-subhead">News Releases</h3>
          <div class="n1-stack">
            {newsArticles.map((a) => (
              <a href={a.path} class="n1-card">
                {a.featuredImage && <div class="n1-card-img"><img src={a.featuredImage.path} alt="" width="480" height="270" loading="lazy" /></div>}
                <div class="n1-card-body">
                  {a.date && <span class="n1-card-date">{fmt(a.date)}</span>}
                  <span class="n1-card-title">{a.title}</span>
                  {a.excerpt && <p class="n1-card-excerpt">{a.excerpt}</p>}
                  <span class="n1-card-cta">Read →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
        <div>
          <h3 class="n1-subhead">Blogs</h3>
          <div class="n1-stack">
            {blogArticles.map((a) => (
              <a href={a.path} class="n1-card">
                {a.featuredImage && <div class="n1-card-img"><img src={a.featuredImage.path} alt="" width="480" height="270" loading="lazy" /></div>}
                <div class="n1-card-body">
                  {a.date && <span class="n1-card-date">{fmt(a.date)}</span>}
                  <span class="n1-card-title">{a.title}</span>
                  {a.excerpt && <p class="n1-card-excerpt">{a.excerpt}</p>}
                  <span class="n1-card-cta">Read →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div style="text-align:center; margin-top:44px; padding-top:28px; border-top:1px solid var(--soeteck-border-soft);">
        <a href="/en/news-and-insights/" style="display:inline-flex; padding:12px 28px; border-radius:999px; border:1.5px solid var(--soeteck-primary); color:var(--soeteck-primary); font-size:14px; font-weight:600; text-decoration:none;">View All News &amp; Insights →</a>
      </div>
    </div>
  </section>

  <!-- ═══ Option N2 — Magazine layout ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(56px,7vw,80px) 0; border-top:1px solid var(--soeteck-border-soft);">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Option N2 · 杂志排版（Featured + 网格）</p>
      <p class="opt-why">每组首篇大图主推跨列，其余两篇小卡，编辑式杂志感</p>
      <h2 style="font-size:26px; font-weight:800; margin:14px 0 6px; color:var(--soeteck-text);">Industry Insights &amp; Company News</h2>

      <div class="n2-cols">
        <div>
          <h3 class="n2-subhead">News Releases</h3>
          {newsArticles.length > 0 && (
            <a href={newsArticles[0].path} class="n2-feat">
              {newsArticles[0].featuredImage && <div class="n2-feat-img"><img src={newsArticles[0].featuredImage.path} alt="" width="640" height="360" loading="lazy" /></div>}
              <div class="n2-feat-body">
                {newsArticles[0].date && <span class="n2-fdate">{fmt(newsArticles[0].date)}</span>}
                <span class="n2-ftitle">{newsArticles[0].title}</span>
                {newsArticles[0].excerpt && <p class="n2-fexcerpt">{newsArticles[0].excerpt}</p>}
                <span class="n2-fcta">Read →</span>
              </div>
            </a>
          )}
          <div class="n2-grid">
            {newsArticles.slice(1).map((a) => (
              <a href={a.path} class="n2-sm">
                <span class="n2-sm-title">{a.title}</span>
                {a.date && <span class="n2-sm-date">{fmt(a.date)}</span>}
              </a>
            ))}
          </div>
        </div>
        <div>
          <h3 class="n2-subhead">Blogs</h3>
          {blogArticles.length > 0 && (
            <a href={blogArticles[0].path} class="n2-feat">
              {blogArticles[0].featuredImage && <div class="n2-feat-img"><img src={blogArticles[0].featuredImage.path} alt="" width="640" height="360" loading="lazy" /></div>}
              <div class="n2-feat-body">
                {blogArticles[0].date && <span class="n2-fdate">{fmt(blogArticles[0].date)}</span>}
                <span class="n2-ftitle">{blogArticles[0].title}</span>
                {blogArticles[0].excerpt && <p class="n2-fexcerpt">{blogArticles[0].excerpt}</p>}
                <span class="n2-fcta">Read →</span>
              </div>
            </a>
          )}
          <div class="n2-grid">
            {blogArticles.slice(1).map((a) => (
              <a href={a.path} class="n2-sm">
                <span class="n2-sm-title">{a.title}</span>
                {a.date && <span class="n2-sm-date">{fmt(a.date)}</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
      <div style="text-align:center; margin-top:44px; padding-top:28px; border-top:1px solid var(--soeteck-border-soft);">
        <a href="/en/news-and-insights/" style="display:inline-flex; padding:12px 28px; border-radius:999px; border:1.5px solid var(--soeteck-primary); color:var(--soeteck-primary); font-size:14px; font-weight:600; text-decoration:none;">View All News &amp; Insights →</a>
      </div>
    </div>
  </section>

  <!-- ═══ Option N3 — 3-col equal card grid ═══ -->
  <section style="background:var(--soeteck-surface); padding:clamp(56px,7vw,80px) 0;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Option N3 · 三列等宽卡片</p>
      <p class="opt-why">新闻与博客各三列等宽卡，均匀分布，每卡带图+标题+日期</p>
      <h2 style="font-size:26px; font-weight:800; margin:14px 0 6px; color:var(--soeteck-text);">Industry Insights &amp; Company News</h2>

      <div>
        <h3 class="n3-subhead">News Releases</h3>
        <div class="n3-grid">
          {newsArticles.map((a) => (
            <a href={a.path} class="n3-card">
              {a.featuredImage && <div class="n3-card-img"><img src={a.featuredImage.path} alt="" width="400" height="225" loading="lazy" /></div>}
              <div class="n3-card-body">
                {a.date && <span class="n3-card-date">{fmt(a.date)}</span>}
                <span class="n3-card-title">{a.title}</span>
                <span class="n3-card-cta">Read →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div style="margin-top:40px;">
        <h3 class="n3-subhead">Blogs</h3>
        <div class="n3-grid">
          {blogArticles.map((a) => (
            <a href={a.path} class="n3-card">
              {a.featuredImage && <div class="n3-card-img"><img src={a.featuredImage.path} alt="" width="400" height="225" loading="lazy" /></div>}
              <div class="n3-card-body">
                {a.date && <span class="n3-card-date">{fmt(a.date)}</span>}
                <span class="n3-card-title">{a.title}</span>
                <span class="n3-card-cta">Read →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div style="text-align:center; margin-top:44px; padding-top:28px; border-top:1px solid var(--soeteck-border-soft);">
        <a href="/en/news-and-insights/" style="display:inline-flex; padding:12px 28px; border-radius:999px; border:1.5px solid var(--soeteck-primary); color:var(--soeteck-primary); font-size:14px; font-weight:600; text-decoration:none;">View All News &amp; Insights →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .opt-label { margin: 0; color: var(--soeteck-primary); font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .opt-why { margin: 4px 0 0 14px; font-size: 14px; color: var(--soeteck-muted); }

  /* N1 - 2-col large cards */
  .n1-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .n1-subhead { margin: 0 0 20px; font-size: 15px; font-weight: 700; color: var(--soeteck-primary); text-transform: uppercase; letter-spacing: .1em; padding-bottom: 10px; border-bottom: 2px solid var(--soeteck-primary); }
  .n1-stack { display: flex; flex-direction: column; gap: 24px; }
  .n1-card { display: flex; flex-direction: column; text-decoration: none; border-radius: 12px; overflow: hidden; border: 1px solid var(--soeteck-border-soft); background: var(--soeteck-white); transition: box-shadow .3s ease, transform .3s ease; }
  .n1-card:hover { box-shadow: 0 12px 36px rgba(0,102,204,.1); transform: translateY(-3px); }
  .n1-card-img { aspect-ratio: 16/9; overflow: hidden; background: var(--soeteck-media-bg); }
  .n1-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .n1-card:hover .n1-card-img img { transform: scale(1.04); }
  .n1-card-body { padding: 16px 20px 20px; }
  .n1-card-date { display: block; font-size: 11px; font-weight: 600; color: var(--soeteck-muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 4px; }
  .n1-card-title { display: block; font-size: 16px; font-weight: 600; color: var(--soeteck-text); line-height: 1.35; }
  .n1-card:hover .n1-card-title { color: var(--soeteck-primary); }
  .n1-card-excerpt { margin: 6px 0 0; font-size: 13px; line-height: 1.55; color: var(--soeteck-text-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .n1-card-cta { display: block; margin-top: 10px; font-size: 13px; font-weight: 600; color: var(--soeteck-primary); }

  /* N2 - Magazine layout */
  .n2-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .n2-subhead { margin: 0 0 20px; font-size: 15px; font-weight: 700; color: var(--soeteck-primary); text-transform: uppercase; letter-spacing: .1em; padding-bottom: 10px; border-bottom: 2px solid var(--soeteck-primary); }
  .n2-feat { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; text-decoration: none; border-radius: 12px; overflow: hidden; border: 1px solid var(--soeteck-border-soft); background: var(--soeteck-white); transition: box-shadow .3s ease, transform .3s ease; }
  .n2-feat:hover { box-shadow: 0 14px 40px rgba(0,102,204,.14); transform: translateY(-3px); }
  .n2-feat-img { aspect-ratio: 16/10; overflow: hidden; background: var(--soeteck-media-bg); }
  .n2-feat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .n2-feat:hover .n2-feat-img img { transform: scale(1.04); }
  .n2-feat-body { padding: 24px 20px; display: flex; flex-direction: column; justify-content: center; }
  .n2-fdate { font-size: 11px; font-weight: 600; color: var(--soeteck-muted); text-transform: uppercase; letter-spacing: .06em; }
  .n2-ftitle { margin-top: 6px; font-size: 18px; font-weight: 700; color: var(--soeteck-text); line-height: 1.3; }
  .n2-feat:hover .n2-ftitle { color: var(--soeteck-primary); }
  .n2-fexcerpt { margin: 8px 0 0; font-size: 13px; line-height: 1.55; color: var(--soeteck-text-soft); }
  .n2-fcta { display: block; margin-top: 12px; font-size: 13px; font-weight: 600; color: var(--soeteck-primary); }
  .n2-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .n2-sm { display: flex; flex-direction: column; padding: 16px; border-radius: 10px; border: 1px solid var(--soeteck-border-soft); background: var(--soeteck-white); text-decoration: none; transition: box-shadow .3s ease, transform .3s ease; }
  .n2-sm:hover { box-shadow: 0 8px 24px rgba(0,102,204,.08); transform: translateY(-2px); }
  .n2-sm-title { font-size: 14px; font-weight: 600; color: var(--soeteck-text); transition: color .25s ease; }
  .n2-sm:hover .n2-sm-title { color: var(--soeteck-primary); }
  .n2-sm-date { margin-top: 6px; font-size: 11px; font-weight: 600; color: var(--soeteck-muted); text-transform: uppercase; }
  .n2-sm:last-child:nth-child(odd) { grid-column: span 2; }

  /* N3 - 3-col equal cards */
  .n3-subhead { margin: 0 0 20px; font-size: 15px; font-weight: 700; color: var(--soeteck-primary); text-transform: uppercase; letter-spacing: .1em; padding-bottom: 10px; border-bottom: 2px solid var(--soeteck-primary); }
  .n3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .n3-card { display: flex; flex-direction: column; text-decoration: none; border-radius: 12px; overflow: hidden; border: 1px solid var(--soeteck-border-soft); background: var(--soeteck-white); transition: box-shadow .3s ease, transform .3s ease; }
  .n3-card:hover { box-shadow: 0 12px 36px rgba(0,102,204,.1); transform: translateY(-3px); }
  .n3-card-img { aspect-ratio: 16/9; overflow: hidden; background: var(--soeteck-media-bg); }
  .n3-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .n3-card:hover .n3-card-img img { transform: scale(1.04); }
  .n3-card-body { padding: 14px 18px 18px; }
  .n3-card-date { display: block; font-size: 11px; font-weight: 600; color: var(--soeteck-muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 4px; }
  .n3-card-title { display: block; font-size: 15px; font-weight: 600; color: var(--soeteck-text); line-height: 1.35; }
  .n3-card:hover .n3-card-title { color: var(--soeteck-primary); }
  .n3-card-cta { display: block; margin-top: 10px; font-size: 12px; font-weight: 600; color: var(--soeteck-primary); }

  @media (max-width: 991px) {
    .n1-cols, .n2-cols { grid-template-columns: 1fr; }
    .n3-grid { grid-template-columns: 1fr; }
    .n2-feat { grid-template-columns: 1fr; }
  }
</style>