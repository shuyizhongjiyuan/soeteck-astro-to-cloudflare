---
import AboutHero from './AboutHero.astro';
import AboutSectionHeading from './AboutSectionHeading.astro';
import AboutCardGrid from './AboutCardGrid.astro';
import AboutFactoryWall from './AboutFactoryWall.astro';
import AboutCertificates from './AboutCertificates.astro';
import AboutGlobalNetwork from './AboutGlobalNetwork.astro';
import AboutTimeline from './AboutTimeline.astro';
import AboutCta from './AboutCta.astro';
import type { AdaptedPage, PageImage } from '@/lib/page-adapter';
import {
  ABOUT_HERO_FALLBACK,
  ABOUT_WORLD_MAP,
  CERTIFICATE_IMAGES,
  FACTORY_IMAGES,
  ABOUT_EN,
  type AboutContent,
} from './about-content';
import { ABOUT_ZH } from './about-content-zh';
import { ABOUT_RU } from './about-content-ru';
import { ABOUT_PT } from './about-content-pt';
import { ABOUT_ES } from './about-content-es';

interface Props {
  page: AdaptedPage;
  lang?: string;
}

const { page, lang = 'en' } = Astro.props;

const contentMap: Record<string, AboutContent> = {
  en: ABOUT_EN,
  zh: ABOUT_ZH,
  ru: ABOUT_RU,
  pt: ABOUT_PT,
  es: ABOUT_ES,
};
const content = contentMap[lang] ?? ABOUT_EN;

const aboutSections = page.sections?.about ?? {};
const heroEyebrow = page.sections?.hero?.eyebrow ?? content.heroEyebrow;
const heroTitle = page.sections?.hero?.title ?? page.title;
const heroImage: PageImage = page.heroImage ?? ABOUT_HERO_FALLBACK;

// Use translation values with content file fallbacks
const lead = aboutSections.lead ?? content.lead;
const introEyebrow = aboutSections.introEyebrow ?? content.introEyebrow;
const introTitle = aboutSections.introTitle ?? content.introTitle;
const introP1 = aboutSections.introP1 ?? content.introP1;
const introP2 = aboutSections.introP2 ?? content.introP2;
const introProofs = aboutSections.introProofs ?? content.introProofs;
const deliverEyebrow = aboutSections.deliverEyebrow ?? content.deliverEyebrow;
const deliverTitle = aboutSections.deliverTitle ?? content.deliverTitle;
const deliverText = aboutSections.deliverText ?? content.deliverText;
const deliverCards = aboutSections.deliverCards ?? content.deliverCards;
const proofEyebrow = aboutSections.proofEyebrow ?? content.proofEyebrow;
const proofTitle = aboutSections.proofTitle ?? content.proofTitle;
const trustCards = aboutSections.trustCards ?? content.trustCards;
const serviceEyebrow = aboutSections.serviceEyebrow ?? content.serviceEyebrow;
const serviceTitle = aboutSections.serviceTitle ?? content.serviceTitle;
const serviceCards = aboutSections.serviceCards ?? content.serviceCards;
const factoryEyebrow = aboutSections.factoryEyebrow ?? content.factoryEyebrow;
const factoryTitle = aboutSections.factoryTitle ?? content.factoryTitle;
const factoryP1 = aboutSections.factoryP1 ?? content.factoryP1;
const factoryP2 = aboutSections.factoryP2 ?? content.factoryP2;
const factoryCapabilities = aboutSections.factoryCapabilities ?? content.factoryCapabilities;
const processEyebrow = aboutSections.processEyebrow ?? content.processEyebrow;
const processTitle = aboutSections.processTitle ?? content.processTitle;
const processText = aboutSections.processText ?? content.processText;
const processCards = aboutSections.processCards ?? content.processCards;
const networkCards = aboutSections.networkNodes ?? content.networkCards;
const milestones = aboutSections.milestones ?? content.milestones;
const timelineEyebrow = aboutSections.timelineEyebrow ?? content.timelineEyebrow;
const timelineTitle = aboutSections.timelineTitle ?? content.timelineTitle;
const timelineText = aboutSections.timelineText ?? content.timelineText;
const visionLabel = aboutSections.visionLabel ?? content.visionLabel;
const visionText = aboutSections.visionText ?? content.visionText;
const missionLabel = aboutSections.missionLabel ?? content.missionLabel;
const missionText = aboutSections.missionText ?? content.missionText;
const certificatesEyebrow = aboutSections.certificatesEyebrow ?? content.certificatesEyebrow;
const certificatesTitle = aboutSections.certificatesTitle ?? content.certificatesTitle;
const certificatesText = aboutSections.certificatesText ?? content.certificatesText;
const certificatesPoints = aboutSections.certificatesPoints ?? content.certificatesPoints;
const networkEyebrow = aboutSections.networkEyebrow ?? content.networkEyebrow;
const networkTitle = aboutSections.networkTitle ?? content.networkTitle;
const networkText = aboutSections.networkText ?? content.networkText;
const ctaEyebrow = aboutSections.ctaEyebrow ?? content.ctaEyebrow;
const ctaTitle = aboutSections.ctaTitle ?? content.ctaTitle;
const ctaText = aboutSections.ctaText ?? content.ctaText;
const ctaChecks = aboutSections.ctaChecks ?? content.ctaChecks;
const ctaButton = aboutSections.ctaButton ?? content.ctaButton;
---
<div class="soeteck-about-page">
  <AboutHero title={heroTitle} lead={lead} image={heroImage} breadcrumbs={page.breadcrumbs} eyebrow={heroEyebrow} lang={lang} />

  <section class="about-section intro" aria-labelledby="about-intro-title">
    <div class="soeteck-container intro__grid">
      <div class="intro__copy">
        <p class="soeteck-eyebrow">{introEyebrow}</p>
        <h2 id="about-intro-title">{introTitle}</h2>
        <p>{introP1}</p>
        <p>{introP2}</p>
        <div class="intro__proofs" aria-label="SOETECK trust highlights">
          {introProofs.map((proof: string) => <span>{proof}</span>)}
        </div>
      </div>
      <div class="intro__video" aria-label="SOETECK company video">
        <iframe src="https://www.youtube-nocookie.com/embed/s5zYTa9BSfo" title="SOETECK company video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <section class="about-section deliver" aria-labelledby="about-deliver-title">
    <div class="soeteck-container">
      <AboutSectionHeading eyebrow={deliverEyebrow} title={deliverTitle} text={deliverText} id="about-deliver-title" />
      <AboutCardGrid cards={deliverCards} variant="deliver" />
    </div>
  </section>

  <section class="about-section proof" aria-labelledby="about-proof-title">
    <div class="soeteck-container">
      <div class="proof__header">
        <p class="soeteck-eyebrow">{proofEyebrow}</p>
        <h2 id="about-proof-title">{proofTitle}</h2>
      </div>
      <AboutCardGrid cards={trustCards} variant="proof" />
    </div>
  </section>

  <section class="about-section service" aria-labelledby="about-service-title">
    <div class="soeteck-container">
      <AboutSectionHeading eyebrow={serviceEyebrow} title={serviceTitle} id="about-service-title" />
      <AboutCardGrid cards={serviceCards} variant="service" />
    </div>
  </section>

  <section class="about-section factory" aria-labelledby="about-factory-title">
    <div class="soeteck-container factory__grid">
      <div class="factory__media">
        <AboutFactoryWall images={FACTORY_IMAGES} />
      </div>
      <div class="factory__copy">
        <p class="soeteck-eyebrow">{factoryEyebrow}</p>
        <h2 id="about-factory-title">{factoryTitle}</h2>
        <p>{factoryP1}</p>
        <p>{factoryP2}</p>
        <ul class="factory__capabilities">
          {factoryCapabilities.map((capability: string) => <li>{capability}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <AboutCertificates images={CERTIFICATE_IMAGES} points={certificatesPoints} eyebrow={certificatesEyebrow} title={certificatesTitle} text={certificatesText} />

  <section class="about-section process" aria-labelledby="about-process-title">
    <div class="soeteck-container">
      <AboutSectionHeading eyebrow={processEyebrow} title={processTitle} text={processText} id="about-process-title" />
      <AboutCardGrid cards={processCards} variant="process" />
    </div>
  </section>

  <AboutGlobalNetwork image={ABOUT_WORLD_MAP} nodes={networkCards} eyebrow={networkEyebrow} title={networkTitle} text={networkText} />
  <AboutTimeline milestones={milestones} eyebrow={timelineEyebrow} title={timelineTitle} text={timelineText} visionLabel={visionLabel} visionText={visionText} missionLabel={missionLabel} missionText={missionText} />
  <AboutCta href="/en/contact-us/" eyebrow={ctaEyebrow} title={ctaTitle} text={ctaText} checks={ctaChecks} button={ctaButton} />
</div>

<style>
  .soeteck-about-page {
    --about-content-width: 1200px;
    --about-content-gutter: 20px;
    background: #fff;
  }

  .soeteck-about-page :global(.soeteck-container) {
    width: min(var(--about-content-width), calc(100% - (var(--about-content-gutter) * 2)));
    max-width: none;
    padding-inline: 0;
  }

  .about-section {
    padding: var(--soeteck-section-y) 0;
  }

  .factory,
  .global {
    background: var(--soeteck-surface);
  }

  .intro__grid,
  .factory__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.78fr);
    gap: clamp(44px, 7vw, 96px);
    align-items: center;
  }

  .factory__grid {
    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1fr);
  }

  .intro h2,
  .factory h2,
  .proof h2 {
    margin: 0;
    color: var(--soeteck-text);
  }

  .intro p:not(.soeteck-eyebrow),
  .factory p:not(.soeteck-eyebrow) {
    margin: 22px 0 0;
    color: var(--soeteck-text-soft);
  }

  .intro__video {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--soeteck-radius-lg);
    background: var(--soeteck-dark);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
  }

  .intro__video::before {
    content: '';
    display: block;
    aspect-ratio: 16 / 9;
  }

  .intro__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .intro__proofs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .intro__proofs span {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 8px 14px;
    border: 1px solid rgba(0, 102, 204, 0.16);
    border-radius: 999px;
    background: rgba(0, 102, 204, 0.06);
    color: var(--soeteck-primary-dark);
    font-size: var(--soeteck-text-sm);
    font-weight: var(--soeteck-weight-semibold);
  }

  .proof {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f8fbff 0%, #eef5fb 100%);
  }

  .proof::before {
    content: '';
    position: absolute;
    top: -120px;
    right: -80px;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    background: rgba(0, 102, 204, 0.08);
  }

  .proof__header {
    position: relative;
    max-width: 860px;
    margin-bottom: clamp(30px, 4vw, 46px);
  }

  .factory__capabilities {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .factory__capabilities li {
    position: relative;
    padding: 13px 14px 13px 38px;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--soeteck-radius);
    background: rgba(255, 255, 255, 0.72);
    color: var(--soeteck-text);
    font-size: var(--soeteck-text-sm);
    font-weight: var(--soeteck-weight-semibold);
    line-height: 1.4;
  }

  .factory__capabilities li::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 16px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--soeteck-primary);
    box-shadow: 0 0 0 5px rgba(0, 102, 204, 0.12);
  }

  @media (max-width: 991px) {
    .intro__grid,
    .factory__grid {
      grid-template-columns: 1fr;
    }

    .factory__media {
      order: 2;
    }

    .factory__copy {
      order: 1;
    }
  }

  /* section padding 已统一到 --soeteck-section-y 变量，768px 移动端覆盖已移除 */

  @media (max-width: 640px) {
    .factory__capabilities {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .soeteck-about-page {
      --about-content-gutter: 16px;
    }
  }
</style>
