---
import type { AdaptedPage } from '@/lib/page-adapter';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {
  ROW_HERO_SUBTITLE, ROW_OVERVIEW_PARAGRAPHS,
  ROW_RACK_HOTSPOTS, ROW_RACK_HOTSPOT_IMAGE,
  ROW_INROW_HOTSPOTS, ROW_INROW_HOTSPOT_IMAGE,
  ROW_EVOLVE_RACK, ROW_EVOLVE_INROW, ROW_CORE_MODULES,
  ROW_CRITICAL_POWER_TEXT, ROW_CRITICAL_POWER_PRODUCTS,
  ROW_THERMAL_MANAGEMENT_TEXT, ROW_THERMAL_PRODUCTS,
  ROW_SPEC_COLUMNS, ROW_SPEC_ROWS,
  ROW_SCENARIOS,
} from './row-modular-content';
import { PREFAB_CLIENT_CASES } from './prefab-content';
import '@/styles/product-gallery.css';

export interface Props {
  page: AdaptedPage;
  lang: string;
}

const { page, lang } = Astro.props;
const brochureUrl = '/resources/Soeteck-Data-Center-Solution-Row-Modular-Data-Center.pdf';
const bannerImage = '/resources/row-modular-data-center-header.webp';
---

<div class="soeteck-prefab-solution" data-row-solution>
  <!-- Banner Hero -->
  <section class="soeteck-prefab-banner" aria-labelledby="row-hero-title">
    <img class="soeteck-prefab-banner__image" src={bannerImage} alt="Row modular data center" width="1920" height="600" loading="eager" fetchpriority="high" />
    <div class="soeteck-prefab-banner__overlay" aria-hidden="true"></div>
    <div class="soeteck-container soeteck-prefab-banner__inner">
      <Breadcrumbs items={page.breadcrumbs} class="soeteck-breadcrumbs--hero" lang={lang} />
      <div class="soeteck-prefab-banner__body">
        <h1 id="row-hero-title" class="soeteck-page-title soeteck-prefab-banner__title">Row Modular Data Center</h1>
        <p class="soeteck-row-banner__subtitle">{ROW_HERO_SUBTITLE}</p>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="soeteck-prefab-section soeteck-prefab-overview">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Build Your Scalable Modular Data Center Like LEGO</h2>
      <div class="soeteck-row-overview__grid">
        <div class="soeteck-prefab-rich-text">
          {ROW_OVERVIEW_PARAGRAPHS.map((p) => (
            <div set:html={p}></div>
          ))}
        </div>
        <div class="soeteck-prefab-video" data-prefab-video>
          <button class="soeteck-prefab-video__button" data-youtube-id="e-XPwDrFCWQ" aria-label="Play Row Modular Data Center video">
            <img class="soeteck-prefab-video__image" src="/resources/row-modular-data-center-header.webp" alt="" width="640" height="360" loading="lazy" />
            <span class="soeteck-prefab-video__play" aria-hidden="true"></span>
          </button>
        </div>
      </div>
      <div class="soeteck-prefab-cta-row">
        <a class="soeteck-button-primary" href={brochureUrl} target="_blank" rel="noopener">GET BROCHURE</a>
        <a class="soeteck-button-outline" href={`/${lang}/contact/`}>CONTACT US</a>
      </div>
    </div>
  </section>

  <!-- Closer Look -->
  <section class="soeteck-prefab-section soeteck-prefab-closer">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Take a Closer Look At Our RMDCs</h2>

      <!-- 1 - Two Typical Units (Two hotspot diagrams) -->
      <article class="soeteck-prefab-detail-block">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>1 - </span>Two Typical Units of RMDC</h3>
        <div class="soeteck-row-hotspot-tabs" data-hotspot-tabs>
          <div class="soeteck-row-hotspot-tab-bar" role="tablist" aria-label="Select cooling type">
            <button class="soeteck-row-hotspot-tab is-active" type="button" role="tab" aria-selected="true" data-hotspot-tab="rack">Rack-Cooling DC</button>
            <button class="soeteck-row-hotspot-tab" type="button" role="tab" aria-selected="false" data-hotspot-tab="inrow">In-Row-Cooling DC</button>
          </div>
          <div class="soeteck-row-hotspot-panel is-active" data-hotspot-panel="rack">
            <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
              <div class="soeteck-prefab-hotspot__media">
                <img class="soeteck-prefab-hotspot__image" src={ROW_RACK_HOTSPOT_IMAGE} alt="Rack cooling DC diagram" width="800" height="800" loading="lazy" />
                {ROW_RACK_HOTSPOTS.map((hotspot, index) => (
                  <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={`rack-${index}`} style={{ '--x': hotspot.x, '--y': hotspot.y } as any} aria-expanded="false" aria-label={hotspot.label}>
                    <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                    <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                    <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{hotspot.label}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
          <div class="soeteck-row-hotspot-panel" data-hotspot-panel="inrow" hidden>
            <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
              <div class="soeteck-prefab-hotspot__media">
                <img class="soeteck-prefab-hotspot__image" src={ROW_INROW_HOTSPOT_IMAGE} alt="In-row cooling DC diagram" width="800" height="800" loading="lazy" />
                {ROW_INROW_HOTSPOTS.map((hotspot, index) => (
                  <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={`inrow-${index}`} style={{ '--x': hotspot.x, '--y': hotspot.y } as any} aria-expanded="false" aria-label={hotspot.label}>
                    <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                    <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                    <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{hotspot.label}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="soeteck-prefab-rich-text soeteck-prefab-detail-block__copy">
          <p>SOETECK row&nbsp;<strong>modular data center</strong>&nbsp;solutions deliver integrated, efficient, and reliable options tailored for modern IT deployments. These solutions can be composed of either single cabinets with&nbsp;<a href={`/${lang}/products/thermal-management/in-row-cooling/`} target="_blank" rel="noopener"><strong>in-row cooling systems</strong></a>&nbsp;or single cabinets with integrated&nbsp;<a href={`/${lang}/products/thermal-management/rack-cooling/`} target="_blank" rel="noopener"><strong>rack-mounted cooling units</strong></a>, providing flexibility to accommodate a wide range of applications. Designed to ensure optimal performance and security for critical infrastructure, SOETECK offers tailored configurations to meet diverse customer needs.</p>
          <p><strong>Key Features:</strong></p>
          <ul>
            <li><strong>Safety and Reliability</strong>: Constructed to high safety standards, our cabinets feature robust fire resistance, water resistance, and advanced security measures, including a multi-faceted access control system for enhanced protection.</li>
            <li><strong>Rapid Deployment</strong>: The modular architecture facilitates quick setup and installation, enabling businesses to achieve operational readiness within a short timeframe.</li>
            <li><strong>Flexible Scalability</strong>: Our solutions support easy expansion to meet evolving demands, allowing organizations to scale up seamlessly as their needs grow.</li>
            <li><strong>High Density and Efficiency</strong>: The design maximizes space utilization for high computing power, supporting configurations of up to 20kW per cabinet while minimizing energy consumption for operational efficiency.</li>
            <li><strong>Intelligent Management</strong>: Equipped with comprehensive monitoring and management systems, our data centers provide effective oversight and maintenance capabilities, ensuring reliable operations through real-time alerts and fault localization.</li>
          </ul>
        </div>
      </article>

      <!-- 2 - Build Your Data Center Like LEGO (Evolve From - Hotspot diagrams) -->
      <article class="soeteck-prefab-detail-block soeteck-row-models">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>2 - </span>Build Your Data Center Like LEGO</h3>
        <p class="soeteck-prefab-rich-text">At SOETECK, we believe in the power of modularity. Our row modular data center solutions allow you to build and expand your infrastructure effortlessly, much like assembling with LEGO bricks. Each component can be easily added or modified to fit your evolving needs.</p>

        <h4 class="soeteck-minor-title soeteck-title-bordered">{ROW_EVOLVE_RACK.title}</h4>
        <div class="soeteck-prefab-rich-text">
          <p>The integrated rack cooling cabinet-based row modular data center provides a compact solution optimized for energy efficiency. With cooling capacities from 3.5 kW to 90 kW, it can handle high-power applications effectively. Featuring advanced security measures and comprehensive monitoring capabilities, this design ensures a secure and resilient operational environment.</p>
        </div>
        <div class="soeteck-row-evolve-grid">
          {ROW_EVOLVE_RACK.images.map((item, idx) => (
            <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
              <div class="soeteck-prefab-hotspot__media">
                <img class="soeteck-prefab-hotspot__image" src={item.image} alt={ROW_EVOLVE_RACK.title} width="300" height="300" loading="lazy" />
                {item.hotspots.map((pin, pi) => (
                  <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={`rack-evo-${idx}-${pi}`} style={{ '--x': pin.x, '--y': pin.y } as any} aria-expanded="false" aria-label={pin.label}>
                    <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                    <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                    <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{pin.label}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <h4 class="soeteck-minor-title soeteck-title-bordered">{ROW_EVOLVE_INROW.title}</h4>
        <div class="soeteck-prefab-rich-text">
          <p>The in-row cooling cabinet-based row modular data center supports high-density deployments with power capacities up to 20 kW per cabinet. Its modular design allows for easy scalability, adapting effortlessly to business growth. With IP55 protection and real-time monitoring, it enhances operational efficiency while minimizing energy consumption.</p>
        </div>
        <div class="soeteck-row-evolve-grid">
          {ROW_EVOLVE_INROW.images.map((item, idx) => (
            <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
              <div class="soeteck-prefab-hotspot__media">
                <img class="soeteck-prefab-hotspot__image" src={item.image} alt={ROW_EVOLVE_INROW.title} width="300" height="300" loading="lazy" />
                {item.hotspots.map((pin, pi) => (
                  <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={`inrow-evo-${idx}-${pi}`} style={{ '--x': pin.x, '--y': pin.y } as any} aria-expanded="false" aria-label={pin.label}>
                    <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                    <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                    <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{pin.label}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="soeteck-prefab-rich-text">
          <p>Our row modular data center solutions are designed with advanced modularity and flexibility in mind. Each cabinet incorporates expandable monitoring systems that communicate via bus-level protocols, allowing for seamless integration of additional critical equipment in the future. The modular cooling options offer various capacities, from 3.5 kW to 12 kW for rack cooling and 5 kW to 90 kW for row cooling, ensuring efficient thermal management. Additionally, the power system is modular, ranging from 3 kVA to 200 kVA, so you can easily adapt and expand your power capabilities as needed. With features like IP55 protection against dust and water and a robust design for high-density deployments of up to 20 kW per cabinet, your data center will maintain security, reliability, and efficiency as it grows.</p>
        </div>
      </article>

      <!-- 3 - Core Infrastructure Modules + Critical Power + Thermal Management -->
      <article class="soeteck-prefab-detail-block soeteck-prefab-modules">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>3 - </span>Core Infrastructure Modules</h3>
        <div class="soeteck-prefab-rich-text soeteck-prefab-modules__lead">
          <p>The SOETECK row modular data center solution consists of several key components, including the cabinet system, thermal control system, critical power supply, security system and dynamic environment system.</p>
        </div>
        <div class="soeteck-prefab-module-grid">
          {ROW_CORE_MODULES.map((module) => (
            <article class="soeteck-prefab-module-card">
              <span class={`soeteck-prefab-module-card__icon soeteck-prefab-module-card__icon--${module.icon}`} aria-hidden="true"></span>
              <h3 class="soeteck-card-title">{module.title}</h3>
              <p>{module.text}</p>
            </article>
          ))}
        </div>

        <!-- Critical Power -->
        <section class="soeteck-prefab-product-group" aria-labelledby="row-critical-power-title">
          <div class="soeteck-prefab-rich-text">
            <h4 id="row-critical-power-title" class="soeteck-minor-title soeteck-title-bordered">Critical Power</h4>
            <p>{ROW_CRITICAL_POWER_TEXT}</p>
          </div>
          <div class="soeteck-prefab-product-gallery-grid" data-row-gallery>
            {ROW_CRITICAL_POWER_PRODUCTS.map((product, pIdx) => {
              const panelId = `row-critical-power-${pIdx}`;
              return (
                <article class="soeteck-prefab-product-gallery" data-product-panel={panelId}>
                  <div class="soeteck-prefab-product-gallery__stage">
                    {product.images.slice(0, 4).map((img, iIdx) => (
                      <a class={`soeteck-prefab-product-gallery__item${iIdx === 0 ? ' is-active' : ''}`}
                         href={`/${lang}/products/${product.slug}/`}
                         target="_blank" rel="noopener"
                         data-product-gallery-item={`${panelId}-${iIdx}`}>
                        <img src={img} alt={product.title} class="soeteck-prefab-product-gallery__image" loading="lazy" />
                      </a>
                    ))}
                  </div>
                  {product.images.slice(0, 4).length > 1 && (
                    <div class="soeteck-prefab-product-gallery__thumbs" role="tablist" aria-label={`${product.title} gallery`}>
                      {product.images.slice(0, 4).map((img, iIdx) => (
                        <button class={`soeteck-prefab-product-gallery__thumb${iIdx === 0 ? ' is-active' : ''}`}
                                type="button"
                                data-product-gallery-target={`${panelId}-${iIdx}`}
                                aria-selected={iIdx === 0 ? 'true' : 'false'}>
                          <img src={img} alt="" class="soeteck-prefab-product-gallery__thumb-image" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="soeteck-prefab-product-gallery__copy">
                    <a class="soeteck-card-title soeteck-prefab-product-gallery__title" href={`/${lang}/products/${product.slug}/`} target="_blank" rel="noopener">{product.title}</a>
                    <p class="soeteck-prefab-product-gallery__excerpt">{product.excerpt}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Thermal Management -->
        <section class="soeteck-prefab-product-group" aria-labelledby="row-thermal-title">
          <div class="soeteck-prefab-rich-text">
            <h4 id="row-thermal-title" class="soeteck-minor-title soeteck-title-bordered">Thermal Management</h4>
            <p>{ROW_THERMAL_MANAGEMENT_TEXT}</p>
          </div>
          <div class="soeteck-prefab-product-gallery-grid" data-row-gallery>
            {ROW_THERMAL_PRODUCTS.map((product, pIdx) => {
              const panelId = `row-thermal-${pIdx}`;
              return (
                <article class="soeteck-prefab-product-gallery" data-product-panel={panelId}>
                  <div class="soeteck-prefab-product-gallery__stage">
                    {product.images.slice(0, 4).map((img, iIdx) => (
                      <a class={`soeteck-prefab-product-gallery__item${iIdx === 0 ? ' is-active' : ''}`}
                         href={`/${lang}/products/${product.slug}/`}
                         target="_blank" rel="noopener"
                         data-product-gallery-item={`${panelId}-${iIdx}`}>
                        <img src={img} alt={product.title} class="soeteck-prefab-product-gallery__image" loading="lazy" />
                      </a>
                    ))}
                  </div>
                  {product.images.slice(0, 4).length > 1 && (
                    <div class="soeteck-prefab-product-gallery__thumbs" role="tablist" aria-label={`${product.title} gallery`}>
                      {product.images.slice(0, 4).map((img, iIdx) => (
                        <button class={`soeteck-prefab-product-gallery__thumb${iIdx === 0 ? ' is-active' : ''}`}
                                type="button"
                                data-product-gallery-target={`${panelId}-${iIdx}`}
                                aria-selected={iIdx === 0 ? 'true' : 'false'}>
                          <img src={img} alt="" class="soeteck-prefab-product-gallery__thumb-image" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="soeteck-prefab-product-gallery__copy">
                    <a class="soeteck-card-title soeteck-prefab-product-gallery__title" href={`/${lang}/products/${product.slug}/`} target="_blank" rel="noopener">{product.title}</a>
                    <p class="soeteck-prefab-product-gallery__excerpt">{product.excerpt}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      </article>
    </div>
  </section>

  <!-- Specs Table -->
  <section class="soeteck-prefab-section soeteck-prefab-specs">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Featured Models and Specifications</h2>
      <div class="soeteck-prefab-table-wrap">
        <table class="soeteck-prefab-spec-table">
          <thead>
            <tr>
              <th scope="col">Models</th>
              {ROW_SPEC_COLUMNS.map((col) => (
                <th scope="col">{col.model}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {ROW_SPEC_ROWS.map((row) => (
              <tr>
                <th scope="row">{row[0]}</th>
                {row.slice(1).map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="soeteck-prefab-pdf-link"><a href={brochureUrl} target="_blank" rel="noopener"><span aria-hidden="true">PDF</span>SOETECK Row Modular Data Center Solution.pdf</a></p>
    </div>
  </section>

  <!-- Scenarios -->
  <section class="soeteck-prefab-section soeteck-prefab-scenarios">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Who Might Need Our RMDCs?</h2>
      <p class="soeteck-prefab-section__subtitle">Application Scenarios: An integration of Power, Cooling &amp; Infrastructure Modules Supporting Reliable IT Operations &ndash; Where Row Modular DC Delivers Unique Value</p>
      <div class="soeteck-prefab-scenario-grid">
        {ROW_SCENARIOS.map((scenario) => (
          <article class="soeteck-prefab-scenario-card" data-scenario-card>
            <img class="soeteck-prefab-scenario-card__image" src={scenario.image} alt={scenario.title} width="436" height="237" loading="lazy" />
            <div class="soeteck-prefab-scenario-card__body">
              <h3 class="soeteck-card-title">{scenario.title}</h3>
              <div class="soeteck-prefab-scenario-card__tabs" role="tablist" aria-label={`${scenario.title} details`}>
                <button class="soeteck-prefab-scenario-card__tab is-active" type="button" role="tab" aria-selected="true" data-scenario-tab="benefits">Solution Benefits</button>
                <button class="soeteck-prefab-scenario-card__tab" type="button" role="tab" aria-selected="false" data-scenario-tab="pain">Critical Pain Points</button>
              </div>
              <div class="soeteck-prefab-scenario-card__panel is-active" data-scenario-panel="benefits">
                <div class="soeteck-prefab-scenario-card__tags">
                  {scenario.benefits.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <p>{scenario.solution}</p>
              </div>
              <div class="soeteck-prefab-scenario-card__panel" data-scenario-panel="pain" hidden>
                <div class="soeteck-prefab-scenario-card__tags">
                  {scenario.pain_points.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <p>{scenario.problem}</p>
              </div>
              <p><strong>{scenario.application}</strong></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Client Cases -->
  <section class="soeteck-prefab-section soeteck-prefab-cases">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Check Our Featured Client Cases</h2>
      <div class="soeteck-prefab-case-grid">
        {PREFAB_CLIENT_CASES.map((c) => (
          <article class="soeteck-prefab-case-card">
            <a class="soeteck-prefab-case-card__media" href={`/${lang}/news-and-insights/client-case-studies/${c.slug}/`}>
              <img class="soeteck-prefab-case-card__image" src={c.imgSrc} alt={c.title} width="436" height="240" loading="lazy" />
            </a>
            <div class="soeteck-prefab-case-card__body">
              <h3 class="soeteck-card-title"><a href={`/${lang}/news-and-insights/client-case-studies/${c.slug}/`}>{c.title}</a></h3>
              <p>{c.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="soeteck-cta" id="row-inquiry">
    <div class="soeteck-container soeteck-cta__inner">
      <div>
        <p class="soeteck-eyebrow">Talk to an Engineer</p>
        <h2>Get in Touch with SOETECK</h2>
        <p>Share your facility requirements and get a practical solution path. Tell us your project type, capacity needs, and timeline — our team will help identify the right configuration.</p>
        <ul class="soeteck-cta__checks">
          <li>Project consultation</li>
          <li>Technical configuration support</li>
          <li>Regional follow-up</li>
        </ul>
      </div>
      <div class="soeteck-cta__actions">
        <a class="soeteck-cta__button" href={`/${lang}/contact/`}>Contact Us</a>
        <a class="soeteck-cta__button soeteck-cta__button--outline" href={brochureUrl} target="_blank" rel="noopener">Download Brochure</a>
      </div>
    </div>
  </section>
</div>

<style is:global>
  .soeteck-row-banner__subtitle {
    max-width: 800px;
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--soeteck-text-lg, clamp(1rem, 1.6vw, 1.2rem));
    font-weight: 400;
    line-height: 1.6;
  }

  /* Overview grid */
  .soeteck-row-overview__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 4.5vw, 54px);
    align-items: start;
  }

  .soeteck-row-overview__grid p {
    color: var(--soeteck-text-soft);
    font-size: var(--soeteck-text-md);
    line-height: 1.75;
    margin-bottom: 16px;
  }

  /* Two hotspot diagrams — tab switching */
  .soeteck-row-hotspot-tab-bar {
    display: inline-flex;
    gap: 0;
    margin: 0 auto 24px;
    border-bottom: 2px solid var(--soeteck-border, #d7dce3);
  }

  .soeteck-row-hotspot-tabs {
    text-align: center;
  }

  .soeteck-row-hotspot-tab {
    position: relative;
    min-height: 36px;
    padding: 0 24px 10px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #697386;
    cursor: pointer;
    font: inherit;
    font-size: var(--soeteck-text-md, 1rem);
    font-weight: 600;
    transition: color 180ms ease;
  }

  .soeteck-row-hotspot-tab::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;
    height: 2px;
    background: transparent;
    transition: background-color 180ms ease;
  }

  .soeteck-row-hotspot-tab:hover,
  .soeteck-row-hotspot-tab.is-active { color: var(--soeteck-primary-dark, #0f5b9e); }

  .soeteck-row-hotspot-tab.is-active::after { background: var(--soeteck-primary, #1a85e5); }

  .soeteck-row-hotspot-panel:not(.is-active) { display: none; }

  .soeteck-row-hotspot-panel .soeteck-prefab-hotspot__media {
    margin: 0 auto;
  }

  .soeteck-row-hotspot-panel .soeteck-prefab-hotspot__image {
    display: block;
    margin: 0 auto;
  }

  /* Rich text base styles (match Prefab/Cabinet pages) */
  .soeteck-prefab-rich-text {
    color: var(--soeteck-text-soft);
    font-size: var(--soeteck-text-md);
    line-height: 1.75;
  }

  .soeteck-prefab-rich-text p { color: inherit; }
  .soeteck-prefab-rich-text strong { color: var(--soeteck-text); }
  .soeteck-prefab-rich-text a { color: var(--soeteck-primary); }
  .soeteck-prefab-rich-text a:hover { color: var(--soeteck-primary-dark); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .soeteck-prefab-rich-text ul { padding-left: 1.25rem; }
  .soeteck-prefab-rich-text > *:last-child { margin-bottom: 0; }

  .soeteck-prefab-detail-block__copy {
    max-width: 980px;
    margin: clamp(28px, 4vw, 44px) auto 0;
  }

  /* Evolve From cards */
  .soeteck-row-evolve-grid {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(16px, 2vw, 24px);
    margin-bottom: 32px;
  }

  .soeteck-row-evolve-grid:last-child {
    margin-bottom: 0;
  }

  .soeteck-row-evolve-grid .soeteck-prefab-hotspot {
    display: block;
    justify-content: flex-start;
  }

  .soeteck-row-evolve-grid .soeteck-prefab-hotspot__media {
    width: auto;
  }

  .soeteck-row-evolve-grid .soeteck-prefab-hotspot__image {
    max-height: 200px;
    width: auto;
    object-fit: contain;
  }

  /* Scenario cards — tab design */
  .soeteck-prefab-scenario-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.4vw, 32px);
  }

  .soeteck-prefab-scenario-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--soeteck-border);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .soeteck-prefab-scenario-card:hover {
    border-color: rgba(26, 133, 229, 0.28);
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
    transform: translateY(-2px);
  }

  .soeteck-prefab-scenario-card__image {
    display: block;
