---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getUITranslation } from '@/lib/translations';
import type { AdaptedPage } from '@/lib/page-adapter';

interface Props {
  page: AdaptedPage;
  lang?: string;
}

const { page, lang = 'en' } = Astro.props;
const t = (key: string): string => getUITranslation(lang, key);
const contentHtml = page.source.page?.contentHtml ?? '';
const modified = page.source.page?.modified ?? null;
const localeMap: Record<string, string> = { en: 'en-US', zh: 'zh-CN', ru: 'ru-RU', pt: 'pt-BR', es: 'es-ES' };
const dateLocale = localeMap[lang] ?? 'en-US';
const displayDate = modified ? new Date(modified).toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---

<div class="soeteck-simple-page">
  <div class="soeteck-container soeteck-simple-page__hero">
    <Breadcrumbs items={page.breadcrumbs} class="soeteck-breadcrumbs--hero" lang={lang} />
    <div class="soeteck-simple-page__header">
      <h1 class="soeteck-page-title">{page.title}</h1>
      {displayDate && (
        <p class="soeteck-simple-page__kicker">{t('common.lastUpdated')}: {displayDate}</p>
      )}
    </div>
  </div>

  <div class="soeteck-container soeteck-simple-page__body">
    {contentHtml ? (
      <div class="entry-content soeteck-simple-page__content" set:html={contentHtml}></div>
    ) : (
      <p class="soeteck-simple-page__empty">No content available.</p>
    )}
  </div>
</div>

<style>
  .soeteck-simple-page {
    background: var(--soeteck-white);
  }

  .soeteck-simple-page__hero {
    padding: 0 0 clamp(32px, 5vw, 64px);
  }

  .soeteck-simple-page__header {
    margin-top: 28px;
  }

  .soeteck-simple-page__header h1 {
    margin: 0;
    color: var(--soeteck-text);
    font-size: clamp(2.25rem, 5vw, 4.75rem);
    font-weight: var(--soeteck-weight-bold);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .soeteck-simple-page__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 16px 0 0;
    color: var(--soeteck-muted);
    font-size: var(--soeteck-text-sm);
    font-weight: var(--soeteck-weight-medium);
    line-height: 1.4;
  }

  .soeteck-simple-page__body {
    padding: 0 0 var(--soeteck-section-y);
  }

  .soeteck-simple-page__content {
    color: var(--soeteck-text-soft);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.82;
  }

  .soeteck-simple-page__content :global(> *) {
    scroll-margin-top: 110px;
  }

  .soeteck-simple-page__content :global(> * + *) {
    margin-top: 1.2rem;
  }

  .soeteck-simple-page__content :global(> :first-child) {
    margin-top: 0;
  }

  .soeteck-simple-page__content :global(h2) {
    margin-top: clamp(42px, 5vw, 68px);
    margin-bottom: 18px;
    color: var(--soeteck-text);
    letter-spacing: -0.025em;
  }

  .soeteck-simple-page__content :global(h3) {
    margin-top: clamp(28px, 4vw, 44px);
    margin-bottom: 12px;
    color: var(--soeteck-text);
  }

  .soeteck-simple-page__content :global(p) {
    margin-bottom: 0;
  }

  .soeteck-simple-page__content :global(ul),
  .soeteck-simple-page__content :global(ol) {
    padding-left: 1.4rem;
    list-style-position: outside;
  }

  .soeteck-simple-page__content :global(li + li) {
    margin-top: 0.55rem;
  }

  .soeteck-simple-page__content :global(a) {
    color: var(--soeteck-primary);
  }

  .soeteck-simple-page__content :global(a:hover) {
    color: var(--soeteck-primary-dark);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .soeteck-simple-page__content :global(img),
  .soeteck-simple-page__content :global(figure) {
    border-radius: var(--soeteck-radius);
  }

  .soeteck-simple-page__empty {
    color: var(--soeteck-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .soeteck-simple-page__header h1 {
      font-size: clamp(2rem, 10vw, 3rem);
      letter-spacing: -0.03em;
    }

    .soeteck-simple-page__content {
      font-size: 1rem;
      line-height: 1.78;
    }
  }
</style>
