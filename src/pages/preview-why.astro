---
/**
 * Preview page — Why section redesign options (Variant C).
 * Access: http://localhost:4321/preview-why/
 *
 * Option A — 6-step delivery strip between stats and cards
 * Option B — Delivery card replaces Speed card
 * Option C — 5-card layout (3+2), delivery added
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HOME_EN } from '@/components/home/home-content';

const c = HOME_EN;
const why = c.whySoeteck;
const timeline = c.timeline;

function fmt(d: string | null): string {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
  catch { return d; }
}
---

<BaseLayout title="Preview: Why Section — Variant C" lang="en" canonical="https://soeteck.com/preview-why/" robots="noindex">
  <div style="padding:40px 24px; background:var(--soeteck-navy); color:#fff;">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:var(--soeteck-primary); font-size:12px; letter-spacing:.16em; text-transform:uppercase; margin:0 0 8px;">Variant C · Why Section</p>
      <h1 style="font-size:26px; margin:0 0 8px;">Why SOETECK 重构方案（DeliveryLight 合并）</h1>
      <p style="color:rgba(255,255,255,.8); margin:0;">三种方式将交付流程融入 Why 板块，删除独立 DeliveryLightSection</p>
    </div>
  </div>

  <!-- ═══ Option A — Delivery strip between stats and cards ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(56px,7vw,80px) 0;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Option A · 统计与卡片之间插入交付流程带</p>
      <p class="opt-why">6 步精简流程条（序号+标题），水平排列，无图标无描述</p>

      <!-- Head -->
      <div style="max-width:760px; margin:0 auto 48px; text-align:center;">
        <p style="margin:0 0 10px; color:var(--soeteck-primary); font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase;">{why.eyebrow}</p>
        <h2 style="margin:0; font-size:clamp(1.85rem,3.1vw,2.5rem); font-weight:700; color:var(--soeteck-text);">{why.title}</h2>
        <p style="margin:16px auto 0; max-width:620px; font-size:1.05rem; line-height:1.7; color:var(--soeteck-text-soft);">{why.text}</p>
      </div>

      <!-- Stats row (same as original) -->
      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:24px; margin-bottom:48px; padding-bottom:40px; border-bottom:1px solid var(--soeteck-border-soft);">
        {why.stats.map((s) => (
          <div style="text-align:center;">
            <span style="display:block; font-size:clamp(2rem,3.5vw,2.8rem); font-weight:800; line-height:1; color:var(--soeteck-text);">{s.value}<span style="color:var(--soeteck-primary);">{s.suffix}</span></span>
            <span style="display:block; margin-top:8px; font-size:14px; color:var(--soeteck-muted);">{s.label}</span>
          </div>
        ))}
      </div>

      <!-- Delivery strip (compact 6-step) -->
      <div style="margin-bottom:48px; padding:32px 0; border-bottom:1px solid var(--soeteck-border-soft);">
        <p style="margin:0 0 24px; font-size:15px; font-weight:700; color:var(--soeteck-primary); text-transform:uppercase; letter-spacing:.1em; text-align:center;">End-to-End Delivery</p>
        <div style="display:grid; grid-template-columns:repeat(6,1fr); gap:16px; text-align:center;">
          {timeline.steps.map((step) => (
            <div>
              <div style="width:40px; height:40px; margin:0 auto 10px; border-radius:50%; background:var(--soeteck-primary-soft); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; color:var(--soeteck-primary);">{step.num}</div>
              <span style="font-size:13px; font-weight:600; color:var(--soeteck-text);">{step.title}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 4 cards (same as original) -->
      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:24px; margin-bottom:48px;">
        {why.items.map((item) => (
          <div style="padding:30px 24px; background:var(--soeteck-surface); border:1px solid var(--soeteck-border-soft); border-radius:14px;">
            <div style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:10px; background:var(--soeteck-primary-soft); color:var(--soeteck-primary); margin-bottom:18px;">
              {item.icon === 'factory' && '<svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M4 28V16l7 4V16l7 4V9h7v19H4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>'}
            </div>
            <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700; color:var(--soeteck-text);">{item.title}</h3>
            <p style="margin:0; font-size:14px; line-height:1.6; color:var(--soeteck-muted);">{item.text}</p>
          </div>
        ))}
      </div>

      <!-- Certs -->
      <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:12px; padding-top:40px; border-top:1px solid var(--soeteck-border-soft);">
        {why.certs.map((c) => <span style="padding:8px 18px; border:1px solid var(--soeteck-border); border-radius:999px; font-size:14px; font-weight:600; color:var(--soeteck-muted);">{c}</span>)}
      </div>
    </div>
  </section>

  <!-- ═══ Option B — Delivery card replaces Speed card ═══ -->
  <section style="background:var(--soeteck-surface); padding:clamp(56px,7vw,80px) 0; border-top:1px solid var(--soeteck-border-soft);">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Option B · 交付卡替换 Speed 卡</p>
      <p class="opt-why">Speed 差异化与统计重叠，改为"End-to-End Delivery"卡，内嵌 6 步迷你时间线</p>

      <div style="max-width:760px; margin:0 auto 48px; text-align:center;">
        <p style="margin:0 0 10px; color:var(--soeteck-primary); font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase;">{why.eyebrow}</p>
        <h2 style="margin:0; font-size:clamp(1.85rem,3.1vw,2.5rem); font-weight:700; color:var(--soeteck-text);">{why.title}</h2>
        <p style="margin:16px auto 0; max-width:620px; font-size:1.05rem; line-height:1.7; color:var(--soeteck-text-soft);">{why.text}</p>
      </div>

      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:24px; margin-bottom:48px; padding-bottom:40px; border-bottom:1px solid var(--soeteck-border-soft);">
        {why.stats.map((s) => (
          <div style="text-align:center;">
            <span style="display:block; font-size:clamp(2rem,3.5vw,2.8rem); font-weight:800; line-height:1; color:var(--soeteck-text);">{s.value}<span style="color:var(--soeteck-primary);">{s.suffix}</span></span>
            <span style="display:block; margin-top:8px; font-size:14px; color:var(--soeteck-muted);">{s.label}</span>
          </div>
        ))}
      </div>

      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:24px; margin-bottom:48px;">
        {why.items.slice(0, 3).map((item) => (
          <div style="padding:30px 24px; background:var(--soeteck-white); border:1px solid var(--soeteck-border-soft); border-radius:14px;">
            <div style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:10px; background:var(--soeteck-primary-soft); color:var(--soeteck-primary); margin-bottom:18px;">
              <svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M4 28V16l7 4V16l7 4V9h7v19H4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            </div>
            <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700; color:var(--soeteck-text);">{item.title}</h3>
            <p style="margin:0; font-size:14px; line-height:1.6; color:var(--soeteck-muted);">{item.text}</p>
          </div>
        ))}
        <!-- Delivery card replaces Speed -->
        <div style="padding:30px 24px; background:var(--soeteck-white); border:1px solid var(--soeteck-border-soft); border-radius:14px;">
          <div style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:10px; background:var(--soeteck-primary-soft); color:var(--soeteck-primary); margin-bottom:18px;">
            <svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M6 10h12l6 6h-4l-4-4H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M6 16h20v5H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </div>
          <h3 style="margin:0 0 10px; font-size:1.1rem; font-weight:700; color:var(--soeteck-text);">End-to-End Delivery</h3>
          <div style="display:flex; flex-wrap:wrap; gap:6px 12px;">
            {timeline.steps.map((s) => (
              <span style="display:inline-flex; align-items:center; gap:4px; font-size:12px; font-weight:500; color:var(--soeteck-text-soft);">
                <span style="font-weight:700; color:var(--soeteck-primary);">{s.num}</span>
                {s.title}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:12px; padding-top:40px; border-top:1px solid var(--soeteck-border-soft);">
        {why.certs.map((c) => <span style="padding:8px 18px; border:1px solid var(--soeteck-border); border-radius:999px; font-size:14px; font-weight:600; color:var(--soeteck-muted);">{c}</span>)}
      </div>
    </div>
  </section>

  <!-- ═══ Option C — 5-card layout (3+2) ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(56px,7vw,80px) 0;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Option C · 5 卡布局（3+2），新增交付卡</p>
      <p class="opt-why">保留 4 原卡 + 新增"End-to-End Delivery"卡，网格 3+2 两行</p>

      <div style="max-width:760px; margin:0 auto 48px; text-align:center;">
        <p style="margin:0 0 10px; color:var(--soeteck-primary); font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase;">{why.eyebrow}</p>
        <h2 style="margin:0; font-size:clamp(1.85rem,3.1vw,2.5rem); font-weight:700; color:var(--soeteck-text);">{why.title}</h2>
        <p style="margin:16px auto 0; max-width:620px; font-size:1.05rem; line-height:1.7; color:var(--soeteck-text-soft);">{why.text}</p>
      </div>

      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:24px; margin-bottom:48px; padding-bottom:40px; border-bottom:1px solid var(--soeteck-border-soft);">
        {why.stats.map((s) => (
          <div style="text-align:center;">
            <span style="display:block; font-size:clamp(2rem,3.5vw,2.8rem); font-weight:800; line-height:1; color:var(--soeteck-text);">{s.value}<span style="color:var(--soeteck-primary);">{s.suffix}</span></span>
            <span style="display:block; margin-top:8px; font-size:14px; color:var(--soeteck-muted);">{s.label}</span>
          </div>
        ))}
      </div>

      <!-- 5 cards: 3 cards in row 1, 2 cards + empty in row 2 -->
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-bottom:24px;">
        {why.items.slice(0, 3).map((item) => (
          <div style="padding:30px 24px; background:var(--soeteck-surface); border:1px solid var(--soeteck-border-soft); border-radius:14px;">
            <div style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:10px; background:var(--soeteck-primary-soft); color:var(--soeteck-primary); margin-bottom:18px;"><svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M4 28V16l7 4V16l7 4V9h7v19H4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div>
            <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700; color:var(--soeteck-text);">{item.title}</h3>
            <p style="margin:0; font-size:14px; line-height:1.6; color:var(--soeteck-muted);">{item.text}</p>
          </div>
        ))}
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;">
        {why.items.slice(3).map((item) => (
          <div style="padding:30px 24px; background:var(--soeteck-surface); border:1px solid var(--soeteck-border-soft); border-radius:14px;">
            <div style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:10px; background:var(--soeteck-primary-soft); color:var(--soeteck-primary); margin-bottom:18px;"><svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M4 28V16l7 4V16l7 4V9h7v19H4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div>
            <h3 style="margin:0 0 8px; font-size:1.1rem; font-weight:700; color:var(--soeteck-text);">{item.title}</h3>
            <p style="margin:0; font-size:14px; line-height:1.6; color:var(--soeteck-muted);">{item.text}</p>
          </div>
        ))}
        <div style="padding:30px 24px; background:var(--soeteck-surface); border:1px solid var(--soeteck-border-soft); border-radius:14px;">
          <div style="width:48px; height:48px; display:flex; align-items:center; justify-content:center; border-radius:10px; background:var(--soeteck-primary-soft); color:var(--soeteck-primary); margin-bottom:18px;"><svg width="26" height="26" viewBox="0 0 32 32" fill="none"><path d="M6 10h12l6 6h-4l-4-4H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M6 16h20v5H6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div>
          <h3 style="margin:0 0 10px; font-size:1.1rem; font-weight:700; color:var(--soeteck-text);">End-to-End Delivery</h3>
          <div style="display:flex; flex-wrap:wrap; gap:6px 12px;">
            {timeline.steps.map((s) => (
              <span style="display:inline-flex; align-items:center; gap:4px; font-size:12px; font-weight:500; color:var(--soeteck-text-soft);">
                <span style="font-weight:700; color:var(--soeteck-primary);">{s.num}</span>
                {s.title}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:48px; padding-top:40px; border-top:1px solid var(--soeteck-border-soft);">
        {why.certs.map((c) => <span style="padding:8px 18px; border:1px solid var(--soeteck-border); border-radius:999px; font-size:14px; font-weight:600; color:var(--soeteck-muted);">{c}</span>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .opt-label { margin: 0; color: var(--soeteck-primary); font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .opt-why { margin: 4px 0 0 14px; font-size: 14px; color: var(--soeteck-muted); }
</style>