---
/**
 * DeliverySection — End-to-end delivery process.
 * Image (factory) on the left, 6-step timeline on the right.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props {
  data: HomeContent['services'];
}

const { data } = Astro.props;
---

<section class="home-delivery" aria-labelledby="delivery-title">
  <div class="soeteck-container">
    <div class="home-delivery__layout">
      <div class="home-delivery__visual">
        <div class="home-delivery__image-wrap">
          <img src={data.image.path} alt={data.image.alt} width="560" height="420" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="home-delivery__info">
        <p class="home-section__eyebrow">{data.eyebrow}</p>
        <h2 id="delivery-title" class="home-section__title">{data.title}</h2>
        <p class="home-section__lead">{data.text}</p>
        <div class="home-delivery__timeline">
          {data.steps.map((step) => (
            <div class="home-delivery__step">
              <span class="home-delivery__step-num">{step.num}</span>
              <div class="home-delivery__step-body">
                <h4 class="home-delivery__step-title">{step.title}</h4>
                <p class="home-delivery__step-text">{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ═══ DELIVERY ═══════════════════════════════════════════════ */
.home-delivery {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-surface);
}

.home-delivery :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

.home-delivery__layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(40px, 5vw, 72px);
  align-items: center;
}

/* ── Section head ─────────────────────────────────────────── */
.home-section__eyebrow { margin: 0 0 10px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(1.85rem, 3.1vw, 2.5rem); font-weight: 700; line-height: 1.14; color: var(--soeteck-text); }
.home-section__lead { margin: 18px 0 0; font-size: 1.05rem; line-height: 1.7; color: var(--soeteck-text-soft); }

/* ── Visual ───────────────────────────────────────────────── */
.home-delivery__image-wrap {
  border-radius: var(--soeteck-radius-lg);
  overflow: hidden;
  box-shadow: 0 16px 48px rgba(15, 23, 42, 0.1);
}
.home-delivery__image-wrap img {
  width: 100%;
  height: auto;
  display: block;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.home-delivery__info .home-section__title {
  font-size: clamp(1.6rem, 2.8vw, 2.2rem);
}

/* ── Timeline ─────────────────────────────────────────────── */
.home-delivery__timeline {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.home-delivery__step {
  display: flex;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--soeteck-border-soft);
}
.home-delivery__step:last-child { border-bottom: none; }

.home-delivery__step-num {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--soeteck-primary-soft);
  color: var(--soeteck-primary);
  font-size: 13px;
  font-weight: 700;
}

.home-delivery__step-body { flex: 1; }
.home-delivery__step-title {
  margin: 0 0 4px;
  font-size: var(--soeteck-text-md);
  font-weight: 700;
  color: var(--soeteck-text);
}
.home-delivery__step-text {
  margin: 0;
  font-size: var(--soeteck-text-sm);
  line-height: 1.6;
  color: var(--soeteck-text-soft);
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 991px) {
  .home-delivery__layout { grid-template-columns: 1fr; }
}
</style>
