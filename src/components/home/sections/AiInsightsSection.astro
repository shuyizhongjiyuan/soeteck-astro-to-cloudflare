---
/**
 * AiInsightsSection — immersive dark background section highlighting
 * AI infrastructure thinking and SOETECK's positioning.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props { data: HomeContent['aiInsights']; }

const { data } = Astro.props;
---

<section class="home-ai-insights" aria-labelledby="ai-insights-title">
  <div class="home-ai-insights__bg" aria-hidden="true">
    <img src="/hero/ai-insights-bg.png" alt="" width="2560" height="1440" />
    <div class="home-ai-insights__overlay"></div>
  </div>
  <div class="soeteck-container home-ai-insights__content">
    <p class="home-ai-insights__eyebrow">{data.eyebrow}</p>
    <h2 id="ai-insights-title" class="home-ai-insights__title">{data.title}</h2>
    <p class="home-ai-insights__subtitle">{data.subtitle}</p>
    <div class="home-ai-insights__points">
      {data.points.map((point) => (
        <div class="home-ai-insights__point">
          <h3 class="home-ai-insights__point-title">{point.title}</h3>
          <p class="home-ai-insights__point-text">{point.text}</p>
        </div>
      ))}
    </div>
    <a href={data.ctaLink} class="home-ai-insights__cta">{data.cta} →</a>
  </div>
</section>

<style>
  .home-ai-insights {
    position: relative;
    overflow: hidden;
    background: #061529;
    color: #fff;
    padding: clamp(80px, 10vw, 140px) 0;
  }

  .home-ai-insights__bg {
    position: absolute;
    inset: 0;
  }
  .home-ai-insights__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }
  .home-ai-insights__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6,21,41,0.7) 0%, rgba(6,21,41,0.95) 100%);
  }

  .home-ai-insights__content {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .home-ai-insights__eyebrow {
    margin: 0 0 20px;
    color: var(--soeteck-primary);
    font-size: var(--soeteck-text-sm);
    font-weight: bold;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-ai-insights__title {
    margin: 0 0 24px;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
  }

  .home-ai-insights__subtitle {
    margin: 0 0 48px;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.75;
    color: rgba(255,255,255,0.82);
    max-width: 760px;
  }

  .home-ai-insights__points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 48px;
  }

  .home-ai-insights__point {
    padding: 28px 24px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--soeteck-radius-lg);
  }

  .home-ai-insights__point-title {
    margin: 0 0 10px;
    font-size: var(--soeteck-text-md);
    font-weight: 700;
    color: #fff;
  }

  .home-ai-insights__point-text {
    margin: 0;
    font-size: var(--soeteck-text-sm);
    line-height: 1.7;
    color: rgba(255,255,255,0.72);
  }

  .home-ai-insights__cta {
    display: inline-flex;
    align-items: center;
    padding: 14px 32px;
    border-radius: 999px;
    background: var(--soeteck-primary);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    transition: background 0.3s, transform 0.2s;
  }

  .home-ai-insights__cta:hover {
    background: var(--soeteck-primary-dark);
    transform: translateY(-2px);
  }

  @media (max-width: 991px) {
    .home-ai-insights__points {
      grid-template-columns: 1fr;
    }
  }
</style>
