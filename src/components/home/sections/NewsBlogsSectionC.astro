---
/**
 * NewsBlogsSectionC — Unified news & blogs zone (Variant C).
 * 3-col editorial grid for each (N3 layout), non-card style with hairline
 * separators, rounded images, single View All.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';
import type { AdaptedArticleCard } from '@/lib/page-adapter';
import { getUITranslation } from '@/lib/translations';

interface Props {
  newsC: NonNullable<HomeContent['newsC']>;
  news: HomeContent['news'];
  newsArticles: AdaptedArticleCard[];
  blogArticles: AdaptedArticleCard[];
  lang: string;
}

const { newsC, news, newsArticles, blogArticles, lang } = Astro.props;
void lang;

function formatDate(d: string | null): string {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
  catch { return d; }
}
---

<section class="home-news-blogs" aria-labelledby="news-blogs-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="soeteck-eyebrow">{news.eyebrow}</p>
      <h2 id="news-blogs-title" class="home-section__title">{news.title}</h2>
      {news.text && <p class="home-section__lead">{news.text}</p>}
    </div>

    <div class="home-news-blogs__block">
      <div class="home-news-blogs__title-row">
        <p class="home-news-blogs__label">
          <span class="hnb-label-num">01</span>
          <span>{newsC.newsLabel}</span>
        </p>
      </div>
      <div class="home-news-blogs__grid">
        {newsArticles.length > 0 ? newsArticles.map((article) => (
          <a href={article.path} class="hnb-card">
            {article.featuredImage && (
              <div class="hnb-card__media">
                <img src={article.featuredImage.path} alt="" width="400" height="225" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="hnb-card__body">
              {article.date && <time class="hnb-card__date">{formatDate(article.date)}</time>}
              <span class="hnb-card__title">{article.title}</span>
              {article.excerpt && <p class="hnb-card__excerpt">{article.excerpt}</p>}
            </div>
          </a>
        )) : (
          <p class="hnb-empty">{getUITranslation(lang, 'common.noArticles')}</p>
        )}
      </div>
      <a href={newsC.newsLink} class="home-news-blogs__link">{newsC.viewAllNews}</a>
    </div>

    <div class="home-news-blogs__block">
      <div class="home-news-blogs__title-row">
        <p class="home-news-blogs__label">
          <span class="hnb-label-num">02</span>
          <span>{newsC.blogLabel}</span>
        </p>
      </div>
      <div class="home-news-blogs__grid">
        {blogArticles.length > 0 ? blogArticles.map((article) => (
          <a href={article.path} class="hnb-card">
            {article.featuredImage && (
              <div class="hnb-card__media">
                <img src={article.featuredImage.path} alt="" width="400" height="225" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="hnb-card__body">
              {article.date && <time class="hnb-card__date">{formatDate(article.date)}</time>}
              <span class="hnb-card__title">{article.title}</span>
              {article.excerpt && <p class="hnb-card__excerpt">{article.excerpt}</p>}
            </div>
          </a>
        )) : (
          <p class="hnb-empty">{getUITranslation(lang, 'common.noArticles')}</p>
        )}
      </div>
      <a href={newsC.blogLink} class="home-news-blogs__link">{newsC.viewAllBlogs}</a>
    </div>

    </div>
</section>

<style>
/* ═══ NEWS & BLOGS — unified editorial zone ═════════════════ */
.home-news-blogs {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-surface);
}
.home-news-blogs :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

/* ── Section head ─────────────────────────────────────────── */
.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
/* 6.1 标准 Eyebrow — 元素只挂规范基类 .soeteck-eyebrow，此处仅覆盖间距（全局基类 20px → 规范 25px） */
.home-section__head .soeteck-eyebrow { margin: 0 0 25px; padding: 0; }
.home-section__title { margin: 0; font-size: clamp(1.85rem, 3.1vw, 2.5rem); font-weight: 700; line-height: 1.14; color: var(--soeteck-text); }
.home-section__lead { margin: 14px auto 0; max-width: 620px; font-size: 1.05rem; line-height: 1.7; color: var(--soeteck-text-soft); }

/* ── Block ────────────────────────────────────────────────── */
.home-news-blogs__block { margin-bottom: 0; }
.home-news-blogs__block + .home-news-blogs__block {
  border-top: 1px solid var(--soeteck-border-soft);
  padding-top: 48px;
  margin-top: 48px;
}
.home-news-blogs__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 16px;
}
.home-news-blogs__link {
  display: inline-flex;
  margin-top: 20px;
  font-size: 14px;
  font-weight: 600;
  color: var(--soeteck-primary);
  text-decoration: none;
  transition: color 0.25s ease;
}
.home-news-blogs__link:hover { color: var(--soeteck-primary-dark); }
.home-news-blogs__label {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 0 16px;
  font-size: 18px;
  font-weight: 700;
  color: var(--soeteck-text);
}
.hnb-label-num {
  font-size: 18px;
  font-weight: 800;
  color: var(--soeteck-primary);
  letter-spacing: 0.04em;
  line-height: 1;
}
/* ── 3-col editorial grid ─────────────────────────────────── */
.home-news-blogs__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

/* ── Editorial card (no card box, hairline separator) ─────── */
.hnb-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  padding-bottom: 20px;
}

.hnb-card__media {
  aspect-ratio: 16 / 9;
  border-radius: 10px;
  overflow: hidden;
  background: var(--soeteck-media-bg);
  margin-bottom: 14px;
}
.hnb-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.hnb-card:hover .hnb-card__media img { transform: scale(1.04); }

.hnb-card__body { display: flex; flex-direction: column; }
.hnb-card__date { font-size: 12px; font-weight: 600; color: var(--soeteck-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
.hnb-card__title { font-size: 16px; font-weight: 600; color: var(--soeteck-text); line-height: 1.35; transition: color 0.25s ease; }
.hnb-card:hover .hnb-card__title { color: var(--soeteck-primary); }
.hnb-card__excerpt { margin: 6px 0 0; font-size: 13px; line-height: 1.6; color: var(--soeteck-text-soft); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.hnb-card__cta { margin-top: 10px; font-size: 13px; font-weight: 600; color: var(--soeteck-primary); transition: transform 0.2s ease; }
.hnb-card:hover .hnb-card__cta { transform: translateX(3px); }

.hnb-empty { font-size: 14px; color: var(--soeteck-muted); font-style: italic; }

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 991px) {
  .home-news-blogs__grid { grid-template-columns: 1fr; }
}
</style>