---
interface Props {
  title: string;
  buttonLabel: string;
  buttonHref: string;
  lang?: string;
}

const { title, buttonLabel, buttonHref, lang = 'en' } = Astro.props;
---

<section class="archive-cta">
  <div class="archive-cta__inner">
    <h2 class="archive-cta__title">{title}</h2>
    <a href={buttonHref} class="archive-cta__button">{buttonLabel}</a>
  </div>
</section>

<style>
  .archive-cta {
    margin-top: clamp(48px, 6vw, 80px);
    padding: var(--soeteck-section-y-sm) 0;
    background: var(--soeteck-text);
  }

  .archive-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    width: min(var(--soeteck-container), calc(100% - (var(--soeteck-gutter) * 2)));
    margin-inline: auto;
  }

  .archive-cta__title {
    margin: 0;
    color: #fff;
    font-weight: 700;
    letter-spacing: -0.025em;
    max-width: 680px;
  }

  .archive-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 48px;
    padding: 0 28px;
    border-radius: var(--soeteck-radius-sm);
    background: var(--soeteck-primary);
    color: #fff;
    font-size: var(--soeteck-text-md);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--soeteck-transition-fast),
                transform var(--soeteck-transition-fast);
  }

  .archive-cta__button:hover {
    background: var(--soeteck-primary-dark);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .archive-cta__inner {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

  }
</style>