---
import type { AdaptedPage } from '@/lib/page-adapter';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {
  CABINET_HERO_SUBTITLE, CABINET_OVERVIEW_PARAGRAPHS, CABINET_OVERVIEW_IMAGE,
  CABINET_HOTSPOTS, CABINET_HOTSPOT_IMAGE, CABINET_KEY_FEATURES,
  CABINET_FEATURED_MODELS, CABINET_MODELS_INTRO, CABINET_MODELS_OUTRO,
  CABINET_CORE_MODULES,
  CABINET_CRITICAL_POWER_TEXT, CABINET_CRITICAL_POWER_PRODUCTS,
  CABINET_THERMAL_MANAGEMENT_TEXT, CABINET_THERMAL_PRODUCTS,
  CABINET_SPEC_COLUMNS, CABINET_SPEC_ROWS,
  CABINET_SCENARIOS,
} from './cabinet-modular-content';
import { PREFAB_CLIENT_CASES } from './prefab-content';
import '@/styles/product-gallery.css';

export interface Props {
  page: AdaptedPage;
  lang: string;
}

const { page, lang } = Astro.props;
const brochureUrl = '/resources/Soeteck-Data-Center-Solution-Micro-Data-Center.pdf';
const bannerImage = '/resources/cabinet-modular-data-center-header.webp';
---

<div class="soeteck-cabinet-modular-page" data-cabinet-solution>
  <!-- Banner Hero -->
  <section class="soeteck-prefab-banner" aria-labelledby="cabinet-hero-title">
    <img class="soeteck-prefab-banner__image" src={bannerImage} alt="Cabinet modular data center" width="1920" height="600" loading="eager" fetchpriority="high" />
    <div class="soeteck-prefab-banner__overlay" aria-hidden="true"></div>
    <div class="soeteck-container soeteck-prefab-banner__inner">
      <Breadcrumbs items={page.breadcrumbs} class="soeteck-breadcrumbs--hero" lang={lang} />
      <div class="soeteck-prefab-banner__body">
        <h1 id="cabinet-hero-title" class="soeteck-page-title soeteck-prefab-banner__title">Cabinet Modular Data Center</h1>
        <p class="soeteck-cabinet-banner__subtitle">{CABINET_HERO_SUBTITLE}</p>
      </div>
    </div>
  </section>

  <!-- Overview: 2-column (text left, image right) -->
  <section class="soeteck-prefab-section soeteck-prefab-overview">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Smart, Efficient, and Scalable Cabinet Data Center</h2>
      <div class="soeteck-cabinet-overview__grid">
        <div class="soeteck-cabinet-overview__text">
          {CABINET_OVERVIEW_PARAGRAPHS.map((p) => (
            <div set:html={p}></div>
          ))}
        </div>
        <div class="soeteck-cabinet-overview__media">
          <img src={CABINET_OVERVIEW_IMAGE} alt="Cabinet modular data center overview" width="1024" height="798" loading="lazy" />
        </div>
      </div>
      <div class="soeteck-prefab-cta-row">
        <a class="soeteck-button-primary" href={brochureUrl} target="_blank" rel="noopener">GET BROCHURE</a>
        <a class="soeteck-button-outline" href={`/${lang}/contact/`}>CONTACT US</a>
      </div>
    </div>
  </section>

  <!-- Closer Look -->
  <section class="soeteck-prefab-section soeteck-prefab-closer">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Take a Closer Look at Our CMDCs</h2>

      <!-- 1 - Typical Design -->
      <article class="soeteck-prefab-detail-block">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>1 - </span>Typical Designs of CMDCs</h3>
        <div class="soeteck-prefab-hotspot" data-prefab-hotspots>
          <div class="soeteck-prefab-hotspot__media">
            <img class="soeteck-prefab-hotspot__image" src={CABINET_HOTSPOT_IMAGE} alt="Typical design of a cabinet modular data center" width="800" height="500" loading="lazy" />
            {CABINET_HOTSPOTS.map((hotspot, index) => (
              <button class="soeteck-prefab-hotspot__pin" type="button" data-hotspot-index={index} style={{ '--x': hotspot.x, '--y': hotspot.y } as any} aria-expanded="false" aria-label={hotspot.label}>
                <span class="soeteck-prefab-hotspot__pulse" aria-hidden="true"></span>
                <span class="soeteck-prefab-hotspot__core" aria-hidden="true">+</span>
                <span class="soeteck-prefab-hotspot__tooltip" role="tooltip">{hotspot.label}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="soeteck-prefab-rich-text soeteck-prefab-detail-block__copy">
          <p>The cabinet modular data center provides an integrated solution for power distribution, cooling management, fire safety, and structured cabling. It is designed to offer safety, reliability, and efficiency in a compact format.</p>
          <p><strong>Key Features:</strong></p>
          <ul>
            {CABINET_KEY_FEATURES.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </div>
      </article>

      <!-- 2 - Featured Models: 3-column grid, each = image + accordion -->
      <article class="soeteck-prefab-detail-block soeteck-cabinet-models">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>2 - </span>Featured Models</h3>
        <div class="soeteck-prefab-rich-text soeteck-cabinet-models__intro">
          <p>{CABINET_MODELS_INTRO}</p>
        </div>
        <div class="soeteck-cabinet-model-grid">
          {CABINET_FEATURED_MODELS.map((model, i) => (
            <div class="soeteck-cabinet-model-item">
              <div class="soeteck-cabinet-model-item__image-wrapper">
                <img class="soeteck-cabinet-model-item__image" src={model.image} alt={model.hotspotLabel} width="284" height="284" loading="lazy" />
                <button class="soeteck-cabinet-model-item__pin" type="button" style={{ '--x': model.hotspotPin.x, '--y': model.hotspotPin.y } as any} aria-expanded="false" aria-label={model.hotspotLabel}>
                  <span class="soeteck-cabinet-model-item__pulse" aria-hidden="true"></span>
                  <span class="soeteck-cabinet-model-item__core" aria-hidden="true">+</span>
                  <span class="soeteck-cabinet-model-item__tooltip" role="tooltip">{model.hotspotLabel}</span>
                </button>
              </div>
              <div class="soeteck-cabinet-accordion" data-cabinet-accordion>
                <div class="soeteck-cabinet-accordion__item" data-accordion-item>
                  <button class="soeteck-cabinet-accordion__header" type="button" aria-expanded="true" data-accordion-trigger={i}>
                    <span class="soeteck-cabinet-accordion__title">{model.accordionTitle}</span>
                    <span class="soeteck-cabinet-accordion__icon" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="icon-plus"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="icon-minus"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </span>
                  </button>
                  <div class="soeteck-cabinet-accordion__content" data-accordion-content={i}>
                    <div class="soeteck-cabinet-accordion__content-inner">
                      <p class="soeteck-cabinet-accordion__subhead">Integrated Systems:</p>
                      <ul class="soeteck-cabinet-check-list">
                        {model.integrated_systems.map((item) => (
                          <li><span class="soeteck-cabinet-check" aria-hidden="true">✓</span> {item}</li>
                        ))}
                      </ul>
                      <p class="soeteck-cabinet-accordion__subhead">Key Advantages:</p>
                      <ul class="soeteck-cabinet-bullet-list">
                        {model.key_advantages.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="soeteck-prefab-rich-text soeteck-cabinet-models__outro">
          <p>{CABINET_MODELS_OUTRO}</p>
        </div>
      </article>

      <!-- 3 - Core Infrastructure Modules + Critical Power + Thermal Management -->
      <article class="soeteck-prefab-detail-block soeteck-prefab-modules">
        <h3 class="soeteck-subsection-title soeteck-prefab-detail-block__title"><span>3 - </span>Core Infrastructure Modules</h3>
        <div class="soeteck-prefab-rich-text soeteck-prefab-modules__lead">
          <p>The SOETECK cabinet modular data center solution consists of several key components, including the cabinet system, thermal control system, critical power supply, security system and dynamic environment system. Here, you will find details about several core modules.</p>
        </div>
        <div class="soeteck-prefab-module-grid">
          {CABINET_CORE_MODULES.map((module) => (
            <article class="soeteck-prefab-module-card">
              <span class={`soeteck-prefab-module-card__icon soeteck-prefab-module-card__icon--${module.icon}`} aria-hidden="true"></span>
              <h3 class="soeteck-card-title">{module.title}</h3>
              <p>{module.text}</p>
            </article>
          ))}
        </div>

        <!-- Critical Power — Product Gallery Grid -->
        <section class="soeteck-prefab-product-group" aria-labelledby="cabinet-critical-power-title">
          <div class="soeteck-prefab-rich-text">
            <h4 id="cabinet-critical-power-title" class="soeteck-minor-title soeteck-title-bordered">Critical Power</h4>
            <p>{CABINET_CRITICAL_POWER_TEXT}</p>
          </div>
          <div class="soeteck-prefab-product-gallery-grid" data-cabinet-gallery>
            {CABINET_CRITICAL_POWER_PRODUCTS.map((product, pIdx) => {
              const panelId = `cabinet-critical-power-${pIdx}`;
              return (
                <article class="soeteck-prefab-product-gallery" data-product-panel={panelId}>
                  <div class="soeteck-prefab-product-gallery__stage">
                    {product.images.slice(0, 4).map((img, iIdx) => (
                      <a class={`soeteck-prefab-product-gallery__item${iIdx === 0 ? ' is-active' : ''}`}
                         href={`/${lang}/products/${product.slug}/`}
                         target="_blank" rel="noopener"
                         data-product-gallery-item={`${panelId}-${iIdx}`}>
                        <img src={img} alt={product.title} class="soeteck-prefab-product-gallery__image" loading="lazy" />
                      </a>
                    ))}
                  </div>
                  {product.images.slice(0, 4).length > 1 && (
                    <div class="soeteck-prefab-product-gallery__thumbs" role="tablist" aria-label={`${product.title} gallery`}>
                      {product.images.slice(0, 4).map((img, iIdx) => (
                        <button class={`soeteck-prefab-product-gallery__thumb${iIdx === 0 ? ' is-active' : ''}`}
                                type="button"
                                data-product-gallery-target={`${panelId}-${iIdx}`}
                                aria-selected={iIdx === 0 ? 'true' : 'false'}>
                          <img src={img} alt="" class="soeteck-prefab-product-gallery__thumb-image" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="soeteck-prefab-product-gallery__copy">
                    <a class="soeteck-card-title soeteck-prefab-product-gallery__title" href={`/${lang}/products/${product.slug}/`} target="_blank" rel="noopener">{product.title}</a>
                    <p class="soeteck-prefab-product-gallery__excerpt">{product.excerpt}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <!-- Thermal Management — Product Gallery Grid -->
        <section class="soeteck-prefab-product-group" aria-labelledby="cabinet-thermal-title">
          <div class="soeteck-prefab-rich-text">
            <h4 id="cabinet-thermal-title" class="soeteck-minor-title soeteck-title-bordered">Thermal Management</h4>
            <p>{CABINET_THERMAL_MANAGEMENT_TEXT}</p>
          </div>
          <div class="soeteck-prefab-product-gallery-grid" data-cabinet-gallery>
            {CABINET_THERMAL_PRODUCTS.map((product, pIdx) => {
              const panelId = `cabinet-thermal-${pIdx}`;
              return (
                <article class="soeteck-prefab-product-gallery" data-product-panel={panelId}>
                  <div class="soeteck-prefab-product-gallery__stage">
                    {product.images.slice(0, 4).map((img, iIdx) => (
                      <a class={`soeteck-prefab-product-gallery__item${iIdx === 0 ? ' is-active' : ''}`}
                         href={`/${lang}/products/${product.slug}/`}
                         target="_blank" rel="noopener"
                         data-product-gallery-item={`${panelId}-${iIdx}`}>
                        <img src={img} alt={product.title} class="soeteck-prefab-product-gallery__image" loading="lazy" />
                      </a>
                    ))}
                  </div>
                  {product.images.slice(0, 4).length > 1 && (
                    <div class="soeteck-prefab-product-gallery__thumbs" role="tablist" aria-label={`${product.title} gallery`}>
                      {product.images.slice(0, 4).map((img, iIdx) => (
                        <button class={`soeteck-prefab-product-gallery__thumb${iIdx === 0 ? ' is-active' : ''}`}
                                type="button"
                                data-product-gallery-target={`${panelId}-${iIdx}`}
                                aria-selected={iIdx === 0 ? 'true' : 'false'}>
                          <img src={img} alt="" class="soeteck-prefab-product-gallery__thumb-image" loading="lazy" />
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="soeteck-prefab-product-gallery__copy">
                    <a class="soeteck-card-title soeteck-prefab-product-gallery__title" href={`/${lang}/products/${product.slug}/`} target="_blank" rel="noopener">{product.title}</a>
                    <p class="soeteck-prefab-product-gallery__excerpt">{product.excerpt}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      </article>
    </div>
  </section>

  <!-- Specs Table -->
  <section class="soeteck-prefab-section soeteck-prefab-specs">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Featured Models and Specifications</h2>
      <div class="soeteck-prefab-table-wrap">
        <table class="soeteck-prefab-spec-table">
          <thead>
            <tr class="soeteck-prefab-spec-table__images">
              <th scope="col"></th>
              {CABINET_SPEC_COLUMNS.map((col) => (
                <th scope="col">
                  <img src={col.image} alt={col.model} width="249" height="282" loading="lazy" />
                </th>
              ))}
            </tr>
            <tr>
              <th scope="col">Models</th>
              {CABINET_SPEC_COLUMNS.map((col) => (
                <th scope="col">{col.model}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {CABINET_SPEC_ROWS.map((row) => (
              <tr>
                <th scope="row">{row[0]}</th>
                {row.slice(1).map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="soeteck-prefab-pdf-link"><a href={brochureUrl} target="_blank" rel="noopener"><span aria-hidden="true">PDF</span>SOETECK Cabinet Data Center Solution.pdf</a></p>
    </div>
  </section>


  <!-- Scenarios -->
  <section class="soeteck-prefab-section soeteck-prefab-scenarios">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Who Might Need Our CMDCs?</h2>
      <p class="soeteck-prefab-section__subtitle">Application Scenarios: An integration of Power, Cooling &amp; Infrastructure Modules Supporting Reliable IT Operations &ndash; Where Cabinet Modular DC Delivers Unique Value</p>
      <div class="soeteck-prefab-scenario-grid">
        {CABINET_SCENARIOS.map((scenario) => (
          <article class="soeteck-prefab-scenario-card" data-scenario-card>
            <img class="soeteck-prefab-scenario-card__image" src={scenario.image} alt={scenario.title} width="436" height="237" loading="lazy" />
            <div class="soeteck-prefab-scenario-card__body">
              <h3 class="soeteck-card-title">{scenario.title}</h3>
              <div class="soeteck-prefab-scenario-card__tabs" role="tablist" aria-label={`${scenario.title} details`}>
                <button class="soeteck-prefab-scenario-card__tab is-active" type="button" role="tab" aria-selected="true" data-scenario-tab="benefits">Solution Benefits</button>
                <button class="soeteck-prefab-scenario-card__tab" type="button" role="tab" aria-selected="false" data-scenario-tab="pain">Critical Pain Points</button>
              </div>
              <div class="soeteck-prefab-scenario-card__panel is-active" data-scenario-panel="benefits">
                <div class="soeteck-prefab-scenario-card__tags">
                  {scenario.benefits.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <p>{scenario.solution}</p>
              </div>
              <div class="soeteck-prefab-scenario-card__panel" data-scenario-panel="pain" hidden>
                <div class="soeteck-prefab-scenario-card__tags">
                  {scenario.pain_points.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
                <p>{scenario.problem}</p>
              </div>
              <p><strong>{scenario.application}</strong></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Client Cases -->
  <section class="soeteck-prefab-section soeteck-prefab-cases">
    <div class="soeteck-container">
      <h2 class="soeteck-section-title soeteck-prefab-section__title">Check Our Featured Client Cases</h2>
      <div class="soeteck-prefab-case-grid">
        {PREFAB_CLIENT_CASES.map((c) => (
          <article class="soeteck-prefab-case-card">
            <a class="soeteck-prefab-case-card__media" href={`/${lang}/news-and-insights/client-case-studies/${c.slug}/`}>
              <img class="soeteck-prefab-case-card__image" src={c.imgSrc} alt={c.title} width="436" height="240" loading="lazy" />
            </a>
            <div class="soeteck-prefab-case-card__body">
              <h3 class="soeteck-card-title"><a href={`/${lang}/news-and-insights/client-case-studies/${c.slug}/`}>{c.title}</a></h3>
              <p>{c.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="soeteck-cta" id="cabinet-inquiry">
    <div class="soeteck-container soeteck-cta__inner">
      <div>
        <p class="soeteck-eyebrow">Talk to an Engineer</p>
        <h2>Get in Touch with SOETECK</h2>
        <p>Share your facility requirements and get a practical solution path. Tell us your project type, capacity needs, and timeline — our team will help identify the right configuration.</p>
        <ul class="soeteck-cta__checks">
          <li>Project consultation</li>
          <li>Technical configuration support</li>
          <li>Regional follow-up</li>
        </ul>
      </div>
      <div class="soeteck-cta__actions">
        <a class="soeteck-cta__button" href={`/${lang}/contact/`}>Contact Us</a>
        <a class="soeteck-cta__button soeteck-cta__button--outline" href={brochureUrl} target="_blank" rel="noopener">Download Brochure</a>
      </div>
    </div>
  </section>
</div>

<style is:global>
  .soeteck-cabinet-modular-page {
    color: var(--soeteck-text);
    background: #fff;
  }

  /* Banner subtitle */
  .soeteck-cabinet-banner__subtitle {
    max-width: 800px;
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--soeteck-text-lg, clamp(1rem, 1.6vw, 1.2rem));
    font-weight: 400;
    line-height: 1.6;
  }

  /* Overview: 2-column grid */
  .soeteck-cabinet-overview__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 3vw, 40px);
    align-items: center;
  }

  .soeteck-cabinet-overview__text p {
    color: var(--soeteck-text-soft);
    font-size: var(--soeteck-text-md);
    margin-bottom: 16px;
  }

  .soeteck-cabinet-overview__text strong {
    color: var(--soeteck-text);
  }

  .soeteck-cabinet-overview__media img {
    width: 100%;
    height: auto;
    border-radius: var(--soeteck-radius-md);
  }

  @media (max-width: 991px) {
    .soeteck-cabinet-overview__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Featured Models: 3-column grid with image + accordion */
  .soeteck-cabinet-models__intro {
    margin: 0 0 24px;
  }

  .soeteck-cabinet-model-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .soeteck-cabinet-model-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .soeteck-cabinet-model-item__image-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 16px;
  }

  .soeteck-cabinet-model-item__image-wrapper {
    position: relative;
    padding: 20px 0;
  }

  .soeteck-cabinet-model-item__image {
    width: 284px;
    height: 284px;
    max-width: 100%;
    object-fit: contain;
  }

  /* Hotspot pins on model images — unified with main hotspot style */
  .soeteck-cabinet-model-item__pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .soeteck-cabinet-model-item__core {
    position: relative;
    z-index: 2;
    display: flex;
    width: 25px;
    height: 25px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(75, 211, 170, 0.9);
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    box-shadow: 0 0 0 4px rgba(75, 211, 170, 0.2);
    transition: background-color var(--soeteck-transition-medium), box-shadow var(--soeteck-transition-medium), transform var(--soeteck-transition-medium);
  }

  .soeteck-cabinet-model-item__pulse {
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 2px solid rgba(75, 211, 170, 0.5);
    border-radius: 50%;
    pointer-events: none;
    animation: soeteck-prefab-hotspot-pulse 2000ms ease infinite;
  }

  .soeteck-cabinet-model-item__tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    z-index: 4;
    width: max-content;
    max-width: min(320px, calc(100vw - 40px));
    padding: 5px 9px;
    border-radius: var(--soeteck-radius-sm);
    background: var(--soeteck-primary);
    color: #fff;
    font-size: var(--soeteck-text-sm);
    line-height: 1.35;
    opacity: 0;
    pointer-events: none;
    text-align: center;
    transform: translate(-50%, 6px);
