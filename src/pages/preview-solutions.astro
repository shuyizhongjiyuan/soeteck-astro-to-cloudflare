---
/**
 * Preview page — Solutions section design options for Variant C (non-card).
 * Access: http://localhost:4321/preview-solutions/
 *
 * Option S1 — Light editorial full-width bands (alternating, hairlines)
 * Option S2 — Dark immersive full-bleed, text overlay without glass card
 * Option S3 — Dark editorial numbered bands (big 01/02/03)
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HOME_EN } from '@/components/home/home-content';

const c = HOME_EN;
const solutions = c.solutions;
const cards = solutions.cards;
const chapter = ['Containerized', 'Micro Module', 'Row Modular'];
---

<BaseLayout title="Preview: Solutions Section — Variant C" lang="en" canonical="https://soeteck.com/preview-solutions/" robots="noindex">
  <!-- ═══ Compare header ═══ -->
  <div style="padding:40px 24px; background:var(--soeteck-navy); color:#fff;">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:var(--soeteck-primary); font-size:12px; letter-spacing:.16em; text-transform:uppercase; margin:0 0 8px;">Variant C · Solutions Section · 非卡片</p>
      <h1 style="font-size:26px; margin:0 0 8px;">方案板块重设计对比（非卡片）</h1>
      <p style="color:rgba(255,255,255,.8); margin:0;">向下滚动查看 <strong>Option S1 / S2 / S3</strong>。每方案头部含"方案 → 三个架构"的过渡引言。</p>
    </div>
  </div>

  <!-- ═══ Option S1 — Light editorial full-width bands ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(56px,7vw,88px) 0;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Option S1 · 浅色编辑式全宽横幅</p>
      <p class="opt-why">图文交替全宽横幅 + 发丝线分隔 + 大序号，无卡片</p>
      <h2 style="font-size:26px; font-weight:800; margin:14px 0 6px; color:var(--soeteck-text);">{solutions.title}</h2>
      <p style="color:var(--soeteck-text-soft); margin:0 0 18px;">{solutions.text}</p>
      <div class="roadmap">
        {chapter.map((ch, i) => <span class="roadmap-item">0{i + 1} · {ch}</span>)}
      </div>
    </div>
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      {cards.map((card, i) => (
        <a href={card.ctaLink} class="s1-band" style={i % 2 === 1 ? 'flex-direction:row-reverse;' : ''}>
          <div class="s1-media"><img src={card.image.path} alt={card.image.alt} width="640" height="400" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
          <div class="s1-info">
            <span class="s1-index">0{i + 1}</span>
            <span class="s1-title">{card.title}</span>
            <p class="s1-text">{card.text}</p>
            <ul class="s1-feats">
              {card.features.map((f) => <li>{f}</li>)}
            </ul>
            <span class="s1-cta">{card.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ Option S2 — Dark immersive full-bleed, text overlay (no card) ═══ -->
  <section style="background:var(--soeteck-navy); padding:clamp(56px,7vw,88px) 0; color:#fff;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label" style="color:var(--soeteck-primary);">Option S2 · 深色沉浸整幅背景（无玻璃卡）</p>
      <p class="opt-why" style="color:rgba(255,255,255,.7);">图片整幅铺满 + 文字直接浮于渐变遮罩上，去掉卡片盒</p>
      <h2 style="font-size:26px; font-weight:800; margin:14px 0 6px; color:#fff;">{solutions.title}</h2>
      <p style="color:rgba(255,255,255,.78); margin:0 0 18px;">{solutions.text}</p>
      <div class="roadmap roadmap--dark">
        {chapter.map((ch, i) => <span class="roadmap-item">0{i + 1} · {ch}</span>)}
      </div>
    </div>
    {cards.map((card, i) => (
      <a href={card.ctaLink} class="s2-band">
        <img class="s2-bg" src={card.image.path} alt="" width="1600" height="900" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        <div class="s2-scrim" style={i % 2 === 1 ? 'transform:scaleX(-1);' : ''}></div>
        <div class="soeteck-container s2-content">
          <div class="s2-inner">
            <span class="s2-index">0{i + 1}</span>
            <span class="s2-title">{card.title}</span>
            <p class="s2-text">{card.text}</p>
            <ul class="s2-feats">
              {card.features.map((f) => <li>{f}</li>)}
            </ul>
            <span class="s2-cta">{card.cta} →</span>
          </div>
        </div>
      </a>
    ))}
  </section>

  <!-- ═══ Option S3 — Dark editorial numbered bands ═══ -->
  <section style="background:#0d2847; padding:clamp(56px,7vw,88px) 0; color:#fff;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label" style="color:var(--soeteck-primary);">Option S3 · 深色编号式大横幅</p>
      <p class="opt-why" style="color:rgba(255,255,255,.7);">超大章节号 + 图文，编辑式深色节奏</p>
      <h2 style="font-size:26px; font-weight:800; margin:14px 0 6px; color:#fff;">{solutions.title}</h2>
      <p style="color:rgba(255,255,255,.78); margin:0 0 40px;">{solutions.text}</p>
    </div>
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      {cards.map((card, i) => (
        <a href={card.ctaLink} class="s3-band" style={i % 2 === 1 ? 'grid-template-columns:1fr 1.2fr;' : ''}>
          <span class="s3-number">0{i + 1}</span>
          <div class="s3-media"><img src={card.image.path} alt={card.image.alt} width="560" height="350" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
          <div class="s3-info">
            <span class="s3-title">{card.title}</span>
            <p class="s3-text">{card.text}</p>
            <ul class="s3-feats">
              {card.features.map((f) => <li>{f}</li>)}
            </ul>
            <span class="s3-cta">{card.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .opt-label { margin: 0; color: var(--soeteck-primary); font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .opt-why { margin: 4px 0 0; font-size: 14px; color: var(--soeteck-muted); }

  /* ── Roadmap (transition lead-in) ── */
  .roadmap { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 40px; }
  .roadmap-item {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--soeteck-surface);
    border: 1px solid var(--soeteck-border);
    color: var(--soeteck-text-soft);
    font-size: 13px;
    font-weight: 600;
  }
  .roadmap--dark .roadmap-item {
    background: rgba(255, 255, 255, .08);
    border-color: rgba(255, 255, 255, .16);
    color: #fff;
  }

  /* ══ Option S1 — light editorial bands ══ */
  .s1-band {
    display: flex;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
    padding: 36px 0;
    border-bottom: 1px solid var(--soeteck-border-soft);
    text-decoration: none;
  }
  .s1-media {
    flex: 0 0 50%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(160deg, #f2f7fd 0%, #e9f2fb 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .s1-media img { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform .5s ease; }
  .s1-band:hover .s1-media img { transform: scale(1.04); }
  .s1-info { flex: 1; }
  .s1-index { display: block; color: var(--soeteck-primary); font-size: 15px; font-weight: 800; letter-spacing: .08em; }
  .s1-title { display: block; margin-top: 8px; font-size: clamp(20px, 2.4vw, 27px); font-weight: 800; color: var(--soeteck-text); }
  .s1-text { margin: 10px 0 0; font-size: 15px; line-height: 1.7; color: var(--soeteck-text-soft); }
  .s1-feats { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .s1-feats li { position: relative; padding-left: 18px; font-size: 13px; font-weight: 500; color: var(--soeteck-text-soft); }
  .s1-feats li::before { content: ''; position: absolute; left: 0; top: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--soeteck-primary); }
  .s1-cta { display: inline-flex; margin-top: 18px; padding: 11px 26px; border-radius: 999px; background: var(--soeteck-primary); color: #fff; font-size: 14px; font-weight: 600; transition: background .3s ease, transform .2s ease; }
  .s1-band:hover .s1-cta { background: var(--soeteck-primary-dark); transform: translateY(-1px); }

  /* ══ Option S2 — dark immersive full-bleed ══ */
  .s2-band { position: relative; display: flex; align-items: center; min-height: clamp(420px, 70vh, 640px); overflow: hidden; text-decoration: none; }
  .s2-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .s2-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8,22,43,.92) 0%, rgba(8,22,43,.55) 55%, rgba(8,22,43,.15) 100%); }
  .s2-content { position: relative; z-index: 1; width: 100%; padding: 56px 0; }
  .s2-inner { max-width: 520px; }
  .s2-index { display: block; color: var(--soeteck-primary); font-size: 20px; font-weight: 800; letter-spacing: .1em; }
  .s2-title { display: block; margin-top: 10px; font-size: clamp(24px, 3vw, 34px); font-weight: 800; color: #fff; line-height: 1.12; }
  .s2-text { margin: 14px 0 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,.85); }
  .s2-feats { list-style: none; margin: 16px 0 0; padding: 0; }
  .s2-feats li { position: relative; padding-left: 20px; font-size: 13px; font-weight: 500; color: rgba(255,255,255,.9); }
  .s2-feats li::before { content: '✓'; position: absolute; left: 0; color: var(--soeteck-primary); font-weight: 800; }
  .s2-cta { display: inline-flex; margin-top: 20px; padding: 12px 28px; border-radius: 999px; background: var(--soeteck-primary); color: #fff; font-size: 14px; font-weight: 600; }

  /* ══ Option S3 — dark editorial numbered bands ══ */
  .s3-band {
    display: grid;
    grid-template-columns: 90px 1.2fr 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding: 40px 0;
    border-bottom: 1px solid rgba(255,255,255,.12);
    text-decoration: none;
  }
  .s3-number { font-size: clamp(48px, 7vw, 84px); font-weight: 800; line-height: 1; color: rgba(255,255,255,.14); font-variant-numeric: tabular-nums; }
  .s3-media { aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; background: linear-gradient(160deg, #f2f7fd 0%, #e9f2fb 100%); display: flex; align-items: center; justify-content: center; padding: 16px; }
  .s3-media img { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform .5s ease; }
  .s3-band:hover .s3-media img { transform: scale(1.04); }
  .s3-title { display: block; font-size: clamp(20px, 2.4vw, 28px); font-weight: 800; color: #fff; }
  .s3-text { margin: 10px 0 0; font-size: 15px; line-height: 1.7; color: rgba(255,255,255,.82); }
  .s3-feats { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .s3-feats li { position: relative; padding-left: 18px; font-size: 13px; font-weight: 500; color: rgba(255,255,255,.85); }
  .s3-feats li::before { content: ''; position: absolute; left: 0; top: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--soeteck-primary); }
  .s3-cta { display: inline-flex; margin-top: 18px; padding: 11px 26px; border-radius: 999px; background: var(--soeteck-primary); color: #fff; font-size: 14px; font-weight: 600; }

  @media (max-width: 991px) {
    .s1-band { flex-direction: column !important; align-items: flex-start; }
    .s1-media { width: 100%; flex: none; }
    .s3-band { grid-template-columns: 1fr; }
    .s3-number { display: none; }
  }
</style>
