---
/**
 * WhySectionC — Timeline tab layout (Variant C).
 * 5 persuasion points as a vertical timeline, click to switch content.
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props {
  data: HomeContent['whySoeteck'];
  timeline: HomeContent['timeline'];
}

const { data, timeline } = Astro.props;

const tabs = [
  {
    id: 'prod',
    num: '01',
    title: 'Production & Delivery',
    items: [
      { type: 'stat', value: '2000', suffix: '+', label: 'Projects Delivered' },
      { type: 'stat', value: '50', suffix: '+', label: 'Countries Served' },
      { type: 'stat', value: '20', suffix: '+', label: 'Years of Innovation' },
      { type: 'stat', value: '8–12', suffix: 'W', label: 'Delivery Lead Time' },
      { type: 'chip', text: '50,000 m² Manufacturing Base', highlight: true },
      { type: 'chip', text: '100% Factory Tested Before Dispatch', highlight: true },
      { type: 'chip', text: '8–12 Weeks Delivery Lead Time', highlight: true },
    ],
  },
  {
    id: 'market',
    num: '02',
    title: 'Market Validation',
    items: [
      { type: 'chip', text: 'Telecom Operators' },
      { type: 'chip', text: 'AI Hyperscalers' },
      { type: 'chip', text: 'Financial Institutions' },
      { type: 'chip', text: 'Government & Public Sector' },
      { type: 'chip', text: 'Telecom Carriers' },
      { type: 'desc', text: 'Deployed across 50+ countries — every climate, every grid standard.' },
    ],
  },
  {
    id: 'diff',
    num: '03',
    title: 'Core Differentiators',
    items: [
      ...data.items.map((item) => ({
        type: 'card' as const,
        icon: item.icon === 'factory' ? '⚙' : item.icon === 'accountability' ? '✓' : item.icon === 'global' ? '🌐' : '⚡',
        title: item.title,
        text: item.text,
      })),
    ],
  },
  {
    id: 'quality',
    num: '04',
    title: 'Quality & Compliance',
    items: [
      { type: 'text', text: 'Every unit undergoes full-load testing before shipment — thermal validation, failover verification, and system integration checks. All systems are certified to international standards.' },
      ...data.certs.map((c) => ({ type: 'chip' as const, text: c, highlight: true })),
    ],
  },
  {
    id: 'support',
    num: '05',
    title: 'After-Sales & Support',
    items: [
      { type: 'text', text: 'One contract, one team, one throat to choke. From design to commissioning, SOETECK owns the entire delivery — backed by comprehensive after-sales support.' },
      { type: 'chip', text: '2-Year Warranty', highlight: true },
      { type: 'chip', text: '24/7 Technical Support', highlight: true },
      { type: 'chip', text: 'On-Site Commissioning', highlight: true },
      { type: 'chip', text: 'FOB / CIF / DDP', highlight: true },
      { type: 'chip', text: 'Operator Training', highlight: true },
    ],
  },
];
---

<section class="home-why-c" aria-labelledby="why-c-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="home-section__eyebrow">{data.eyebrow}</p>
      <h2 id="why-c-title" class="home-section__title">{data.title}</h2>
      <p class="home-section__lead">{data.text}</p>
    </div>

    <div class="home-why-c__layout">
      <!-- Timeline tabs -->
      <div class="home-why-c__tabs" role="tablist" aria-label="Why SOETECK">
        <div class="home-why-c__line" aria-hidden="true"></div>
        {tabs.map((tab, i) => (
          <button
            type="button"
            class={`home-why-c__tab${i === 0 ? ' home-why-c__tab--active' : ''}`}
            data-tab={tab.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`why-panel-${tab.id}`}
          >
            <span class="home-why-c__dot">{tab.num}</span>
            <span class="home-why-c__tab-title">{tab.title}</span>
          </button>
        ))}
      </div>

      <!-- Content panels -->
      <div class="home-why-c__panels">
        {tabs.map((tab, i) => (
          <div
            class={`home-why-c__panel${i === 0 ? ' home-why-c__panel--active' : ''}`}
            id={`why-panel-${tab.id}`}
            role="tabpanel"
            aria-labelledby={`why-tab-${tab.id}`}
          >
            <div class="home-why-c__panel-inner">
                <p class="home-why-c__panel-title">{tab.num} · {tab.title}</p>
                <div class="home-why-c__items">
              {tab.items.map((item) => {
                if (item.type === 'stat') {
                  return (
                    <div class="w-item w-item--stat">
                      <span class="w-stat-value">{item.value}<span class="w-stat-suffix">{item.suffix}</span></span>
                      <span class="w-stat-label">{item.label}</span>
                    </div>
                  );
                }
                if (item.type === 'chip') {
                  return (
                    <span class={`w-item w-item--chip${item.highlight ? ' w-item--chip-highlight' : ''}`}>
                      {item.text}
                    </span>
                  );
                }
                if (item.type === 'desc') {
                  return <p class="w-item w-item--desc">{item.text}</p>;
                }
                if (item.type === 'text') {
                  return <p class="w-item w-item--text">{item.text}</p>;
                }
                if (item.type === 'card') {
                  return (
                    <div class="w-item w-item--card">
                      <div class="w-card-icon">{item.icon}</div>
                      <h4 class="w-card-title">{item.title}</h4>
                      <p class="w-card-text">{item.text}</p>
                    </div>
                  );
                }
                return null;
              })}
            </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* ═══ WHY C — timeline tab layout ═══════════════════════════ */
.home-why-c {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-white);
}
.home-why-c :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

/* ── Head ── */
.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
.home-section__eyebrow { margin: 0 0 30px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(1.85rem, 3.1vw, 2.5rem); font-weight: 700; line-height: 1.14; color: var(--soeteck-text); }
.home-section__lead { margin: 18px auto 0; max-width: 620px; font-size: 1.05rem; line-height: 1.7; color: var(--soeteck-text-soft); }

/* ── Layout ── */
.home-why-c__layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 48px;
}

/* ── Timeline tabs ── */
.home-why-c__tabs {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0;
}
.home-why-c__line {
  position: absolute;
  left: 21px;
  top: 34px;
  bottom: 34px;
  width: 2px;
  background: var(--soeteck-border);
}
.home-why-c__tab {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 0;
  border: none;
  background: transparent;
  cursor: pointer;
  text-align: left;
  width: 100%;
  position: relative;
  z-index: 1;
}
.home-why-c__tab:not(.home-why-c__tab--active) .home-why-c__tab-title { opacity: 0.55; }
.home-why-c__dot {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 16px;
  font-weight: 700;
  position: relative;
  z-index: 1;
  transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  background: var(--soeteck-surface);
  border: 2px solid var(--soeteck-border);
  color: var(--soeteck-muted);
}
.home-why-c__tab--active .home-why-c__dot {
  background: var(--soeteck-primary);
  border-color: var(--soeteck-primary);
  color: #fff;
}
.home-why-c__tab-title {
  font-size: 15px;
  font-weight: 600;
  line-height: 1.35;
  color: var(--soeteck-text-soft);
  transition: color 0.3s ease;
}
.home-why-c__tab--active .home-why-c__tab-title {
  color: var(--soeteck-primary);
}

/* ── Content panels ── */
.home-why-c__panels {
  display: flex;
  flex-direction: column;
  height: 360px;
}
.home-why-c__panel {
  display: none;
}
.home-why-c__panel--active {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.home-why-c__panel-inner {
  flex: 1;
  padding: 28px;
  background: var(--soeteck-surface);
  border: 1px solid var(--soeteck-border-soft);
  border-radius: 14px;
  box-sizing: border-box;
  overflow-y: auto;
}
.home-why-c__panel-title {
  margin: 0 0 24px;
  font-size: 18px;
  font-weight: 700;
  color: var(--soeteck-text);
  line-height: 1.3;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--soeteck-border-soft);
}

/* ── Unified items grid ── */
.home-why-c__items {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: flex-start;
}

/* ── Stat item ── */
.w-item--stat {
  flex: 1;
  min-width: 100px;
  text-align: center;
  padding: 16px 12px;
  background: var(--soeteck-surface);
  border: 1px solid var(--soeteck-border-soft);
  border-radius: 10px;
}
.w-stat-value {
  display: block;
  font-size: clamp(1.4rem, 2.2vw, 1.8rem);
  font-weight: 800;
  color: var(--soeteck-text);
}
.w-stat-suffix { color: var(--soeteck-primary); }
.w-stat-label {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  font-weight: 500;
  color: var(--soeteck-muted);
}

/* ── Chip item ── */
.w-item--chip {
  padding: 10px 20px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  background: var(--soeteck-surface);
  border: 1px solid var(--soeteck-border);
  color: var(--soeteck-text-soft);
}
.w-item--chip-highlight {
  background: var(--soeteck-primary-soft);
  border-color: transparent;
  color: var(--soeteck-primary);
}

/* ── Text / desc items ── */
.w-item--text, .w-item--desc {
  width: 100%;
  margin: 0;
  font-size: 15px;
  line-height: 1.65;
  color: var(--soeteck-text-soft);
}
.w-item--desc { font-style: italic; }

/* ── Card item ── */
.w-item--card {
  flex: 1;
  min-width: 140px;
  padding: 14px 12px;
  background: var(--soeteck-surface);
  border: 1px solid var(--soeteck-border-soft);
  border-radius: 8px;
}
.w-card-icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  background: var(--soeteck-primary-soft);
  color: var(--soeteck-primary);
  margin-bottom: 8px;
  font-size: 15px;
}
.w-card-title {
  margin: 0 0 4px;
  font-size: 14px;
  font-weight: 700;
  color: var(--soeteck-text);
}
.w-card-text {
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
  color: var(--soeteck-muted);
}

/* ── Responsive ── */
@media (max-width: 991px) {
  .home-why-c__layout { grid-template-columns: 1fr; }
  .home-why-c__tabs { flex-direction: row; flex-wrap: wrap; gap: 8px; }
  .home-why-c__line { display: none; }
  .home-why-c__tab { width: auto; padding: 8px 16px; border-radius: 999px; background: var(--soeteck-surface); border: 1px solid var(--soeteck-border); }
  .home-why-c__tab--active { background: var(--soeteck-primary-soft); border-color: var(--soeteck-primary); }
  .home-why-c__dot { width: 28px; height: 28px; font-size: 12px; }
  .home-why-c__tab-title { font-size: 13px; }
}
</style>

<script is:inline>
(function() {
  var section = document.querySelector('.home-why-c');
  if (!section) return;
  var tabs = section.querySelectorAll('.home-why-c__tab');
  var panels = section.querySelectorAll('.home-why-c__panel');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var id = tab.getAttribute('data-tab');
      tabs.forEach(function(t) {
        t.classList.remove('home-why-c__tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach(function(p) { p.classList.remove('home-why-c__panel--active'); });
      tab.classList.add('home-why-c__tab--active');
      tab.setAttribute('aria-selected', 'true');
      var panel = document.getElementById('why-panel-' + id);
      if (panel) panel.classList.add('home-why-c__panel--active');
    });
  });
})();
</script>