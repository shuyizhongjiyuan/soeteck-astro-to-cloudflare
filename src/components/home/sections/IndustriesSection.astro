---
import type { HomeContent } from '../home-content';

interface Props {
  data: HomeContent['industries'];
}

const { data } = Astro.props;
---

<section class="home-industries" aria-labelledby="industries-title">
  <div class="soeteck-container">
    <div class="home-section__head">
      <p class="soeteck-eyebrow">{data.eyebrow}</p>
      <h2 id="industries-title" class="home-section__title">{data.title}</h2>
      <p class="home-section__lead">{data.text}</p>
    </div>
    <div class="home-industries__grid">
      {data.items.map((item) => (
        <a href={item.ctaLink} class="home-industry-card">
          <div class="home-industry-card__media">
            <img src={item.image.path} alt={item.image.alt} loading="lazy" width="400" height="260" />
          </div>
          <div class="home-industry-card__body">
            <h3 class="home-industry-card__title">{item.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .home-industries {
    padding: var(--soeteck-section-y) 0;
    background: var(--soeteck-white);
  }

  .home-industries :global(.soeteck-container) {
    width: min(var(--soeteck-container), calc(100% - 48px));
    margin: 0 auto;
  }

  .home-section__head {
    max-width: 760px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .home-section__title {
    margin: 0;
    font-size: clamp(1.85rem, 3.1vw, 2.5rem);
    font-weight: 700;
    line-height: 1.14;
    color: var(--soeteck-text);
  }

  .home-section__lead {
    margin: 18px 0 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--soeteck-text-soft);
  }

  .home-industries__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }

  .home-industry-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--soeteck-radius-lg);
    overflow: hidden;
    background: var(--soeteck-surface);
    border: 1px solid var(--soeteck-border-soft);
    text-decoration: none;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }

  .home-industry-card:hover {
    border-color: var(--soeteck-primary);
    box-shadow: var(--soeteck-shadow);
    transform: translateY(-3px);
  }

  .home-industry-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .home-industry-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .home-industry-card:hover .home-industry-card__media img {
    transform: scale(1.05);
  }

  .home-industry-card__body {
    padding: 20px 24px;
  }

  .home-industry-card__title {
    margin: 0;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    font-weight: 700;
    color: var(--soeteck-text);
  }

  @media (max-width: 640px) {
    .home-industries__grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }
</style>
