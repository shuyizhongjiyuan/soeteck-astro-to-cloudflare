      padding: 24px 12px;
    }

    .language-panel {
      top: 72px;
      min-height: 160px;
      flex-wrap: wrap;
      gap: 18px 26px;
      padding: 24px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-toggle-item,
    .mobile-menu-link,
    .mobile-menu-close,
    .mobile-accordion-toggle,
    .mobile-accordion-sub-link,
    .mobile-arrow,
    .mobile-accordion-arrow,
    .mobile-submenu,
    .mobile-accordion-nested,
    .mobile-contact-btn {
      transition: none !important;
      animation: none !important;
    }

    .mobile-menu-toggle-item:active,
    .mobile-menu-link:active,
    .mobile-accordion-toggle:active {
      transform: none !important;
    }
  }

  /* Footer Styles */
  .site-footer {
    margin-top: 0;
    background: var(--soeteck-dark);
    color: var(--soeteck-white);
  }

  .footer-main {
    padding: 118px 0 74px;
  }

  .footer-inner {
    width: min(var(--soeteck-container), calc(100% - 48px));
    margin: 0 auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 88px;
    align-items: start;
  }

  .footer-desktop-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 88px;
    align-items: start;
  }

  .footer-brand {
    min-width: 0;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center; /* 品牌列统一中轴：logo / 定位语 / 社媒入口全部居中 */
    gap: 20px; /* 品牌区统一垂直节奏 */
  }

  .footer-tagline {
    max-width: 240px;
    margin: 0;
    color: var(--soeteck-white);
    font-family: var(--soeteck-font-ui);
    font-size: 14px; /* 定位语提级：13→14px、500→600、白字 */
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
    letter-spacing: 0.2px;
  }

  .footer-logo img {
    display: block;
    width: 240px;
    height: auto;
  }

  .footer-social-title,
  .footer-column-title {
    margin: 0;
    font-family: var(--soeteck-font-heading);
    color: var(--soeteck-white);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
  }

  .footer-social-block {
    align-self: stretch; /* 品牌列内全宽；标题居中 + 双侧短分割线 */
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  .footer-social-block-desktop {
    margin-top: 30px; /* 桌面社交块与上方定位语拉开距离（用户指定） */
  }

  .footer-social-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px; /* 缩小：15→11px */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
  }

  /* 分割线：分隔定位语与下方社媒入口 */
  .footer-social-title::before,
  .footer-social-title::after {
    content: '';
    width: 28px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .footer-social-links {
    display: flex;
    align-items: center;
    justify-content: center; /* 图标行在社交块内居中（标题左对齐） */
    width: 100%;
    gap: 7px;
  }

  .footer-social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    background: #f0f2f4;
    color: #111;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .footer-social-links a:hover {
    color: var(--soeteck-white);
    transform: translateY(-1px);
  }

  .footer-social-links a[aria-label="LinkedIn"]:hover {
    background: #0a66c2;
  }

  .footer-social-links a[aria-label="Facebook"]:hover {
    background: #1877f2;
  }

  .footer-social-links a[aria-label="YouTube"]:hover {
    background: #ff0000;
  }

  .footer-social-links svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .footer-desktop-nav {
    min-width: 0;
  }

  .footer-column-title {
    margin-bottom: 22px;
    text-align: left;
  }

  .footer-column-title a {
    color: inherit;
    text-decoration: none;
  }
  .footer-column-title a:hover {
    color: var(--soeteck-primary);
  }

  .footer-column {
    text-align: left;
  }

  .footer-column ul,
  .footer-accordion-panel {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-column li + li {
    margin-top: 18px;
  }

  .footer-column a,
  .footer-mobile-nav a,
  .footer-legal-nav a {
    font-family: var(--soeteck-font-ui);
    color: var(--soeteck-white);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer-column a {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
  }

  .footer-column a:hover,
  .footer-mobile-nav a:hover,
  .footer-legal-nav a:hover {
    color: var(--soeteck-primary);
  }

  .footer-mobile-nav,
  .footer-social-block-mobile {
    display: none;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.38);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(var(--soeteck-container), calc(100% - 48px));
    min-height: 44px;
    margin: 0 auto;
  }

  .footer-copyright {
    margin: 0;
    font-family: var(--soeteck-font-ui);
    color: var(--soeteck-white);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
  }

  .footer-legal-nav {
    display: flex;
    font-family: var(--soeteck-font-ui);
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0 9px;
    color: var(--soeteck-white);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
  }

  @media (max-width: 1200px) {
    .footer-inner,
    .footer-desktop-nav {
      gap: 48px;
    }

    .footer-inner {
      grid-template-columns: 250px repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 991px) {
    .footer-main {
      padding: 82px 0 44px;
    }

    .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: min(416px, calc(100% - 48px));
      gap: 0;
    }

    .footer-brand {
      width: 100%;
      text-align: center;
      align-items: center;
    }

    .footer-logo {
      margin-bottom: 0;
    }

    .footer-logo img {
      width: 300px;
    }

    .footer-desktop-nav,
    .footer-social-block-desktop {
      display: none;
    }

    .footer-mobile-nav {
      display: block;
      width: 100%;
    }

    .footer-accordion-header,
    .footer-mobile-link,
    .footer-accordion-sub-link {
      border-bottom: 1px solid rgba(255, 255, 255, 0.72);
    }

    .footer-accordion-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 48px;
      align-items: center;
      min-height: 52px; /* 对齐 Header 移动端 menu-item 行高 */
    }

    .footer-accordion-header > a,
    .footer-mobile-link {
      display: flex;
      font-family: var(--soeteck-font-ui);
      align-items: center;
      justify-content: flex-start;
      min-height: 52px;
      padding: 0 16px;
      color: var(--soeteck-white);
      font-size: 16px; /* 对齐 Header 移动端 16/500 */
      font-weight: 500;
      line-height: 1.2;
      text-align: left;
    }

    .footer-accordion-toggle {
      display: inline-flex;
      font-family: var(--soeteck-font-ui);
      align-items: center;
      justify-content: center;
      width: 48px; /* 对齐 Header 移动端 48px 切换钮 */
      height: 52px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--soeteck-white);
      cursor: pointer;
    }

    .footer-accordion-arrow {
      width: 16px; /* 对齐 Header 移动端箭头 16px */
      height: 16px;
      color: var(--soeteck-white);
      transition: transform var(--soeteck-transition-medium);
    }

    .footer-accordion-section.is-open > .footer-accordion-header .footer-accordion-arrow {
      transform: rotate(180deg);
    }

    .footer-accordion-panel .footer-accordion-arrow {
      width: 12px;
      height: 12px;
      color: rgba(255, 255, 255, 0.78);
    }

    .footer-accordion-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height var(--soeteck-accordion-transition);
    }

    .footer-accordion-section.is-open > .footer-accordion-panel {
      max-height: 1200px;
    }

    .footer-accordion-panel .footer-accordion-header {
      min-height: 42px;
      padding-left: 16px;
    }

    .footer-accordion-panel .footer-accordion-header > a {
      min-height: 42px;
      padding-right: 8px;
      color: rgba(255, 255, 255, 0.78);
      font-size: 13px;
      font-weight: 500;
    }

    .footer-accordion-panel .footer-accordion-toggle {
      height: 42px;
    }

    .footer-accordion-panel .footer-accordion-panel .footer-accordion-header {
      padding-left: 30px;
    }

    .footer-accordion-panel .footer-accordion-panel .footer-accordion-header > a {
      color: rgba(255, 255, 255, 0.64);
      font-size: 12px;
    }

    .footer-accordion-sub-link {
      display: flex;
      font-family: var(--soeteck-font-ui);
      align-items: center;
      min-height: 42px;
      padding: 0 10px 0 24px;
      color: rgba(255, 255, 255, 0.78);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.35;
      text-align: left;
    }

    .footer-accordion-panel .footer-accordion-panel .footer-accordion-sub-link {
      padding-left: 38px;
      color: rgba(255, 255, 255, 0.64);
      font-size: 12px;
    }

    .footer-social-block-mobile {
      display: flex;
      justify-content: center;
      width: 100%;
      margin-top: 31px;
    }

    .footer-social-links {
      justify-content: center;
      gap: 7px;
    }

    .footer-social-links a {
      width: 32px;
      height: 32px;
      border-radius: 8px;
    }

    .footer-social-links svg {
      width: 17px;
      height: 17px;
    }

    .footer-bottom-inner {
      flex-direction: column-reverse;
      justify-content: center;
      width: min(482px, calc(100% - 48px));
      min-height: 114px;
      padding: 14px 0 18px;
      text-align: center;
    }

    .footer-copyright,
    .footer-legal-nav {
      color: rgba(255, 255, 255, 0.82);
      font-size: 14px;
      font-weight: 400;
    }

    .footer-legal-nav {
      justify-content: center;
      gap: 0 8px;
    }
  }

  @media (max-width: 480px) {
    .footer-inner,
    .footer-bottom-inner {
      width: calc(100% - 32px);
    }

    .footer-main {
      padding-top: 64px;
    }

    .footer-logo img {
      width: 190px;
    }

    .footer-legal-nav {
      max-width: 330px;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
    padding: 0;
  }

  :root {
    --soeteck-primary: #1a85e5;
    --soeteck-primary-dark: #0067c5;
    --soeteck-primary-soft: #e8f3ff;
    --soeteck-navy: #0b1f3a;
    --soeteck-dark: #202020;
    --soeteck-text: #111827;
    --soeteck-text-soft: #374151;
    --soeteck-muted: #6b7280;
    --soeteck-border: #d7dce3;
    --soeteck-border-soft: #e5e7eb;
    --soeteck-surface: #f5f7fa;
    --soeteck-white: #ffffff;
    --soeteck-font-brand: 'Sora', 'Noto Sans SC', 'Microsoft YaHei', 'PingFang SC', 'Segoe UI', sans-serif;
    --soeteck-font-body: var(--soeteck-font-brand);
    --soeteck-font-heading: var(--soeteck-font-brand);
    --soeteck-font-ui: var(--soeteck-font-brand);
    --soeteck-text-xs: 0.75rem;
    --soeteck-text-sm: 0.875rem;
    --soeteck-text-md: 1rem;
    --soeteck-text-lg: 1.125rem;
    --soeteck-heading-lg: clamp(2.5rem, 4vw, 3.5rem);
    --soeteck-weight-medium: 500;
    --soeteck-weight-semibold: 600;
    --soeteck-weight-bold: 700;
    --soeteck-container: 1200px;
    --soeteck-container-wide: 1504px;
    --soeteck-content: 960px;
    --soeteck-gutter: 20px;
    --soeteck-section-y: clamp(64px, 7vw, 112px);
    --soeteck-section-y-sm: clamp(40px, 5vw, 72px);
    --soeteck-card-gap: clamp(20px, 2.4vw, 32px);
    --soeteck-radius-sm: 6px;
    --soeteck-radius: 8px;
    --soeteck-radius-md: 10px;
    --soeteck-radius-lg: 14px;
    --soeteck-radius-pill: 999px;
    --soeteck-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    --soeteck-shadow-card: 0 18px 45px rgba(15, 23, 42, 0.12);
    --soeteck-shadow-header: 0 1px 5px rgba(33, 33, 33, 0.46);
    --soeteck-shadow-panel: 0 5px 10px rgba(33, 33, 33, 0.23);
    --soeteck-navy-accent: #0058a7; /* 品牌深蓝：顶部条 / 历史品牌色（Aisle、Prefab 页复用） */
    --soeteck-header-h: 70px; /* header 主体高（不含 7px 顶条） */
    --soeteck-header-topbar: 7px;
    --soeteck-header-total: 77px; /* 主体高 + 顶条 = 悬浮面板定位基准 */
    --soeteck-transition-fast: 180ms ease;
    --soeteck-transition-medium: 240ms ease-out;
    --soeteck-accordion-transition: 420ms cubic-bezier(0.33, 1, 0.68, 1); /* 手风琴柔和展开缓动（easeOutCubic 类） */
    --soeteck-media-bg: #f3f5f8;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-size: 16px;
  }

  body {
    margin: 0;
    color: var(--soeteck-text);
    background: var(--soeteck-white);
    font-family: var(--soeteck-font-body);
    font-size: var(--soeteck-text-md);
    line-height: 1.7;
  }

  img,
  picture,
  video,
  canvas,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: var(--soeteck-primary);
    text-decoration: none;
    transition: color var(--soeteck-transition-fast);
  }

  a:hover {
    color: var(--soeteck-primary-dark);
  }

  a:focus-visible {
    outline: 2px solid var(--soeteck-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  a:active {
    color: var(--soeteck-primary-dark);
    opacity: 0.8;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--soeteck-text);
    font-family: var(--soeteck-font-heading);
    font-weight: var(--soeteck-weight-bold);
    line-height: 1.2;
  }

  /* 全站标题字号规范（2026-07-27 ADR-014）—— About 页面设计推广到全站
     产品单页（ProductSingle）和博客单页（ArticleContent）保持原设计 */
  h2 {
    font-size: clamp(1.85rem, 3.1vw, 2.5rem);
    line-height: 1.14;
  }

  h3 {
    font-size: clamp(1.12rem, 1.35vw, 1.36rem);
    line-height: 1.25;
  }

  h4 {
    font-size: clamp(1rem, 1.1vw, 1.125rem);
    line-height: 1.35;
  }

  p {
    margin-bottom: 1em;
  }

  .soeteck-container {
    width: min(var(--soeteck-container), calc(100% - (var(--soeteck-gutter) * 2)));
    margin-inline: auto;
  }

  .soeteck-eyebrow {
    margin: 0 0 20px;
    color: var(--soeteck-primary);
    font-family: var(--soeteck-font-ui);
    font-size: var(--soeteck-text-sm);
    font-weight: var(--soeteck-weight-bold);
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  /* 相邻同背景色 section：消除重复顶部间距 */
  .soeteck-section--adjacent {
    padding-top: 0 !important;
  }

  .soeteck-poc-page {
    background: var(--soeteck-surface);
    padding: var(--soeteck-section-y) 0;
  }

  .poc-panel {
    width: min(var(--soeteck-container), calc(100% - (var(--soeteck-gutter) * 2)));
    margin-inline: auto;
    background: var(--soeteck-white);
    border: 1px solid var(--soeteck-border-soft);
    border-radius: var(--soeteck-radius-lg);
    box-shadow: var(--soeteck-shadow);
    padding: clamp(24px, 4vw, 44px);
  }

  /* ========================================
     Lightbox — ported from WordPress theme
     ======================================== */
  .soeteck-lightbox-open {
    scrollbar-gutter: stable;
  }
  .soeteck-lightbox-open body {
    position: fixed;
    inset: var(--soeteck-lightbox-scroll-y, 0) 0 auto 0;
    width: 100%;
    overflow-y: scroll;
  }
  .soeteck-lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    padding: clamp(72px, 9vw, 96px) clamp(18px, 4vw, 48px) clamp(18px, 4vw, 48px);
    background: rgba(3, 12, 28, 0.88);
    touch-action: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }
  .soeteck-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .soeteck-lightbox__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .soeteck-lightbox__dialog {
    position: relative;
    z-index: 2;
    display: grid;
    max-width: min(1120px, 100%);
    max-height: min(82vh, 860px);
    gap: 14px;
    overflow: visible;
    overscroll-behavior: contain;
  }
  .soeteck-lightbox__image {
    --soeteck-lightbox-scale: 1;
    --soeteck-lightbox-pan-x: 0px;
    --soeteck-lightbox-pan-y: 0px;
    display: block;
    max-width: min(1120px, 100%);
    max-height: min(76vh, 800px);
    width: auto;
    height: auto;
    border-radius: 10px;
    background: var(--soeteck-white);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.38);
    cursor: default;
    object-fit: contain;
    transform: translate3d(var(--soeteck-lightbox-pan-x), var(--soeteck-lightbox-pan-y), 0) scale(var(--soeteck-lightbox-scale));
    transition: transform 180ms ease;
    user-select: none;
    -webkit-user-drag: none;
  }
  .soeteck-lightbox.is-zoomed .soeteck-lightbox__image {
    cursor: move;
  }
  .soeteck-lightbox.is-zoomed.is-panning .soeteck-lightbox__image {
    cursor: grabbing;
    transition: none;
  }
  .soeteck-lightbox__image.is-switching-next {
    animation: soeteck-lightbox-next 240ms ease both;
  }
  .soeteck-lightbox__image.is-switching-prev {
    animation: soeteck-lightbox-prev 240ms ease both;
  }
  .soeteck-lightbox__caption {
    position: fixed;
    top: clamp(14px, 2vw, 28px);
    left: 50%;
    z-index: 7;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: min(680px, calc(100vw - 132px));
    min-height: 44px;
    margin: 0;
    padding: 8px 18px;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    background: rgba(3, 12, 28, 0.88);
    color: var(--soeteck-white);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.34), 0 0 0 1px rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    font-size: 14px;
    line-height: 1.35;
    text-align: center;
    transform: translateX(-50%);
  }
  .soeteck-lightbox__close,
  .soeteck-lightbox__nav {
    position: absolute;
    z-index: 5;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: rgba(3, 12, 28, 0.86);
    color: var(--soeteck-white);
    cursor: pointer;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.34), 0 0 0 1px rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    transition: background 160ms ease, transform 160ms ease;
  }
  .soeteck-lightbox__close:hover,
  .soeteck-lightbox__nav:hover {
    background: rgba(10, 28, 54, 0.94);
    transform: translateY(-1px);
  }
  .soeteck-lightbox__close {
    top: clamp(14px, 2vw, 28px);
    right: clamp(14px, 2vw, 28px);
    width: 44px;
    height: 44px;
    font-size: 28px;
    line-height: 1;
  }
  .soeteck-lightbox__nav {
    top: 50%;
    width: 48px;
    height: 48px;
    transform: translateY(-50%);
  }
  .soeteck-lightbox__nav::before {
