---
interface Props {
  title: string;
  buttonLabel: string;
  buttonHref: string;
  lang?: string;
}

const { title, buttonLabel, buttonHref, lang = 'en' } = Astro.props;
---

<section class="archive-cta">
  <div class="archive-cta__inner">
    <h2 class="archive-cta__title">{title}</h2>
    <a href={buttonHref} class="archive-cta__button">{buttonLabel}</a>
  </div>
</section>

<style>
  .archive-cta {
    position: relative;
    overflow: hidden;
    padding: var(--soeteck-section-y-sm) 0;
    background: radial-gradient(circle at 78% 18%, rgba(0, 102, 204, 0.28), transparent 34%), linear-gradient(135deg, #061529 0%, #0a2749 56%, #061529 100%);
    color: #fff;
  }

  .archive-cta::before {
    content: '';
    position: absolute;
    inset: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  /* Desktop: unified CTA min-height (2026-09-02); flex centers content when min-height applies */
  @media (min-width: 1200px) {
    .archive-cta {
      display: flex;
      align-items: center;
      min-height: 460px;
    }
  }

  .archive-cta__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    width: min(var(--soeteck-container), calc(100% - (var(--soeteck-gutter) * 2)));
    margin-inline: auto;
  }

  .archive-cta__title {
    margin: 0;
    color: #fff;
    font-weight: 700;
    letter-spacing: -0.025em;
    max-width: 680px;
  }

  .archive-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 48px;
    padding: 0 28px;
    border-radius: var(--soeteck-radius-pill); /* §12: pill */
    background: var(--soeteck-primary);
    color: #fff;
    font-size: var(--soeteck-text-md);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--soeteck-transition-fast),
                transform var(--soeteck-transition-fast);
  }

  .archive-cta__button:hover {
    background: var(--soeteck-primary-dark);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .archive-cta { padding-block: 56px; }
    .archive-cta::before { display: none; }
    .archive-cta__inner {
      flex-direction: column;
      align-items: stretch;
      text-align: left;
      gap: 24px;
    }
    .archive-cta__button { width: 100%; justify-content: center; }
  }
</style>