---
/**
 * SolutionsSection — Turnkey Solutions, dark alternating layout.
 * Variant A: leads the page after Hero (solutions before products).
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';
interface Props {
  solutions: HomeContent['solutions'];
}
const { solutions } = Astro.props;
---

{/* ── SOLUTIONS — dark background, alternating rows ── */}
<section class="home-solutions-dark" aria-labelledby="solutions-dark-title">
  <div class="soeteck-container">
    <div class="home-section__head home-section__head--left">
      <p class="home-section__eyebrow home-section__eyebrow--light">{solutions.eyebrow}</p>
      <h2 id="solutions-dark-title" class="home-section__title home-section__title--light">{solutions.title}</h2>
      <p class="home-section__lead home-section__lead--light">{solutions.text}</p>
    </div>
    <div class="home-solutions-dark__list">
      {solutions.cards.map((card, i) => (
        <a href={card.ctaLink} class={`home-solution-row${i % 2 === 1 ? ' home-solution-row--reverse' : ''}`}>
          <div class="home-solution-row__media">
            <img src={card.image.path} alt={card.image.alt} width="600" height="380" loading="lazy" decoding="async" />
          </div>
          <div class="home-solution-row__content">
            <h3 class="home-solution-row__title">{card.title}</h3>
            <p class="home-solution-row__text">{card.text}</p>
            <ul class="home-solution-row__features">
              {card.features.map((feat) => <li>{feat}</li>)}
            </ul>
            <span class="home-solution-row__cta">{card.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
/* ═══ SOLUTIONS — dark background, alternating rows ═══════════ */
.home-solutions-dark {
  padding: var(--soeteck-section-y) 0;
  background: var(--soeteck-navy);
  color: #fff;
}
.home-solutions-dark :global(.soeteck-container) {
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

/* ── Section head ─────────────────────────────────────────── */
.home-section__head { max-width: 760px; margin: 0 auto 48px; text-align: center; }
.home-section__head--left { margin-left: 0; text-align: left; }
.home-section__eyebrow { margin: 0 0 10px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__eyebrow--light { color: var(--soeteck-primary); }
.home-section__title { margin: 0; font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 800; line-height: 1.12; color: var(--soeteck-text); }
.home-section__title--light { color: #fff; }
.home-section__lead { margin: 18px 0 0; font-size: 1.05rem; line-height: 1.7; color: var(--soeteck-text-soft); }
.home-section__lead--light { color: rgba(255,255,255,0.78); }

.home-solutions-dark__list {
  display: flex;
  flex-direction: column;
  gap: clamp(48px, 6vw, 80px);
}

/* ── Solution row — alternating image/text ─────────────────── */
.home-solution-row {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: clamp(32px, 4vw, 56px);
  align-items: center;
  text-decoration: none;
  color: inherit;
  transition: transform 0.3s ease;
}
.home-solution-row:hover { transform: translateY(-2px); }
.home-solution-row--reverse { direction: rtl; }
.home-solution-row--reverse > * { direction: ltr; }

.home-solution-row__media {
  border-radius: var(--soeteck-radius-lg);
  overflow: hidden;
  aspect-ratio: 16 / 10;
}
.home-solution-row__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.home-solution-row:hover .home-solution-row__media img {
  transform: scale(1.04);
}

.home-solution-row__title {
  margin: 0 0 14px;
  font-size: clamp(1.4rem, 2.2vw, 1.8rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}
.home-solution-row__text {
  margin: 0 0 20px;
  font-size: 1rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.78);
}
.home-solution-row__features {
  list-style: none;
  margin: 0 0 24px;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.home-solution-row__features li {
  position: relative;
  padding-left: 20px;
  font-size: var(--soeteck-text-sm);
  font-weight: 500;
  color: rgba(255,255,255,0.88);
}
.home-solution-row__features li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--soeteck-primary);
}
.home-solution-row__cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 24px;
  border-radius: 999px;
  background: var(--soeteck-primary);
  color: #fff;
  font-size: var(--soeteck-text-sm);
  font-weight: 600;
  transition: background 0.3s ease, transform 0.2s ease;
}
.home-solution-row__cta:hover {
  background: var(--soeteck-primary-dark);
  transform: translateY(-1px);
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 991px) {
  .home-solution-row { grid-template-columns: 1fr; gap: 24px; }
  .home-solution-row--reverse { direction: ltr; }
}
</style>
