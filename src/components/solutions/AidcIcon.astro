---
/**
 * AidcIcon — inline SVG icon set for the AI Data Center solution page.
 * Consistent stroke-based 24×24 line icons, colored via currentColor
 * so they inherit the surrounding accent color.
 */
interface Props {
  name: 'calendar' | 'temp' | 'cost' | 'container' | 'cool' | 'power' | 'gpu' | 'grid' | 'ups' | 'busway' | 'pdu' | 'auth' | 'ai' | 'liquid' | 'prefab' | 'cabinet' | 'row' | 'aisle' | 'ac';
  size?: number;
}

const { name, size = 24 } = Astro.props;

const stroke = {
  fill: 'none',
  'stroke': 'currentColor',
  'stroke-width': '1.8',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
};
---

{
  name === 'calendar' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="3" y="4.5" width="18" height="16" rx="2" />
      <path d="M3 9h18M8 2.5v4M16 2.5v4" />
    </svg>
  ) : name === 'temp' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <path d="M10 13.2V5a2 2 0 0 1 4 0v8.2a4.5 4.5 0 1 1-4 0Z" />
      <path d="M12 9v4.5" />
    </svg>
  ) : name === 'cost' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <circle cx="12" cy="12" r="9" />
      <path d="M15 9.2c-.6-1-1.7-1.6-3-1.6-1.8 0-3.2 1-3.2 2.4 0 3.5 6.4 1.4 6.4 4.9 0 1.4-1.4 2.4-3.2 2.4-1.3 0-2.4-.6-3-1.6M12 6.4v11.2" />
    </svg>
  ) : name === 'container' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="3" y="7" width="18" height="10" rx="1" />
      <path d="M3 10.5h18M3 13.5h18M12 7v10M17 7v10" />
    </svg>
  ) : name === 'cool' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <path d="M12 2.5v19M5.1 5.5l13.8 13M18.9 5.5 5.1 18.5" />
    </svg>
  ) : name === 'power' || name === 'pdu' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <path d="M13 2.5 5 13.5h6l-1 8 8-11h-6l1-8Z" />
    </svg>
  ) : name === 'gpu' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="6" y="6" width="12" height="12" rx="1.5" />
      <rect x="9.5" y="9.5" width="5" height="5" />
      <path d="M9 2.7v2.6M9 18.7v2.6M15 2.7v2.6M15 18.7v2.6M2.7 9h2.6M2.7 15h2.6M18.7 9h2.6M18.7 15h2.6" />
    </svg>
  ) : name === 'grid' || name === 'busway' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="3" y="3" width="7.5" height="7.5" />
      <rect x="13.5" y="3" width="7.5" height="7.5" />
      <rect x="3" y="13.5" width="7.5" height="7.5" />
      <rect x="13.5" y="13.5" width="7.5" height="7.5" />
    </svg>
  ) : name === 'ups' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="3.5" y="6" width="17" height="12" rx="1.5" />
      <path d="M10.5 9 8 12h8l-2.5 3" />
    </svg>
  ) : name === 'auth' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Z" />
      <path d="m9.5 12 1.8 1.8L15 9.8" />
    </svg>
  ) : name === 'ai' ? (
    // AI Data Center：GPU/AI 处理芯片 + 内芯火花
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="4.5" y="4.5" width="15" height="15" rx="2" />
      <rect x="8.5" y="8.5" width="7" height="7" rx="1" />
      <path d="M8.5 4.5V2.6M12 4.5V2.6M15.5 4.5V2.6M8.5 21.4v-1.9M12 21.4v-1.9M15.5 21.4v-1.9" />
      <path d="M4.5 8.5H2.6M4.5 12H2.6M4.5 15.5H2.6M21.4 8.5h-1.9M21.4 12h-1.9M21.4 15.5h-1.9" />
      <path d="m12 10.2.85 1 1 .85-1 .85-.85 1-.85-1-1-.85 1-.85.85-1Z" />
    </svg>
  ) : name === 'liquid' ? (
    // 液冷：水滴 + 冷流
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <path d="M12 2.8c3.4 2.7 5.8 5.4 5.8 8.7a5.8 5.8 0 1 1-11.6 0C6.2 8.2 8.6 5.5 12 2.8Z" />
      <path d="m9.6 11.9 1.7 1.7 3.1-3.2" />
    </svg>
  ) : name === 'prefab' ? (
    // 预制集装箱：ISO 箱体 + 内部机架
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="3" y="5" width="18" height="14" rx="1" />
      <path d="M3 9h18M3 13h18" />
      <rect x="8" y="14.4" width="8" height="2" rx="0.4" />
    </svg>
  ) : name === 'cabinet' ? (
    // 柜式模块：紧凑机柜
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="7" y="3" width="10" height="18" rx="1" />
      <path d="M9.6 6.2h4.8M9.6 9h4.8M9.6 11.8h4.8M9.6 14.6h4.8" />
    </svg>
  ) : name === 'row' ? (
    // 列式模块：三排机柜
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="3" y="4" width="5" height="16" rx="0.8" />
      <rect x="9.5" y="4" width="5" height="16" rx="0.8" />
      <rect x="16" y="4" width="5" height="16" rx="0.8" />
      <path d="M4.6 7.4h1.8M11.1 7.4h1.8M17.6 7.4h1.8M4.6 10.6h1.8M11.1 10.6h1.8M17.6 10.6h1.8" />
    </svg>
  ) : name === 'aisle' ? (
    // 通道模块：两侧机柜 + 冷热通道
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="3" y="3.5" width="7" height="17" rx="1" />
      <rect x="14" y="3.5" width="7" height="17" rx="1" />
      <path d="M10 7h4M10 12h4M10 17h4" />
    </svg>
  ) : name === 'ac' ? (
    // 精密空调：风机盘管
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <rect x="4" y="4" width="16" height="16" rx="2" />
      <circle cx="12" cy="12" r="3.4" />
      <path d="M12 8.6V7.2M12 16.8v-1.4M8.6 12H7.2M16.8 12h-1.4" />
    </svg>
  ) : (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
      <circle cx="12" cy="12" r="9" />
    </svg>
  )
}