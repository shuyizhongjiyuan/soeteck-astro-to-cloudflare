---
import type { AdaptedPage } from '@/lib/page-adapter';
import NewsArchiveHero from '@/components/news-releases/NewsArchiveHero.astro';
import FeaturedArticleCard from './FeaturedArticleCard.astro';
import ArticleCard from './ArticleCard.astro';
import ArchiveCta from './ArchiveCta.astro';
import { ARCHIVE_EN } from '@/components/news-releases/news-releases-content';
import { ARCHIVE_ZH } from '@/components/news-releases/news-releases-content-zh';
import { ARCHIVE_RU } from '@/components/news-releases/news-releases-content-ru';
import { ARCHIVE_PT } from '@/components/news-releases/news-releases-content-pt';
import { ARCHIVE_ES } from '@/components/news-releases/news-releases-content-es';
import type { ArchiveContent } from '@/components/news-releases/news-releases-content';

interface Props {
  page: AdaptedPage;
  lang?: string;
}

const { page, lang = 'en' } = Astro.props;

const contentMap: Record<string, ArchiveContent> = {
  en: ARCHIVE_EN,
  zh: ARCHIVE_ZH,
  ru: ARCHIVE_RU,
  pt: ARCHIVE_PT,
  es: ARCHIVE_ES,
};
const archiveContent = contentMap[lang] ?? ARCHIVE_EN;
const heroConfig = archiveContent.caseStudies;
const csLabels = archiveContent.caseStudyLabels;

const description = page.source.archive?.description || heroConfig.description;
const allArticles = page.articles;

// Page 1: first article is featured, rest in grid
const featuredArticle = allArticles.length > 0 ? allArticles[0] : null;
const gridArticles = featuredArticle ? allArticles.slice(1) : [];
---

<div class="soeteck-case-studies-page">
  <NewsArchiveHero
    breadcrumbs={page.breadcrumbs}
    title={page.title || heroConfig.title}
    description={description}
    lang={lang}
    heroConfig={heroConfig}
  />
  <div class="soeteck-container soeteck-case-studies-page__container">
    {featuredArticle && (
      <div class="soeteck-case-studies-page__featured">
        <FeaturedArticleCard
          article={featuredArticle}
          label={csLabels.featuredLabel}
          readMoreLabel={csLabels.readMoreLabel}
          lang={lang}
        />
      </div>
    )}
    {gridArticles.length > 0 && (
      <div class="soeteck-case-studies-page__grid">
        {gridArticles.map((article) => (
          <ArticleCard
            article={article}
            showAuthor={true}
            sourceLabel={csLabels.sourceLabel}
            lang={lang}
          />
        ))}
      </div>
    )}
    {allArticles.length === 0 && (
      <p class="soeteck-case-studies-page__empty">{csLabels.noArticles}</p>
    )}
  </div>
  <ArchiveCta
    title={archiveContent.cta.title}
    buttonLabel={archiveContent.cta.buttonLabel}
    buttonHref={`/${lang}/contact-us/`}
    lang={lang}
  />
</div>

<style>
  .soeteck-case-studies-page {
    background: var(--soeteck-white);
  }

  .soeteck-case-studies-page__container {
    padding: var(--soeteck-section-y-sm) 0 var(--soeteck-section-y);
  }

  .soeteck-case-studies-page__featured {
    margin-bottom: clamp(34px, 5vw, 72px);
  }

  .soeteck-case-studies-page__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .soeteck-case-studies-page__empty {
    text-align: center;
    color: var(--soeteck-muted);
    padding: 48px 0;
    font-size: var(--soeteck-text-lg);
  }

  @media (max-width: 768px) {
    .soeteck-case-studies-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>