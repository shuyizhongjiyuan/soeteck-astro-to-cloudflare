---
/**
 * Preview page — Tab style options for Why section.
 * Access: http://localhost:4321/preview-why-tabs/
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HOME_EN } from '@/components/home/home-content';

const c = HOME_EN;
const why = c.whySoeteck;
const tabs = [
  { num: '01', short: 'Production', title: 'Quantified Production &amp; Delivery Certainty' },
  { num: '02', short: 'Validation', title: 'Market Validation &amp; Social Proof' },
  { num: '03', short: 'Differentiators', title: 'Core Differentiators' },
  { num: '04', short: 'Quality', title: 'Quality &amp; Global Compliance' },
  { num: '05', short: 'After-Sales', title: 'After-Sales &amp; Supply Chain Guarantee' },
];
---

<BaseLayout title="Preview: Tab Styles — Why Section" lang="en" canonical="https://soeteck.com/preview-why-tabs/" robots="noindex">
  <div style="padding:40px 24px; background:var(--soeteck-navy); color:#fff;">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:var(--soeteck-primary); font-size:12px; letter-spacing:.16em; text-transform:uppercase; margin:0 0 8px;">Variant C · Tab 样式探索</p>
      <h1 style="font-size:26px; margin:0 0 8px;">5 种 Tab 切换样式</h1>
      <p style="color:rgba(255,255,255,.8); margin:0;">每种只展示第一个 tab 激活态，其他 tab 为非激活态示意</p>
    </div>
  </div>

  <!-- ═══ Style 1: Vertical numbered tabs ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(48px,6vw,72px) 0; border-bottom:1px solid var(--soeteck-border-soft);">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Style 1 · 垂直编号 Tab</p>
      <p class="opt-why">左侧编号，激活项蓝色左条 + 文字高亮，右侧内容区</p>
      <div style="display:grid; grid-template-columns:260px 1fr; gap:48px; margin-top:24px; min-height:360px;">
        <div style="display:flex; flex-direction:column; gap:4px; border-right:1px solid var(--soeteck-border-soft); padding-right:24px;">
          {tabs.map((t, i) => (
            <div style={`display:flex; align-items:center; gap:14px; padding:14px 16px; border-radius:10px; ${i === 0 ? 'background:var(--soeteck-primary-soft); border-left:3px solid var(--soeteck-primary);' : 'border-left:3px solid transparent;'}`}>
              <span style={`font-size:20px; font-weight:800; line-height:1; ${i === 0 ? 'color:var(--soeteck-primary);' : 'color:var(--soeteck-muted);'}`}>{t.num}</span>
              <span style={`font-size:15px; font-weight:600; line-height:1.3; ${i === 0 ? 'color:var(--soeteck-primary);' : 'color:var(--soeteck-text-soft);'}`}>{t.short}</span>
            </div>
          ))}
        </div>
        <div style="padding:24px 0;">
          <span style="display:inline-block; padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary); margin-right:8px; margin-bottom:8px;">50,000 m² Manufacturing Base</span>
          <span style="display:inline-block; padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary); margin-right:8px; margin-bottom:8px;">100% Factory Tested</span>
          <span style="display:inline-block; padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary); margin-bottom:8px;">8–12W Delivery</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Style 2: Vertical card tabs ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(48px,6vw,72px) 0; border-bottom:1px solid var(--soeteck-border-soft);">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Style 2 · 垂直卡片 Tab</p>
      <p class="opt-why">每个 tab 是一个小卡片，带编号 + 标题 + 简短描述，激活项上浮高亮</p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:48px; margin-top:24px; min-height:360px;">
        <div style="display:flex; flex-direction:column; gap:10px;">
          {tabs.map((t, i) => (
            <div style={`padding:16px 18px; border-radius:12px; cursor:pointer; transition:all .3s; ${i === 0 ? 'border:1px solid var(--soeteck-primary); background:var(--soeteck-primary-soft); box-shadow:0 4px 16px rgba(26,133,229,.12);' : 'border:1px solid var(--soeteck-border-soft); background:var(--soeteck-surface);'}`}>
              <div style="display:flex; align-items:center; gap:12px;">
                <span style={`flex-shrink:0; width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:8px; font-size:14px; font-weight:700; ${i === 0 ? 'background:var(--soeteck-primary); color:#fff;' : 'background:var(--soeteck-primary-soft); color:var(--soeteck-primary);'}`}>{t.num}</span>
                <div>
                  <span style={`font-size:15px; font-weight:600; ${i === 0 ? 'color:var(--soeteck-primary);' : 'color:var(--soeteck-text);'}`}>{t.title}</span>
                  <span style="display:block; font-size:12px; color:var(--soeteck-muted); margin-top:2px;">{i === 0 ? 'Click to view details' : ''}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div style="padding:24px; background:var(--soeteck-surface); border-radius:14px; border:1px solid var(--soeteck-border-soft);">
          <p style="margin:0 0 16px; font-size:15px; font-weight:600; color:var(--soeteck-text);">Quantified Production &amp; Delivery</p>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">50,000 m² Base</span>
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">100% Tested</span>
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">8–12W Delivery</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Style 3: Horizontal pill tabs ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(48px,6vw,72px) 0; border-bottom:1px solid var(--soeteck-border-soft);">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Style 3 · 水平胶囊 Tab</p>
      <p class="opt-why">顶部胶囊行，激活项浅蓝底 + 主色，下方内容区，适合偏好紧凑布局</p>
      <div style="margin-top:24px;">
        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:32px; padding-bottom:16px; border-bottom:1px solid var(--soeteck-border-soft);">
          {tabs.map((t, i) => (
            <span style={`padding:10px 22px; border-radius:999px; font-size:14px; font-weight:600; cursor:pointer; ${i === 0 ? 'background:var(--soeteck-primary); color:#fff;' : 'background:var(--soeteck-surface); border:1px solid var(--soeteck-border); color:var(--soeteck-text-soft);'}`}>
              {t.num} {t.short}
            </span>
          ))}
        </div>
        <div style="padding:24px; background:var(--soeteck-surface); border-radius:14px; border:1px solid var(--soeteck-border-soft); min-height:200px;">
          <p style="margin:0 0 16px; font-size:15px; font-weight:600; color:var(--soeteck-text);">01 · Quantified Production &amp; Delivery</p>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">50,000 m² Manufacturing Base</span>
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">100% Factory Tested</span>
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">8–12W Delivery</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Style 4: Timeline step tabs ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(48px,6vw,72px) 0; border-bottom:1px solid var(--soeteck-border-soft);">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Style 4 · 时间线步骤 Tab</p>
      <p class="opt-why">纵向连接线 + 圆点编号，激活项圆点填色 + 标题高亮，有"叙事递进"感</p>
      <div style="display:grid; grid-template-columns:260px 1fr; gap:48px; margin-top:24px; min-height:360px;">
        <div style="position:relative;">
          <div style="position:absolute; left:19px; top:10px; bottom:10px; width:2px; background:var(--soeteck-border);"></div>
          <div style="display:flex; flex-direction:column; gap:0;">
            {tabs.map((t, i) => (
              <div style={`display:flex; align-items:center; gap:16px; padding:14px 0; cursor:pointer;`}>
                <span style={`flex-shrink:0; width:40px; height:40px; display:flex; align-items:center; justify-content:center; border-radius:50%; font-size:15px; font-weight:700; z-index:1; ${i === 0 ? 'background:var(--soeteck-primary); color:#fff;' : 'background:var(--soeteck-surface); border:2px solid var(--soeteck-border); color:var(--soeteck-muted);'}`}>{t.num}</span>
                <span style={`font-size:15px; font-weight:600; ${i === 0 ? 'color:var(--soeteck-primary);' : 'color:var(--soeteck-text-soft);'}`}>{t.title}</span>
              </div>
            ))}
          </div>
        </div>
        <div style="padding:24px; background:var(--soeteck-surface); border-radius:14px; border:1px solid var(--soeteck-border-soft);">
          <p style="margin:0 0 16px; font-size:15px; font-weight:600; color:var(--soeteck-text);">01 · Quantified Production &amp; Delivery</p>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">50,000 m² Base</span>
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">100% Factory Tested</span>
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">8–12W Delivery</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Style 5: Vertical icon tabs ═══ -->
  <section style="background:var(--soeteck-white); padding:clamp(48px,6vw,72px) 0;">
    <div style="max-width:1200px; margin:0 auto; padding:0 24px;">
      <p class="opt-label">Style 5 · 垂直图标 Tab</p>
      <p class="opt-why">编号 + 图标 + 标题三行式，激活项整块高亮，视觉丰富</p>
      <div style="display:grid; grid-template-columns:300px 1fr; gap:48px; margin-top:24px; min-height:380px;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
          {tabs.map((t, i) => (
            <div style={`padding:18px 12px; border-radius:12px; text-align:center; cursor:pointer; transition:all .3s; ${i === 0 ? 'border:1px solid var(--soeteck-primary); background:var(--soeteck-primary-soft);' : 'border:1px solid var(--soeteck-border-soft); background:var(--soeteck-surface);'}`}>
              <span style={`font-size:18px; font-weight:800; line-height:1; ${i === 0 ? 'color:var(--soeteck-primary);' : 'color:var(--soeteck-muted);'}`}>{t.num}</span>
              <div style="font-size:24px; margin:8px 0;">{['⚙','📊','⚡','✓','🔒'][i]}</div>
              <span style={`font-size:12px; font-weight:600; line-height:1.2; ${i === 0 ? 'color:var(--soeteck-primary);' : 'color:var(--soeteck-text-soft);'}`}>{t.short}</span>
            </div>
          ))}
        </div>
        <div style="padding:24px; background:var(--soeteck-surface); border-radius:14px; border:1px solid var(--soeteck-border-soft);">
          <p style="margin:0 0 16px; font-size:15px; font-weight:600; color:var(--soeteck-text);">Quantified Production &amp; Delivery</p>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">50,000 m² Base</span>
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">100% Tested</span>
            <span style="padding:10px 20px; background:var(--soeteck-primary-soft); border-radius:8px; font-size:14px; font-weight:600; color:var(--soeteck-primary);">8–12W Delivery</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .opt-label { margin: 0; color: var(--soeteck-primary); font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .opt-why { margin: 4px 0 0; font-size: 14px; color: var(--soeteck-muted); }
</style>