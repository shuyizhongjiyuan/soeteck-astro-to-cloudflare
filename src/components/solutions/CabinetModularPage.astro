<script>
  (function initCabinetGallery() {
    var root = document.querySelector('[data-cabinet-solution]');
    if (!root) return;

    /* ── Product Gallery thumbnail switching ── */
    var galleries = root.querySelectorAll('[data-cabinet-gallery]');
    galleries.forEach(function(grid) {
      var thumbs = grid.querySelectorAll('[data-product-gallery-target]');
      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          var target = this.getAttribute('data-product-gallery-target');
          if (!target) return;

          // Find parent product panel
          var panel = this.closest('[data-product-panel]');
          if (!panel) return;

          // Deactivate all thumbs in this panel
          panel.querySelectorAll('[data-product-gallery-target]').forEach(function(t) {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
          });

          // Activate clicked thumb
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          // Switch main image
          panel.querySelectorAll('[data-product-gallery-item]').forEach(function(item) {
            item.classList.remove('is-active');
          });
          var activeItem = panel.querySelector('[data-product-gallery-item="' + target + '"]');
          if (activeItem) activeItem.classList.add('is-active');
        });
      });
    });
  })();

  (function initCabinetPage() {
    const container = document.querySelector('[data-cabinet-solution]');
    if (!container) return;

    // --- Hotspot interaction ---
    // Hover → tooltip + core 变主题色（纯 CSS），无需点击状态
    const hotspotMedia = container.querySelector('[data-prefab-hotspots]');
    const pins = hotspotMedia?.querySelectorAll('[data-hotspot-index]');
    pins?.forEach((pin) => {
      pin.addEventListener('click', () => {});
    });

    // --- Model image hotspot pins ---
    const modelPins = container.querySelectorAll('.soeteck-cabinet-model-item__pin');
    modelPins.forEach((pin) => {
      pin.addEventListener('click', () => {
        const expanded = pin.getAttribute('aria-expanded') === 'true';
        pin.setAttribute('aria-expanded', String(!expanded));
      });
      pin.addEventListener('mouseenter', () => pin.setAttribute('aria-expanded', 'true'));
      pin.addEventListener('mouseleave', () => pin.setAttribute('aria-expanded', 'false'));
    });

    // --- Accordion ---
    const accordionItems = container.querySelectorAll('[data-accordion-item]');
    accordionItems.forEach((item) => {
      const trigger = item.querySelector('[data-accordion-trigger]');
      if (!trigger) return;
      trigger.addEventListener('click', () => {
        const expanded = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', String(!expanded));
      });
    });

    // --- Scenario card tabs ---
    const scenarioCards = container.querySelectorAll('[data-scenario-card]');
    scenarioCards.forEach(function(card) {
      card.querySelectorAll('[data-scenario-tab]').forEach(function(tab) {
        tab.addEventListener('click', function() {
          var target = tab.getAttribute('data-scenario-tab');
          if (!target) return;
          card.querySelectorAll('[data-scenario-tab]').forEach(function(node) {
            var isActive = node === tab;
            node.classList.toggle('is-active', isActive);
            node.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
          card.querySelectorAll('[data-scenario-panel]').forEach(function(panel) {
            var isActive = panel.getAttribute('data-scenario-panel') === target;
            panel.classList.toggle('is-active', isActive);
            panel.hidden = !isActive;
          });
        });
      });
    });
  })();
</script>
