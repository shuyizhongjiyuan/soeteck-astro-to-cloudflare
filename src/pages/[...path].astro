---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageDispatcher from '@/components/PageDispatcher.astro';
import { fetchPocRoutes, fetchRouteContent } from '@/lib/content-api';
import { adaptPage } from '@/lib/page-adapter';
import { buildBreadcrumbSchema } from '@/lib/schema';
import { getUITranslation } from '@/lib/translations';

const languages = ['en', 'zh', 'ru', 'pt', 'es'];

export async function getStaticPaths() {
  const routes = await fetchPocRoutes();
  const langs = ['en', 'zh', 'ru', 'pt', 'es'];

  // 为每种语言 × 每个路由生成静态路径
  // API 路由路径格式: /en/solutions/liquid-cooling/
  // 需要替换语言前缀为目标语言
  return langs.flatMap(lang =>
    routes.map((route) => {
      // 替换语言前缀: /en/xxx → /{lang}/xxx
      const pathWithLang = route.path.replace(/^\/en\//, `/${lang}/`);
      // 移除前导斜杠和尾部斜杠，生成 params
      const pathParam = pathWithLang.replace(/^\//, '').replace(/\/$/, '') || undefined;

      return {
        params: { path: pathParam },
        props: { route, lang },
      };
    })
  );
}

const { route, lang } = Astro.props;

let page;
try {
  const content = await fetchRouteContent(route, lang);
  page = adaptPage(content);
} catch (e) {
  // API 请求失败时渲染降级页面
  page = {
    id: null,
    kind: 'generic' as const,
    routeType: route.routeType,
    routePath: route.path,
    language: lang,
    title: getUITranslation(lang, 'common.errorLoadingPage'),
    seo: { title: getUITranslation(lang, 'common.errorLoadingPage'), canonical: '', robots: 'noindex' },
    breadcrumbs: [{ label: getUITranslation(lang, 'nav.home'), path: `/${lang}/` }],
    heroImage: null,
    contentHtml: '',
    media: [],
    article: null,
    articles: [],
    featuredArticles: [],
    source: {} as any,
  };
}

// 使用 API 返回的真实 localizedPaths（包含各语言实际路径和状态）
const localizedPaths: Record<string, { path: string | null; status: string }> | undefined = page.source?.route?.localizedPaths;
// 去掉语言前缀的路径，用于 canonical URL
const pathWithoutLang = route.path.replace(/^\/[a-z]{2}\//, '/');

// Schema JSON-LD：优先用 Rank Math 在 Content API 交付的 schema；
// 无则用 Astro 生成 BreadcrumbList 兜底，保证全站基础结构化数据覆盖
const schemas = (page.seo.schema && page.seo.schema.length > 0)
  ? page.seo.schema
  : [buildBreadcrumbSchema(page.breadcrumbs, lang)];
---
<BaseLayout
  lang={lang}
  title={page.seo.title}
  canonical={`https://soeteck.com/${lang}${pathWithoutLang}`}
  robots={page.seo.robots}
  description={page.seo.description}
  localizedPaths={localizedPaths}
  schemas={schemas}
>
  <PageDispatcher page={page} lang={lang} />
</BaseLayout>
