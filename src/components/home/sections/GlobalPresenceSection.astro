---
/**
 * GlobalPresenceSection — Global footprint (Variant B only).
 * Lightweight: dot-grid backdrop + regions list + stats panel.
 * (Interactive world map deferred — simplified per spec "待确认" item.)
 *
 * @package Soeteck\Astro
 */
import type { HomeContent } from '../home-content';

interface Props {
  data: NonNullable<HomeContent['globalPresence']>;
}

const { data } = Astro.props;
---

<section class="home-global" aria-labelledby="global-title">
  <div class="soeteck-container">
    <div class="home-global__layout">
      <div class="home-global__intro">
        <p class="home-section__eyebrow">{data.eyebrow}</p>
        <h2 id="global-title" class="home-section__title">{data.title}</h2>
        <p class="home-section__lead">{data.text}</p>
        <div class="home-global__regions">
          {data.regions.map((region) => <span class="home-global__region">{region}</span>)}
        </div>
      </div>
      <div class="home-global__panel" aria-label="Company global statistics">
        <div class="home-global__stats">
          {data.stats.map((stat) => (
            <div class="home-global-stat">
              <span class="home-global-stat__value">{stat.value}<span class="home-global-stat__suffix">{stat.suffix}</span></span>
              <span class="home-global-stat__label">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ═══ GLOBAL PRESENCE — dot-grid backdrop ════════════════════ */
.home-global {
  position: relative;
  padding: var(--soeteck-section-y) 0;
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.14) 1px, transparent 1px),
    linear-gradient(180deg, #0b1f3a 0%, #0d2847 100%);
  background-size: 26px 26px, cover;
  color: #fff;
  overflow: hidden;
}
.home-global::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(900px 420px at 90% 15%, rgba(0, 102, 204, 0.28), transparent 60%);
  pointer-events: none;
}
.home-global :global(.soeteck-container) {
  position: relative;
  width: min(var(--soeteck-container), calc(100% - 48px));
  margin: 0 auto;
}

.home-global__layout {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: clamp(40px, 5vw, 72px);
  align-items: center;
}

/* ── Intro ────────────────────────────────────────────────── */
.home-section__eyebrow { margin: 0 0 10px; color: var(--soeteck-primary); font-size: var(--soeteck-text-xs); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.home-section__title { margin: 0; font-size: clamp(1.85rem, 3.1vw, 2.5rem); font-weight: 700; line-height: 1.14; color: #fff; }
.home-section__lead { margin: 18px 0 0; font-size: 1.05rem; line-height: 1.7; color: rgba(255, 255, 255, 0.78); }

.home-global__regions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}
.home-global__region {
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: var(--soeteck-text-sm);
  font-weight: 500;
}

/* ── Stats panel ──────────────────────────────────────────── */
.home-global__panel {
  padding: 40px 32px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: var(--soeteck-radius-lg);
  backdrop-filter: blur(8px);
}
.home-global__stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px 24px;
  text-align: center;
}
.home-global-stat__value {
  display: block;
  font-size: clamp(2.2rem, 3.5vw, 3rem);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
  background: linear-gradient(120deg, #fff 0%, var(--soeteck-primary) 90%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.home-global-stat__label {
  display: block;
  margin-top: 8px;
  font-size: var(--soeteck-text-sm);
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 991px) {
  .home-global__layout { grid-template-columns: 1fr; }
}
</style>
